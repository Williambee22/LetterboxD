<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Users - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
</head>
<body class="app">
  <main class="wrap">

    <div class="panel">
      <div class="row between" style="align-items:flex-end; gap:12px; flex-wrap:wrap; margin-bottom:8px;">
        <div>
          <div class="kicker">Admin</div>
          <h1 style="margin:6px 0 8px;">Users</h1>
          <div class="muted small">
            Total users:
            <strong><%= Array.isArray(users) ? users.length : 0 %></strong>
          </div>
        </div>

        <form method="get" action="/admin/users" class="row gap" style="align-items:center; margin:0;">
          <label class="muted small" for="sortUsers" style="font-weight:700;">Sort by</label>
          <select id="sortUsers" name="sort" class="input" onchange="this.form.submit()">
            <option value="default" <%= sort === "default" ? "selected" : "" %>>Username</option>
            <option value="newest" <%= sort === "newest" ? "selected" : "" %>>Newest created</option>
          </select>
          <noscript>
            <button class="btn" type="submit">Apply</button>
          </noscript>
        </form>
      </div>

      <% if (Array.isArray(users) && users.length > 0) { %>
        <div class="stack">
          <% for (const u of users) { %>
            <div class="row between" style="align-items:center; padding:10px 0; border-bottom:1px solid rgba(255,255,255,.08);">
              <div>
                <div style="font-weight:800;"><%= u.username %></div>
                <div class="muted small"><%= Number(u.is_admin) === 1 ? "Admin" : "User" %></div>

                <% if (u.created_ts) { %>
                  <div class="muted small" style="margin-top:4px;">
                    Created: <%= new Date(Number(u.created_ts) * 1000).toLocaleString() %>
                  </div>
                <% } %>

                <% if (u.must_change_password) { %>
                  <div class="muted small" style="margin-top:4px;">
                    Must change password on next login
                  </div>
                <% } %>
              </div>

              <div class="row gap" style="align-items:center; flex-wrap:wrap;">
                <a class="btn ghost" href="/u/<%= encodeURIComponent(u.username) %>">Profile</a>
                <a class="btn green" href="/admin/user/<%= encodeURIComponent(u.username) %>/roles">Assign roles</a>

                <form method="post" action="/admin/user/<%= encodeURIComponent(u.username) %>/force-reset" style="margin:0;">
                  <button class="btn ghost" type="submit">Force reset</button>
                </form>

                <form method="post" action="/admin/user/<%= encodeURIComponent(u.username) %>/set-temp-password" style="margin:0;">
                  <button class="btn ghost" type="submit">Set temp password</button>
                </form>
              </div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="muted">No users found.</div>
      <% } %>
    </div>

  </main>
</body>
</html>
