<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Manage Competitions | Pressboxd</title>
<link rel="stylesheet" href="/static/betting.css"><link rel="stylesheet" href="/static/betsadmin.css">
<style>.event-delete{background:#51252d!important;border:1px solid #a94b57!important;color:#fff!important;padding:7px 12px;border-radius:4px}.event-delete:disabled{opacity:.45;cursor:not-allowed}.event-search{font:inherit;background:var(--panel);color:var(--text);border:1px solid var(--stroke);padding:9px 12px;margin:12px 0;width:min(360px,100%);border-radius:4px}.event-form{margin:0}.event-status{font-size:11px;color:var(--muted)}</style>
</head><body class="pb-body"><header class="ba-header"><a href="/betsadmin" class="ba-brand"><img src="/static/logo.png" alt="" width="38" height="38"><strong>BETS ADMIN</strong></a><nav><a href="/betsadmin">Gems Admin</a> <a href="/betsadmin/lines">Line Monitor</a> <a href="/betsadmin/sync">DCI Sync</a> <a href="/betting">Betting</a></nav></header>
<main class="ba-main"><div class="ba-heading"><div><span class="ba-kicker">ADMINISTRATOR ONLY</span><h1>Manage Competitions</h1><p>Remove competitions from the betting board and calendar. Removed competitions will not be reimported by the official schedule sync.</p></div></div>
<% if(notice){ %><div class="ba-alert ba-ok"><%=notice%></div><% } %><% if(error){ %><div class="ba-alert ba-error"><%=error%></div><% } %>
<section class="ba-panel"><h2>Scheduled competitions (<%=events.length%>)</h2><p class="ba-muted">Competitions with submitted picks, settled markets or recorded refunds cannot be deleted.</p><input id="eventSearch" class="event-search" type="search" placeholder="Search competitions" aria-label="Search competitions">
<div class="ba-table-wrap"><table><thead><tr><th>Competition</th><th>Date</th><th>Submitted picks / entries</th><th>Action</th></tr></thead><tbody id="eventRows">
<% for(const e of events){const blocked=e.singles||e.entries||e.settled||e.refunded; %><tr data-event-row><td><a href="/betsadmin/lines?event_id=<%=encodeURIComponent(e.id)%>"><%=e.name%></a></td><td><%=e.local_date||(e.start_ts!=null?new Date(e.start_ts*1000).toISOString().slice(0,10):'Date TBA')%><% if(e.start_ts==null){ %><br><span class="event-status">Start time TBA</span><% } %></td><td><%=e.singles%> single / <%=e.entries%> multi-entry</td><td><% if(blocked){ %><button class="event-delete" disabled>Delete</button><br><span class="event-status">Protected history</span><% } else { %><form class="event-form" method="post" action="/betsadmin/events/delete" onsubmit="return confirm('Delete this competition from the betting schedule and calendar? It will not be automatically reimported.');"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="event_id" value="<%=e.id%>"><input type="hidden" name="confirm" value="yes"><button class="event-delete" type="submit">Delete</button></form><% } %></td></tr><% } %>
<% if(!events.length){ %><tr><td colspan="4">No scheduled competitions.</td></tr><% } %></tbody></table></div></section>
<section class="ba-panel ba-history"><h2>Recently deleted competitions</h2><div class="ba-table-wrap"><table><thead><tr><th>Competition</th><th>Removed by</th><th>Time (CT)</th></tr></thead><tbody><% for(const r of removed){ %><tr><td><%=r.event_name%></td><td><%=r.username||('User #'+r.admin_id)%></td><td><%=new Date(r.removed_ts*1000).toLocaleString('en-US',{timeZone:'America/Chicago'})%></td></tr><% } %><% if(!removed.length){ %><tr><td colspan="3">No competitions deleted yet.</td></tr><% } %></tbody></table></div></section></main>
<script>document.getElementById('eventSearch').addEventListener('input',function(){const q=this.value.trim().toLowerCase();document.querySelectorAll('[data-event-row]').forEach(row=>row.hidden=!row.textContent.toLowerCase().includes(q));});</script></body></html>
