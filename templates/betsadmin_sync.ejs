<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>DCI Sync & Replay | Bets Admin</title><style>
:root{color-scheme:dark}*{box-sizing:border-box}body{font:14px system-ui,Arial;background:#111016;color:#f5f3f7;margin:0}header{display:flex;justify-content:space-between;align-items:center;padding:18px 4%;background:#1c1a23;border-bottom:1px solid #35313f;gap:15px;flex-wrap:wrap}a{color:#c29bff}main{max-width:1150px;margin:25px auto;padding:0 16px}h1{font-size:28px}h2{font-size:18px;margin:0 0 13px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:16px}.panel{background:#221f2a;border:1px solid #393542;border-radius:8px;padding:20px;margin-bottom:18px}.muted{color:#aaa4b6;font-size:12px;line-height:1.6}input,select,button{font:inherit;border-radius:5px;padding:9px;background:#332e3f;color:white;border:1px solid #504a5b}button{cursor:pointer;background:#b17bf4;color:#160e25;font-weight:bold;border:0}form{display:flex;flex-wrap:wrap;gap:9px;align-items:center;margin:12px 0}input[type=number]{width:95px}input[type=text]{min-width:220px;max-width:100%}.notice{padding:15px;background:#332b43;border-radius:6px;overflow-wrap:anywhere}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:10px;border-bottom:1px solid #413947;text-align:left}.scroll{overflow:auto}code{color:#d0b9ff}.test{border-left:4px solid #f0c86a}small{color:#b9b1c7}
</style></head><body><header><strong>💎 BETS ADMIN · DCI AUTOMATION</strong><nav><a href="/betsadmin">Gems Admin</a> · <a href="/betting">Betting</a> · <a href="/predictions">Pressboxd</a></nav></header><main>
<h1>DCI Sync & Historical Replay</h1><p class="muted">Admin only. Real DCI schedule sync and score checks are separate from the historical sandbox. Sandbox bets use isolated TEST Gems.</p>
<% if(notice){%><p class="notice"><%= notice %></p><% } %>
<div class="grid"><section class="panel"><h2>Official Event Discovery</h2><p class="muted">Fetch the live DCI event schedule and lineups. Import eligible future events and create historical-data projections when the lineup is verified.</p><form method="post" action="/betsadmin/sync/action"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="discover"><label>Season <input name="year" type="number" min="2022" max="2100" value="<%= new Date().getFullYear() %>"></label><button>Sync DCI Events</button></form></section>
<section class="panel"><h2>Official Score Check</h2><p class="muted">Read the DCI scores index and matching individual result pages. Only verified overall-score markets settle automatically; unverified captions remain pending.</p><form method="post" action="/betsadmin/sync/action"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="scores"><button>Check Official Scores</button></form></section></div>
<section class="panel test"><h2>Historical Replay · Separate TEST Gems</h2><p>Test wallet: <strong>💎 <%= testBalance.toLocaleString() %></strong> (test-only; does not change live Gems)</p><p class="muted">Select any 2022–2026 event ID found in your historical workbook. Default: 2026 DCI Dallas. Lines use only results BEFORE the event. The actual score data is hidden until settlement.</p><form method="post" action="/betsadmin/sync/action"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="replay"><label>Historical event slug <input type="text" name="slug" value="2026-dci-dallas" required pattern="20[0-9]{2}-[a-z0-9-]+"></label><button>Load Replay from Workbook</button></form>
<% sandbox.forEach(ev=>{const markets=JSON.parse(ev.markets_json).filter(m=>m.caption==='Overall'&&m.kind==='absolute').slice(0,16); %><div class="panel"><strong><%= ev.name %> · <%= ev.original_date %></strong><p class="muted"><%= ev.market_count %> generated historical lines. No future score leakage. Results aren't shown until you settle.</p><div class="grid"><form method="post" action="/betsadmin/sync/action"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="testbet"><input type="hidden" name="event_id" value="<%= ev.id %>"><select name="market_id" required><% markets.forEach(m=>{ %><option value="<%= m.id %>"><%= m.corps %> · <%= m.caption %> · <%= m.line.toFixed(3) %></option><% }) %></select><select name="choice"><option value="over">MORE</option><option value="under">LESS</option></select><input type="number" name="stake" min="1" max="1000" value="50" required><button>Place Test Bet</button></form><form method="post" action="/betsadmin/sync/action"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="settle"><input type="hidden" name="event_id" value="<%= ev.id %>"><button>Settle From Historical Scores</button></form></div></div><% }) %></section>
<section class="panel"><h2>Test Bets (your sandbox only)</h2><div class="scroll"><table><thead><tr><th>Corps / Caption</th><th>Choice</th><th>Line</th><th>Stake</th><th>Actual</th><th>Result</th><th>Payout</th></tr></thead><tbody><% recent.forEach(b=>{ %><tr><td><%= b.corps %> / <%= b.caption %></td><td><%= b.choice %></td><td><%= b.line %></td><td><%= b.stake %></td><td><%= b.actual==null?'—':b.actual.toFixed(3) %></td><td><%= b.result %></td><td><%= b.payout %></td></tr><% }) %></tbody></table></div></section>
<section class="panel"><h2>Imported DCI Events</h2><div class="scroll"><table><thead><tr><th>Event</th><th>Date (UTC)</th><th>Status</th></tr></thead><tbody><% events.forEach(e=>{ %><tr><td><%= e.name %></td><td><%= new Date(e.start_ts*1000).toISOString() %></td><td><%= e.status %></td></tr><% }) %></tbody></table></div></section>
<section class="panel"><h2>Automation Logs</h2><div class="scroll"><table><thead><tr><th>Time (UTC)</th><th>Job</th><th>Status</th><th>Details</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><%= new Date(l.created_ts*1000).toISOString() %></td><td><%= l.kind %></td><td><%= l.status %></td><td><%= l.details %></td></tr><% }) %></tbody></table></div></section>
</main></body></html>
