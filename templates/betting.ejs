
<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <title>Board | Pressboxd</title>

  <link rel="stylesheet" href="/static/betting.css">
</head>

<body class="pb-body">

  <!-- ==========================================
       HEADER
       ========================================== -->

  <header class="pb-header">

    <div class="pb-top-inner">

      <a class="pb-brand" href="/shows">
        <img
          src="/static/favicon.png"
          alt="Pressboxd"
          style="height:45px;width:auto;object-fit:contain;"
        >
      </a>

      <nav class="pb-main-nav">
        <a href="/shows">Shows</a>
        <a href="/predictions">Predictions</a>
        <a class="active" href="/betting">Board</a>
        <a href="/forums">Forums</a>
      </nav>

      <div class="pb-header-right">

        <a href="#history" class="pb-my-picks">
          My Picks
        </a>

        <div class="pb-balance">
          <span class="pb-coin">P</span>

          <strong id="balance">
            <%= balance.toLocaleString() %>
          </strong>

          <span class="pb-point-unit">PTS</span>
        </div>

        <a href="/me" class="pb-profile" title="Profile">
          <%= String((me && me.username) || 'U').charAt(0).toUpperCase() %>
        </a>

      </div>

    </div>

  </header>


  <!-- ==========================================
       MAIN BETTING LAYOUT
       ========================================== -->

  <div class="pb-app-layout">

    <main class="pb-board">

      <!-- PAGE HEADING -->

      <section class="pb-board-heading">

        <div>

          <div class="pb-eyebrow">
            DRUM CORPS INTERNATIONAL

            <span class="pb-live-dot"></span>

            PROJECTION BOARD
          </div>

          <h1>Board</h1>

        </div>

        <span class="pb-virtual">
          VIRTUAL POINTS ONLY
        </span>

      </section>


      <!-- ==========================================
           COMPETITION SELECTION
           ========================================== -->

      <section class="pb-event-section">

        <div class="pb-shelf-label">
          COMPETITIONS
          <span class="pb-muted">SELECT AN EVENT</span>
        </div>

        <div class="bt-events" id="eventTabs">

          <!-- All Events -->

          <button data-id="all" class="on">
            <b>ALL EVENTS</b>
            <small>Open projections</small>
          </button>

          <!-- Individual Events -->

          <% events.forEach(e => { %>

            <button
              data-id="<%= e.id %>"
              class="<%= now >= e.start_ts - 86400 && now < e.start_ts ? '' : 'locked' %>"
            >

              <b><%= e.name %></b>

              <small>
                <%= new Date(e.start_ts * 1000).toLocaleString(
                  'en-US',
                  {
                    month: 'short',
                    day: 'numeric',
                    hour: 'numeric',
                    minute: '2-digit',
                    timeZone: 'America/Chicago'
                  }
                ) %> CT
              </small>

              <% if (now < e.start_ts - 86400) { %>

                <small>
                  Opens 24h before
                </small>

              <% } %>

            </button>

          <% }) %>

        </div>

      </section>


      <!-- ==========================================
           MARKET FILTERS
           ========================================== -->

      <section class="pb-controls">

        <div class="pb-shelf-label">
          MARKET TYPE
        </div>

        <!-- Score Type -->

        <div class="bt-tabs" id="kindTabs">

          <button data-kind="all" class="on">
            All Lines
          </button>

          <button data-kind="absolute">
            Final Score
          </button>

          <button data-kind="change">
            Score Change
          </button>

        </div>


        <!-- Caption Categories -->

        <div class="pb-category-row">

          <div class="bt-captions" id="captionTabs">

            <button data-cat="all" class="on">
              Popular
            </button>

            <button data-cat="total">
              Overall
            </button>

            <button data-cat="ge">
              General Effect
            </button>

            <button data-cat="music">
              Music
            </button>

            <button data-cat="visual">
              Visual
            </button>

            <button data-cat="other">
              Other
            </button>

          </div>


          <!-- Search -->

          <label class="pb-search">

            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m16 16 5 5"></path>
            </svg>

            <input
              type="search"
              id="search"
              placeholder="Search corps, captions"
              aria-label="Search corps or caption"
            >

          </label>

        </div>

      </section>


      <!-- ==========================================
           PROJECTION CARDS
           ========================================== -->

      <div class="pb-list-heading">

        <div>
          <h2>Projections</h2>
          <span id="shownCount"></span>
        </div>

        <span class="pb-list-note">
          Pick MORE or LESS than the projected line
        </span>

      </div>


      <!-- Cards generated by betting.js -->

      <div id="marketGrid" class="bt-grid"></div>


      <!-- Empty Market Message -->

      <div class="bt-empty" id="empty" hidden>

        <div class="pb-empty-icon">—</div>

        <h3>No projections available</h3>

        <p>
          Markets go live 24 hours before the competition.
          Check the event schedule above.
        </p>

      </div>


      <!-- ==========================================
           BET HISTORY
           ========================================== -->

      <section id="history" class="bt-history">

        <div class="pb-list-heading">
          <h2>My recent picks</h2>
        </div>

        <div class="bt-history-list">

          <% if (!bets.length) { %>

            <p class="pb-muted">
              Your selections will appear here after
              you submit an entry.
            </p>

          <% } %>


          <% bets.forEach(b => { %>

            <div class="bt-history-item">

              <div>

                <b>
                  <%= b.corps %>
                  <span class="pb-muted">/</span>
                  <%= b.caption %>
                </b>

                <small>
                  <%= b.event_name %>
                  ·
                  <%= b.choice.toUpperCase() %>
                  <%= b.line.toFixed(3) %>
                </small>

              </div>

              <div>

                <b>
                  <%= b.stake %> pts
                </b>

                <small>
                  <%= b.result %>

                  <% if (b.payout) { %>
                    · +<%= b.payout %> pts
                  <% } %>
                </small>

              </div>

            </div>

          <% }) %>

        </div>

      </section>

    </main>


    <!-- ==========================================
         BETTING SLIP / SIDEBAR
         ========================================== -->

    <aside class="bt-slip">

      <div class="bt-slip-head">

        <h2>My Entry</h2>

        <span>1 PICK MAX</span>

      </div>


      <!-- Empty Pick Slip -->

      <div id="slipEmpty" class="bt-slip-empty">

        <div class="pb-slip-symbol">

          <svg
            width="46"
            height="46"
            viewBox="0 0 46 46"
            fill="none"
          >

            <rect
              x="6"
              y="12"
              width="34"
              height="24"
              rx="3"
              stroke="currentColor"
              stroke-width="1.5"
            ></rect>

            <path
              d="M12 21h22M12 27h14M29 27h5"
              stroke="currentColor"
              stroke-width="1.5"
            ></path>

          </svg>

        </div>

        <strong>
          Your entry is empty
        </strong>

        <span>
          Tap MORE or LESS on any projection
          to start your entry.
        </span>

      </div>


      <!-- Selected Pick Slip -->

      <div id="slipFilled" hidden>

        <div class="bt-picked">

          <small id="slipEvent"></small>

          <b id="slipCorps"></b>

          <span id="slipDetail"></span>

          <button
            id="removePick"
            aria-label="Remove selection"
          >
            ×
          </button>

        </div>


        <div class="pb-slip-divider"></div>


        <!-- Stake -->

        <label for="stake">
          Entry Amount
          <span>POINTS</span>
        </label>

        <div class="pb-stake-wrap">

          <input
            type="number"
            id="stake"
            value="100"
            min="1"
            max="10000"
            step="1"
          >

          <span>PTS</span>

        </div>


        <!-- Quick Stake Buttons -->

        <div class="bt-quick">

          <button data-amount="25">25</button>

          <button data-amount="100">100</button>

          <button data-amount="250">250</button>

          <button data-amount="500">500</button>

        </div>


        <!-- Payout -->

        <div class="bt-slip-math">

          <span>Payout multiplier</span>
          <b id="slipOdds"></b>

          <span>To Win (incl. stake)</span>
          <b id="slipPayout"></b>

        </div>


        <!-- Submit -->

        <button id="placeBet" class="bt-submit">
          SUBMIT ENTRY
        </button>

      </div>


      <!-- Status Message -->

      <p id="btMessage" role="status"></p>


      <!-- Disclaimer -->

      <div class="bt-fineprint">
        For entertainment only.
        Virtual Pressboxd points have no cash value,
        cannot be purchased, and cannot be
        redeemed for prizes.
      </div>

    </aside>

  </div>


  <!-- ==========================================
       MARKET DATA
       ========================================== -->

  <script>
    const MARKETS = <%- JSON.stringify(markets).replace(/</g, '\\u003c') %>;
  </script>

  <script src="/static/betting.js"></script>

</body>
</html>
