<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Betting | Pressboxd</title><link rel="stylesheet" href="/static/styles.css"><link rel="stylesheet" href="/static/betting.css"></head>
<body class="app" style="--accent:<%= accent_color || '#4569e8' %>">
<header class="bt-top"><a href="/shows" class="bt-logo"><img src="/static/pressboxd-wordmark.png" alt="Pressboxd"></a><nav><a href="/shows">Shows</a><a href="/predictions">Predictions</a><a class="current" href="/betting">Betting</a><a href="/forums">Forums</a><a href="/me">Profile</a></nav><div class="bt-wallet">● <span id="balance"><%= balance.toLocaleString() %></span> pts</div></header>
<div class="bt-page"><div class="bt-head"><div><div class="bt-kicker">PRESSBOXD • VIRTUAL PICKS</div><h1>Betting</h1><p>Pick more or less on DCI scores and captions. Markets open 24 hours before the event.</p></div><a class="bt-history-link" href="#history">My picks ↗</a></div>
<div class="bt-layout"><main><section class="bt-filterbox"><div class="bt-label">EVENTS</div><div class="bt-events" id="eventTabs"><button data-id="all" class="on">All Open Events</button><% events.forEach(e=>{ %><button data-id="<%= e.id %>" class="<%= now>=e.start_ts-86400 && now<e.start_ts?'':'locked' %>"><%= e.name %> <small><%= new Date(e.start_ts*1000).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZone:'America/Chicago'}) %> CT</small><% if(now<e.start_ts-86400){ %><small>Opens <%= new Date((e.start_ts-86400)*1000).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZone:'America/Chicago'}) %> CT</small><% } %></button><% }) %></div><div class="bt-filterrow"><div class="bt-tabs" id="kindTabs"><button class="on" data-kind="all">All lines</button><button data-kind="absolute">Final scores</button><button data-kind="change">Score changes</button></div><input type="search" id="search" placeholder="Search corps or caption…" aria-label="Search corps or caption"></div><div class="bt-captions" id="captionTabs"><button class="on" data-cat="all">All captions</button><button data-cat="total">Overall</button><button data-cat="ge">General Effect</button><button data-cat="music">Music</button><button data-cat="visual">Visual</button><button data-cat="other">Other</button></div></section>
<div class="bt-section-heading"><h2>Available lines</h2><span id="shownCount"></span></div><div id="marketGrid" class="bt-grid"></div><div class="bt-empty" id="empty" hidden>No open markets match these filters. Check the upcoming event schedule above.</div>
<section id="history" class="bt-history"><h2>My recent picks</h2><div class="bt-history-list"><% if(!bets.length){ %><p>No picks placed yet.</p><% } %><% bets.forEach(b=>{ %><div class="bt-history-item"><div><b><%= b.corps %> · <%= b.caption %></b><small><%= b.event_name %> · <%= b.choice.toUpperCase() %> <%= b.line.toFixed(3) %></small></div><div><b><%= b.stake %> pts</b><small><%= b.result %><% if(b.payout){ %> · +<%= b.payout %> pts<% } %></small></div></div><% }) %></div></section>
</main><aside class="bt-slip"><div class="bt-slip-head"><h2>Pick slip</h2><span>Single pick</span></div><div id="slipEmpty" class="bt-slip-empty">Choose More or Less on a card to add your pick.</div><div id="slipFilled" hidden><div class="bt-picked"><small id="slipEvent"></small><b id="slipCorps"></b><span id="slipDetail"></span><button id="removePick" aria-label="Remove selection">×</button></div><label for="stake">Entry amount (points)</label><input type="number" id="stake" value="100" min="1" max="10000" step="1"><div class="bt-quick"><button data-amount="25">25</button><button data-amount="100">100</button><button data-amount="250">250</button><button data-amount="500">500</button></div><div class="bt-slip-math"><span>Multiplier</span><b id="slipOdds"></b><span>Potential payout</span><b id="slipPayout"></b></div><button id="placeBet" class="bt-submit">Place virtual pick</button></div><p id="btMessage" role="status"></p><div class="bt-fineprint">Virtual Pressboxd points only. No purchases, cashouts or prizes. Lines are based on projections, not guaranteed outcomes.</div></aside></div></div>
<script>const MARKETS=<%- JSON.stringify(markets).replace(/</g,'\\u003c') %>;</script><script src="/static/betting.js"></script></body></html>
