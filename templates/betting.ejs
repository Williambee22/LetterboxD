
<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <title>Board | Pressboxd</title>

  <link rel="stylesheet" href="/static/betting.css">
  <link rel="icon" type="image/png" href="/static/logo.png"/>
  <style>
    /* Center the single navigation link without changing the rest of the header. */
    .pb-header .pb-top-inner { position: relative; }
    .pb-back-nav {
      position: absolute;
      left: 50%;
      top: 0;
      height: 100%;
      transform: translateX(-50%);
      align-self: center;
    }
    .pb-back-nav a { white-space: nowrap; }
    /* Result not published within the 16-hour cutoff. */
    .bt-not-scored {position:relative!important;overflow:hidden!important;isolation:isolate;}
    .bt-not-scored::after {
      content:"NOT SCORED";
      position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-22deg);
      z-index:8;pointer-events:none;white-space:nowrap;
      color:#ff243c;font-size:clamp(18px,3vw,36px);font-weight:1000;
      letter-spacing:.045em;text-shadow:0 1px 2px #210000,0 0 12px #000;
      border-top:4px solid #ff243c;border-bottom:4px solid #ff243c;
      padding:5px 8px;line-height:1.1;
    }
    .bt-history-item.bt-not-scored::after {font-size:clamp(22px,4vw,38px);}
    .bt-not-scored > * {opacity:.60;}
    @media (max-width: 760px) {
      .pb-back-nav {
        position: static;
        transform: none;
        order: 3;
        width: 100%;
        height: 35px;
        justify-content: center;
      }
    }

    /* True month grid and participant filters. */
    .pb-shelf-label.pb-calendar-heading {display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .bt-calendar-open {display:inline-flex;align-items:center;gap:7px;background:transparent;color:inherit;
      border:1px solid var(--stroke);border-radius:5px;padding:6px 11px;cursor:pointer;font:inherit;
      font-size:12px;font-weight:700;letter-spacing:.03em}
    .bt-calendar-open:hover,.bt-calendar-open:focus-visible {border-color:var(--violet);background:var(--card)}
    .bt-calendar-dialog {box-sizing:border-box;border:1px solid var(--stroke);border-radius:5px;
      padding:0;width:min(1060px,calc(100vw - 20px));max-height:92vh;color:var(--text);
      background:var(--bg);font:inherit;font-family:inherit;box-shadow:0 12px 40px rgba(0,0,0,.5)}
    .bt-calendar-dialog::backdrop {background:rgba(0,0,0,.68)}
    .bt-calendar-panel {padding:clamp(10px,2vw,20px);max-height:90vh;overflow:auto}
    .bt-calendar-top,.bt-calendar-month-row {display:flex;justify-content:space-between;align-items:center;gap:12px}
    .bt-calendar-top h2 {font-family:'Barlow Condensed',Impact,sans-serif;font-weight:800;font-size:26px;margin:0}
    .bt-calendar-month-row {margin:14px 0}
    .bt-calendar-month-row strong {font-family:'Barlow Condensed',Impact,sans-serif;font-weight:700;font-size:22px;text-align:center}
    .bt-calendar-icon-button {display:grid;place-items:center;min-width:36px;height:36px;border-radius:5px;
      background:var(--card);color:var(--text);border:1px solid var(--stroke);cursor:pointer;font-size:19px}
    .bt-calendar-icon-button:hover:not(:disabled) {background:#302c39}
    .bt-calendar-icon-button:disabled {opacity:.35;cursor:default}
    .bt-cal-filters {display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:16px;
      padding:12px;background:var(--panel);border:1px solid var(--stroke);border-radius:5px}
    .bt-cal-chip {color:var(--muted);background:var(--card);border:1px solid var(--stroke);border-radius:5px;
      padding:8px 12px;font-size:12px;font-weight:700;cursor:pointer}
    .bt-cal-chip.is-active {color:var(--text);background:#2d223e;border-color:var(--violet)}
    .bt-cal-class-filters {display:flex;flex-wrap:wrap;align-items:center;gap:8px}
    .bt-cal-corps-panel {min-width:min(300px,100%);flex:1;position:relative}
    .bt-cal-corps-panel summary {list-style:none;cursor:pointer;color:var(--text);background:var(--card);
      border:1px solid var(--stroke);border-radius:5px;padding:9px 12px;font-weight:700;font-size:12px}
    .bt-cal-corps-panel summary::-webkit-details-marker {display:none}
    .bt-cal-corps-contents {position:relative;z-index:30;margin-top:6px;width:100%;box-sizing:border-box;
      background:var(--panel);border:1px solid var(--stroke);box-shadow:0 16px 35px #0009;border-radius:5px;padding:10px}
    .bt-cal-corps-search {width:100%;box-sizing:border-box;padding:10px;border-radius:5px;
      border:1px solid var(--stroke);background:var(--bg);color:#fff}
    .bt-cal-corps-options {max-height:240px;overflow:auto;display:grid;gap:2px;margin-top:8px}
    .bt-cal-corps-option {display:flex;align-items:center;gap:9px;font-size:13px;padding:7px;border-radius:5px;cursor:pointer}
    .bt-cal-corps-option:hover {background:var(--card)}
    .bt-cal-corps-option input {accent-color:var(--violet)}
    .bt-cal-match-all {display:flex;gap:10px;align-items:flex-start;padding:11px 9px;margin:9px 0 3px;
      background:var(--card);border:1px solid var(--stroke);border-radius:5px;color:var(--text);cursor:pointer;font-size:13px}
    .bt-cal-match-all input {margin-top:3px;accent-color:var(--violet);flex-shrink:0}
    .bt-cal-match-all strong {display:block;font-size:13px}
    .bt-cal-match-all small {display:block;color:var(--muted);font-size:11px;margin-top:3px;line-height:1.4}
    .bt-cal-corps-actions {display:flex;justify-content:space-between;gap:10px;margin-top:9px}
    .bt-cal-corps-actions button {color:var(--text);background:var(--card);border:1px solid var(--stroke);border-radius:5px;padding:7px 12px;cursor:pointer}
    .bt-cal-count {font-size:12px;color:var(--muted);margin:10px 0}
    .bt-cal-weekdays,.bt-cal-days {display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}
    .bt-cal-weekdays span {text-align:center;color:var(--muted);font-size:11px;font-weight:800;padding:8px 0}
    .bt-cal-day {min-height:108px;min-width:0;background:var(--panel);border:1px solid var(--stroke);
      border-radius:5px;padding:6px;box-sizing:border-box;display:flex;flex-direction:column;gap:5px}
    .bt-cal-day.is-outside {opacity:.4;background:var(--bg)}
    .bt-cal-day.has-events {border-color:#595361}
    .bt-cal-number {font-size:12px;font-weight:800;color:var(--text)}
    .bt-cal-day.is-today .bt-cal-number {background:var(--text);color:var(--bg);border-radius:3px;padding:3px 6px;align-self:flex-start}
    .bt-cal-event {display:block;text-align:left;width:100%;background:var(--card);color:var(--text);border:1px solid var(--stroke);
      border-radius:5px;font-size:11px;line-height:1.3;padding:5px 6px;overflow-wrap:anywhere;cursor:pointer}
    .bt-cal-event:hover,.bt-cal-event:focus-visible {background:#2d223e;border-color:var(--violet);outline-offset:1px}
    .bt-cal-event.is-tba {border-left:3px solid #ddb969}
    .bt-cal-event.is-open {border-left:3px solid var(--green)}
    .bt-cal-event.is-not-scored {border-left:3px solid #ff5269}
    .bt-cal-event small {display:block;font-size:10px;color:var(--muted);margin-top:2px}
    .bt-cal-empty-day {color:var(--muted);font-size:11px}
    .bt-calendar-note {color:var(--muted);font-size:12px;line-height:1.5;margin:12px 0 0}
    @media(max-width:650px) {
      .bt-calendar-panel {padding:10px}
      .bt-cal-day {min-height:82px;padding:3px;gap:3px}
      .bt-cal-event {font-size:9px;padding:4px 3px}
      .bt-cal-event small {font-size:8px}
      .bt-cal-number {font-size:11px}
      .bt-cal-weekdays span {font-size:10px}
      .bt-cal-weekdays,.bt-cal-days {gap:2px}
      .bt-calendar-month-row strong {font-size:16px}
      .bt-cal-filters {gap:7px;padding:8px}
    }

    /* Published competition lineups are independent of market availability. */
    .bt-events button.locked {opacity:.85}
    .bt-events button.on {opacity:1}
    .bt-event-lineup {margin-top:14px;padding:12px 14px;background:var(--panel);border:1px solid var(--stroke);border-radius:5px}
    .bt-event-lineup-head {display:flex;align-items:baseline;justify-content:space-between;gap:8px;flex-wrap:wrap}
    .bt-event-lineup-head h2 {font-size:15px;margin:0;color:var(--text);font-weight:800}
    .bt-event-lineup-status {font-size:11px;color:var(--muted)}
    .bt-event-lineup-list {list-style:none;margin:10px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:5px 14px}
    .bt-event-lineup-list li {padding:5px 0;border-bottom:1px solid var(--stroke);font-size:12px;overflow-wrap:anywhere}
    .bt-event-lineup-list small {display:block;color:var(--muted);font-size:10px;margin-top:2px}
    .bt-event-lineup-note {color:var(--muted);font-size:11px;margin:8px 0 0}
    .bt-cal-event .bt-cal-lineup-count {color:var(--muted);margin-top:3px}

    /* Prize-pick-like multiple virtual entries (no real-money wagering). */
    .pb-entry-help,.pb-play-explanation{color:#aaa4b7;font-size:11px;line-height:1.5;margin:14px 0}
    .pb-entry-picks{display:grid;gap:8px;margin:14px 0}
    .pb-selected-leg{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px;border:1px solid #494258;border-radius:6px;background:#272330}
    .pb-selected-leg strong{font-size:12px}.pb-selected-leg small{display:block;color:#afa9bd;font-size:10px;margin-top:5px}
    .pb-selected-leg button,.pb-queue-entry button{border:0;background:#41334b;color:#fff;border-radius:5px;padding:6px 9px}
    .pb-slip-placeholder{padding:22px 12px;border:1px dashed #544b61;color:#ada6b8;border-radius:8px;text-align:center}
    .pb-play-types{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-top:17px}
    .pb-play-types button{padding:9px 3px;background:#2b2836;border:1px solid #484153;color:#d0cbd7;border-radius:6px;font-size:11px;font-weight:800}
    .pb-play-types button.on{border-color:#a96bff;color:#fff;background:#43285b}
    .pb-play-types button:disabled{opacity:.35;cursor:not-allowed}
    .pb-flex-payouts{font-size:11px;color:#c6bbd2;line-height:1.9;margin-bottom:14px}
    .pb-entry-queue{border-top:1px solid #423b4a;margin-top:20px;padding-top:13px}
    .pb-queue-heading{display:flex;justify-content:space-between;gap:6px;font-size:12px}
    .pb-queue-heading span{color:#a9a1b2}
    .pb-queue-entry{background:#23212e;padding:10px;margin:9px 0;border:1px solid #484151;border-radius:6px;font-size:11px}
    .pb-queue-entry span{display:block;color:#aaa4b7;margin:5px 0}
    .pb-queue-entry button{font-size:10px}
    .pb-submit-queue{margin-top:12px;background:#a9f146}
    .pb-submit-queue:disabled{opacity:.35;cursor:not-allowed}
    .bt-history-item small{line-height:1.5}
  </style>
</head>

<body class="pb-body">

  <!-- ==========================================
       HEADER
       ========================================== -->

  <header class="pb-header">

    <div class="pb-top-inner">

      <a
        href="https://www.generaleffect.media/"
        target="_blank"
        rel="noopener"
        class="pb-brand"
        style="display:flex; align-items:center;"
      >
        <img
          src="/static/logo.png"
          alt="General Effect Media"
          style="width:40px; height:40px; object-fit:contain; transition:transform 0.6s ease-in-out;"
          onmouseover="this.style.transform='rotate(360deg)'"
          onmouseout="this.style.transform='rotate(0deg)'"
        >
        <span style="font-family:'Barlow Condensed', Impact, sans-serif; font-size:30px; font-weight:800; letter-spacing:.5px; margin-left:10px; color:#fff;">BETS</span>
      </a>


      <nav class="pb-main-nav pb-back-nav" aria-label="Return to Pressboxd">
        <a href="/predictions">Back to Pressboxd</a>
      </nav>

      <div class="pb-header-right">

        <a href="#history" class="pb-my-picks">
          My Picks
        </a>

        <div class="pb-balance">
          <span class="pb-coin">💎</span>

          <strong id="balance">
            <%= balance.toLocaleString() %>
          </strong>

          <span class="pb-point-unit">GEMS</span>
        </div>

        <button id="dailyGemClaim" type="button" class="pb-daily-claim" data-next="<%= next_claim_ts || 0 %>">💎 Claim 10</button>
        <a href="/me" class="pb-profile" title="Profile">
          <%= String((me && me.username) || 'U').charAt(0).toUpperCase() %>
        </a>

      </div>

    </div>

  </header>


  <!-- ==========================================
       MAIN BETTING LAYOUT
       ========================================== -->

  <div class="pb-app-layout">

    <main class="pb-board">

      <!-- PAGE HEADING -->

      <section class="pb-board-heading">

        <div>

          <h1>Board</h1>

        </div>

        <span class="pb-virtual">
          VIRTUAL POINTS ONLY
        </span>

      </section>


      <!-- ==========================================
           COMPETITION SELECTION
           ========================================== -->

      <section class="pb-event-section">

        <div class="pb-shelf-label pb-calendar-heading">
          COMPETITIONS
          <span class="pb-muted">SELECT AN EVENT</span>
          <button class="bt-calendar-open" id="openEventCalendar" type="button" aria-haspopup="dialog" aria-controls="eventCalendar" title="Browse competitions by month">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
            Calendar
          </button>
        </div>

        <div class="bt-events" id="eventTabs">

          <!-- All Events -->

          <button data-id="all" class="on">
            <b>ALL EVENTS</b>
            <small>Open projections</small>
          </button>

          <!-- Individual Events -->

          <% events.forEach(e => { %>
            <button data-id="<%= e.id %>"
              class="<%= e.not_scored ? 'locked bt-not-scored' : (e.start_ts != null && now >= e.open_ts && now < e.start_ts ? '' : 'locked') %>">
              <b><%= e.name %></b>
              <% const lineupCount = new Set((Array.isArray(e.lineup) ? e.lineup : []).map(x => String(typeof x === 'string' ? x : (x?.corps || '')).trim().toLowerCase()).filter(Boolean)).size; %>
              <small><%= lineupCount ? lineupCount + (lineupCount === 1 ? ' corps attending' : ' corps attending') : 'Lineup TBA' %></small>
              <small>
                <% if (e.local_date) { %>
                  <%= new Date(e.local_date + 'T12:00:00Z').toLocaleDateString('en-US', {
                    month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC'
                  }) %>
                <% } else if (e.start_ts != null) { %>
                  <%= new Date(e.start_ts * 1000).toLocaleDateString('en-US', {
                    month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago'
                  }) %>
                <% } else { %>
                  Date TBA
                <% } %>
              </small>
              <small>
                <% if (e.start_ts == null) { %>
                  Start Time TBA
                <% } else { %>
                  <%= new Date(e.start_ts * 1000).toLocaleTimeString('en-US', {
                    hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago'
                  }) %> CT
                <% } %>
              </small>
              <% if (e.not_scored) { %>
                <small>All pending bets refunded</small>
              <% } else if (e.start_ts == null) { %>
                <small>Betting unavailable until start time is announced</small>
              <% } else if (now < e.open_ts) { %>
                <small>Opens <%= e.start_ts - e.open_ts === 172800 ? '48h' : e.start_ts - e.open_ts > 172800 ? 'early' : '24h' %> before</small>
              <% } %>
            </button>
          <% }) %>

        </div>

        <section id="selectedEventLineup" class="bt-event-lineup" aria-labelledby="selectedEventLineupTitle" hidden>
          <div class="bt-event-lineup-head">
            <h2 id="selectedEventLineupTitle">Participating Corps</h2>
            <span id="selectedEventLineupStatus" class="bt-event-lineup-status"></span>
          </div>
          <ul id="selectedEventLineupList" class="bt-event-lineup-list"></ul>
          <p id="selectedEventLineupNote" class="bt-event-lineup-note"></p>
        </section>
      </section>


      <!-- ==========================================
           MARKET FILTERS
           ========================================== -->

      <section class="pb-controls">

        <div class="pb-shelf-label">
          MARKET TYPE
        </div>

        <!-- Score Type -->

        <div class="bt-tabs" id="kindTabs">

          <button data-kind="all" class="on">
            All Lines
          </button>

          <button data-kind="absolute">
            Final Score
          </button>

          <button data-kind="change">
            Score Change
          </button>

        </div>


        <!-- Caption Categories -->

        <div class="pb-category-row">

          <div class="bt-captions" id="captionTabs">

            <button data-cat="all" class="on">
              Popular
            </button>

            <button data-cat="total">
              Overall
            </button>

            <button data-cat="ge">
              General Effect
            </button>

            <button data-cat="music">
              Music
            </button>

            <button data-cat="visual">
              Visual
            </button>

            <button data-cat="other">
              Other
            </button>

          </div>


          <!-- Search -->

          <label class="pb-search">

            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m16 16 5 5"></path>
            </svg>

            <input
              type="search"
              id="search"
              placeholder="Search corps, captions"
              aria-label="Search corps or caption"
            >

          </label>

        </div>

      </section>


      <!-- ==========================================
           PROJECTION CARDS
           ========================================== -->

      <div class="pb-list-heading">

        <div>
          <h2>Projections</h2>
          <span id="shownCount"></span>
        </div>

        <span class="pb-list-note">
          Pick MORE or LESS than the projected line
        </span>

      </div>


      <!-- Cards generated by betting.js -->

      <div id="marketGrid" class="bt-grid"></div>


      <!-- Empty Market Message -->

      <div class="bt-empty" id="empty" hidden>

        <div class="pb-empty-icon">—</div>

        <h3>No projections available</h3>

        <p>
          Markets go live 24 hours before the competition, or 48 hours early when all participating corps have two days without performances.
          Check the event schedule above.
        </p>

      </div>


      <!-- ==========================================
           BET HISTORY
           ========================================== -->

      <section id="entryHistory" class="bt-history">
        <div class="pb-list-heading"><h2>My Power / Flex Entries</h2></div>
        <div id="entryHistoryList" class="bt-history-list">
          <% if (typeof multiEntries !== 'undefined' && Array.isArray(multiEntries)) { %>
            <% multiEntries.forEach(entry => { %>
              <div class="bt-history-item">
                <div><b>#<%= entry.id %> · <%= entry.play_type.toUpperCase() %> · <%= entry.legs.length %> picks</b>
                  <% entry.legs.forEach(leg => { %><small><%= leg.corps %> / <%= leg.caption %> · <%= leg.choice.toUpperCase() %> <%= Number(leg.line).toFixed(3) %> · <%= leg.result.toUpperCase() %></small><% }) %>
                </div><div><b>💎 <%= entry.stake %></b><small><%= entry.status.toUpperCase() %><%= entry.payout ? ' · +'+entry.payout+' Gems' : '' %></small></div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </section>

      <section id="history" class="bt-history">

        <div class="pb-list-heading">
          <h2>My recent picks</h2>
        </div>

        <div class="bt-history-list">

          <% if (!bets.length) { %>

            <p class="pb-muted">
              Your selections will appear here after
              you submit an entry.
            </p>

          <% } %>


          <% bets.forEach(b => { %>

            <div class="bt-history-item <%= b.not_scored ? 'bt-not-scored' : '' %>">

              <div>

                <b>
                  <%= b.corps %>
                  <span class="pb-muted">/</span>
                  <%= b.caption %>
                </b>

                <small>
                  <%= b.event_name %>
                  ·
                  <%= b.choice.toUpperCase() %>
                  <%= b.line.toFixed(3) %>
                </small>

              </div>

              <div>

                <b>
                  💎 <%= b.stake %> Gems
                </b>

                <small>
                  <%= b.not_scored ? 'NOT SCORED · REFUNDED' : b.result %>

                  <% if (b.payout) { %>
                    · +💎 <%= b.payout %> Gems
                  <% } %>
                </small>

              </div>

            </div>

          <% }) %>

        </div>

      </section>

    </main>


    <!-- ==========================================
         BETTING SLIP / SIDEBAR
         ========================================== -->

    <aside class="bt-slip">

      <div class="bt-slip-head">

        <h2>My Entry</h2>

        <span>1–6 PICKS / ENTRY</span>

      </div>


      <!-- Multi-pick virtual Gems entry builder -->
      <div class="pb-multi-slip" id="multiSlip">
        <p class="pb-entry-help">Choose MORE or LESS on up to six predictions. Add separate entries to your queue, then submit them together.</p>
        <div id="entryPicks" class="pb-entry-picks" aria-live="polite"></div>
        <div class="pb-play-types" id="playTypes" aria-label="Entry type">
          <button type="button" data-play="single">Single</button>
          <button type="button" data-play="power" class="on">Power Play</button>
          <button type="button" data-play="flex">Flex Play</button>
        </div>
        <p id="playExplanation" class="pb-play-explanation"></p>
        <label for="stake">Entry Amount <span>GEMS</span></label>
        <div class="pb-stake-wrap"><input type="number" id="stake" value="100" min="1" max="10000" step="1"><span>💎</span></div>
        <div class="bt-quick"><button type="button" data-amount="25">25</button><button type="button" data-amount="100">100</button><button type="button" data-amount="250">250</button><button type="button" data-amount="500">500</button></div>
        <div class="bt-slip-math">
          <span>Max payout multiplier</span><b id="slipOdds">—</b>
          <span>Potential return (incl. stake)</span><b id="slipPayout">—</b>
        </div>
        <div id="flexPayouts" class="pb-flex-payouts"></div>
        <button type="button" id="addEntry" class="bt-submit">ADD ENTRY TO QUEUE</button>
        <div class="pb-entry-queue">
          <div class="pb-queue-heading"><strong>Entry Queue</strong><span id="queueCount">0 entries</span></div>
          <div id="queuedEntries"></div>
          <button type="button" id="placeBet" class="bt-submit pb-submit-queue">SUBMIT QUEUED ENTRIES</button>
        </div>
      </div>

      <!-- Status Message -->

      <p id="btMessage" role="status"></p>


      <!-- Disclaimer -->

      <div class="bt-fineprint">
        For entertainment only.
        Virtual Pressboxd Gems have no cash value,
        cannot be purchased, but CAN be
        redeemed for prizes.
      </div>

    </aside>

  </div>


  <!-- Month-grid calendar; event selections reuse the normal betting event tabs. -->
  <dialog id="eventCalendar" class="bt-calendar-dialog" aria-labelledby="eventCalendarTitle">
    <div class="bt-calendar-panel">
      <div class="bt-calendar-top">
        <h2 id="eventCalendarTitle">Competition Calendar</h2>
        <button type="button" class="bt-calendar-icon-button" id="closeEventCalendar" aria-label="Close calendar">×</button>
      </div>
      <div class="bt-cal-filters" aria-label="Filter competitions">
        <button type="button" id="calAllEvents" class="bt-cal-chip is-active">ALL EVENTS</button>
        <div class="bt-cal-class-filters" role="group" aria-label="Competition class">
          <button type="button" id="calWorldClass" class="bt-cal-chip" aria-pressed="false">World Class</button>
          <button type="button" id="calOpenClass" class="bt-cal-chip" aria-pressed="false">Open Class</button>
        </div>
        <details id="calCorpsPicker" class="bt-cal-corps-panel">
          <summary id="calCorpsSummary">Filter Corps · All Corps</summary>
          <div class="bt-cal-corps-contents">
            <label class="bt-cal-match-all">
              <input type="checkbox" id="calRequireAllCorps">
              <span><strong>Require ALL selected corps</strong><small>Only show competitions featuring every checked corps together (AND instead of OR).</small></span>
            </label>
            <input id="calCorpsSearch" class="bt-cal-corps-search" type="search" placeholder="Search corps..." aria-label="Search corps">
            <div id="calCorpsOptions" class="bt-cal-corps-options" role="group" aria-label="Select one or multiple corps"></div>
            <div class="bt-cal-corps-actions">
              <button type="button" id="calClearCorps">Clear corps</button>
              <button type="button" id="calDoneCorps">Done</button>
            </div>
          </div>
        </details>
      </div>
      <p id="calMatchCount" class="bt-cal-count" aria-live="polite"></p>
      <div class="bt-calendar-month-row">
        <button type="button" class="bt-calendar-icon-button" id="calendarPrevMonth" aria-label="Previous month">‹</button>
        <strong id="calendarMonthTitle"></strong>
        <button type="button" class="bt-calendar-icon-button" id="calendarNextMonth" aria-label="Next month">›</button>
      </div>
      <div class="bt-cal-weekdays" aria-hidden="true"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
      <div id="calendarMonthGrid" class="bt-cal-days" role="grid" aria-label="Competition dates"></div>
      <p class="bt-calendar-note">Select a competition to view its betting board. Select multiple corps to show events featuring any selected corps, or tick Require ALL selected corps to show only competitions featuring every selected corps together. World/Open Class filters use confirmed imported lineups. The corps picker also shows historical DCI corps; appearing in the picker does not imply a 2027 booking. Events without a published lineup appear under All Events.</p>
    </div>
  </dialog>

  <!-- ==========================================
       MARKET DATA
       ========================================== -->

  <script>
    const MARKETS = <%- JSON.stringify(markets).replace(/</g, '\\u003c') %>;
  </script>

  <script src="/static/betting.js?v=20261126-daily-fix"></script>

  <script>
    // A historical corps catalog supplies visible checkboxes even when all imported
    // 2027 event lineups are TBA. Selection never fabricates participation.
    const CORPS_CATALOG = <%- JSON.stringify(typeof corpsCatalog !== 'undefined' && Array.isArray(corpsCatalog) ? corpsCatalog : []).replace(/</g, '\\u003c') %>;
    const CALENDAR_EVENTS = <%- JSON.stringify(events.map(e => ({
      id:e.id, name:e.name, local_date:e.local_date||null,
      start_ts:e.start_ts, open_ts:e.open_ts,
      not_scored:Boolean(e.not_scored),
      lineup:(e.lineup||[]).map(x => ({
        corps:String(typeof x==='string' ? x : (x?.corps||'')),
        cls:String(typeof x==='string' ? '' : (x?.cls||''))
      }))
    }))).replace(/</g, '\\u003c') %>;
    (() => {
      const $ = id => document.getElementById(id);
      const dialog=$('eventCalendar'), openButton=$('openEventCalendar'), closeButton=$('closeEventCalendar');
      const previous=$('calendarPrevMonth'), next=$('calendarNextMonth');
      const title=$('calendarMonthTitle'), grid=$('calendarMonthGrid');
      const allButton=$('calAllEvents'), worldButton=$('calWorldClass'), openClassButton=$('calOpenClass');
      const corpsPicker=$('calCorpsPicker'), corpsSummary=$('calCorpsSummary');
      const corpsSearch=$('calCorpsSearch'), corpsOptions=$('calCorpsOptions'), requireAllCorps=$('calRequireAllCorps');
      const matchCount=$('calMatchCount');
      const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const corpsKey=s=>String(s||'').trim().toLowerCase().replace(/\s+/g,' ');
      const classKey=s=>{
        const value=String(s||'').trim().toLowerCase().replace(/[_-]/g,' ').replace(/\s+/g,' ');
        if (/^(world|wc|world class)$/.test(value)) return 'world';
        if (/^(open|oc|open class)$/.test(value)) return 'open';
        return '';
      };
      const eventDate=e=>{
        if(/^\d{4}-\d{2}-\d{2}$/.test(e.local_date||'')) return e.local_date;
        if(e.start_ts==null) return null;
        return new Date(e.start_ts*1000).toISOString().slice(0,10);
      };
      const dated=CALENDAR_EVENTS.map(e=>({...e,day:eventDate(e)}))
        .filter(e=>e.day).sort((a,b)=>a.day.localeCompare(b.day)||a.name.localeCompare(b.name));
      const allCorps=[...new Map([
        ...CORPS_CATALOG.filter(p=>p.corps).map(p=>[corpsKey(p.corps),p.corps]),
        ...dated.flatMap(e=>e.lineup).filter(p=>p.corps).map(p=>[corpsKey(p.corps),p.corps])
      ]).entries()].sort((a,b)=>a[1].localeCompare(b[1]));
      const selectedCorps=new Set(), selectedClasses=new Set();
      const months=[...new Set(dated.map(e=>e.day.slice(0,7)))];
      const currentMonth=new Date().toISOString().slice(0,7);
      let month=months.find(m=>m>=currentMonth) || months[months.length-1] || currentMonth;
      if (months.length && currentMonth<months[0]) month=months[0];
      const shiftMonth=(ym,shift)=>{
        const [year,mon]=ym.split('-').map(Number);
        const next=new Date(Date.UTC(year,mon-1+shift,1));
        return next.toISOString().slice(0,7);
      };
      const firstMonth=months[0]||currentMonth, lastMonth=months[months.length-1]||currentMonth;
      function matchesFilters(event) {
        if(!selectedCorps.size && !selectedClasses.size) return true;
        // Each selected corps is checked against the confirmed lineup.
        // With "Require ALL" enabled, ALL selected corps must be present.
        // Otherwise, ANY selected corps may be present (the original behavior).
        // Class filters are applied to the matching corps, preserving the
        // existing "selected corps AND class" behavior.
        const eligible=event.lineup.filter(p=>!selectedClasses.size || selectedClasses.has(classKey(p.cls)));
        if(!selectedCorps.size) return eligible.length>0;
        const present=new Set(eligible.map(p=>corpsKey(p.corps)));
        return requireAllCorps.checked
          ? [...selectedCorps].every(key=>present.has(key))
          : [...selectedCorps].some(key=>present.has(key));
      }
      function renderCorpsOptions(){
        const q=corpsSearch.value.trim().toLowerCase();
        const options=allCorps.filter(([key,name])=>name.toLowerCase().includes(q));
        corpsOptions.innerHTML=options.map(([key,name])=>`<label class="bt-cal-corps-option"><input type="checkbox" value="${esc(key)}" ${selectedCorps.has(key)?'checked':''}><span>${esc(name)}</span></label>`).join('') || '<p class="bt-calendar-note">No corps match that search. Clear your search to see all corps.</p>';
        corpsSummary.textContent=selectedCorps.size?`Filter Corps · ${selectedCorps.size} selected${requireAllCorps.checked?' · ALL required':''}`:`Filter Corps · ${allCorps.length} available`;
      }
      function updateFilterButtons(){
        const all=!selectedCorps.size&&!selectedClasses.size;
        allButton.classList.toggle('is-active',all);
        worldButton.classList.toggle('is-active',selectedClasses.has('world'));
        openClassButton.classList.toggle('is-active',selectedClasses.has('open'));
        worldButton.setAttribute('aria-pressed',String(selectedClasses.has('world')));
        openClassButton.setAttribute('aria-pressed',String(selectedClasses.has('open')));
        renderCorpsOptions();
      }
      function eventStatus(e){
        const now=Date.now()/1000;
        if(e.not_scored) return 'NOT SCORED · Refunded';
        if(e.start_ts==null) return 'Start time TBA';
        if(now>=e.start_ts) return 'Betting closed';
        if(now>=e.open_ts) return 'Betting open';
        return 'Betting not yet open';
      }
      // Render official participants even when the selected competition has no markets or start time.
      const eventTabs=$('eventTabs');
      const lineupPanel=$('selectedEventLineup');
      const lineupTitle=$('selectedEventLineupTitle');
      const lineupStatus=$('selectedEventLineupStatus');
      const lineupList=$('selectedEventLineupList');
      const lineupNote=$('selectedEventLineupNote');
      const eventsById=new Map(CALENDAR_EVENTS.map(e=>[String(e.id),e]));
      function uniqueLineup(event){
        return [...new Map((event.lineup||[]).filter(p=>corpsKey(p.corps)).map(p=>[corpsKey(p.corps),p])).values()];
      }
      function renderSelectedLineup(id){
        const event=eventsById.get(String(id));
        lineupPanel.hidden=!event;
        if(!event){lineupList.replaceChildren();return;}
        const corps=uniqueLineup(event);
        lineupTitle.textContent='Participating Corps — '+event.name;
        lineupStatus.textContent=(corps.length ? `${corps.length} corps · ` : '')+eventStatus(event);
        lineupList.replaceChildren();
        for(const participant of corps){
          const li=document.createElement('li');
          const name=document.createElement('strong');
          name.textContent=participant.corps;
          li.append(name);
          if(participant.cls){const cls=document.createElement('small');cls.textContent=participant.cls;li.append(cls);}
          lineupList.append(li);
        }
        lineupList.hidden=!corps.length;
        lineupNote.textContent=!corps.length ? 'No official lineup has been imported yet.' : event.start_ts==null ? 'Published lineup; performance times are TBA. Betting remains unavailable until an official start time is imported.' : 'Published lineup is subject to change.';
      }
      eventTabs.addEventListener('click',event=>{
        const button=event.target.closest('button[data-id]');
        if(button && eventTabs.contains(button))renderSelectedLineup(button.dataset.id);
      });
      renderSelectedLineup(eventTabs.querySelector('button.on[data-id]')?.dataset.id||'all');
      function renderMonth(){
        title.textContent=new Date(month+'-01T12:00:00Z').toLocaleDateString('en-US',{month:'long',year:'numeric',timeZone:'UTC'});
        previous.disabled=month<=firstMonth;
        next.disabled=month>=lastMonth;
        const visible=dated.filter(e=>matchesFilters(e));
        const monthEvents=visible.filter(e=>e.day.startsWith(month));
        const withoutLineup=dated.filter(e=>!e.lineup.length).length;
        matchCount.textContent=`${monthEvents.length} matching competition${monthEvents.length===1?'':'s'} this month · ${visible.length} across the schedule` +
          ((selectedCorps.size || selectedClasses.size) && withoutLineup ?
            ` · ${withoutLineup} event${withoutLineup===1?' has':'s have'} no confirmed corps lineup and cannot be matched` : '');
        const [year,mon]=month.split('-').map(Number);
        const firstDay=new Date(Date.UTC(year,mon-1,1)).getUTCDay();
        const dayCount=new Date(Date.UTC(year,mon,0)).getUTCDate();
        const slots=Math.ceil((firstDay+dayCount)/7)*7;
        const today=new Date().toISOString().slice(0,10);
        const byDay=new Map();
        for(const event of monthEvents){if(!byDay.has(event.day))byDay.set(event.day,[]);byDay.get(event.day).push(event);}
        const out=[];
        for(let i=0;i<slots;i++){
          const day=i-firstDay+1;
          if(day<1||day>dayCount){out.push('<div class="bt-cal-day is-outside" aria-hidden="true"></div>');continue;}
          const iso=month+'-'+String(day).padStart(2,'0');
          const matches=byDay.get(iso)||[];
          out.push(`<div class="bt-cal-day ${matches.length?'has-events':''} ${iso===today?'is-today':''}" role="gridcell" aria-label="${esc(iso)}">
            <span class="bt-cal-number">${day}</span>
            ${matches.map(e=>{
              const status=eventStatus(e),klass=e.not_scored?'is-not-scored':e.start_ts==null?'is-tba':status==='Betting open'?'is-open':'';
              return `<button type="button" class="bt-cal-event ${klass}" data-event-id="${esc(e.id)}" title="${esc(e.name+' · '+status)}"><b>${esc(e.name)}</b><small>${esc(status)}</small><small class="bt-cal-lineup-count">${uniqueLineup(e).length ? uniqueLineup(e).length+' corps' : 'Lineup TBA'}</small></button>`;
            }).join('')}</div>`);
        }
        grid.innerHTML=out.join('');
      }
      const update=()=>{updateFilterButtons();renderMonth();};
      allButton.addEventListener('click',()=>{selectedCorps.clear();selectedClasses.clear();requireAllCorps.checked=false;corpsSearch.value='';update();});
      requireAllCorps.addEventListener('change',update);
      for(const [button,key] of [[worldButton,'world'],[openClassButton,'open']]){
        button.addEventListener('click',()=>{if(selectedClasses.has(key))selectedClasses.delete(key);else selectedClasses.add(key);update();});
      }
      corpsSearch.addEventListener('input',renderCorpsOptions);
      corpsOptions.addEventListener('change',event=>{
        const input=event.target.closest('input[type=checkbox]');if(!input)return;
        if(input.checked)selectedCorps.add(input.value);else selectedCorps.delete(input.value);
        update();
      });
      $('calClearCorps').addEventListener('click',()=>{selectedCorps.clear();update();});
      $('calDoneCorps').addEventListener('click',()=>{corpsPicker.open=false;});
      openButton.addEventListener('click',()=>{update();if(typeof dialog.showModal==='function')dialog.showModal();else dialog.setAttribute('open','');});
      closeButton.addEventListener('click',()=>dialog.close());
      dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
      previous.addEventListener('click',()=>{if(month>firstMonth){month=shiftMonth(month,-1);renderMonth();}});
      next.addEventListener('click',()=>{if(month<lastMonth){month=shiftMonth(month,1);renderMonth();}});
      grid.addEventListener('click',event=>{
        const button=event.target.closest('button[data-event-id]');if(!button)return;
        const id=button.dataset.eventId;
        const tab=[...document.querySelectorAll('#eventTabs button[data-id]')].find(el=>el.dataset.id===id);
        if(!tab)return;
        tab.click();dialog.close();
        const chosen=CALENDAR_EVENTS.find(e=>e.id===id);
        if(chosen && (chosen.start_ts==null || chosen.not_scored || Date.now()/1000<chosen.open_ts)){
          const info=$('btMessage');
          if(info)info.textContent=chosen.not_scored?'NOT SCORED — pending bets refunded.':chosen.start_ts==null?'Start time TBA. Betting is not available yet.':'Betting has not opened for this competition yet.';
        }
        $('eventTabs').scrollIntoView({behavior:'smooth',block:'start'});
        tab.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});
      });
      update();
    })();
  </script>


</body>
