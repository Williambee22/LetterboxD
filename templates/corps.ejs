<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>

  <title><%= corps_name %> — Pressboxd</title>
  <meta
    name="description"
    content="Ratings, placements, Finals appearances, and shows from <%= corps_name %> on Pressboxd."
  >

  <link rel="stylesheet" href="/static/styles.css"/>
  <link rel="icon" type="image/png" href="/static/favicon.png"/>

  <style>
    html,
    body,
    body.app {
      background: #000 !important;
      background-image: none !important;
    }

    :root {
      --corps-line: rgba(255,255,255,.09);
      --corps-muted: rgba(255,255,255,.58);
    }

    main.wrap {
      max-width: 1480px;
      padding-bottom: 48px;
    }

    .corpsBack {
      display: inline-block;
      margin: 14px 0 10px;
      color: var(--corps-muted);
      text-decoration: none;
      font-size: 12px;
      font-weight: 700;
    }

    .corpsBack:hover {
      color: #fff;
    }

    .corpsDetailPanel {
      padding: 16px !important;
      border-radius: 16px;
      background: rgba(255,255,255,.025);
      border: 1px solid rgba(255,255,255,.09);
    }

    .corpsDetailInner {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 28px;
      width: 100%;
    }

    .corpsLeft {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      flex: 1 1 auto;
      min-width: 0;
    }

    .corpsPosterColumn {
      flex: 0 0 210px;
      width: 210px;
      min-width: 210px;
    }

    .corpsPoster {
      position: relative;
      width: 210px;
      height: 315px;
      overflow: hidden;
      border-radius: 0;
      border: 1px solid rgba(255,255,255,.08);
      box-shadow: 0 12px 28px rgba(0,0,0,.32);
      background: #070707;
    }

    .corpsPoster img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .corpsMeta {
      flex: 1 1 auto;
      min-width: 0;
      padding-top: 4px;
    }

    .corpsKicker {
      font-size: 10px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: var(--corps-muted);
    }

    .corpsMeta h1 {
      margin: 4px 0 6px !important;
      font-size: clamp(1.8rem, 3vw, 2.6rem);
      line-height: 1.05;
      letter-spacing: -.025em;
    }

    .corpsSummary {
      font-size: 14px;
      color: var(--corps-muted);
    }

    .corpsBadges {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 10px;
    }

    .corpsBadge {
      display: inline-flex;
      align-items: center;
      padding: 5px 9px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 800;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.10);
    }

    .corpsTopRight {
      flex: 0 0 500px;
      width: 500px;
      min-width: 500px;
      margin-left: auto;
      padding-top: 8px;
    }

    .corpsStatsPanel {
      padding: 12px 4px !important;
      border: none;
      background: transparent;
      box-shadow: none;
    }

    .corpsStatsLabel {
      font-size: 14px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--corps-muted);
      margin-bottom: 14px;
    }

    .corpsStatsGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      column-gap: 22px;
      row-gap: 18px;
    }

    .corpsStat {
      min-width: 0;
      padding: 0 0 10px;
      border-bottom: 1px solid rgba(255,255,255,.08);
      background: transparent;
    }

    .corpsStatValue {
      font-size: 30px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: -.025em;
    }

    .corpsStatLabel {
      margin-top: 7px;
      font-size: 14px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: rgba(255,255,255,.62);
    }

    .corpsStatSub {
      margin-top: 3px;
      font-size: 12px;
      line-height: 1.3;
      color: rgba(255,255,255,.38);
    }

    .corpsShowsHeader {
      margin-top: 24px;
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 14px;
    }

    .corpsShowsHeader h2 {
      margin: 0;
      font-size: 23px;
      letter-spacing: -.02em;
    }

    .corpsShowsCount {
      color: var(--corps-muted);
      font-size: 11px;
    }

    .postergrid {
      margin-top: 14px !important;
      gap: 18px 14px !important;
    }

    .poster {
      min-width: 0;
      transition: transform .17s ease;
    }

    .poster:hover {
      transform: translateY(-3px);
    }

    .poster_art {
      overflow: hidden;
      border-radius: 9px;
      background: #070707;
      box-shadow: 0 8px 20px rgba(0,0,0,.18);
      transition: box-shadow .17s ease;
    }

    .poster:hover .poster_art {
      box-shadow: 0 14px 30px rgba(0,0,0,.34);
    }

    .poster_img {
      display: block;
      width: 100%;
      transition: transform .22s ease, opacity .22s ease;
    }

    .poster:hover .poster_img {
      transform: scale(1.015);
      opacity: .96;
    }

    .poster_meta {
      padding-top: 8px;
    }

    .poster_title {
      font-size: 13px;
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -.01em;
    }

    .poster_sub {
      margin-top: 3px;
      font-size: 9px;
      color: rgba(255,255,255,.52);
    }

    .tile_rating {
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }

    .myShowStatus {
      position: absolute;
      left: 8px;
      top: 8px;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      pointer-events: none;
    }

    .myShowStatusPill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 3px;
      padding: 3px 6px;
      border-radius: 999px;
      color: #fff;
      font-size: 9px;
      line-height: 1;
      font-weight: 900;
      white-space: nowrap;
      border: 1px solid rgba(255,255,255,.24);
      box-shadow: 0 2px 7px rgba(0,0,0,.55);
    }

    .myShowStatusPill.rated {
      background: rgba(45,82,190,.64);
    }

    .myShowStatusPill.reviewed {
      background: rgba(25,135,75,.64);
    }

    @media (max-width: 1180px) {
      .corpsDetailInner {
        flex-wrap: wrap;
      }

      .corpsTopRight {
        flex: 1 1 100%;
        width: 100%;
        min-width: 0;
      }
    }

    @media (max-width: 768px) {
      .corpsDetailInner {
        flex-direction: column;
        align-items: center;
      }

      .corpsLeft {
        flex-direction: column;
        align-items: center;
        width: 100%;
      }

      .corpsPosterColumn {
        flex: 0 0 150px;
        width: 150px;
        min-width: 150px;
      }

      .corpsPoster {
        width: 150px;
        height: 225px;
      }

      .corpsMeta {
        text-align: center;
        width: 100%;
      }

      .corpsBadges {
        justify-content: center;
      }

      .corpsStatsGrid {
        grid-template-columns: repeat(2, 1fr);
        column-gap: 18px;
        row-gap: 16px;
      }
    }

    @media (max-width: 560px) {
      .postergrid {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)) !important;
        gap: 10px !important;
      }
    }

    .auth { align-items:center; gap: 12px; }

    .notifWrap {
      position: relative;
      display: inline-flex;
      align-items:center;
    }

    .bellBtn {
      position: relative;
      border: none;
      background: transparent;
      cursor: pointer;
      color: inherit;
      padding: 6px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.95;
    }

    .bellBtn:hover {
      background: rgba(255,255,255,0.06);
    }

    .badge,
    .badgeDot {
      position:absolute;
      top: 3px;
      right: 3px;
      min-width: 18px;
      height: 18px;
      padding: 0 6px;
      border-radius: 999px;
      background: #ff3b30;
      color: #fff;
      font-size: 11px;
      line-height: 18px;
      text-align: center;
      font-weight: 800;
      box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }

    .notifDropdown {
      display: none;
      position: absolute;
      right: 0;
      top: 40px;
      width: 340px;
      max-height: 420px;
      overflow: auto;
      background: rgba(15,23,42,.98);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,.45);
      z-index: 9999;
    }

    .notifDropdown.open {
      display:block;
    }

    .notifHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding: 10px 12px;
      border-bottom: 1px solid rgba(255,255,255,.10);
      position: sticky;
      top: 0;
      background: rgba(15,23,42,.98);
      backdrop-filter: blur(8px);
    }

    .notifTitle {
      font-weight: 900;
    }

    .markReadBtn {
      border: none;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: .85;
      font-size: 12px;
      padding: 6px 8px;
      border-radius: 10px;
    }

    .notifList {
      padding: 8px;
      display:flex;
      flex-direction:column;
      gap: 8px;
    }

    .notifItem {
      padding: 10px;
      border-radius: 12px;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.08);
    }

    .notifItem.unread {
      background: rgba(99,102,241,.18);
      border-color: rgba(99,102,241,.25);
    }

    .notifTime {
      font-size: 12px;
      opacity: .7;
      margin-top: 4px;
    }

    .notifEmpty {
      padding: 12px;
      opacity: .8;
    }

    .authBellSlot {
      display:inline-flex;
      align-items:center;
    }

    .userSearchWrap {
      position: relative;
      display: inline-flex;
      align-items: center;
    }

    .userSearchInput {
      width: 220px;
      height: 38px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.05);
      color: inherit;
      padding: 0 12px;
      outline: none;
    }

    .userSearchInput::placeholder {
      color: rgba(255,255,255,.55);
    }

    .userSearchDropdown {
      display: none;
      position: absolute;
      top: 44px;
      right: 0;
      width: 280px;
      max-height: 320px;
      overflow: auto;
      background: rgba(13,13,16,.98);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,.45);
      z-index: 9999;
    }

    .userSearchDropdown.open {
      display:block;
    }

    .userSearchItem {
      display:flex;
      align-items:center;
      gap:10px;
      padding:10px 12px;
      text-decoration:none;
      color:inherit;
      border-bottom:1px solid rgba(255,255,255,.06);
    }

    .userSearchItem:last-child {
      border-bottom:none;
    }

    .userSearchAvatar {
      width:30px;
      height:30px;
      border-radius:999px;
      overflow:hidden;
      flex:0 0 auto;
      background:rgba(255,255,255,.08);
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .userSearchAvatar img {
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .userSearchEmpty {
      padding:12px;
      opacity:.8;
    }

    @media (max-width: 768px) {
      .topbar .wrap {
        flex-direction: column !important;
        gap: 15px;
        padding: 15px 10px !important;
      }

      .nav.row {
        width: 100%;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      .auth.row {
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
      }

      .userSearchInput {
        width: 100% !important;
        min-width: 280px;
      }

      .userSearchDropdown {
        width: 100%;
        right: 0;
        left: 0;
      }

      .notifDropdown {
        width: 90vw;
        position: fixed;
        left: 5vw;
        right: 5vw;
        top: 60px;
      }
    }

  </style>
</head>

<%
  const POSTER_FALLBACK = "/static/posters/placeholder.png";
  const corpsPosterKey = String(corps_name || "")
    .trim()
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "_")
    .replace(/_+/g, "_")
    .replace(/^_+|_+$/g, "");

  const CORPS_POSTER = `/posters/${corpsPosterKey}default`;
  const safeRows = Array.isArray(rows) ? rows : [];
  const safeStats = stats || {};
  const meUser = typeof me !== "undefined" ? me : null;
  const notifCountSafe =
    typeof notif_count !== "undefined" ? Number(notif_count || 0) : 0;

  const notifItemsSafe =
    Array.isArray(typeof notif_items !== "undefined" ? notif_items : [])
      ? notif_items
      : [];

  const avgRatingText =
    safeStats.avg_rating != null
      ? Number(safeStats.avg_rating).toFixed(2)
      : null;

  const ratingCount = Number(safeStats.rating_count || 0);
  const showCount = Number(safeStats.show_count || 0);
%>

<body class="app" style="--accent: <%= typeof accent_color !== 'undefined' ? accent_color : '#3252b3' %>;">
  <header class="topbar">
    <div class="wrap row between">
      <div style="display:flex; align-items:center; gap:10px;">
        <a
          href="https://www.generaleffect.media/"
          target="_blank"
          rel="noopener"
          style="display:flex; align-items:center;"
        >
          <img
            src="/static/logo.png"
            alt="Logo"
            style="width:40px; height:40px; object-fit:contain; transition: transform 0.6s ease-in-out;"
            onmouseover="this.style.transform='rotate(360deg)'"
            onmouseout="this.style.transform='rotate(0deg)'"
          >
        </a>

        <a class="brand" href="/shows" style="display:flex; align-items:center;">
          <img
            src="/static/pressboxd-wordmark.png"
            alt="Pressboxd"
            style="height:90px; width:auto; display:block; object-fit:contain;"
          >
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <a href="/predictions">Predictions</a>
        <a href="/forums">Forums</a>
        <a href="/tierlists">Tierlists</a>

        <% if (meUser && Number(meUser.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
          <a href="/admin/stats">Stats</a>
          <a href="/admin/predictions">Predictions Admin</a>
          <a href="/admin/site-message">Site Message</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (meUser) { %>
          <div class="userSearchWrap">
            <input
              id="userSearchInput"
              class="userSearchInput"
              type="text"
              placeholder="Search users..."
              autocomplete="off"
            >
            <div id="userSearchDropdown" class="userSearchDropdown"></div>
          </div>

          <div class="authBellSlot">
            <div class="notifWrap">
              <button
                class="bellBtn"
                id="bellBtn"
                aria-label="Notifications"
                title="Notifications"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z"
                    stroke="currentColor"
                    stroke-width="1"
                  />
                  <path
                    d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z"
                    stroke="currentColor"
                    stroke-width="1"
                    stroke-linejoin="round"
                  />
                </svg>

                <% if (notifCountSafe > 0) { %>
                  <span class="badge"><%= notifCountSafe %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>

                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>

                <% if (notifItemsSafe.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of notifItemsSafe) {
                         const kind = n?.kind || "";
                         const actor = n?.actor_username || "Someone";
                         const created = n?.created_at || "";
                         const unread = Number(n?.is_read ?? 0) === 0;
                         const sid = n?.show_id || null;
                         const showName = n?.show_title
                           ? `${n.show_title}${n.show_corps ? " — " + n.show_corps : ""}${n.show_year ? " (" + n.show_year + ")" : ""}`
                           : "";
                    %>
                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>

                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>

                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (showName) { %>
                              of <a href="/show/<%= sid %>"><%= showName %></a>
                            <% } else if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>

                        <% } else if (kind === "review_comment") { %>
                          <div>
                            <b><%= actor %></b> commented on your review
                            <% if (showName) { %>
                              of <a href="/show/<%= sid %>"><%= showName %></a>
                            <% } else if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>

                        <% } else if (kind === "comment_reply") { %>
                          <div>
                            <b><%= actor %></b> replied to your comment
                            <% if (showName) { %>
                              on <a href="/show/<%= sid %>"><%= showName %></a>
                            <% } else if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>

                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (meUser.avatar_url) { %>
                <img src="<%= meUser.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>

            <span class="muted small"><%= meUser.username || "me" %></span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <a class="corpsBack" href="/shows">← Back to all shows</a>

    <section class="panel corpsDetailPanel">
      <div class="corpsDetailInner">
        <div class="corpsLeft">
          <div class="corpsPosterColumn">
            <div class="corpsPoster">
              <img
                src="<%= CORPS_POSTER %>"
                alt="<%= corps_name %> poster"
                onerror="this.onerror=null;this.src='<%= POSTER_FALLBACK %>';"
              >
            </div>
          </div>

          <div class="corpsMeta">
            <div class="corpsKicker">Drum Corps</div>
            <h1><%= corps_name %></h1>

      

            <div class="corpsBadges">
              <% if (avgRatingText != null) { %>
                <span class="corpsBadge">★ <%= avgRatingText %> average</span>
              <% } else { %>
                <span class="corpsBadge">Unrated</span>
              <% } %>

              <span class="corpsBadge">
                <%= ratingCount %> rating<%= ratingCount === 1 ? "" : "s" %>
              </span>

              <span class="corpsBadge">
                <%= Number(safeStats.finals_appearances || 0) %>
                Finals appearance<%= Number(safeStats.finals_appearances || 0) === 1 ? "" : "s" %>
              </span>
            </div>
          </div>
        </div>

        <div class="corpsTopRight">
          <div class="panel corpsStatsPanel">
            <div class="corpsStatsLabel">Corps History</div>

            <div class="corpsStatsGrid">
              <div class="corpsStat">
                <div class="corpsStatValue"><%= Number(safeStats.titles || 0) %></div>
                <div class="corpsStatLabel">Titles</div>
                <div class="corpsStatSub">1st place</div>
              </div>

              <div class="corpsStat">
                <div class="corpsStatValue"><%= Number(safeStats.silvers || 0) %></div>
                <div class="corpsStatLabel">Silvers</div>
                <div class="corpsStatSub">2nd place</div>
              </div>

              <div class="corpsStat">
                <div class="corpsStatValue"><%= Number(safeStats.bronzes || 0) %></div>
                <div class="corpsStatLabel">Bronzes</div>
                <div class="corpsStatSub">3rd place</div>
              </div>

              <div class="corpsStat">
                <div class="corpsStatValue"><%= Number(safeStats.finals_appearances || 0) %></div>
                <div class="corpsStatLabel">Finals</div>
                <div class="corpsStatSub">Top 12 finishes</div>
              </div>

              <div class="corpsStat">
                <div class="corpsStatValue"><%= avgRatingText != null ? "★ " + avgRatingText : "—" %></div>
                <div class="corpsStatLabel">Avg. Rating</div>
                <div class="corpsStatSub"><%= ratingCount %> total ratings</div>
              </div>

              <div class="corpsStat">
                <div class="corpsStatValue"><%= showCount %></div>
                <div class="corpsStatLabel">Shows</div>
            
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="corpsShowsHeader">
      <h2>Shows</h2>
      <div class="corpsShowsCount">
        Newest season first
      </div>
    </div>

    <% if (safeRows.length > 0) { %>
      <div class="postergrid">
        <% for (const row of safeRows) {
             const poster = row?.poster_url || POSTER_FALLBACK;
             const avg =
               row?.avg_rating != null
                 ? Number(row.avg_rating)
                 : (row?.avg != null ? Number(row.avg) : 0);

             const pct = Math.max(0, Math.min(1, avg / 5));
             const hue = 60 * Math.pow(pct, 2.6);

             const myRatingHalf =
               row?.my_rating_half != null
                 ? Number(row.my_rating_half)
                 : null;

             const hasMyReview =
               Number(row?.has_review || 0) === 1;
        %>
          <div class="poster">
            <a
              class="poster_art"
              href="/show/<%= row.id %>"
              style="position:relative; display:block;"
            >
              <img
                class="poster_img"
                src="<%= poster %>"
                alt="<%= row.title || 'Show poster' %>"
                loading="lazy"
                onerror="this.src='<%= POSTER_FALLBACK %>';"
              >

              <% if (meUser && (myRatingHalf !== null || hasMyReview)) { %>
                <div class="myShowStatus">
                  <% if (myRatingHalf !== null) { %>
                    <span
                      class="myShowStatusPill rated"
                      title="You rated this show <%= (myRatingHalf / 2).toFixed(1) %> out of 5"
                    >
                      ★ Rated <%= (myRatingHalf / 2).toFixed(1) %>
                    </span>
                  <% } %>

                  <% if (hasMyReview) { %>
                    <span
                      class="myShowStatusPill reviewed"
                      title="You wrote a review for this show"
                    >
                      ✓ Reviewed
                    </span>
                  <% } %>
                </div>
              <% } %>

              <% if (Number(row.cnt || 0) > 0) { %>
                <div
                  class="tile_rating"
                  style="
                    color:hsl(<%= hue %>, 100%, 50%);
                    text-shadow:
                      -0.3px -0.3px 0 #000,
                       0.3px -0.3px 0 #000,
                      -0.3px  0.3px 0 #000,
                       0.3px  0.3px 0 #000,
                       0 0 4px rgba(0,0,0,.9);
                  "
                >
                  <span class="tile_star">★</span>
                  <%= avg.toFixed(2) %>
                </div>

                <div
                  class="muted small"
                  style="
                    position:absolute;
                    right:8px;
                    top:8px;
                    z-index:3;
                    background:rgba(0,0,0,.60);
                    color:#fff;
                    padding:3px 6px;
                    border-radius:999px;
                    font-size:9px;
                    line-height:1;
                    border:1px solid rgba(255,255,255,.10);
                  "
                >
                  <%= Number(row.cnt || 0) %> ratings
                </div>
              <% } else { %>
                <span class="badge unrated bottom_left">Unrated</span>
              <% } %>
            </a>

            <div class="poster_meta">
              <div class="poster_title">
                <a
                  href="/show/<%= row.id %>"
                  style="color:inherit; text-decoration:none;"
                >
                  <%= row.title || "Untitled" %>
                </a>
              </div>

              <div class="poster_sub">
                <a
                  href="/corps/<%= encodeURIComponent(row.corps) %>"
                  style="color:inherit; text-decoration:none;"
                >
                  <%= row.corps %>
                </a>

                <% if (row.year) { %>
                  <span style="opacity:.5; margin:0 4px;">&bull;</span>
                  <a
                    href="/shows?year=<%= encodeURIComponent(row.year) %>"
                    style="color:inherit; text-decoration:none;"
                  >
                    <%= row.year %>
                  </a>
                <% } %>

                <% if (Number.isInteger(Number(row.placement)) && Number(row.placement) > 0) { %>
                  <span style="opacity:.5; margin:0 4px;">&bull;</span>
                  <span><%= Number(row.placement) %><%=
                    Number(row.placement) % 100 >= 11 && Number(row.placement) % 100 <= 13
                      ? "th"
                      : Number(row.placement) % 10 === 1
                        ? "st"
                        : Number(row.placement) % 10 === 2
                          ? "nd"
                          : Number(row.placement) % 10 === 3
                            ? "rd"
                            : "th"
                  %></span>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="panel" style="margin-top:14px;">
        <div class="muted">No shows found for this corps.</div>
      </div>
    <% } %>


  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd = document.getElementById("notifDropdown");

      if (btn && dd) {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          dd.classList.toggle("open");
        });

        dd.addEventListener("click", (e) => e.stopPropagation());
        document.addEventListener("click", () => dd.classList.remove("open"));
      }
    })();

    (() => {
      const input = document.getElementById("userSearchInput");
      const dropdown = document.getElementById("userSearchDropdown");

      if (!input || !dropdown) return;

      let timer = null;
      let requestId = 0;

      function escapeHtml(str) {
        return String(str || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function renderUsers(users) {
        if (!Array.isArray(users) || users.length === 0) {
          dropdown.innerHTML =
            '<div class="userSearchEmpty">No users found.</div>';
          dropdown.classList.add("open");
          return;
        }

        dropdown.innerHTML = users.map(u => {
          const avatar = u.avatar_url
            ? `<img src="${escapeHtml(u.avatar_url)}" alt="${escapeHtml(u.username)}">`
            : `<span style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:12px;opacity:.7;">👤</span>`;

          return `
            <a class="userSearchItem" href="/u/${encodeURIComponent(u.username)}">
              <div class="userSearchAvatar">${avatar}</div>
              <div style="min-width:0;">
                <div style="font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                  ${escapeHtml(u.username)}
                </div>
              </div>
            </a>
          `;
        }).join("");

        dropdown.classList.add("open");
      }

      function clearDropdown() {
        dropdown.innerHTML = "";
        dropdown.classList.remove("open");
      }

      input.addEventListener("input", () => {
        const q = input.value.trim();
        clearTimeout(timer);

        if (!q) {
          clearDropdown();
          return;
        }

        timer = setTimeout(async () => {
          const currentRequest = ++requestId;

          try {
            const res = await fetch(
              `/api/users/search?q=${encodeURIComponent(q)}`,
              { headers: { Accept: "application/json" } }
            );

            if (!res.ok) throw new Error("search request failed");

            const data = await res.json();

            if (currentRequest !== requestId) return;

            renderUsers(Array.isArray(data.users) ? data.users : []);
          } catch (err) {
            console.error("user search failed:", err);

            if (currentRequest !== requestId) return;

            dropdown.innerHTML =
              '<div class="userSearchEmpty">Search failed.</div>';
            dropdown.classList.add("open");
          }
        }, 200);
      });

      input.addEventListener("focus", () => {
        if (dropdown.innerHTML.trim()) {
          dropdown.classList.add("open");
        }
      });

      document.addEventListener("click", (e) => {
        if (!dropdown.contains(e.target) && e.target !== input) {
          dropdown.classList.remove("open");
        }
      });
    })();
  </script>

</body>
</html>
