<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#000000">
  <title>GEM Store — Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css">
  <link rel="stylesheet" href="/static/cosmetics.css?v=20">
  <link rel="icon" type="image/png" href="/static/favicon.png">
</head>
<body class="app pc-store-page pc2-page" style="--accent:<%= (typeof accent_color !== 'undefined' && /^#[0-9a-fA-F]{6}$/.test(String(accent_color))) ? accent_color : '#3252b3' %>">
  <header class="topbar pc2-site-header">
    <div class="wrap pc2-topbar-inner">
      <div class="pc2-brand-cluster">
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" class="pc2-logo" aria-label="General Effect Media"><img src="/static/logo.png" alt="" width="36" height="36"></a>
        <a href="/shows" class="pc2-wordmark"><img src="/static/pressboxd-wordmark.png" alt="Pressboxd" height="74"></a>
      </div>
      <nav class="pc2-top-nav" aria-label="Main navigation">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <a href="/predictions">Predictions</a>
        <a href="/forums">Forums</a>
        <a href="/tierlists">Tierlists</a>
      </nav>
      <div class="pc2-account-nav">
        <% if(me){ %>
          <a href="/me" class="pc2-user-link"><% if(me.avatar_url){ %><img src="<%= me.avatar_url %>" alt="" width="28" height="28"><% } %><span><%= me.username %></span></a>
          <a href="/logout" class="pc2-logout">Logout</a>
        <% } else { %>
          <a href="/login?next=%2Fstore">Login</a>
          <a class="pc2-register" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap pc2-main">
    <div class="pc2-breadcrumb"><a href="/shows">Pressboxd</a><span>/</span> GEM Store</div>
    <section class="pc2-page-heading" aria-labelledby="pc2-store-title">
      <div class="pc2-heading-copy">
        <div class="pc2-kicker">PROFILE CUSTOMIZATION</div>
        <h1 id="pc2-store-title">GEM Store</h1>
        <p>Customize your profile with avatar frames, animations and nameplates. Purchases are permanent.</p>
      </div>
      <div class="pc2-heading-aside">
        <% if(me){ %>
          <div class="pc2-wallet-label">AVAILABLE BALANCE</div>
          <div class="pc2-wallet-amount">💎 <%= Number(balance).toLocaleString() %> <span>GEMS</span></div>
          <a href="/me/cosmetics" class="pc2-button pc2-button-primary">My Cosmetics</a>
        <% } else { %>
          <p class="pc2-signin-prompt">Sign in to buy cosmetics using Gems.</p>
          <a href="/login?next=%2Fstore" class="pc2-button pc2-button-primary">Sign In</a>
        <% } %>
      </div>
    </section>
    <% if(notice){ %><div class="pc2-message pc2-message-success" role="status"><%= notice %></div><% } %>
    <% if(error){ %><div class="pc2-message pc2-message-error" role="alert"><%= error %></div><% } %>

    <div class="pc2-content-grid">
      <aside class="pc2-sidebar" aria-label="Store categories">
        <div class="pc2-sidebar-heading">CATEGORIES</div>
        <a href="#frames">Avatar Frames <span>›</span></a>
        <a href="#motion">Avatar Motion <span>›</span></a>
        <a href="#nameplates">Nameplates <span>›</span></a>
        <a href="#special">Special Unlocks <span>›</span></a>
        <div class="pc2-sidebar-divider"></div>
        <a href="/me/cosmetics">My Collection <span>↗</span></a>
        <a href="/betting">Earn Gems <span>↗</span></a>
      </aside>
      <div class="pc2-store-content">
        <div class="pc2-intro-strip">
          <div>
            <strong>Make your profile yours.</strong>
            <span>Preview items below before you buy. Equip owned items whenever you want.</span>
          </div>
          <div class="pc2-intro-preview"><div class="pc-preview-avatar pc-frame_sapphire"><img src="/static/logo.png" alt=""></div></div>
        </div>
        <% const sections=[['frame','frames','Avatar Frames','Decorative borders and ambient glows for your profile picture.'],['motion','motion','Avatar Motion','Animated effects that give your profile picture movement.'],['nameplate','nameplates','Nameplates','Special treatments for your display name.'],['unlock','special','Special Unlocks','Additional profile customization capabilities.']]; %>
        <% for(const [cat,id,title,description] of sections){ %>
          <section class="pc2-category-section" id="<%= id %>">
            <div class="pc2-section-header">
              <div><h2><%= title %></h2><p><%= description %></p></div>
              <span class="pc2-item-count"><%= catalog.filter(it=>it.category===cat).length %> ITEMS</span>
            </div>
            <div class="pc2-product-grid">
              <% for(const item of catalog.filter(it=>it.category===cat)){ const isOwned=owned_ids.has(item.id); const isEquipped=equipped[cat]===item.id; %>
                <article class="pc2-product">
                  <div class="pc2-product-art pc-item-<%= item.id %>">
                    <% if(cat==='frame' || cat==='motion' || cat==='unlock'){ %>
                      <div class="pc-preview-avatar <%= cat==='frame'?'pc-'+item.id:cat==='motion'?'pc-'+item.id:'pc-frame-prism' %>"><img src="/static/logo.png" alt=""></div>
                    <% } else if(cat==='nameplate'){ %>
                      <div class="pc-name-sample pc-<%= item.id %>">USERNAME</div>
                    <% } %>
                    <span class="pc2-rarity"><%= item.rarity %></span>
                  </div>
                  <div class="pc2-product-info">
                    <h3><%= item.name %></h3>
                    <p><%= item.description %></p>
                    <div class="pc2-product-buy-row">
                      <span class="pc2-price">💎 <%= item.price.toLocaleString() %></span>
                      <% if(isEquipped){ %>
                        <span class="pc2-owned">Equipped</span>
                      <% } else if(isOwned){ %>
                        <a class="pc2-owned" href="/me/cosmetics">Owned · Equip</a>
                      <% } else if(!me){ %>
                        <a class="pc2-button pc2-button-secondary pc2-button-small" href="/login?next=%2Fstore">Sign In</a>
                      <% } else { %>
                        <form action="/store/buy" method="post">
                          <input type="hidden" name="csrf" value="<%= csrf %>">
                          <input type="hidden" name="item_id" value="<%= item.id %>">
                          <button type="submit" class="pc2-button pc2-button-secondary pc2-button-small" <%= balance < item.price ? 'disabled title="Not enough Gems"' : '' %>>Buy</button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                </article>
              <% } %>
            </div>
          </section>
        <% } %>
      </div>
    </div>
  </main>
  <footer class="wrap pc2-footer">Cosmetic items only. Gems are virtual, have no cash value, and cannot be redeemed for prizes.</footer>
</body>
</html>
