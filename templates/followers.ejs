<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Followers - Pressboxd</title>

  <link rel="stylesheet" href="/static/styles.css">
  <link rel="icon" type="image/png" href="/static/favicon.png">

  <style>
    :root {
      --social-border: rgba(255,255,255,.09);
      --social-muted: rgba(255,255,255,.58);
      --social-card: rgba(255,255,255,.03);
      --social-card-hover: rgba(255,255,255,.055);
      --presence-online: #35d07f;
      --presence-recent: #e6b94a;
      --presence-offline: #70798b;
    }

    .auth { align-items:center; gap:12px; }
    .followersPage { padding-top:26px; padding-bottom:50px; }

    .followersBrand {
      display:flex;
      align-items:center;
      flex-shrink:0;
      text-decoration:none;
    }

    .followersBrand img {
      height:70px;
      width:auto;
      display:block;
      object-fit:contain;
    }

    .followersHero {
      position:relative;
      overflow:hidden;
      margin-bottom:18px;
      padding:24px 26px;
      border:1px solid var(--social-border);
      border-radius:18px;
      background:linear-gradient(135deg, rgba(255,255,255,.055), rgba(255,255,255,.018));
    }

    .followersHero::before {
      content:"";
      position:absolute;
      width:300px;
      height:300px;
      right:-110px;
      top:-170px;
      border-radius:50%;
      background:var(--accent, #3252b3);
      opacity:.14;
      filter:blur(24px);
      pointer-events:none;
    }

    .followersHeroInner {
      position:relative;
      z-index:1;
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:20px;
    }

    .followersTitle {
      margin:5px 0;
      font-size:clamp(30px, 5vw, 44px);
      line-height:1;
      letter-spacing:-.035em;
    }

    .followersDescription {
      margin:0;
      max-width:580px;
      color:var(--social-muted);
      font-size:14px;
      line-height:1.5;
    }

    .followersStats {
      display:flex;
      flex-wrap:wrap;
      justify-content:flex-end;
      gap:9px;
    }

    .followersStat {
      min-width:94px;
      padding:11px 14px;
      text-align:center;
      border:1px solid var(--social-border);
      border-radius:13px;
      background:rgba(0,0,0,.14);
    }

    .followersStatNumber {
      display:block;
      font-size:19px;
      font-weight:900;
      line-height:1.1;
    }

    .followersStatLabel {
      display:block;
      margin-top:3px;
      color:var(--social-muted);
      font-size:11px;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:.055em;
    }

    .followersStat.online .followersStatNumber {
      color:var(--presence-online);
    }

    .followersPanel {
      overflow:hidden;
      border:1px solid var(--social-border);
      border-radius:18px;
      background:rgba(255,255,255,.022);
    }

    .followersPanelHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:17px 18px;
      border-bottom:1px solid var(--social-border);
    }

    .followersPanelTitle {
      margin:0;
      font-size:17px;
      font-weight:900;
    }

    .followersPanelSubtitle {
      margin-top:3px;
      color:var(--social-muted);
      font-size:12px;
    }

    .followersCount {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:30px;
      height:30px;
      padding:0 9px;
      border:1px solid var(--social-border);
      border-radius:999px;
      background:rgba(255,255,255,.055);
      font-size:12px;
      font-weight:850;
    }

    .followersGrid {
      display:grid;
      grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));
      gap:10px;
      padding:12px;
    }

    .followerCard {
      display:flex;
      align-items:center;
      min-width:0;
      gap:12px;
      padding:12px;
      border:1px solid var(--social-border);
      border-radius:14px;
      background:var(--social-card);
      transition:background .12s ease, border-color .12s ease, transform .12s ease;
    }

    .followerCard:hover {
      background:var(--social-card-hover);
      border-color:rgba(255,255,255,.14);
      transform:translateY(-1px);
    }

    .followerAvatarWrap {
      position:relative;
      width:48px;
      height:48px;
      flex:0 0 48px;
    }

    .followerAvatar {
      display:block;
      width:48px;
      height:48px;
      overflow:hidden;
      border:1px solid rgba(255,255,255,.12);
      border-radius:50%;
      background:rgba(255,255,255,.07);
    }

    .followerAvatar img {
      width:100%;
      height:100%;
      display:block;
      object-fit:cover;
    }

    .followerAvatarFallback {
      display:block;
      width:100%;
      height:100%;
      background:linear-gradient(145deg, rgba(255,255,255,.13), rgba(255,255,255,.035));
    }

    .presenceAvatarDot {
      position:absolute;
      right:-1px;
      bottom:1px;
      width:13px;
      height:13px;
      border:3px solid #0d1118;
      border-radius:50%;
      background:var(--presence-offline);
    }

    .presenceAvatarDot.online {
      background:var(--presence-online);
      box-shadow:0 0 0 3px rgba(53,208,127,.11);
    }

    .presenceAvatarDot.recent { background:var(--presence-recent); }
    .presenceAvatarDot.offline { background:var(--presence-offline); }

    .followerUserInfo {
      min-width:0;
      flex:1;
    }

    .followerUsername {
      display:block;
      max-width:100%;
      overflow:hidden;
      color:inherit;
      font-size:15px;
      font-weight:850;
      text-decoration:none;
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .followerUsername:hover {
      color:var(--accent, #3252b3);
    }

    .followerUserLabel {
      margin-top:4px;
      color:var(--social-muted);
      font-size:11px;
    }

    .presenceLine {
      display:flex;
      align-items:center;
      gap:6px;
      margin-top:4px;
      color:rgba(255,255,255,.42);
      font-size:11px;
      font-weight:650;
    }

    .presenceMiniDot {
      width:7px;
      height:7px;
      flex:0 0 7px;
      border-radius:50%;
      background:var(--presence-offline);
    }

    .presenceLine.online { color:var(--presence-online); }
    .presenceLine.online .presenceMiniDot { background:var(--presence-online); }

    .presenceLine.recent { color:var(--presence-recent); }
    .presenceLine.recent .presenceMiniDot { background:var(--presence-recent); }

    .presenceLine.offline { color:rgba(255,255,255,.42); }
    .presenceLine.offline .presenceMiniDot { background:var(--presence-offline); }

    .followersEmpty {
      padding:42px 24px;
      text-align:center;
    }

    .followersEmptyIcon {
      display:flex;
      align-items:center;
      justify-content:center;
      width:50px;
      height:50px;
      margin:0 auto 12px;
      border:1px solid var(--social-border);
      border-radius:15px;
      background:rgba(255,255,255,.045);
      font-size:22px;
    }

    .followersEmptyTitle {
      font-size:15px;
      font-weight:850;
    }

    .followersEmptyText {
      max-width:360px;
      margin:5px auto 0;
      color:var(--social-muted);
      font-size:12px;
      line-height:1.5;
    }

    .notifWrap {
      position:relative;
      display:inline-flex;
      align-items:center;
    }

    .bellBtn {
      position:relative;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:34px;
      height:34px;
      padding:0;
      color:inherit;
      cursor:pointer;
      opacity:.9;
      border:1px solid transparent;
      border-radius:10px;
      background:transparent;
      transition:background .12s ease, border-color .12s ease, opacity .12s ease;
    }

    .bellBtn:hover {
      opacity:1;
      border-color:rgba(255,255,255,.08);
      background:rgba(255,255,255,.06);
    }

    .badgeDot {
      position:absolute;
      top:-3px;
      right:-4px;
      min-width:18px;
      height:18px;
      padding:0 5px;
      color:#fff;
      font-size:10px;
      font-weight:900;
      line-height:18px;
      text-align:center;
      border:2px solid #0d1118;
      border-radius:999px;
      background:#ff3b30;
    }

    .notifDropdown {
      display:none;
      position:absolute;
      top:43px;
      right:0;
      z-index:9999;
      width:min(350px, calc(100vw - 24px));
      max-height:440px;
      overflow:auto;
      border:1px solid rgba(255,255,255,.12);
      border-radius:14px;
      background:rgba(15,23,42,.99);
      box-shadow:0 18px 55px rgba(0,0,0,.5);
    }

    .notifDropdown.open { display:block; }
    .notifDropdown, .notifDropdown * { pointer-events:auto !important; }

    .notifHeader {
      position:sticky;
      top:0;
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:11px 12px;
      border-bottom:1px solid rgba(255,255,255,.1);
      background:rgba(15,23,42,.99);
      backdrop-filter:blur(8px);
    }

    .notifTitle { font-weight:900; }

    .markReadBtn {
      padding:6px 8px;
      color:inherit;
      font-size:11px;
      cursor:pointer;
      opacity:.75;
      border:0;
      border-radius:8px;
      background:transparent;
    }

    .markReadBtn:hover {
      opacity:1;
      background:rgba(255,255,255,.06);
    }

    .notifList {
      display:flex;
      flex-direction:column;
      gap:7px;
      padding:8px;
    }

    .notifItem {
      padding:10px;
      font-size:13px;
      border:1px solid rgba(255,255,255,.07);
      border-radius:11px;
      background:rgba(255,255,255,.035);
    }

    .notifItem.unread {
      border-color:rgba(99,102,241,.24);
      background:rgba(99,102,241,.15);
    }

    .notifTime {
      margin-top:4px;
      font-size:10px;
      opacity:.6;
    }

    .notifEmpty {
      padding:15px;
      font-size:13px;
      opacity:.7;
    }

    @media (max-width:760px) {
      .followersPage { padding-top:16px; }

      .followersHero {
        padding:19px 17px;
        border-radius:15px;
      }

      .followersHeroInner {
        align-items:flex-start;
        flex-direction:column;
      }

      .followersStats { justify-content:flex-start; }
      .followersPanel { border-radius:15px; }
      .followersGrid { grid-template-columns:1fr; }
      .followersBrand img { height:62px; }
      .topbar .nav { display:none; }
      .auth .muted.small { display:none; }
    }
  </style>
</head>

<%
  const safeMe = (typeof me !== "undefined" && me) ? me : null;
  const safeProfileUser = (typeof profile_user !== "undefined" && profile_user) ? profile_user : {};
  const safeRows = (typeof rows !== "undefined" && Array.isArray(rows)) ? rows : [];
  const safeNotifCount = (typeof notif_count !== "undefined" && notif_count) ? Number(notif_count) : 0;
  const safeNotifItems = (typeof notif_items !== "undefined" && Array.isArray(notif_items)) ? notif_items : [];
  const safeFlashes = (typeof flashes !== "undefined" && Array.isArray(flashes)) ? flashes : [];

  const isOwnFollowers = !!(
    safeMe &&
    safeProfileUser &&
    Number(safeMe.id) === Number(safeProfileUser.id)
  );

  function cleanPresence(user) {
    const status = String(user?.presence_status || "offline").toLowerCase();
    return status === "online" || status === "recent" ? status : "offline";
  }

  function presenceLabel(status) {
    if (status === "online") return "Online";
    if (status === "recent") return "Active recently";
    return "Offline";
  }

  const initialOnlineCount = isOwnFollowers
    ? safeRows.filter(u => cleanPresence(u) === "online").length
    : 0;
%>

<body class="app" <%= safeMe && safeMe.theme_color ? `style="--accent: ${safeMe.theme_color};"` : "" %>>

  <header class="topbar">
    <div class="wrap row between">
      <a class="followersBrand" href="/shows" aria-label="Pressboxd">
        <img src="/static/pressboxd-wordmark.png" alt="Pressboxd">
      </a>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <a href="/predictions">Predictions</a>
        <a href="/forums">Forums</a>
        <a href="/tierlists">Tierlists</a>

        <% if (safeMe && Number(safeMe.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (safeMe) { %>
          <div class="notifWrap">
            <button class="bellBtn" id="bellBtn" type="button" aria-label="Notifications" title="Notifications">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1.3"/>
                <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
              </svg>

              <% if (safeNotifCount > 0) { %>
                <span class="badgeDot"><%= safeNotifCount %></span>
              <% } %>
            </button>

            <div class="notifDropdown" id="notifDropdown">
              <div class="notifHeader">
                <div class="notifTitle">Notifications</div>
                <form method="post" action="/me/notifications/read">
                  <button class="markReadBtn" type="submit">Mark all read</button>
                </form>
              </div>

              <% if (safeNotifItems.length > 0) { %>
                <div class="notifList">
                  <% for (const n of safeNotifItems) {
                    const kind = n.kind || "";
                    const actor = n.actor_username || "Someone";
                    const created = n.created_at || "";
                    const unread = Number(n.is_read || 0) === 0;
                    const sid = n.show_id || null;
                  %>
                    <div class="notifItem <%= unread ? 'unread' : '' %>">
                      <% if (kind === "friend_request") { %>
                        <div><b><%= actor %></b> sent you a friend request.</div>
                      <% } else if (kind === "follow") { %>
                        <div><b><%= actor %></b> followed you.</div>
                      <% } else if (kind === "review_upvote") { %>
                        <div>
                          <b><%= actor %></b> upvoted your review
                          <% if (sid) { %> — <a href="/show/<%= sid %>">View show</a><% } %>
                        </div>
                      <% } else if (kind === "review_comment") { %>
                        <div>
                          <b><%= actor %></b> commented on your review.
                          <% if (sid) { %> — <a href="/show/<%= sid %>">View</a><% } %>
                        </div>
                      <% } else if (kind === "comment_reply") { %>
                        <div>
                          <b><%= actor %></b> replied to your comment.
                          <% if (sid) { %> — <a href="/show/<%= sid %>">View</a><% } %>
                        </div>
                      <% } else { %>
                        <div>New activity.</div>
                      <% } %>

                      <% if (created) { %>
                        <div class="notifTime"><%= created %></div>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              <% } else { %>
                <div class="notifEmpty">No notifications.</div>
              <% } %>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (safeMe.avatar_url) { %>
                <img src="<%= safeMe.avatar_url %>" alt="">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= safeMe.username %></span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap followersPage">
    <% if (safeFlashes.length > 0) { %>
      <div class="flashes" style="margin-bottom:14px;">
        <% for (const f of safeFlashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <section class="followersHero">
      <div class="followersHeroInner">
        <div>
          <div class="kicker">Followers</div>

          <h1 class="followersTitle">
            <%= isOwnFollowers ? "Your Followers" : `${safeProfileUser.username || "User"}'s Followers` %>
          </h1>

          <p class="followersDescription">
            <% if (isOwnFollowers) { %>
              See who's following you and which of your followers are currently active on Pressboxd.
            <% } else { %>
              People following <%= safeProfileUser.username || "this user" %>.
            <% } %>
          </p>
        </div>

        <div class="followersStats">
          <div class="followersStat">
            <span class="followersStatNumber"><%= safeRows.length %></span>
            <span class="followersStatLabel">Followers</span>
          </div>

          <% if (isOwnFollowers) { %>
            <div class="followersStat online">
              <span class="followersStatNumber" id="followersOnlineCount"><%= initialOnlineCount %></span>
              <span class="followersStatLabel">Online</span>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <section class="followersPanel">
      <div class="followersPanelHeader">
        <div>
          <h2 class="followersPanelTitle">
            <%= isOwnFollowers ? "People Following You" : "Followers" %>
          </h2>

          <div class="followersPanelSubtitle">
            <%= safeRows.length === 1 ? "1 account" : `${safeRows.length} accounts` %>
          </div>
        </div>

        <div class="followersCount"><%= safeRows.length %></div>
      </div>

      <% if (safeRows.length > 0) { %>
        <div class="followersGrid">
          <% for (const u of safeRows) {
            const status = cleanPresence(u);
          %>
            <div
              class="followerCard"
              data-follower-id="<%= u.id %>"
              <% if (isOwnFollowers) { %>data-presence="<%= status %>"<% } %>
            >
              <div class="followerAvatarWrap">
                <a class="followerAvatar" href="/u/<%= encodeURIComponent(u.username) %>">
                  <% if (u.avatar_url) { %>
                    <img src="<%= u.avatar_url %>" alt="">
                  <% } else { %>
                    <span class="followerAvatarFallback"></span>
                  <% } %>
                </a>

                <% if (isOwnFollowers) { %>
                  <span class="presenceAvatarDot <%= status %>" data-presence-avatar-dot aria-hidden="true"></span>
                <% } %>
              </div>

              <div class="followerUserInfo">
                <a class="followerUsername" href="/u/<%= encodeURIComponent(u.username) %>">
                  <%= u.username %>
                </a>

                <% if (isOwnFollowers) { %>
                  <div class="presenceLine <%= status %>" data-presence-line>
                    <span class="presenceMiniDot"></span>
                    <span data-presence-text><%= presenceLabel(status) %></span>
                  </div>
                <% } else { %>
                  <div class="followerUserLabel">Pressboxd user</div>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="followersEmpty">
          <div class="followersEmptyIcon">☆</div>
          <div class="followersEmptyTitle">No followers yet</div>

          <div class="followersEmptyText">
            <% if (isOwnFollowers) { %>
              When other Pressboxd users follow you, they'll appear here.
            <% } else { %>
              <%= safeProfileUser.username || "This user" %> doesn't have any followers yet.
            <% } %>
          </div>
        </div>
      <% } %>
    </section>
  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <% if (safeMe) { %>
    <script src="/static/js/presence.js?v=20260822a"></script>
  <% } %>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd = document.getElementById("notifDropdown");

      if (btn && dd) {
        dd.addEventListener("click", e => e.stopPropagation());

        btn.addEventListener("click", e => {
          e.preventDefault();
          e.stopPropagation();
          dd.classList.toggle("open");
        });

        document.addEventListener("click", () => dd.classList.remove("open"));

        document.addEventListener("keydown", e => {
          if (e.key === "Escape") dd.classList.remove("open");
        });
      }

      const isOwnFollowers = <%= isOwnFollowers ? "true" : "false" %>;
      if (!isOwnFollowers) return;

      const onlineCount = document.getElementById("followersOnlineCount");
      const validStatuses = new Set(["online", "recent", "offline"]);

      function cleanStatus(value) {
        const status = String(value || "").trim().toLowerCase();
        return validStatuses.has(status) ? status : "offline";
      }

      function statusText(status) {
        if (status === "online") return "Online";
        if (status === "recent") return "Active recently";
        return "Offline";
      }

      function updateFollowerCard(userId, status) {
        const card = document.querySelector(
          `[data-follower-id="${CSS.escape(String(userId))}"]`
        );

        if (!card) return;

        const clean = cleanStatus(status);
        card.dataset.presence = clean;

        const avatarDot = card.querySelector("[data-presence-avatar-dot]");
        const line = card.querySelector("[data-presence-line]");
        const text = card.querySelector("[data-presence-text]");

        if (avatarDot) {
          avatarDot.classList.remove("online", "recent", "offline");
          avatarDot.classList.add(clean);
        }

        if (line) {
          line.classList.remove("online", "recent", "offline");
          line.classList.add(clean);
        }

        if (text) text.textContent = statusText(clean);
      }

      function refreshOnlineCount() {
        if (!onlineCount) return;

        onlineCount.textContent = String(
          document.querySelectorAll('.followerCard[data-presence="online"]').length
        );
      }

      async function refreshPresence() {
        if (document.visibilityState !== "visible") return;

        try {
          const response = await fetch("/api/presence/followers", {
            method: "GET",
            credentials: "same-origin",
            cache: "no-store",
            headers: {
              "X-Requested-With": "XMLHttpRequest"
            }
          });

          if (!response.ok) return;

          const payload = await response.json();
          if (!payload || !Array.isArray(payload.users)) return;

          document.querySelectorAll("[data-follower-id]").forEach(card => {
            updateFollowerCard(card.dataset.followerId, "offline");
          });

          for (const user of payload.users) {
            updateFollowerCard(user.id, user.presence_status);
          }

          refreshOnlineCount();
        } catch (_) {
          // Presence should never break the Followers page.
        }
      }

      refreshOnlineCount();
      refreshPresence();

      setInterval(refreshPresence, 30 * 1000);

      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") refreshPresence();
      });

      window.addEventListener("focus", refreshPresence);
    })();
  </script>
</body>
</html>
