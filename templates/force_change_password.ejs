<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Change Password - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body class="app">
  <main class="wrap">
    <div class="panel" style="max-width: 400px; margin: 50px auto;">
      <h2>Update Password</h2>
      <p class="muted">You are required to change your password before continuing.</p>
      
      <form method="post" action="/force-change-password">
        <div class="field">
          <label>New Password</label>
          <input type="password" name="new_password" required minlength="8">
        </div>
        <div class="field">
          <label>Confirm New Password</label>
          <input type="password" name="confirm_password" required>
        </div>
        <button class="btn green" type="submit">Update Password</button>
      </form>
    </div>
  </main>
</body>
</html>
