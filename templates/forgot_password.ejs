<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Forgot Password - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
</head>
<body class="app">
  <main class="wrap">
    <% if (Array.isArray(flashes) && flashes.length > 0) { %>
      <div class="flashes">
        <% for (const f of flashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <h1>Forgot Password</h1>

    <form class="panel form" method="post" action="/forgot-password">
      <label>Email</label>
      <input type="email" name="email" required placeholder="you@example.com"/>

      <button class="btn green" type="submit">Send reset link</button>
    </form>
  </main>
</body>
</html>
