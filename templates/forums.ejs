<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>

  <title>Forums — Pressboxd</title>
  <meta name="description" content="Discuss drum corps shows, rankings, predictions, design, music, guard, percussion, brass, and more on the Pressboxd forums.">

  <link rel="stylesheet" href="/static/styles.css"/>
  <link rel="icon" type="image/png" href="/static/favicon.png"/>

  <style>
    html,
    body,
    body.app {
      background: #000000 !important;
      background-image: none !important;
      color: #e5e7eb;
    }

    a {
      color: inherit;
    }

    .forumShell {
      width: min(1180px, calc(100% - 28px));
      margin: 0 auto;
      padding: 22px 0 70px;
    }

    .forumHeader {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 18px;
      margin-bottom: 18px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(255,255,255,0.10);
    }

    .forumEyebrow {
      color: var(--accent);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .14em;
      text-transform: uppercase;
      margin-bottom: 6px;
    }

    .forumPageTitle {
      margin: 0;
      font-size: 32px;
      line-height: 1.1;
      font-weight: 950;
      letter-spacing: -0.03em;
    }

    .forumPageSub {
      margin-top: 6px;
      color: rgba(229,231,235,0.70);
      font-size: 14px;
      max-width: 720px;
    }

    .forumBreadcrumbs {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 18px;
      color: rgba(229,231,235,0.68);
      font-size: 14px;
    }

    .forumBreadcrumbs a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 700;
    }

    .forumBreadcrumbs a:hover {
      text-decoration: underline;
    }

    .forumPanel {
      border: 1px solid rgba(255,255,255,0.12);
      background: #070707;
      margin-bottom: 18px;
    }

    .forumPanelHeader {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      padding: 11px 14px;
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--accent) 20%, #111 80%),
        #111
      );
      border-bottom: 1px solid rgba(255,255,255,0.12);
    }

    .forumPanelTitle {
      font-size: 14px;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #fff;
      margin: 0;
    }

    .forumPanelBody {
      padding: 14px;
    }

    .forumTable {
      width: 100%;
      border-collapse: collapse;
    }

    .forumTable th {
      text-align: left;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: rgba(229,231,235,0.58);
      background: #0d0d0d;
      border-bottom: 1px solid rgba(255,255,255,0.10);
      padding: 10px 12px;
      white-space: nowrap;
    }

    .forumTable td {
      padding: 14px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      vertical-align: middle;
    }

    .forumTable tr:last-child td {
      border-bottom: none;
    }

    .forumTable tbody tr:hover {
      background: rgba(255,255,255,0.035);
    }

    .forumMainCell {
      width: 100%;
    }

    .forumIconCell {
      width: 42px;
    }

    .forumIcon {
      width: 34px;
      height: 34px;
      border-radius: 6px;
      display: grid;
      place-items: center;
      font-weight: 950;
      background: color-mix(in srgb, var(--accent) 18%, #151515 82%);
      border: 1px solid color-mix(in srgb, var(--accent) 34%, rgba(255,255,255,0.12));
      color: #fff;
    }

    .forumRowTitle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 16px;
      font-weight: 900;
      color: #f9fafb;
      text-decoration: none;
    }

    .forumRowTitle:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .forumRowDesc {
      margin-top: 4px;
      font-size: 13px;
      color: rgba(229,231,235,0.66);
      line-height: 1.35;
    }

    .forumRowMeta {
      margin-top: 5px;
      font-size: 12px;
      color: rgba(229,231,235,0.48);
    }

    .forumStatCell {
      width: 88px;
      text-align: center;
      color: rgba(229,231,235,0.70);
      white-space: nowrap;
    }

    .forumStatNum {
      display: block;
      color: #f9fafb;
      font-size: 17px;
      font-weight: 950;
      line-height: 1.1;
    }

    .forumLatestCell {
      width: 245px;
      min-width: 210px;
      font-size: 13px;
      color: rgba(229,231,235,0.72);
      line-height: 1.35;
    }

    .forumLatestTitle {
      color: #f9fafb;
      font-weight: 800;
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 230px;
    }

    .forumLatestBy {
      color: rgba(229,231,235,0.52);
      font-size: 12px;
    }

    .forumBadge {
      display: inline-flex;
      align-items: center;
      height: 20px;
      padding: 0 7px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 950;
      letter-spacing: .02em;
      text-transform: uppercase;
      color: #fff;
      background: color-mix(in srgb, var(--accent) 38%, #222 62%);
      border: 1px solid color-mix(in srgb, var(--accent) 48%, rgba(255,255,255,0.15));
    }

    .forumEmpty {
      padding: 34px 16px;
      text-align: center;
      color: rgba(229,231,235,0.62);
      font-size: 14px;
    }

    .forumBtn,
    .forumBtn:visited {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 34px;
      padding: 0 12px;
      border-radius: 6px;
      border: 1px solid color-mix(in srgb, var(--accent) 42%, rgba(255,255,255,0.16));
      background: color-mix(in srgb, var(--accent) 28%, #111 72%);
      color: #fff;
      font-size: 13px;
      font-weight: 900;
      text-decoration: none;
      cursor: pointer;
    }

    .forumBtn:hover {
      filter: brightness(1.12);
      text-decoration: none;
    }

    .forumBtnSecondary {
      background: #111;
      border-color: rgba(255,255,255,0.16);
    }

    .forumBtnDanger {
      color: #fecaca;
      background: rgba(127, 29, 29, 0.42);
      border-color: rgba(248, 113, 113, 0.35);
    }

    .forumForm {
      display: grid;
      gap: 11px;
    }

    .forumLabel {
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: rgba(229,231,235,0.62);
    }

    .forumInput,
    .forumTextarea {
      width: 100%;
      box-sizing: border-box;
      background: #050505;
      color: #f9fafb;
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 5px;
      padding: 11px 12px;
      outline: none;
      font: inherit;
    }

    .forumTextarea {
      min-height: 150px;
      resize: vertical;
      line-height: 1.5;
    }

    .forumInput:focus,
    .forumTextarea:focus {
      border-color: color-mix(in srgb, var(--accent) 62%, rgba(255,255,255,0.20));
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    }

    .forumFormGrid {
      display: grid;
      grid-template-columns: 1fr 120px;
      gap: 11px;
    }

    .topicLayout {
      display: grid;
      gap: 9px;
    }

    .forumPost {
      display: grid;
      grid-template-columns: 150px 1fr;
      border: 1px solid rgba(255,255,255,0.12);
      background: #070707;
      align-items: start;
    }

    .postSidebar {
      padding: 10px;
      background: #0d0d0d;
      border-right: 1px solid rgba(255,255,255,0.10);
      min-height: 0;
    }

    .postAvatar {
      width: 44px;
      height: 44px;
      border-radius: 8px;
      display: grid;
      place-items: center;
      overflow: hidden;
      background: color-mix(in srgb, var(--accent) 16%, #1a1a1a 84%);
      border: 1px solid rgba(255,255,255,0.12);
      color: #fff;
      font-size: 18px;
      font-weight: 950;
      margin-bottom: 7px;
    }

    .postAvatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .postUsername {
      display: block;
      font-weight: 950;
      color: #fff;
      text-decoration: none;
      word-break: break-word;
    }

    .postUsername:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .postRole {
      display: inline-flex;
      margin-top: 6px;
      padding: 2px 7px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 950;
      background: color-mix(in srgb, var(--accent) 20%, #171717 80%);
      border: 1px solid color-mix(in srgb, var(--accent) 32%, rgba(255,255,255,0.12));
    }

    .postDate {
      margin-top: 7px;
      color: rgba(229,231,235,0.52);
      font-size: 12px;
      line-height: 1.35;
    }

    .postMain {
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .postTopline {
      min-height: 28px;
      padding: 6px 10px;
      background: #101010;
      border-bottom: 1px solid rgba(255,255,255,0.09);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      color: rgba(229,231,235,0.62);
      font-size: 12px;
    }

    .postContent {
      padding: 10px;
      white-space: pre-wrap;
      line-height: 1.45;
      color: #e5e7eb;
      flex: 0 0 auto;
      min-height: 0;
    }

    .replyNotice {
      margin-bottom: 9px;
      padding: 7px 9px;
      border-left: 3px solid var(--accent);
      background: rgba(255,255,255,0.045);
      color: rgba(229,231,235,0.72);
      font-size: 13px;
      white-space: normal;
    }

    .postFooter {
      padding: 7px 10px;
      border-top: 1px solid rgba(255,255,255,0.08);
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .modBox {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .modChecks {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      color: rgba(229,231,235,0.78);
      font-size: 14px;
    }

    .replyingToBox {
      display: none;
      align-items: center;
      gap: 8px;
      padding: 7px 9px;
      background: rgba(255,255,255,0.045);
      border: 1px solid rgba(255,255,255,0.10);
      color: rgba(229,231,235,0.76);
      font-size: 13px;
    }

    @media (max-width: 820px) {
      .forumHeader {
        align-items: flex-start;
        flex-direction: column;
      }

      .forumTable,
      .forumTable thead,
      .forumTable tbody,
      .forumTable tr,
      .forumTable th,
      .forumTable td {
        display: block;
      }

      .forumTable thead {
        display: none;
      }

      .forumTable tr {
        border-bottom: 1px solid rgba(255,255,255,0.10);
        padding: 12px;
      }

      .forumTable tr:last-child {
        border-bottom: none;
      }

      .forumTable td {
        border: none;
        padding: 5px 0;
      }

      .forumIconCell {
        float: left;
        margin-right: 10px;
        width: auto;
      }

      .forumStatCell {
        display: inline-block;
        width: auto;
        margin-right: 16px;
        text-align: left;
      }

      .forumLatestCell {
        width: auto;
        min-width: 0;
        clear: both;
        padding-top: 10px !important;
      }

      .forumPost {
        grid-template-columns: 1fr;
      }

      .postSidebar {
        border-right: none;
        border-bottom: 1px solid rgba(255,255,255,0.10);
        display: grid;
        grid-template-columns: 44px 1fr;
        gap: 10px;
        align-items: center;
      }

      .postAvatar {
        margin-bottom: 0;
      }

      .forumFormGrid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<%
  const meUser = typeof me !== "undefined" ? me : null;
  const isAdmin = meUser && Number(meUser.is_admin || 0) === 1;

  function fmtTs(ts) {
    if (!ts) return "";
    const n = Number(ts);
    const d = Number.isFinite(n)
      ? new Date(n * 1000)
      : new Date(ts);
    if (Number.isNaN(d.getTime())) return "";
    return d.toLocaleString();
  }

  function initials(name) {
    return String(name || "?").trim().slice(0, 1).toUpperCase();
  }
%>

<body class="app" style="--accent:<%= accent_color || '#3252b3' %>;">
  <header class="topbar">
    <div class="wrap row between">
      <div class="row" style="gap:10px;">
        <a class="brand" href="/shows" style="display:flex;align-items:center;">
          <img src="/static/pressboxd-wordmark.png" alt="Pressboxd" style="height:68px;width:auto;display:block;">
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <a href="/predictions">Predictions</a>
        <a href="/forums">Forums</a>

        <% if (isAdmin) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (meUser) { %>
          <a href="/me">@<%= meUser.username %></a>
          <form method="post" action="/logout" style="display:inline;">
            <button class="btn" type="submit">Logout</button>
          </form>
        <% } else { %>
          <a href="/login">Login</a>
          <a href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="forumShell">
    <% if (Array.isArray(flashes) && flashes.length) { %>
      <% for (const f of flashes) { %>
        <div class="flash <%= f.category %>"><%= f.message %></div>
      <% } %>
    <% } %>

    <% if (mode === 'index') { %>
      <section class="forumHeader">
        <div>
          <div class="forumEyebrow">Community</div>
          <h1 class="forumPageTitle">Forums</h1>
          <div class="forumPageSub">
            Talk about shows, corps, predictions, captions, rankings, design, music, guard, percussion, brass, and drum corps history.
          </div>
        </div>
      </section>

      <% if (isAdmin) { %>
        <section class="forumPanel">
          <div class="forumPanelHeader">
            <h2 class="forumPanelTitle">Admin: Create Forum Category</h2>
          </div>

          <div class="forumPanelBody">
            <form class="forumForm" method="post" action="/forums/categories">
              <div>
                <label class="forumLabel">Category Title</label>
                <input class="forumInput" name="title" maxlength="80" required placeholder="General Discussion">
              </div>

              <div>
                <label class="forumLabel">Description</label>
                <textarea class="forumTextarea" name="description" maxlength="500" placeholder="What this category is for..." style="min-height:90px;"></textarea>
              </div>

              <div class="forumFormGrid">
                <div>
                  <label class="forumLabel">Sort Order</label>
                  <input class="forumInput" name="sort_order" type="number" value="0">
                </div>

                <div style="display:flex;align-items:end;">
                  <button class="forumBtn" type="submit" style="width:100%;">Create</button>
                </div>
              </div>
            </form>
          </div>
        </section>
      <% } %>

      <section class="forumPanel">
        <div class="forumPanelHeader">
          <h2 class="forumPanelTitle">Forum Categories</h2>
        </div>

        <% if (!categories || !categories.length) { %>
          <div class="forumEmpty">
            No forum categories yet.
            <% if (isAdmin) { %>
              Create one above.
            <% } %>
          </div>
        <% } else { %>
          <table class="forumTable">
            <thead>
              <tr>
                <th colspan="2">Forum</th>
                <th>Topics</th>
                <th>Posts</th>
                <th>Latest</th>
              </tr>
            </thead>

            <tbody>
              <% for (const c of categories) { %>
                <tr>
                  <td class="forumIconCell">
                    <div class="forumIcon">#</div>
                  </td>

                  <td class="forumMainCell">
                    <a class="forumRowTitle" href="/forums/category/<%= c.id %>">
                      <%= c.title %>
                    </a>

                    <% if (c.description) { %>
                      <div class="forumRowDesc"><%= c.description %></div>
                    <% } %>
                  </td>

                  <td class="forumStatCell">
                    <span class="forumStatNum"><%= c.topic_count || 0 %></span>
                    topics
                  </td>

                  <td class="forumStatCell">
                    <span class="forumStatNum"><%= c.post_count || 0 %></span>
                    posts
                  </td>

                  <td class="forumLatestCell">
                    <% if (c.latest_topic_id) { %>
                      <span class="forumLatestTitle"><%= c.latest_topic_title %></span>
                      <span class="forumLatestBy">by <%= c.latest_username || 'Unknown' %></span>
                    <% } else { %>
                      <span class="forumLatestBy">No posts yet</span>
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        <% } %>
      </section>
    <% } %>

    <% if (mode === 'category') { %>
      <div class="forumBreadcrumbs">
        <a href="/forums">Forums</a>
        <span>/</span>
        <span><%= category.title %></span>
      </div>

      <section class="forumHeader">
        <div>
          <div class="forumEyebrow">Forum Category</div>
          <h1 class="forumPageTitle"><%= category.title %></h1>
          <% if (category.description) { %>
            <div class="forumPageSub"><%= category.description %></div>
          <% } %>
        </div>

        <% if (meUser && Number(category.is_locked || 0) !== 1) { %>
          <a class="forumBtn" href="/forums/category/<%= category.id %>/new">New Topic</a>
        <% } else if (!meUser) { %>
          <a class="forumBtn" href="/login?next=/forums/category/<%= category.id %>/new">Login to Post</a>
        <% } %>
      </section>

      <section class="forumPanel">
        <div class="forumPanelHeader">
          <h2 class="forumPanelTitle">Topics</h2>
        </div>

        <% if (!topics || !topics.length) { %>
          <div class="forumEmpty">No topics in this category yet.</div>
        <% } else { %>
          <table class="forumTable">
            <thead>
              <tr>
                <th colspan="2">Topic</th>
                <th>Replies</th>
                <th>Views</th>
                <th>Latest</th>
              </tr>
            </thead>

            <tbody>
              <% for (const t of topics) { %>
                <tr>
                  <td class="forumIconCell">
                    <div class="forumIcon"><%= Number(t.is_locked || 0) === 1 ? 'L' : 'T' %></div>
                  </td>

                  <td class="forumMainCell">
                    <a class="forumRowTitle" href="/forums/topic/<%= t.id %>">
                      <% if (Number(t.is_pinned || 0) === 1) { %>
                        <span class="forumBadge">Pinned</span>
                      <% } %>

                      <% if (Number(t.is_locked || 0) === 1) { %>
                        <span class="forumBadge">Locked</span>
                      <% } %>

                      <%= t.title %>
                    </a>

                    <div class="forumRowMeta">
                      Started by <strong><%= t.username %></strong> · <%= fmtTs(t.created_ts) %>
                    </div>
                  </td>

                  <td class="forumStatCell">
                    <span class="forumStatNum"><%= t.reply_count || 0 %></span>
                    replies
                  </td>

                  <td class="forumStatCell">
                    <span class="forumStatNum"><%= t.views || 0 %></span>
                    views
                  </td>

                  <td class="forumLatestCell">
                    <span class="forumLatestTitle"><%= t.title %></span>
                    <span class="forumLatestBy">by <%= t.last_username || t.username %></span>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        <% } %>
      </section>
    <% } %>

    <% if (mode === 'new_topic') { %>
      <div class="forumBreadcrumbs">
        <a href="/forums">Forums</a>
        <span>/</span>
        <a href="/forums/category/<%= category.id %>"><%= category.title %></a>
        <span>/</span>
        <span>New Topic</span>
      </div>

      <section class="forumHeader">
        <div>
          <div class="forumEyebrow">New Topic</div>
          <h1 class="forumPageTitle">Create Topic</h1>
          <div class="forumPageSub">Posting in <strong><%= category.title %></strong></div>
        </div>
      </section>

      <section class="forumPanel">
        <div class="forumPanelHeader">
          <h2 class="forumPanelTitle">Topic Details</h2>
        </div>

        <div class="forumPanelBody">
          <form class="forumForm" method="post" action="/forums/category/<%= category.id %>/new">
            <div>
              <label class="forumLabel">Topic Title</label>
              <input class="forumInput" name="title" maxlength="120" required placeholder="Topic title">
            </div>

            <div>
              <label class="forumLabel">Message</label>
              <textarea class="forumTextarea" name="body" maxlength="8000" required placeholder="Write your post..."></textarea>
            </div>

            <div>
              <button class="forumBtn" type="submit">Create Topic</button>
              <a class="forumBtn forumBtnSecondary" href="/forums/category/<%= category.id %>">Cancel</a>
            </div>
          </form>
        </div>
      </section>
    <% } %>

    <% if (mode === 'topic') { %>
      <div class="forumBreadcrumbs">
        <a href="/forums">Forums</a>
        <span>/</span>
        <a href="/forums/category/<%= topic.category_id %>"><%= topic.category_title %></a>
        <span>/</span>
        <span><%= topic.title %></span>
      </div>

      <section class="forumHeader">
        <div>
          <div class="forumEyebrow">Topic</div>
          <h1 class="forumPageTitle"><%= topic.title %></h1>
          <div class="forumPageSub">
            Started by <strong><%= topic.username %></strong>
            · <%= fmtTs(topic.created_ts) %>
            · <%= topic.views || 0 %> views

            <% if (Number(topic.is_pinned || 0) === 1) { %>
              · Pinned
            <% } %>

            <% if (Number(topic.is_locked || 0) === 1) { %>
              · Locked
            <% } %>
          </div>
        </div>
      </section>

      <% if (isAdmin) { %>
        <section class="forumPanel">
          <div class="forumPanelHeader">
            <h2 class="forumPanelTitle">Moderator Tools</h2>
          </div>

          <div class="forumPanelBody">
            <div class="modBox">
              <form class="modChecks" method="post" action="/forums/topic/<%= topic.id %>/mod">
                <label>
                  <input type="checkbox" name="is_pinned" value="1" <%= Number(topic.is_pinned || 0) === 1 ? 'checked' : '' %>>
                  Pinned
                </label>

                <label>
                  <input type="checkbox" name="is_locked" value="1" <%= Number(topic.is_locked || 0) === 1 ? 'checked' : '' %>>
                  Locked
                </label>

                <button class="forumBtn" type="submit">Save</button>
              </form>

              <form method="post" action="/forums/topic/<%= topic.id %>/delete" onsubmit="return confirm('Delete this entire topic?');">
                <button class="forumBtn forumBtnDanger" type="submit">Delete Topic</button>
              </form>
            </div>
          </div>
        </section>
      <% } %>

      <section class="topicLayout">
        <% for (const p of posts) { %>
          <article class="forumPost" id="post-<%= p.id %>">
            <aside class="postSidebar">
              <div class="postAvatar">
                <% if (p.avatar_url) { %>
                  <img src="<%= p.avatar_url %>" alt="">
                <% } else { %>
                  <%= initials(p.username) %>
                <% } %>
              </div>

              <div>
                <a class="postUsername" href="/u/<%= encodeURIComponent(p.username) %>">
                  <%= p.username %>
                </a>

                <% if (Number(p.is_admin || 0) === 1) { %>
                  <div class="postRole">Admin</div>
                <% } %>

                <div class="postDate">
                  <%= fmtTs(p.created_ts) %>
                </div>
              </div>
            </aside>

            <div class="postMain">
              <div class="postTopline">
                <span>Post #<%= p.id %></span>

                <% if (Number(p.is_deleted || 0) !== 1) { %>
                  <a href="#post-<%= p.id %>" style="color:rgba(229,231,235,0.62);text-decoration:none;">Link</a>
                <% } %>
              </div>

              <div class="postContent">
                <% if (p.reply_to_username) { %>
                  <div class="replyNotice">
                    Replying to @<%= p.reply_to_username %>
                  </div>
                <% } %>

                <%= p.body %>
              </div>

              <div class="postFooter">
                <% if (meUser && Number(topic.is_locked || 0) !== 1 && Number(topic.category_locked || 0) !== 1 && Number(p.is_deleted || 0) !== 1) { %>
                  <button
                    class="forumBtn forumBtnSecondary directReplyBtn"
                    type="button"
                    data-post-id="<%= p.id %>"
                    data-username="<%= p.username %>"
                  >
                    Reply to @<%= p.username %>
                  </button>
                <% } %>

                <% if (isAdmin && Number(p.is_deleted || 0) !== 1) { %>
                  <form method="post" action="/forums/post/<%= p.id %>/delete" onsubmit="return confirm('Delete this post?');">
                    <input type="hidden" name="topic_id" value="<%= topic.id %>">
                    <button class="forumBtn forumBtnDanger" type="submit">Delete Post</button>
                  </form>
                <% } %>
              </div>
            </div>
          </article>
        <% } %>
      </section>

      <% if (meUser && Number(topic.is_locked || 0) !== 1 && Number(topic.category_locked || 0) !== 1) { %>
        <section class="forumPanel" style="margin-top:18px;">
          <div class="forumPanelHeader">
            <h2 class="forumPanelTitle">Post Reply</h2>
          </div>

          <div class="forumPanelBody">
            <form class="forumForm" method="post" action="/forums/topic/<%= topic.id %>/reply">
              <input type="hidden" name="reply_to_post_id" id="replyToPostId" value="">

              <div id="replyingToBox" class="replyingToBox">
                Replying to <strong id="replyingToName"></strong>
                <button class="forumBtn forumBtnSecondary" type="button" id="cancelDirectReply">Cancel</button>
              </div>

              <textarea
                class="forumTextarea"
                name="body"
                id="replyTextarea"
                maxlength="8000"
                required
                placeholder="Write a reply..."
              ></textarea>

              <div>
                <button class="forumBtn" type="submit">Post Reply</button>
              </div>
            </form>
          </div>
        </section>
      <% } else if (!meUser) { %>
        <section class="forumPanel" style="margin-top:18px;">
          <div class="forumPanelBody">
            <a class="forumBtn" href="/login?next=/forums/topic/<%= topic.id %>">Login to reply</a>
          </div>
        </section>
      <% } else { %>
        <section class="forumPanel" style="margin-top:18px;">
          <div class="forumPanelBody">
            This topic is locked.
          </div>
        </section>
      <% } %>
    <% } %>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const replyToPostId = document.getElementById('replyToPostId');
      const replyingToBox = document.getElementById('replyingToBox');
      const replyingToName = document.getElementById('replyingToName');
      const cancelBtn = document.getElementById('cancelDirectReply');
      const textarea = document.getElementById('replyTextarea');

      document.querySelectorAll('.directReplyBtn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const postId = btn.dataset.postId || '';
          const username = btn.dataset.username || '';

          if (replyToPostId) replyToPostId.value = postId;
          if (replyingToName) replyingToName.textContent = '@' + username;
          if (replyingToBox) replyingToBox.style.display = 'flex';

          if (textarea) {
            textarea.focus();
            textarea.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });

      if (cancelBtn) {
        cancelBtn.addEventListener('click', () => {
          if (replyToPostId) replyToPostId.value = '';
          if (replyingToName) replyingToName.textContent = '';
          if (replyingToBox) replyingToBox.style.display = 'none';
          if (textarea) textarea.focus();
        });
      }
    });
  </script>
</body>
</html>
