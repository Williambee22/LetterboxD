<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>

  <title>Forums — Pressboxd</title>
  <meta name="description" content="Pressboxd forums for drum corps discussion.">

  <link rel="stylesheet" href="/static/styles.css"/>
  <link rel="icon" type="image/png" href="/static/favicon.png"/>

  <style>
    html,
    body,
    body.app {
      background: #000 !important;
      background-image: none !important;
      color: #e5e7eb;
    }

    a {
      color: inherit;
    }

    .forumPage {
      width: min(1120px, calc(100% - 28px));
      margin: 0 auto;
      padding: 22px 0 70px;
    }

    .forumTop {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
      margin-bottom: 18px;
    }

    .forumTitle {
      margin: 0;
      font-size: 30px;
      line-height: 1.05;
      font-weight: 950;
      letter-spacing: -0.03em;
      color: #fff;
    }

    .forumSubtitle {
      margin-top: 6px;
      color: rgba(229,231,235,0.68);
      font-size: 14px;
    }

    .forumCrumbs {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: 16px;
      font-size: 13px;
      color: rgba(229,231,235,0.6);
    }

    .forumCrumbs a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 800;
    }

    .forumCrumbs a:hover {
      text-decoration: underline;
    }

    .forumBox {
      background: #080808;
      border: 1px solid rgba(255,255,255,0.12);
      margin-bottom: 16px;
    }

    .forumBoxHead {
      padding: 10px 12px;
      background: #111;
      border-bottom: 1px solid rgba(255,255,255,0.10);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .forumBoxTitle {
      margin: 0;
      color: #fff;
      font-size: 13px;
      font-weight: 950;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .forumBoxBody {
      padding: 12px;
    }

    .forumBtn {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 34px;
      padding: 0 12px;
      border-radius: 6px;
      border: 1px solid color-mix(in srgb, var(--accent) 38%, rgba(255,255,255,0.14));
      background: color-mix(in srgb, var(--accent) 24%, #111 76%);
      color: #fff;
      font-size: 13px;
      font-weight: 900;
      text-decoration: none;
      cursor: pointer;
    }

    .forumBtn:hover {
      filter: brightness(1.12);
      text-decoration: none;
    }

    .forumBtn.secondary {
      background: #111;
      border-color: rgba(255,255,255,0.15);
    }

    .forumBtn.danger {
      background: rgba(127,29,29,.42);
      border-color: rgba(248,113,113,.35);
      color: #fecaca;
    }

    .forumList {
      display: flex;
      flex-direction: column;
    }

    .forumRow {
      display: grid;
      grid-template-columns: 42px minmax(0, 1fr) 90px 90px 230px;
      gap: 12px;
      align-items: center;
      padding: 12px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .forumRow:last-child {
      border-bottom: none;
    }

    .forumRow:hover {
      background: rgba(255,255,255,0.035);
    }

    .forumIcon {
      width: 32px;
      height: 32px;
      border-radius: 7px;
      display: grid;
      place-items: center;
      background: color-mix(in srgb, var(--accent) 18%, #181818 82%);
      border: 1px solid color-mix(in srgb, var(--accent) 30%, rgba(255,255,255,0.12));
      color: #fff;
      font-weight: 950;
      font-size: 13px;
    }

    .forumRowMain {
      min-width: 0;
    }

    .forumRowTitle {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: #fff;
      font-size: 15px;
      font-weight: 950;
      text-decoration: none;
      line-height: 1.25;
    }

    .forumRowTitle:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .forumRowDesc {
      margin-top: 3px;
      color: rgba(229,231,235,0.62);
      font-size: 13px;
      line-height: 1.35;
    }

    .forumMeta {
      margin-top: 4px;
      color: rgba(229,231,235,0.46);
      font-size: 12px;
    }

    .forumStat {
      text-align: center;
      color: rgba(229,231,235,0.60);
      font-size: 12px;
    }

    .forumStat strong {
      display: block;
      color: #fff;
      font-size: 16px;
      line-height: 1.1;
    }

    .forumLatest {
      min-width: 0;
      color: rgba(229,231,235,0.64);
      font-size: 12px;
      line-height: 1.35;
    }

    .forumLatest a,
    .forumLatest strong {
      display: block;
      color: #fff;
      font-weight: 850;
      text-decoration: none;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .forumLatest a:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .forumBadge {
      display: inline-flex;
      align-items: center;
      height: 19px;
      padding: 0 6px;
      border-radius: 4px;
      background: color-mix(in srgb, var(--accent) 30%, #222 70%);
      border: 1px solid color-mix(in srgb, var(--accent) 42%, rgba(255,255,255,0.14));
      color: #fff;
      font-size: 10px;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .forumEmpty {
      padding: 28px 12px;
      text-align: center;
      color: rgba(229,231,235,0.58);
      font-size: 14px;
    }

    .forumForm {
      display: grid;
      gap: 10px;
    }

    .forumLabel {
      display: block;
      margin-bottom: 5px;
      color: rgba(229,231,235,0.64);
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .forumInput,
    .forumTextarea {
      width: 100%;
      box-sizing: border-box;
      background: #050505;
      border: 1px solid rgba(255,255,255,0.14);
      color: #fff;
      border-radius: 6px;
      padding: 10px 11px;
      outline: none;
      font: inherit;
    }

    .forumTextarea {
      min-height: 115px;
      resize: vertical;
      line-height: 1.45;
    }

    .forumInput:focus,
    .forumTextarea:focus {
      border-color: color-mix(in srgb, var(--accent) 54%, rgba(255,255,255,0.18));
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent);
    }

    .forumFormGrid {
      display: grid;
      grid-template-columns: 1fr 130px;
      gap: 10px;
      align-items: end;
    }

    .threadList {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .threadPost {
      background: #080808;
      border: 1px solid rgba(255,255,255,0.12);
    }

    .threadPostHead {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 8px 10px;
      background: #111;
      border-bottom: 1px solid rgba(255,255,255,0.09);
    }

    .threadUser {
      display: flex;
      align-items: center;
      gap: 9px;
      min-width: 0;
    }

    .threadAvatar {
      width: 32px;
      height: 32px;
      border-radius: 7px;
      display: grid;
      place-items: center;
      overflow: hidden;
      background: color-mix(in srgb, var(--accent) 18%, #181818 82%);
      border: 1px solid rgba(255,255,255,0.13);
      color: #fff;
      font-size: 14px;
      font-weight: 950;
      flex: 0 0 auto;
    }

    .threadAvatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .threadName {
      color: #fff;
      font-size: 14px;
      font-weight: 950;
      text-decoration: none;
      line-height: 1.2;
    }

    .threadName:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .threadInfo {
      color: rgba(229,231,235,0.50);
      font-size: 12px;
      line-height: 1.25;
    }

    .threadRight {
      display: flex;
      align-items: center;
      gap: 9px;
      color: rgba(229,231,235,0.54);
      font-size: 12px;
      white-space: nowrap;
    }

    .threadRight a {
      color: rgba(229,231,235,0.62);
      text-decoration: none;
    }

    .threadRight a:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .threadBody {
      padding: 10px;
      color: #e5e7eb;
      font-size: 14px;
      min-height: 28px;
    }
    
    .threadBodyText {
      line-height: 1.45;
    }

    .threadReplyNotice {
      margin: 0 0 7px;
      padding: 6px 8px;
      border-left: 3px solid var(--accent);
      background: rgba(255,255,255,0.045);
      color: rgba(229,231,235,0.70);
      font-size: 12px;
      line-height: 1.3;
      white-space: normal;
    }

    .threadActions {
      padding: 7px 10px;
      background: #0b0b0b;
      border-top: 1px solid rgba(255,255,255,0.08);
      display: flex;
      justify-content: flex-end;
      gap: 7px;
      flex-wrap: wrap;
    }

    .threadActions .forumBtn {
      min-height: 28px;
      padding: 0 9px;
      font-size: 12px;
    }

    .replyingToBox {
      display: none;
      align-items: center;
      gap: 8px;
      padding: 7px 9px;
      background: rgba(255,255,255,0.045);
      border: 1px solid rgba(255,255,255,0.10);
      color: rgba(229,231,235,0.74);
      font-size: 13px;
    }

    .modTools {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .reactionBar {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 10px;
    }
    
    .reactionForm {
      display: inline-flex;
      margin: 0;
    }
    
    .reactionBtn,
    .reactionToggleBtn {
      appearance: none;
      min-height: 26px;
      padding: 0 8px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.045);
      color: #fff;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    
    .reactionBtn:hover,
    .reactionToggleBtn:hover {
      background: rgba(255,255,255,0.08);
      border-color: color-mix(in srgb, var(--accent) 36%, rgba(255,255,255,0.14));
    }
    
    .reactionBtn.active {
      background: color-mix(in srgb, var(--accent) 26%, rgba(255,255,255,0.06));
      border-color: color-mix(in srgb, var(--accent) 52%, rgba(255,255,255,0.18));
    }
    
    .reactionCount {
      color: rgba(255,255,255,0.72);
      font-size: 12px;
    }
    
    .reactionPicker {
      display: none;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    
    .reactionPicker.open {
      display: flex;
    }
    
    .reactionLoginHint {
      color: rgba(229,231,235,0.48);
      font-size: 12px;
    }



    .modChecks {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      color: rgba(229,231,235,0.75);
      font-size: 13px;
    }

    @media (max-width: 850px) {
      .forumTop {
        align-items: flex-start;
        flex-direction: column;
      }

      .forumRow {
        grid-template-columns: 34px minmax(0, 1fr);
      }

      .forumStat,
      .forumLatest {
        grid-column: 2;
        text-align: left;
      }

      .forumStat {
        display: inline-block;
        margin-right: 14px;
      }

      .forumStat strong {
        display: inline;
        margin-right: 4px;
      }

      .forumFormGrid {
        grid-template-columns: 1fr;
      }

      .threadPostHead {
        align-items: flex-start;
        flex-direction: column;
        gap: 6px;
      }

      .threadRight {
        white-space: normal;
      }
    }
  </style>
</head>

<%
  const meUser = typeof me !== "undefined" ? me : null;
  const isAdmin = meUser && Number(meUser.is_admin || 0) === 1;

  function fmtTs(ts) {
    if (!ts) return "";
    const n = Number(ts);
    const d = Number.isFinite(n) ? new Date(n * 1000) : new Date(ts);
    if (Number.isNaN(d.getTime())) return "";
    return d.toLocaleString();
  }

  function initials(name) {
    return String(name || "?").trim().slice(0, 1).toUpperCase();
  }

  function cleanReplyBody(body, replyUser) {
    let visibleBody = String(body || "");
    if (replyUser) {
      const mentionPrefix = "@" + replyUser + " ";
      if (visibleBody.startsWith(mentionPrefix)) {
        visibleBody = visibleBody.slice(mentionPrefix.length);
      }
    }
    return visibleBody;
  }
%>

<body class="app" style="--accent:<%= accent_color || '#3252b3' %>;">
  <header class="topbar">
    <div class="wrap row between">
      <div style="display:flex; align-items:center; gap:10px;">
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" style="display:flex; align-items:center;">
          <img
            src="/static/logo.png"
            alt="Logo"
            style="width:36px; height:36px; object-fit:contain; transition: transform 0.6s ease-in-out;"
            onmouseover="this.style.transform='rotate(360deg)'"
            onmouseout="this.style.transform='rotate(0deg)'"
          >
        </a>

        <a class="brand" href="/shows" style="display:flex; align-items:center;">
          <img
            src="/static/pressboxd-wordmark.png"
            alt="Pressboxd"
            style="height:68px; width:auto; display:block;"
          >
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <a href="/predictions">Predictions</a>
        <a href="/forums">Forums</a>

        <% if (isAdmin) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
          <a href="/admin/stats">Stats</a>
          <a href="/admin/predictions">Predictions Admin</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (meUser) { %>
          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (meUser.avatar_url) { %>
                <img src="<%= meUser.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= meUser.username || "me" %></span>
          </a>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="forumPage">
    <% if (Array.isArray(flashes) && flashes.length) { %>
      <% for (const f of flashes) { %>
        <div class="flash <%= f.category %>"><%= f.message %></div>
      <% } %>
    <% } %>

    <% if (mode === "index") { %>
      <section class="forumTop">
        <div>
          <h1 class="forumTitle">Forums</h1>
          <div class="forumSubtitle">
            Drum corps discussion, rankings, predictions, captions, design, music, guard, percussion, brass, and history.
          </div>
        </div>
      </section>

      <% if (isAdmin) { %>
        <section class="forumBox">
          <div class="forumBoxHead">
            <h2 class="forumBoxTitle">Create Forum Category</h2>
          </div>

          <div class="forumBoxBody">
            <form class="forumForm" method="post" action="/forums/categories">
              <div>
                <label class="forumLabel">Category title</label>
                <input class="forumInput" name="title" maxlength="80" required placeholder="General Discussion">
              </div>

              <div>
                <label class="forumLabel">Description</label>
                <textarea class="forumTextarea" name="description" maxlength="500" style="min-height:80px;" placeholder="What this category is for..."></textarea>
              </div>

              <div class="forumFormGrid">
                <div>
                  <label class="forumLabel">Sort order</label>
                  <input class="forumInput" name="sort_order" type="number" value="0">
                </div>

                <button class="forumBtn" type="submit">Create</button>
              </div>
            </form>
          </div>
        </section>
      <% } %>

      <section class="forumBox">
        <div class="forumBoxHead">
          <h2 class="forumBoxTitle">Categories</h2>
        </div>

        <% if (!categories || !categories.length) { %>
          <div class="forumEmpty">No forum categories yet.</div>
        <% } else { %>
          <div class="forumList">
            <% for (const c of categories) { %>
              <div class="forumRow">
                <div class="forumIcon">#</div>

                <div class="forumRowMain">
                  <a class="forumRowTitle" href="/forums/category/<%= c.id %>">
                    <%= c.title %>
                  </a>

                  <% if (c.description) { %>
                    <div class="forumRowDesc"><%= c.description %></div>
                  <% } %>
                </div>

                <div class="forumStat">
                  <strong><%= c.topic_count || 0 %></strong>
                  topics
                </div>

                <div class="forumStat">
                  <strong><%= c.post_count || 0 %></strong>
                  posts
                </div>

                <div class="forumLatest">
                  <% if (c.latest_topic_id) { %>
                    <a href="/forums/topic/<%= c.latest_topic_id %>"><%= c.latest_topic_title %></a>
                    <span>by <%= c.latest_username || "Unknown" %></span>
                  <% } else { %>
                    <span>No posts yet</span>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </section>
    <% } %>

    <% if (mode === "category") { %>
      <div class="forumCrumbs">
        <a href="/forums">Forums</a>
        <span>/</span>
        <span><%= category.title %></span>
      </div>

      <section class="forumTop">
    
        <div>
          <h1 class="forumTitle"><%= category.title %></h1>
          <% if (category.description) { %>
            <div class="forumSubtitle"><%= category.description %></div>
          <% } %>
        </div>

       <% if (meUser && Number(category.is_locked || 0) !== 1) { %>
        <a class="forumBtn" href="/forums/category/<%= category.id %>/new">New Topic</a>
      <% } else if (!meUser) { %>
        <a class="forumBtn" href="/login?next=/forums/category/<%= category.id %>/new">Login to Post</a>
      <% } %>
      </section>

      <% if (isAdmin) { %>
        <section class="forumBox">
          <div class="forumBoxHead">
            <h2 class="forumBoxTitle">Edit Category</h2>
          </div>
      
          <div class="forumBoxBody">
            <form class="forumForm" method="post" action="/forums/category/<%= category.id %>/edit">
              <div>
                <label class="forumLabel">Category title</label>
                <input
                  class="forumInput"
                  name="title"
                  maxlength="80"
                  required
                  value="<%= category.title || '' %>"
                >
              </div>
      
              <div>
                <label class="forumLabel">Description</label>
                <textarea
                  class="forumTextarea"
                  name="description"
                  maxlength="500"
                  style="min-height:80px;"
                ><%= category.description || '' %></textarea>
              </div>
      
              <div class="forumFormGrid">
                <div>
                  <label class="forumLabel">Sort order</label>
                  <input
                    class="forumInput"
                    name="sort_order"
                    type="number"
                    value="<%= category.sort_order || 0 %>"
                  >
                </div>
      
                <label style="display:flex; align-items:center; gap:8px; color:rgba(229,231,235,0.75); font-size:13px;">
                  <input
                    type="checkbox"
                    name="is_locked"
                    value="1"
                    <%= Number(category.is_locked || 0) === 1 ? 'checked' : '' %>
                  >
                  Locked
                </label>
              </div>
      
              <div>
                <button class="forumBtn" type="submit">Save Category</button>
              </div>
            </form>
          </div>
        </section>
      <% } %>

      <section class="forumBox">
        <div class="forumBoxHead">
          <h2 class="forumBoxTitle">Topics</h2>
        </div>

        <% if (!topics || !topics.length) { %>
          <div class="forumEmpty">No topics yet.</div>
        <% } else { %>
          <div class="forumList">
            <% for (const t of topics) { %>
              <div class="forumRow">
                <div class="forumIcon"><%= Number(t.is_locked || 0) === 1 ? "L" : "T" %></div>

                <div class="forumRowMain">
                  <a class="forumRowTitle" href="/forums/topic/<%= t.id %>">
                    <% if (Number(t.is_pinned || 0) === 1) { %>
                      <span class="forumBadge">Pinned</span>
                    <% } %>
                    <% if (Number(t.is_locked || 0) === 1) { %>
                      <span class="forumBadge">Locked</span>
                    <% } %>
                    <%= t.title %>
                  </a>

                  <div class="forumMeta">
                    Started by <strong><%= t.username %></strong> · <%= fmtTs(t.created_ts) %>
                  </div>
                </div>

                <div class="forumStat">
                  <strong><%= t.reply_count || 0 %></strong>
                  replies
                </div>

                <div class="forumStat">
                  <strong><%= t.views || 0 %></strong>
                  views
                </div>

                <div class="forumLatest">
                  <strong><%= t.title %></strong>
                  <span>by <%= t.last_username || t.username %></span>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </section>
    <% } %>

    <% if (mode === "new_topic") { %>
      <div class="forumCrumbs">
        <a href="/forums">Forums</a>
        <span>/</span>
        <a href="/forums/category/<%= category.id %>"><%= category.title %></a>
        <span>/</span>
        <span>New Topic</span>
      </div>

      <section class="forumTop">
        <div>
          <h1 class="forumTitle">Create Topic</h1>
          <div class="forumSubtitle">Posting in <strong><%= category.title %></strong></div>
        </div>
      </section>

      <section class="forumBox">
        <div class="forumBoxHead">
          <h2 class="forumBoxTitle">Topic Details</h2>
        </div>

        <div class="forumBoxBody">
          <form class="forumForm" method="post" action="/forums/category/<%= category.id %>/new">
            <div>
              <label class="forumLabel">Topic title</label>
              <input class="forumInput" name="title" maxlength="120" required placeholder="Topic title">
            </div>

            <div>
              <label class="forumLabel">Post</label>
              <textarea class="forumTextarea" name="body" maxlength="8000" required placeholder="Write your post..."></textarea>
            </div>

            <div>
              <button class="forumBtn" type="submit">Create Topic</button>
              <a class="forumBtn secondary" href="/forums/category/<%= category.id %>">Cancel</a>
            </div>
          </form>
        </div>
      </section>
    <% } %>

    <% if (mode === "topic") { %>
      <div class="forumCrumbs">
        <a href="/forums">Forums</a>
        <span>/</span>
        <a href="/forums/category/<%= topic.category_id %>"><%= topic.category_title %></a>
        <span>/</span>
        <span><%= topic.title %></span>
      </div>

      <% if (isAdmin) { %>
        <section class="forumBox">
          <div class="forumBoxHead">
            <h2 class="forumBoxTitle">Edit Topic</h2>
          </div>
      
          <div class="forumBoxBody">
            <form class="forumForm" method="post" action="/forums/topic/<%= topic.id %>/edit">
              <div>
                <label class="forumLabel">Topic title</label>
                <input
                  class="forumInput"
                  name="title"
                  maxlength="120"
                  required
                  value="<%= topic.title || '' %>"
                >
              </div>
      
              <div>
                <label class="forumLabel">Topic body</label>
                <textarea
                  class="forumTextarea"
                  name="body"
                  maxlength="8000"
                  required
                ><%= topic.body || '' %></textarea>
              </div>
      
              <div class="modTools">
                <div class="modChecks">
                  <label>
                    <input
                      type="checkbox"
                      name="is_pinned"
                      value="1"
                      <%= Number(topic.is_pinned || 0) === 1 ? "checked" : "" %>
                    >
                    Pinned
                  </label>
      
                  <label>
                    <input
                      type="checkbox"
                      name="is_locked"
                      value="1"
                      <%= Number(topic.is_locked || 0) === 1 ? "checked" : "" %>
                    >
                    Locked
                  </label>
      
                  <button class="forumBtn" type="submit">Save Topic</button>
                </div>
              </div>
            </form>
      
            <form
              method="post"
              action="/forums/topic/<%= topic.id %>/delete"
              onsubmit="return confirm('Delete this entire topic?');"
              style="margin-top:12px;"
            >
              <button class="forumBtn danger" type="submit">Delete Topic</button>
            </form>
          </div>
        </section>
      <% } %>

      <% if (isAdmin) { %>
        <section class="forumBox">
          <div class="forumBoxHead">
            <h2 class="forumBoxTitle">Moderator Tools</h2>
          </div>

          <div class="forumBoxBody">
            <div class="modTools">
              <form class="modChecks" method="post" action="/forums/topic/<%= topic.id %>/mod">
                <label>
                  <input type="checkbox" name="is_pinned" value="1" <%= Number(topic.is_pinned || 0) === 1 ? "checked" : "" %>>
                  Pinned
                </label>

                <label>
                  <input type="checkbox" name="is_locked" value="1" <%= Number(topic.is_locked || 0) === 1 ? "checked" : "" %>>
                  Locked
                </label>

                <button class="forumBtn" type="submit">Save</button>
              </form>

              <form method="post" action="/forums/topic/<%= topic.id %>/delete" onsubmit="return confirm('Delete this entire topic?');">
                <button class="forumBtn danger" type="submit">Delete Topic</button>
              </form>
            </div>
          </div>
        </section>
      <% } %>

      <section class="threadList">
        <% for (const p of posts) { %>
          <article class="threadPost" id="post-<%= p.id %>">
            <div class="threadPostHead">
              <div class="threadUser">
                <div class="threadAvatar">
                  <% if (p.avatar_url) { %>
                    <img src="<%= p.avatar_url %>" alt="">
                  <% } else { %>
                    <%= initials(p.username) %>
                  <% } %>
                </div>

                <div>
                  <a class="threadName" href="/u/<%= encodeURIComponent(p.username) %>">
                    <%= p.username %>
                  </a>

                  <div class="threadInfo">
                    <%= fmtTs(p.created_ts) %>
                    <% if (Number(p.is_admin || 0) === 1) { %>
                      · Admin
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="threadRight">
                <span>Post #<%= p.id %></span>
                <% if (Number(p.is_deleted || 0) !== 1) { %>
                  <a href="#post-<%= p.id %>">Link</a>
                <% } %>
              </div>
            </div>

            <div class="threadBody">
              <% 
                const visibleBody = cleanReplyBody(p.body, p.reply_to_username).trim();
                const postReactionData = reactions && reactions[p.id]
                  ? reactions[p.id]
                  : { counts: {}, mine: null };
            
                const allowedReactions = ['👍', '😂', '❤️', '👀', '🔥', '💀'];
              %>
            
              <% if (p.reply_to_username) { %>
                <div class="threadReplyNotice">
                  Replying to @<%= p.reply_to_username %>
                </div>
              <% } %>
            
              <div class="threadBodyText"><%= visibleBody %></div>
            
              <div class="reactionBar" data-post-id="<%= p.id %>">
                <% for (const emoji of allowedReactions) { %>
                  <% 
                    const count = Number(postReactionData.counts?.[emoji] || 0);
                    const isMine = postReactionData.mine === emoji;
                  %>
            
                  <% if (count > 0 || isMine) { %>
                    <form
                      method="post"
                      action="/forums/post/<%= p.id %>/react"
                      class="reactionForm reactionExistingForm"
                      <%= !meUser ? 'data-disabled="1"' : '' %>
                    >
                      <input type="hidden" name="emoji" value="<%= emoji %>">
            
                      <button
                        class="reactionBtn <%= isMine ? 'active' : '' %>"
                        type="<%= meUser ? 'submit' : 'button' %>"
                        data-emoji="<%= emoji %>"
                        <%= !meUser ? 'disabled' : '' %>
                      >
                        <span><%= emoji %></span>
                        <span class="reactionCount"><%= count > 0 ? count : '' %></span>
                      </button>
                    </form>
                  <% } %>
                <% } %>
            
                <% if (meUser) { %>
                  <button class="reactionToggleBtn" type="button" title="React">＋</button>
            
                  <div class="reactionPicker">
                    <% for (const emoji of allowedReactions) { %>
                      <% 
                        const count = Number(postReactionData.counts?.[emoji] || 0);
                        const isMine = postReactionData.mine === emoji;
                      %>
            
                      <% if (count === 0 && !isMine) { %>
                        <form
                          method="post"
                          action="/forums/post/<%= p.id %>/react"
                          class="reactionForm reactionPickerForm"
                        >
                          <input type="hidden" name="emoji" value="<%= emoji %>">
            
                          <button
                            class="reactionBtn"
                            type="submit"
                            data-emoji="<%= emoji %>"
                          >
                            <span><%= emoji %></span>
                            <span class="reactionCount"></span>
                          </button>
                        </form>
                      <% } %>
                    <% } %>
                  </div>
                <% } else { %>
                  <span class="reactionLoginHint">Login to react</span>
                <% } %>
              </div>
            </div>

            <div class="threadActions">
              <% if (meUser && Number(topic.is_locked || 0) !== 1 && Number(topic.category_locked || 0) !== 1 && Number(p.is_deleted || 0) !== 1) { %>
                <button
                  class="forumBtn secondary directReplyBtn"
                  type="button"
                  data-post-id="<%= p.id %>"
                  data-username="<%= p.username %>"
                >
                  Reply
                </button>
              <% } %>

              <% if (isAdmin) { %>
                <form method="post" action="/forums/post/<%= p.id %>/delete" onsubmit="return confirm('Permanently delete this post? This cannot be undone.');">
                  <input type="hidden" name="topic_id" value="<%= topic.id %>">
                  <button class="forumBtn danger" type="submit">
                    <%= Number(p.is_deleted || 0) === 1 ? 'Permanently Delete' : 'Delete' %>
                  </button>
                </form>
              <% } %>
            </div>
          </article>
        <% } %>
      </section>

      <% if (meUser && Number(topic.is_locked || 0) !== 1 && Number(topic.category_locked || 0) !== 1) { %>
        <section class="forumBox" style="margin-top:16px;">
          <div class="forumBoxHead">
            <h2 class="forumBoxTitle">Post Reply</h2>
          </div>

          <div class="forumBoxBody">
            <form class="forumForm" method="post" action="/forums/topic/<%= topic.id %>/reply">
              <input type="hidden" name="reply_to_post_id" id="replyToPostId" value="">

              <div id="replyingToBox" class="replyingToBox">
                Replying to <strong id="replyingToName"></strong>
                <button class="forumBtn secondary" type="button" id="cancelDirectReply">Cancel</button>
              </div>

              <textarea
                class="forumTextarea"
                name="body"
                id="replyTextarea"
                maxlength="8000"
                required
                placeholder="Write a reply..."
              ></textarea>

              <div>
                <button class="forumBtn" type="submit">Post Reply</button>
              </div>
            </form>
          </div>
        </section>
      <% } else if (!meUser) { %>
        <section class="forumBox" style="margin-top:16px;">
          <div class="forumBoxBody">
            <a class="forumBtn" href="/login?next=/forums/topic/<%= topic.id %>">Login to reply</a>
          </div>
        </section>
      <% } else { %>
        <section class="forumBox" style="margin-top:16px;">
          <div class="forumBoxBody">This topic is locked.</div>
        </section>
      <% } %>
    <% } %>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const replyToPostId = document.getElementById('replyToPostId');
      const replyingToBox = document.getElementById('replyingToBox');
      const replyingToName = document.getElementById('replyingToName');
      const cancelBtn = document.getElementById('cancelDirectReply');
      const textarea = document.getElementById('replyTextarea');
  
      document.querySelectorAll('.directReplyBtn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const postId = btn.dataset.postId || '';
          const username = btn.dataset.username || '';
  
          if (replyToPostId) replyToPostId.value = postId;
          if (replyingToName) replyingToName.textContent = '@' + username;
          if (replyingToBox) replyingToBox.style.display = 'flex';
  
          if (textarea) {
            textarea.focus();
            textarea.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });
  
      if (cancelBtn) {
        cancelBtn.addEventListener('click', () => {
          if (replyToPostId) replyToPostId.value = '';
          if (replyingToName) replyingToName.textContent = '';
          if (replyingToBox) replyingToBox.style.display = 'none';
          if (textarea) textarea.focus();
        });
      }
  
      document.querySelectorAll('.reactionToggleBtn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const bar = btn.closest('.reactionBar');
          const picker = bar ? bar.querySelector('.reactionPicker') : null;
          if (picker) picker.classList.toggle('open');
        });
      });
  
      document.addEventListener('click', (e) => {
        if (e.target.closest('.reactionBar')) return;
  
        document.querySelectorAll('.reactionPicker.open').forEach((picker) => {
          picker.classList.remove('open');
        });
      });
  
      document.querySelectorAll('.reactionForm').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
  
          if (form.dataset.disabled === '1') return;
  
          const bar = form.closest('.reactionBar');
          const emojiInput = form.querySelector('input[name="emoji"]');
  
          if (!bar || !emojiInput) return;
  
          const emoji = emojiInput.value;
  
          try {
            const res = await fetch(form.action, {
              method: 'POST',
              headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
              },
              body: new URLSearchParams({ emoji })
            });
  
            const data = await res.json();
  
            if (!res.ok || !data.ok) {
              throw new Error(data.error || 'Reaction failed.');
            }
  
            const counts = data.reactions?.counts || {};
            const mine = data.reactions?.mine || null;
  
            const allowedReactions = ['👍', '😂', '❤️', '👀', '🔥', '💀'];
  
            const toggleBtn = bar.querySelector('.reactionToggleBtn');
            const picker = bar.querySelector('.reactionPicker');
  
            bar.querySelectorAll('.reactionForm').forEach((oldForm) => {
              oldForm.remove();
            });
  
            for (const reactionEmoji of allowedReactions) {
              const count = Number(counts[reactionEmoji] || 0);
              const isMine = mine === reactionEmoji;
  
              if (count > 0 || isMine) {
                const newForm = document.createElement('form');
                newForm.method = 'post';
                newForm.action = `/forums/post/${bar.dataset.postId}/react`;
                newForm.className = 'reactionForm reactionExistingForm';
  
                newForm.innerHTML = `
                  <input type="hidden" name="emoji" value="${reactionEmoji}">
                  <button
                    class="reactionBtn ${isMine ? 'active' : ''}"
                    type="submit"
                    data-emoji="${reactionEmoji}"
                  >
                    <span>${reactionEmoji}</span>
                    <span class="reactionCount">${count > 0 ? count : ''}</span>
                  </button>
                `;
  
                bar.insertBefore(newForm, toggleBtn);
                attachReactionSubmit(newForm);
              }
            }
  
            if (picker) {
              picker.innerHTML = '';
  
              for (const reactionEmoji of allowedReactions) {
                const count = Number(counts[reactionEmoji] || 0);
                const isMine = mine === reactionEmoji;
  
                if (count === 0 && !isMine) {
                  const newForm = document.createElement('form');
                  newForm.method = 'post';
                  newForm.action = `/forums/post/${bar.dataset.postId}/react`;
                  newForm.className = 'reactionForm reactionPickerForm';
  
                  newForm.innerHTML = `
                    <input type="hidden" name="emoji" value="${reactionEmoji}">
                    <button
                      class="reactionBtn"
                      type="submit"
                      data-emoji="${reactionEmoji}"
                    >
                      <span>${reactionEmoji}</span>
                      <span class="reactionCount"></span>
                    </button>
                  `;
  
                  picker.appendChild(newForm);
                  attachReactionSubmit(newForm);
                }
              }
  
              picker.classList.remove('open');
            }
          } catch (err) {
            console.error(err);
            alert(err.message || 'Reaction failed.');
          }
        });
      });
  
      function attachReactionSubmit(form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
  
          const bar = form.closest('.reactionBar');
          const emojiInput = form.querySelector('input[name="emoji"]');
  
          if (!bar || !emojiInput) return;
  
          const emoji = emojiInput.value;
  
          try {
            const res = await fetch(form.action, {
              method: 'POST',
              headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
              },
              body: new URLSearchParams({ emoji })
            });
  
            const data = await res.json();
  
            if (!res.ok || !data.ok) {
              throw new Error(data.error || 'Reaction failed.');
            }
  
            window.location.reload();
          } catch (err) {
            console.error(err);
            alert(err.message || 'Reaction failed.');
          }
        });
      }
    });
  </script>
</body>
</html>
