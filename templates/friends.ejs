<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Friends - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
</head>
<body class="app">
  <main class="wrap">

    <div class="row between" style="align-items:flex-end;">
      <div>
        <div class="kicker">Social</div>
        <h1 style="margin:6px 0 0;">Friends</h1>
        <div class="muted small">Friends are mutual (request → accept).</div>
      </div>
    </div>

    <div class="layout" style="margin-top:14px;">
      <section>
        <div class="panel">
          <div class="kicker">Your friends</div>

          <% if (Array.isArray(friends) && friends.length > 0) { %>
            <div class="stack" style="margin-top:12px;">
              <% for (const u of friends) { %>
                <div class="row between" style="align-items:center;">
                  <div class="row gap" style="align-items:center;">
                    <span class="avatar_sm">
                      <% if (u.avatar_url) { %>
                        <img src="<%= u.avatar_url %>" alt="avatar">
                      <% } else { %>
                        <span class="avatar_fallback"></span>
                      <% } %>
                    </span>
                    <a class="reviewuser" href="/u/<%= encodeURIComponent(u.username) %>"><%= u.username %></a>
                  </div>
                  <form method="post" action="/u/<%= encodeURIComponent(u.username) %>/friend/remove">
                    <button class="btn ghost" type="submit">Remove</button>
                  </form>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div class="muted" style="margin-top:10px;">No friends yet.</div>
          <% } %>
        </div>
      </section>

      <aside class="side">
        <div class="panel">
          <div class="kicker">Incoming requests</div>

          <% if (Array.isArray(incoming) && incoming.length > 0) { %>
            <div class="stack" style="margin-top:12px;">
              <% for (const u of incoming) { %>
                <div class="row between" style="align-items:center;">
                  <div class="row gap" style="align-items:center;">
                    <span class="avatar_sm">
                      <% if (u.avatar_url) { %>
                        <img src="<%= u.avatar_url %>" alt="avatar">
                      <% } else { %>
                        <span class="avatar_fallback"></span>
                      <% } %>
                    </span>
                    <a class="reviewuser" href="/u/<%= encodeURIComponent(u.username) %>"><%= u.username %></a>
                  </div>

                  <div class="row gap">
                    <form method="post" action="/u/<%= encodeURIComponent(u.username) %>/friend/accept">
                      <button class="btn green" type="submit">Accept</button>
                    </form>
                    <form method="post" action="/u/<%= encodeURIComponent(u.username) %>/friend/decline">
                      <button class="btn ghost" type="submit">Decline</button>
                    </form>
                  </div>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div class="muted" style="margin-top:10px;">No incoming requests.</div>
          <% } %>
        </div>
      </aside>
    </div>

  </main>
</body>
</html>
