<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= (profile_user && profile_user.username ? profile_user.username : "Profile") %> - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
  <link rel="icon" type="image/png" href="/static/favicon.png"/>

  <style>
    .auth { align-items:center; gap:12px; }

    .notifWrap {
      position:relative;
      display:inline-flex;
      align-items:center;
    }

    .bellBtn {
      position:relative;
      border:none;
      background:transparent;
      cursor:pointer;
      color:inherit;
      padding:6px;
      border-radius:10px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      opacity:.95;
    }

    .bellBtn:hover {
      background:rgba(255,255,255,.06);
    }

    .badgeDot {
      position:absolute;
      top:3px;
      right:3px;
      min-width:18px;
      height:18px;
      padding:0 6px;
      border-radius:999px;
      background:#ff3b30;
      color:#fff;
      font-size:11px;
      line-height:18px;
      text-align:center;
      font-weight:800;
      box-shadow:0 6px 18px rgba(0,0,0,.35);
    }

    .notifDropdown {
      display:none;
      position:absolute;
      right:0;
      top:40px;
      width:340px;
      max-height:420px;
      overflow:auto;
      background:rgba(15,23,42,.98);
      border:1px solid rgba(255,255,255,.12);
      border-radius:14px;
      box-shadow:0 14px 40px rgba(0,0,0,.45);
      z-index:9999;
    }

    .notifDropdown.open {
      display:block;
    }

    .notifHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:10px 12px;
      border-bottom:1px solid var(--accentSoft);
      position:sticky;
      top:0;
      background:rgba(15,23,42,.98);
      backdrop-filter:blur(8px);
    }

    .notifTitle {
      font-weight:900;
      color:var(--text);
    }

    .markReadBtn {
      border:1px solid transparent;
      background:transparent;
      color:inherit;
      cursor:pointer;
      opacity:.9;
      font-size:12px;
      padding:6px 8px;
      border-radius:10px;
      transition:background .15s ease,border-color .15s ease;
    }

    .markReadBtn:hover {
      background:var(--accentFaint);
      border-color:var(--accentSoft);
      opacity:1;
    }

    .notifList {
      padding:8px;
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    .notifItem {
      padding:10px;
      border-radius:12px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      transition:border-color .15s ease,background .15s ease;
    }

    .notifItem.unread {
      background:var(--accentFaint);
      border-color:var(--accentSoft);
    }

    .notifItem a {
      color:var(--accent);
      text-decoration:none;
      font-weight:700;
    }

    .notifItem a:hover {
      text-decoration:underline;
    }

    .notifTime {
      font-size:12px;
      opacity:.7;
      margin-top:4px;
    }

    .notifEmpty {
      padding:12px;
      opacity:.8;
    }

    .authBellSlot {
      display:inline-flex;
      align-items:center;
    }

    .notifDropdown,
    .notifDropdown * {
      pointer-events:auto !important;
    }

    .profile_top_actions {
      margin-top:10px;
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }

    .profile_counts .badge {
      border-color:var(--accentFaint);
      background:var(--accentFaint);
      color:var(--text);
    }

    .profile_hero {
      position:relative;
      overflow:visible;
      margin-top:16px;
      border:1px solid var(--accentSoft);
      box-shadow:var(--shadow,0 10px 30px rgba(0,0,0,.35));
      background:#0b0b0b;
    }

    .profile_hero_bg {
      position:absolute;
      inset:0;
      z-index:0;
    }

    .profile_hero_bg img {
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center;
      display:block;
      opacity:.60;
    }

    .profile_hero_overlay {
      position:absolute;
      inset:0;
      z-index:1;
      background:
        linear-gradient(180deg,rgba(0,0,0,.18),rgba(0,0,0,.62)),
        radial-gradient(circle at top left,var(--accentFaint),transparent 30%);
      pointer-events:none;
    }

    .profile_hero_inner {
      position:relative;
      z-index:2;
    }

    .profile_hero_inner h1 {
      color:var(--text);
      text-shadow:0 2px 18px rgba(0,0,0,.45);
    }

    .profile_username_row {
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
    }

    .profile_username_row h1 {
      margin:6px 0 0;
    }

    .profile_avatar_column {
      flex:0 0 auto;
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:8px;
    }
    
    .profile_presence_status {
      display:flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      font-size:12px;
      font-weight:700;
      color:rgba(255,255,255,.82);
      line-height:1;
      white-space:nowrap;
    }
    
    .profile_presence_circle {
      display:inline-block !important;
      width:10px !important;
      height:10px !important;
      min-width:10px !important;
      min-height:10px !important;
      max-width:10px !important;
      max-height:10px !important;
      padding:0 !important;
      margin:0 !important;
      border:0 !important;
      border-radius:999px !important;
      box-sizing:border-box !important;
      aspect-ratio:1 / 1;
      flex:0 0 10px !important;
      overflow:hidden;
      background:#70798b;
    }
    
    .profile_presence_circle.online {
      background:#35d07f !important;
      box-shadow:0 0 0 3px rgba(53,208,127,.13);
    }
    
    .profile_presence_circle.recent {
      background:#e6b94a !important;
      box-shadow:0 0 0 3px rgba(230,185,74,.10);
    }
    
    .profile_presence_circle.offline {
      background:#70798b !important;
    }

    .profile_bio {
      margin-top:12px;
      opacity:.95;
      line-height:1.55;
      border-left:3px solid var(--accentSoft);
      padding-left:12px;
    }

    .profile_section_title {
      color:var(--accent);
    }

    .acct_panel {
      border:1px solid var(--accentSoft) !important;
      background:color-mix(in srgb,var(--accent) 6%,rgba(0,0,0,.94));
      box-shadow:0 0 0 1px var(--accentFaint);
    }

    .profile_main_panel {
      border-color:var(--accentSoft);
      box-shadow:0 0 0 1px var(--accentFaint);
    }

    .profile_ratings_panel .kicker,
    .profile_reviews_panel .kicker {
      color:var(--accent);
    }

    .profile_layout {
      display:block !important;
    }

    .profile_content_stack {
      width:100%;
    }

    .profile_avg_box {
      position:relative !important;
      transform:none !important;
      margin:0 auto !important;
      background:rgba(0,0,0,.35);
      backdrop-filter:blur(4px);
    }

    .profile_avg_value {
      color:var(--text);
    }

    .profile_avg_star {
      color:var(--accent);
    }

    .role_tag {
      box-shadow:0 0 0 1px rgba(0,0,0,.15) inset;
    }

    .rolebadge {
      display:inline-flex;
      align-items:center;
      font-size:11px;
      font-weight:800;
      border-radius:999px;
      padding:4px 9px;
      color:#fff;
      line-height:1;
      box-shadow:0 0 0 1px rgba(0,0,0,.18) inset;
    }

    .poster_meta {
      border-top:1px solid var(--accentFaint);
    }

    .reviewcard {
      border-color:var(--accentSoft);
      background:color-mix(in srgb,var(--accent) 5%,rgba(7,10,16,.35));
    }

    .reviewtext {
      border-left:3px solid var(--accentSoft);
      padding-left:12px;
      margin-top:12px;
      text-indent:0 !important;
      white-space:normal;
    }

    .tile_rating {
      border-color:var(--accentSoft) !important;
      background:rgba(0,0,0,.72) !important;
    }

    .tile_star {
      color:var(--accent) !important;
    }

    .topline_accent {
      border-top:1px solid var(--accentSoft);
      padding-top:12px;
    }

    .profile_hero_content {
      display:flex;
      flex-direction:column;
      gap:14px;
      min-width:0;
      flex:1;
    }

    .profile_favorites_box {
      margin-top:4px;
      padding-top:12px;
      border-top:1px solid var(--accentSoft);
    }

    .profile_favorites_title {
      color:var(--accent);
      font-weight:800;
      font-size:12px;
      letter-spacing:.04em;
      text-transform:uppercase;
      margin-bottom:10px;
    }

    .profile_favorites_row {
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:flex-start;
    }

    .profile_favorite_item {
      width:72px;
      text-decoration:none;
      color:inherit;
      display:block;
    }

    .profile_favorite_art {
      position:relative;
      width:79px;
      height:119px;
      overflow:hidden;
      background:rgba(0,0,0,.55);
      border:1px solid var(--accentSoft);
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .profile_favorite_art img {
      width:100% !important;
      height:100% !important;
      object-fit:contain !important;
      object-position:center center !important;
      display:block;
    }

    .profile_account_floating {
      position:absolute;
      top:14px;
      right:14px;
      z-index:50;
      width:220px;
    }

    .profile_account_summary {
      width:100%;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      cursor:pointer;
      list-style:none;
    }

    .profile_account_summary::-webkit-details-marker {
      display:none;
    }

    .profile_account_summary .small {
      display:inline-block;
      transition:transform .15s ease;
    }

    .profile_account_floating[open] .profile_account_summary .small {
      transform:rotate(180deg);
    }

    .profile_account_panel {
      position:absolute;
      top:calc(100% + 8px);
      right:0;
      width:350px;
      max-width:calc(100vw - 30px);
      max-height:calc(100vh - 120px);
      overflow-y:auto;
      padding:16px;
      background:rgba(10,12,17,.98) !important;
      backdrop-filter:blur(14px);
      border:1px solid var(--accentSoft) !important;
      box-shadow:0 18px 50px rgba(0,0,0,.65);
      z-index:999;
    }

    .profile_account_forms {
      display:grid;
      grid-template-columns:1fr;
      gap:14px;
      margin-top:12px;
    }

    .profile_account_label {
      margin-bottom:8px;
    }

    .profile_account_password {
      padding-top:14px;
      border-top:1px solid var(--accentFaint);
    }

    .profile_favorite_rank {
      position:absolute;
      left:6px;
      top:6px;
      min-width:22px;
      height:22px;
      padding:0 6px;
      border-radius:999px;
      background:rgba(0,0,0,.78);
      border:1px solid rgba(255,255,255,.10);
      color:#fff;
      font-size:11px;
      font-weight:900;
      line-height:22px;
      text-align:center;
    }

    .profile_favorite_name {
      margin-top:6px;
      font-size:11px;
      line-height:1.25;
      color:var(--text);
      display:-webkit-box;
      -webkit-line-clamp:2;
      -webkit-box-orient:vertical;
      overflow:hidden;
    }

    .profile_favorite_empty {
      opacity:.8;
      font-size:13px;
    }

    .profile_favorites_title_row {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      flex-wrap:wrap;
      margin-bottom:10px;
    }

    .profile_favorites_title_row .profile_favorites_title {
      margin-bottom:0;
    }

    .profile_favorites_order_status {
      font-size:10px;
      line-height:1.2;
      color:rgba(255,255,255,.58);
      min-height:12px;
    }

    .profile_favorites_row.is_sortable .profile_favorite_item {
      cursor:grab;
      user-select:none;
      -webkit-user-drag:element;
      transition:
        opacity .12s ease,
        transform .12s ease,
        filter .12s ease;
    }

    .profile_favorites_row.is_sortable .profile_favorite_item:active {
      cursor:grabbing;
    }

    .profile_favorites_row.is_sortable .profile_favorite_item.is_dragging {
      opacity:.38;
      transform:scale(.96);
      filter:saturate(.65);
    }

    .profile_favorites_row.is_sortable .profile_favorite_item.is_drag_target {
      transform:translateY(-3px);
    }

    .profile_favorites_row.is_sortable .profile_favorite_art,
    .profile_favorites_row.is_sortable .profile_favorite_name {
      pointer-events:none;
    }

    @media (max-width:768px) {
      .topbar {
        position:relative !important;
        height:auto !important;
        padding:15px 0 !important;
      }

      .topbar .wrap {
        flex-direction:column !important;
        gap:15px !important;
      }

      .profile_layout {
        display:block !important;
      }

      .profile_content_stack {
        width:100%;
      }

      .profile_hero_inner {
        padding:20px 10px !important;
      }

      .profile_hero_inner .row.gap {
        flex-direction:column !important;
        text-align:center !important;
      }

      .profile_username_row {
        justify-content:center;
      }

      .avatar_lg {
        margin:0 auto 15px auto !important;
      }

      .profile_account_floating {
        position:relative;
        top:auto;
        right:auto;
        width:100%;
        margin-bottom:14px;
      }

      .profile_account_panel {
        position:relative;
        top:auto;
        right:auto;
        width:100%;
        max-width:none;
        margin-top:8px;
      }

      .postergrid {
        display:grid !important;
        grid-template-columns:repeat(3,1fr) !important;
        gap:8px !important;
      }

      .profile_favorites_row {
        justify-content:center;
      }
    }
  </style>
</head>

<%
  const pu = profile_user || {};
  const meUsername = me && me.username ? me.username : null;
  const puUsername = pu && pu.username ? pu.username : null;

  const isMe = typeof is_me !== "undefined"
    ? !!is_me
    : !!(meUsername && puUsername && meUsername === puUsername);

  const viewerIsFollowing = !!pu.viewer_is_following;
  const friendStatus = pu.viewer_friend_status || "none";

  const canSeeProfilePresence = !!pu.id;

  const recentRatings = Array.isArray(recent_ratings) ? recent_ratings : [];
  const recentReviews = Array.isArray(recent_reviews) ? recent_reviews : [];
  const favoriteShows = Array.isArray(favorite_shows) ? favorite_shows : [];
  const roles = Array.isArray(user_roles) ? user_roles : [];
  const flashesList = Array.isArray(flashes) ? flashes : [];

  const avgRatingCnt = pu.avg_rating_cnt != null ? Number(pu.avg_rating_cnt) : 0;
  const avgRating = pu.avg_rating != null ? Number(pu.avg_rating) : 0;

  const profileAccent = String((pu && pu.theme_color) || '').trim();
  const meAccent = String((me && me.theme_color) || '').trim();

  const validProfileAccent = /^#([0-9a-fA-F]{6})$/.test(profileAccent)
    ? profileAccent
    : '';

  const validMeAccent = /^#([0-9a-fA-F]{6})$/.test(meAccent)
    ? meAccent
    : '';

  const pageAccent = isMe
    ? (validMeAccent || '#ffffff')
    : (validProfileAccent || '#ffffff');
%>

<body class="app" style="--accent: <%= pageAccent %>; --accent2: <%= pageAccent %>;">
  <header class="topbar">
    <div class="wrap row between">
      <div style="display:flex; align-items:center; gap:10px;">
        <a
          href="https://www.generaleffect.media/"
          target="_blank"
          rel="noopener"
          style="display:flex; align-items:center;"
        >
          <img
            src="/static/logo.png"
            alt="Logo"
            style="width:36px; height:36px; object-fit:contain; transition:transform .6s ease-in-out;"
            onmouseover="this.style.transform='rotate(360deg)'"
            onmouseout="this.style.transform='rotate(0deg)'"
          >
        </a>

        <a class="brand" href="/shows" style="display:flex; align-items:center;">
          <img
            src="/static/pressboxd-wordmark.png"
            alt="Pressboxd"
            style="height:68px; width:auto; display:block;"
          >
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>

        <% if (me && Number(me.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (me) { %>
          <div class="authBellSlot">
            <div class="notifWrap">
              <button
                class="bellBtn"
                id="bellBtn"
                aria-label="Notifications"
                title="Notifications"
                type="button"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z"
                    stroke="currentColor"
                    stroke-width="1"
                  />
                  <path
                    d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z"
                    stroke="currentColor"
                    stroke-width="1"
                    stroke-linejoin="round"
                  />
                </svg>

                <% if (notif_count && notif_count > 0) { %>
                  <span class="badgeDot"><%= notif_count %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>

                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">
                      Mark all read
                    </button>
                  </form>
                </div>

                <% if (notif_items && notif_items.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of notif_items) {
                      const kind = n.kind || "";
                      const actor = n.actor_username || "Someone";
                      const created = n.created_at || "";
                      const unread = Number(n.is_read || 0) === 0;
                      const sid = n.show_id || null;
                    %>

                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div>
                            <b><%= actor %></b> sent you a friend request.
                          </div>

                        <% } else if (kind === "follow") { %>
                          <div>
                            <b><%= actor %></b> followed you.
                          </div>

                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>

                        <% } else if (kind === "review_comment") { %>
                          <div>
                            <b><%= actor %></b> commented on your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>

                        <% } else if (kind === "comment_reply") { %>
                          <div>
                            <b><%= actor %></b> replied to your comment
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>

                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">
                    No notifications.
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (me.avatar_url) { %>
                <img src="<%= me.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>

            <span class="muted small">
              <%= me.username %>
            </span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <% if (flashesList.length > 0) { %>
      <div class="flashes">
        <% for (const f of flashesList) { %>
          <div class="flash <%= f.category %>">
            <%= f.message %>
          </div>
        <% } %>
      </div>
    <% } %>

    <% if (pu.username) { %>
      <div class="profile_top_actions profile_counts">
        <a
          class="badge muted"
          href="/u/<%= encodeURIComponent(pu.username) %>/followers"
        >
          Followers: <%= pu.followers_count != null ? pu.followers_count : 0 %>
        </a>

        <a
          class="badge muted"
          href="/u/<%= encodeURIComponent(pu.username) %>/following"
        >
          Following: <%= pu.following_count != null ? pu.following_count : 0 %>
        </a>

        <% if (me && !isMe) { %>
          <% if (viewerIsFollowing) { %>
            <form
              method="post"
              action="/u/<%= encodeURIComponent(pu.username) %>/unfollow"
            >
              <button class="btn ghost" type="submit">
                Unfollow
              </button>
            </form>
          <% } else { %>
            <form
              method="post"
              action="/u/<%= encodeURIComponent(pu.username) %>/follow"
            >
              <button class="btn green" type="submit">
                Follow
              </button>
            </form>
          <% } %>

          <% if (friendStatus === "friends") { %>
            <form
              method="post"
              action="/u/<%= encodeURIComponent(pu.username) %>/friend/remove"
            >
              <button class="btn ghost" type="submit">
                Remove friend
              </button>
            </form>

          <% } else if (friendStatus === "pending_out") { %>
            <span class="badge muted">
              Friend request sent
            </span>

          <% } else if (friendStatus === "pending_in") { %>
            <form
              method="post"
              action="/u/<%= encodeURIComponent(pu.username) %>/friend/accept"
            >
              <button class="btn green" type="submit">
                Accept friend
              </button>
            </form>

            <form
              method="post"
              action="/u/<%= encodeURIComponent(pu.username) %>/friend/decline"
            >
              <button class="btn ghost" type="submit">
                Decline
              </button>
            </form>

          <% } else { %>
            <form
              method="post"
              action="/u/<%= encodeURIComponent(pu.username) %>/friend/request"
            >
              <button class="btn ghost" type="submit">
                Add friend
              </button>
            </form>
          <% } %>
        <% } %>

        <% if (isMe) { %>
          <a class="btn ghost" href="/me/friends">
            Friends
          </a>
        <% } %>
      </div>
    <% } %>

    <div class="profile_hero">
      <% if (pu.banner_url) { %>
        <div class="profile_hero_bg">
          <img
            src="<%= pu.banner_url %>"
            alt="Profile banner"
          >
        </div>
      <% } %>

      <div class="profile_hero_overlay"></div>

      <div class="profile_hero_inner">
        <% if (isMe) { %>
          <details class="profile_account_floating">
            <summary class="btn ghost profile_account_summary">
              Account Settings
              <span class="muted small">▼</span>
            </summary>

            <div class="panel acct_panel profile_account_panel">
              <div class="kicker profile_section_title">
                Account
              </div>

              <div class="profile_account_forms">
                <div>
                  <div class="muted small profile_account_label">
                    <b>Change username</b>
                  </div>

                  <form method="post" action="/me/change_username">
                    <div class="field">
                      <label>New username</label>
                      <input
                        name="new_username"
                        placeholder="New username"
                        autocomplete="username"
                      >
                    </div>

                    <div class="field">
                      <label>Current password</label>
                      <input
                        type="password"
                        name="current_password"
                        placeholder="Current password"
                        autocomplete="current-password"
                      >
                    </div>

                    <div class="actions">
                      <button class="btn green" type="submit">
                        Update username
                      </button>
                    </div>
                  </form>
                </div>

                <div class="profile_account_password">
                  <div class="muted small profile_account_label">
                    <b>Change password</b>
                  </div>

                  <form method="post" action="/me/change_password">
                    <div class="field">
                      <label>Current password</label>
                      <input
                        type="password"
                        name="current_password"
                        placeholder="Current password"
                        autocomplete="current-password"
                      >
                    </div>

                    <div class="field">
                      <label>New password</label>
                      <input
                        type="password"
                        name="new_password"
                        placeholder="New password"
                        autocomplete="new-password"
                      >
                    </div>

                    <div class="field">
                      <label>Confirm new password</label>
                      <input
                        type="password"
                        name="new_password2"
                        placeholder="Confirm new password"
                        autocomplete="new-password"
                      >
                    </div>

                    <div class="actions">
                      <button class="btn green" type="submit">
                        Update password
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </details>
        <% } %>

        <div class="row gap" style="align-items:center;">
          <div class="profile_avatar_column">
            <div class="avatar_lg">
              <% if (pu.avatar_url) { %>
                <img
                  src="<%= pu.avatar_url %>"
                  alt="avatar"
                >
              <% } else { %>
                <div class="avatar_fallback"></div>
              <% } %>
            </div>
          
            <% if (canSeeProfilePresence) { %>
              <div
                class="profile_presence_status"
                id="profilePresenceStatus"
              >
                <span
                  id="profilePresenceDot"
                  class="profile_presence_circle <%= isMe ? 'online' : 'offline' %>"
                ></span>
          
                <span id="profilePresenceText">
                  <%= isMe ? "Online" : "Checking…" %>
                </span>
              </div>
            <% } %>
          </div>

          <div class="profile_hero_content">
            <div>
              <div class="kicker" style="color:var(--accent);">
                Profile
              </div>

              <div class="profile_username_row">
                <h1><%= pu.username || "User" %></h1>
              </div>

              <% if (roles.length > 0) { %>
                <div
                  class="row gap"
                  style="margin-top:10px; flex-wrap:wrap;"
                >
                  <% for (const r of roles) { %>
                    <span
                      class="rolebadge"
                      style="background:<%= (r && r.color) ? r.color : '#666666' %>;"
                    >
                      <%= r && r.name ? r.name : "" %>
                    </span>
                  <% } %>
                </div>
              <% } %>

              <% if (pu.bio) { %>
                <div class="profile_bio">
                  <%= pu.bio %>
                </div>
              <% } %>

              <% if (pu.username) { %>
                <div
                  class="row gap"
                  style="margin-top:10px; flex-wrap:wrap;"
                >
                  <% if (isMe) { %>
                    <a class="btn ghost" href="/me/customize">
                      Customize
                    </a>
                  <% } %>

                  <a
                    class="btn ghost"
                    href="/u/<%= encodeURIComponent(pu.username) %>/ratings"
                  >
                    All Ratings & Reviews
                  </a>

                  <% if (me && Number(me.is_admin) === 1) { %>
                    <a
                      class="btn ghost"
                      href="/admin/user/<%= encodeURIComponent(pu.username) %>/roles"
                    >
                      Roles
                    </a>
                  <% } %>
                </div>
              <% } %>
            </div>

            <div class="profile_favorites_box">
              <div class="profile_favorites_title_row">
                <div class="profile_favorites_title">
                  Top 5 / Favorites
                </div>

                <% if (isMe && favoriteShows.length > 1) { %>
                  <div
                    class="profile_favorites_order_status"
                    id="favoriteOrderStatus"
                    aria-live="polite"
                  >
                    Drag to reorder
                  </div>
                <% } %>
              </div>

              <% if (favoriteShows.length > 0) { %>
                <div
                  class="profile_favorites_row <%= isMe ? 'is_sortable' : '' %>"
                  <% if (isMe) { %>id="favoriteShowsSortable"<% } %>
                >
                  <% for (let i = 0; i < favoriteShows.length; i++) {
                    const fav = favoriteShows[i];
                  %>
                    <a
                      class="profile_favorite_item"
                      href="/show/<%= fav.show_id %>"
                      <% if (isMe) { %>
                        draggable="true"
                        data-show-id="<%= fav.show_id %>"
                      <% } %>
                    >
                      <div class="profile_favorite_art">
                        <% if (fav && fav.poster_url) { %>
                          <img
                            src="<%= fav.poster_url %>"
                            alt="<%= fav.title || 'Favorite show' %> poster"
                            loading="lazy"
                            draggable="false"
                          >
                        <% } else { %>
                          <div class="poster_fallback"></div>
                        <% } %>

                        <div
                          class="profile_favorite_rank"
                          data-favorite-rank
                        >
                          <%= i + 1 %>
                        </div>
                      </div>

                      <div class="profile_favorite_name">
                        <%= fav && fav.title ? fav.title : "" %>
                      </div>
                    </a>
                  <% } %>
                </div>
              <% } else { %>
                <div class="profile_favorite_empty muted">
                  No favorite shows selected yet.
                </div>
              <% } %>
            </div>
          </div>

          <div class="profile_avg_box">
            <div class="kicker" style="color:var(--accent);">
              Avg rating
            </div>

            <% if (avgRatingCnt > 0) { %>
              <div class="profile_avg_value">
                <span class="profile_avg_star">★</span>
                <%= avgRating.toFixed(2) %>
              </div>

              <div class="muted small">
                <%= avgRatingCnt %> ratings
              </div>
            <% } else { %>
              <div class="muted">
                No ratings
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div
      class="profile_layout"
      style="margin-top:16px;"
    >
      <section class="stack profile_content_stack">
        <% if (isMe) { %>
          <div class="panel profile_main_panel">
            <div class="kicker profile_section_title">
              Bio
            </div>

            <div
              class="field"
              style="margin-top:12px;"
            >
              <form
                method="post"
                action="/me/update_bio"
              >
                <textarea
                  name="bio"
                  placeholder="Tell us about your favorite corps..."
                  rows="3"
                  style="width:100%;"
                ><%= pu.bio || "" %></textarea>

                <div
                  class="actions"
                  style="margin-top:8px;"
                >
                  <button
                    class="btn green"
                    type="submit"
                  >
                    Save Bio
                  </button>
                </div>
              </form>
            </div>
          </div>
        <% } %>

        <div class="panel profile_ratings_panel">
          <div
            class="kicker"
            style="color:var(--accent);"
          >
            Recent ratings
          </div>

          <% if (recentRatings.length > 0) { %>
            <div
              class="postergrid"
              style="margin-top:12px;"
            >
              <% for (const rr of recentRatings) {
                const rh = rr && rr.rating_half != null
                  ? Number(rr.rating_half)
                  : 0;
              %>
                <a
                  class="poster"
                  href="/show/<%= rr.show_id %>"
                >
                  <div class="poster_art">
                    <% if (rr && rr.poster_url) { %>
                      <img
                        class="poster_img"
                        src="<%= rr.poster_url %>"
                        alt="<%= rr.title || 'poster' %> poster"
                        loading="lazy"
                      >
                    <% } else { %>
                      <div class="poster_fallback"></div>
                    <% } %>

                    <div class="tile_rating">
                      <span class="tile_star">★</span>
                      <%= (rh / 2).toFixed(1) %>
                    </div>

                    <% if (rr && rr.year) { %>
                      <div class="tile_year">
                        <%= rr.year %>
                      </div>
                    <% } %>
                  </div>

                  <div class="poster_meta">
                    <div class="poster_title">
                      <%= rr && rr.title ? rr.title : "" %>
                    </div>

                    <div class="poster_sub">
                      <%= rr && rr.corps ? rr.corps : "" %>
                    </div>
                  </div>
                </a>
              <% } %>
            </div>
          <% } else { %>
            <div
              class="muted"
              style="margin-top:8px;"
            >
              No ratings yet.
            </div>
          <% } %>
        </div>

        <div class="panel profile_reviews_panel">
          <div
            class="kicker"
            style="color:var(--accent);"
          >
            Recent reviews
          </div>

          <% if (recentReviews.length > 0) { %>
            <div
              class="reviewlist"
              style="margin-top:12px;"
            >
              <% for (const rv of recentReviews) { %>
                <div class="reviewcard">
                  <div class="small">
                    <a
                      class="reviewuser"
                      href="/show/<%= rv.show_id %>"
                    >
                      <%= rv && rv.title ? rv.title : "Show" %>
                    </a>

                    <% if (rv && rv.year && rv.corps) { %>
                      <span class="muted">
                        • <%= rv.year %> — <%= rv.corps %>
                      </span>
                    <% } %>

                    <% if (rv && rv.rating_half != null) { %>
                      <span class="muted">
                        • ★ <%= (Number(rv.rating_half) / 2).toFixed(1) %>
                      </span>
                    <% } %>
                  </div>

                  <div class="reviewtext">“<%= rv && rv.review_text ? rv.review_text : "" %>”</div>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div
              class="muted"
              style="margin-top:8px;"
            >
              No reviews yet.
            </div>
          <% } %>
        </div>
      </section>
    </div>
  </main>

  <footer class="wrap footer">
    <div class="small">
      Rate drum corps shows.
    </div>
  </footer>

  <% if (me) { %>
    <script src="/static/js/presence.js?v=20260822a"></script>
  <% } %>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd = document.getElementById("notifDropdown");

      if (!btn || !dd) return;

      dd.addEventListener("click", (e) => {
        e.stopPropagation();
      });

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        dd.classList.toggle("open");
      });

      document.addEventListener("click", () => {
        dd.classList.remove("open");
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          dd.classList.remove("open");
        }
      });
    })();

    (() => {
      const dot = document.getElementById("profilePresenceDot");
      const text = document.getElementById("profilePresenceText");
      
      if (!dot) return;
      const profileUserId = Number(
        <%- JSON.stringify(Number(pu.id || 0)) %>
      );

      const isOwnProfile = <%= isMe ? "true" : "false" %>;

      if (!profileUserId) return;

      function applyStatus(value) {
        let status = String(value || "offline")
          .trim()
          .toLowerCase();

        if (!["online", "recent", "offline"].includes(status)) {
          status = "offline";
        }

        dot.classList.remove(
          "online",
          "recent",
          "offline"
        );

        dot.classList.add(status);

        const label = status === "online"
          ? "Online"
          : status === "recent"
            ? "Active recently"
            : "Offline";
        
        dot.title = label;
        dot.setAttribute("aria-label", label);
        
        if (text) {
          text.textContent = label;
        }
      }

      async function refreshProfilePresence() {
        if (document.visibilityState !== "visible") {
          return;
        }

        if (isOwnProfile) {
          applyStatus("online");
          return;
        }

        try {
          const response = await fetch(
            `/api/presence/user/${profileUserId}`,
            {
              method:"GET",
              credentials:"same-origin",
              cache:"no-store",
              headers:{
                "X-Requested-With":"XMLHttpRequest"
              }
            }
          );

          if (!response.ok) return;

          const data = await response.json();

          if (
            !data ||
            data.ok !== true ||
            !data.user
          ) {
            applyStatus("offline");
            return;
          }
          
          applyStatus(
            data.user.presence_status || "offline"
          );

        } catch (_) {
          // Presence should never break the profile page.
        }
      }

      refreshProfilePresence();

      setInterval(
        refreshProfilePresence,
        30 * 1000
      );

      document.addEventListener(
        "visibilitychange",
        () => {
          if (document.visibilityState === "visible") {
            refreshProfilePresence();
          }
        }
      );

      window.addEventListener(
        "focus",
        refreshProfilePresence
      );
    })();

    (() => {
      const row = document.getElementById(
        "favoriteShowsSortable"
      );

      if (!row) return;

      const status = document.getElementById(
        "favoriteOrderStatus"
      );

      let dragging = null;
      let startingOrder = "";
      let lastSavedOrder = "";
      let lastDragEndedAt = 0;
      let statusTimer = null;

      const items = () =>
        Array.from(
          row.querySelectorAll(
            ".profile_favorite_item[data-show-id]"
          )
        );

      const orderString = () =>
        items()
          .map((item) =>
            String(
              item.dataset.showId || ""
            )
          )
          .join(",");

      const updateRanks = () => {
        items().forEach(
          (item,index) => {
            const rank = item.querySelector(
              "[data-favorite-rank]"
            );

            if (rank) {
              rank.textContent = String(index + 1);
            }
          }
        );
      };

      const setStatus = (
        text,
        clearAfter = 0
      ) => {
        if (!status) return;

        status.textContent = text;

        if (statusTimer) {
          clearTimeout(statusTimer);
          statusTimer = null;
        }

        if (clearAfter > 0) {
          statusTimer = setTimeout(
            () => {
              status.textContent = "Drag to reorder";
            },
            clearAfter
          );
        }
      };

      const clearTargets = () => {
        items().forEach((item) => {
          item.classList.remove(
            "is_drag_target"
          );
        });
      };

      const saveOrder = async () => {
        const currentItems = items();

        const showIds = currentItems.map(
          (item) =>
            Number(item.dataset.showId)
        );

        const currentOrder = showIds.join(",");

        if (
          !showIds.length ||
          currentOrder === lastSavedOrder
        ) {
          return;
        }

        setStatus("Saving…");

        try {
          const response = await fetch(
            "/me/favorites/reorder",
            {
              method:"POST",
              credentials:"same-origin",
              headers:{
                "Content-Type":"application/json",
                "Accept":"application/json"
              },
              body:JSON.stringify({
                show_ids:showIds
              })
            }
          );

          const data = await response
            .json()
            .catch(() => null);

          if (
            !response.ok ||
            !data ||
            data.ok !== true
          ) {
            throw new Error(
              data?.error ||
              "Could not save favorite order."
            );
          }

          lastSavedOrder = currentOrder;

          setStatus(
            "Order saved",
            1200
          );

        } catch (err) {
          console.error(
            "Favorite reorder failed:",
            err
          );

          setStatus(
            "Could not save order",
            2200
          );
        }
      };

      lastSavedOrder = orderString();

      items().forEach((item) => {
        item.addEventListener(
          "dragstart",
          (event) => {
            dragging = item;
            startingOrder = orderString();

            event.dataTransfer.effectAllowed = "move";

            event.dataTransfer.setData(
              "text/plain",
              String(item.dataset.showId || "")
            );

            requestAnimationFrame(() => {
              item.classList.add(
                "is_dragging"
              );
            });
          }
        );

        item.addEventListener(
          "dragenter",
          (event) => {
            event.preventDefault();

            if (
              !dragging ||
              dragging === item
            ) {
              return;
            }

            clearTargets();

            item.classList.add(
              "is_drag_target"
            );
          }
        );

        item.addEventListener(
          "dragover",
          (event) => {
            if (
              !dragging ||
              dragging === item
            ) {
              return;
            }

            event.preventDefault();

            event.dataTransfer.dropEffect = "move";

            const rect = item.getBoundingClientRect();

            const centerX =
              rect.left +
              rect.width / 2;

            const centerY =
              rect.top +
              rect.height / 2;

            const verticalDistance =
              event.clientY -
              centerY;

            let putBefore;

            if (
              Math.abs(verticalDistance) >
              rect.height * .35
            ) {
              putBefore = verticalDistance < 0;
            } else {
              putBefore = event.clientX < centerX;
            }

            if (putBefore) {
              row.insertBefore(
                dragging,
                item
              );
            } else {
              row.insertBefore(
                dragging,
                item.nextSibling
              );
            }

            updateRanks();
          }
        );

        item.addEventListener(
          "drop",
          (event) => {
            event.preventDefault();
            clearTargets();
          }
        );

        item.addEventListener(
          "dragend",
          () => {
            if (!dragging) return;

            dragging.classList.remove(
              "is_dragging"
            );

            clearTargets();
            updateRanks();

            const changed =
              orderString() !==
              startingOrder;

            dragging = null;

            lastDragEndedAt = Date.now();

            if (changed) {
              saveOrder();
            }
          }
        );

        item.addEventListener(
          "click",
          (event) => {
            if (
              Date.now() -
              lastDragEndedAt <
              300
            ) {
              event.preventDefault();
            }
          }
        );
      });
    })();
  </script>
</body>
</html>
