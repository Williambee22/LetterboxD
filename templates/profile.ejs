<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= (profile_user && profile_user.username ? profile_user.username : "Profile") %> - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>

  <style>
    .auth { align-items:center; gap: 12px; }

.notifWrap { position: relative; display: inline-flex; align-items:center; }
  .bellBtn {
    position: relative;
    border: none;
    background: transparent;
    cursor: pointer;
    color: inherit;
    padding: 6px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.95;
  }
  .bellBtn:hover { background: rgba(255,255,255,0.06); }
  
  .badgeDot {
    position:absolute;
    top: 3px;
    right: 3px;
    min-width: 18px;
    height: 18px;
    padding: 0 6px;
    border-radius: 999px;
    background: #ff3b30;
    color: #fff;
    font-size: 11px;
    line-height: 18px;
    text-align: center;
    font-weight: 800;
    box-shadow: 0 6px 18px rgba(0,0,0,0.35);
  }
  
  .notifDropdown {
    display: none;
    position: absolute;
    right: 0;
    top: 40px;
    width: 340px;
    max-height: 420px;
    overflow: auto;
    background: rgba(15, 23, 42, 0.98);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    box-shadow: 0 14px 40px rgba(0,0,0,0.45);
    z-index: 9999;
  }
  .notifDropdown.open { display:block; }
  
  .notifHeader {
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(255,255,255,0.10);
    position: sticky;
    top: 0;
    background: rgba(15, 23, 42, 0.98);
    backdrop-filter: blur(8px);
  }
  .notifTitle { font-weight: 900; }
  
  .markReadBtn {
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.85;
    font-size: 12px;
    padding: 6px 8px;
    border-radius: 10px;
  }
  .markReadBtn:hover { background: rgba(255,255,255,0.06); opacity: 1; }
  
  .notifList { padding: 8px; display:flex; flex-direction:column; gap: 8px; }
  .notifItem {
    padding: 10px;
    border-radius: 12px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
  }
  .notifItem.unread { background: rgba(99,102,241,0.18); border-color: rgba(99,102,241,0.25); }
  .notifTime { font-size: 12px; opacity: 0.7; margin-top: 4px; }
  .notifEmpty { padding: 12px; opacity: 0.8; }
  
  .authBellSlot { display:inline-flex; align-items:center; }
  
  .notifDropdown,
  .notifDropdown * {
    pointer-events: auto !important;
  }

    .notifHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding: 10px 12px;
      border-bottom: 1px solid var(--accentSoft);
      position: sticky;
      top: 0;
      background: rgba(15, 23, 42, 0.98);
      backdrop-filter: blur(8px);
    }
    .notifTitle {
      font-weight: 900;
      color: var(--text);
    }

    .markReadBtn {
      border: 1px solid transparent;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.9;
      font-size: 12px;
      padding: 6px 8px;
      transition: background .15s ease, border-color .15s ease;
    }
    .markReadBtn:hover {
      background: var(--accentFaint);
      border-color: var(--accentSoft);
      opacity: 1;
    }

    .notifList { padding: 8px; display:flex; flex-direction:column; gap: 8px; }

    .notifItem {
      padding: 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      transition: border-color .15s ease, background .15s ease;
    }

    .notifItem.unread {
      background: var(--accentFaint);
      border-color: var(--accentSoft);
    }

    .notifItem a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 700;
    }
    .notifItem a:hover {
      text-decoration: underline;
    }

    .notifTime {
      font-size: 12px;
      opacity: 0.7;
      margin-top: 4px;
    }

    .notifEmpty {
      padding: 12px;
      opacity: 0.8;
    }

    .authBellSlot { display:inline-flex; align-items:center; }

    .notifDropdown,
    .notifDropdown * {
      pointer-events: auto !important;
    }

    .profile_top_actions{
      margin-top:10px;
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }

    .profile_counts .badge{
      border-color: var(--accentFaint);
      background: var(--accentFaint);
      color: var(--text);
    }

    .profile_bio{
      margin-top:12px;
      opacity:0.95;
      line-height:1.55;
      border-left: 3px solid var(--accentSoft);
      padding-left: 12px;
    }

    .profile_section_title{
      color: var(--accent);
    }

    .acct_details{
      border-top: 1px solid var(--accentSoft);
      padding-top: 12px;
      margin-top: 12px;
    }

    .acct_panel{
      border: 1px solid var(--accentSoft) !important;
      background: color-mix(in srgb, var(--accent) 6%, rgba(0,0,0,.92));
      box-shadow: 0 0 0 1px var(--accentFaint);
    }

    .profile_main_panel{
      border-color: var(--accentSoft);
      box-shadow: 0 0 0 1px var(--accentFaint);
    }

    .profile_ratings_panel .kicker,
    .profile_reviews_panel .kicker,
    .profile_stats .kicker{
      color: var(--accent);
    }

    .profile_stats {
        position: relative !important;
        background-attachment: scroll !important; /* Forces background to move with the box */
        width: 100% !important;
        margin: 10px 0 !important;
        display: flex !important;
        flex-wrap: wrap !important; /* Ensures stats don't squeeze too tight */
        justify-content: center !important;
        gap: 15px !important;
    }

    .profile_hero_inner h1{
      color: var(--text);
      text-shadow: 0 2px 18px rgba(0,0,0,.45);
    }

    /* Ensure the average rating box inside stats also flows */
    .profile_avg_box {
        position: relative !important;
        transform: none !important;
        margin: 0 auto !important;
    }

    .profile_avg_value{
      color: var(--text);
    }

    .profile_avg_star{
      color: var(--accent);
    }

    .role_tag{
      box-shadow: 0 0 0 1px rgba(0,0,0,.15) inset;
    }

    .poster_meta{
      border-top: 1px solid var(--accentFaint);
    }

    .reviewcard{
      border-color: var(--accentSoft);
      background: color-mix(in srgb, var(--accent) 5%, rgba(7,10,16,.35));
    }

    .reviewtext{
      border-left: 3px solid var(--accentSoft);
      padding-left: 12px;
      margin-top: 12px;
    }

    .tile_rating{
      border-color: var(--accentSoft) !important;
      background: rgba(0,0,0,.72) !important;
    }

    .tile_star{
      color: var(--accent) !important;
    }

    .topline_accent{
      border-top: 1px solid var(--accentSoft);
      padding-top: 12px;
    }

    /* ... keep all your existing notification and desktop styles ... */

    /* ADD OR UPDATE THIS SECTION */
    @media (max-width: 768px) {
        /* 1. Force the Header to be part of the scroll, not staying at the top */
        .topbar {
            position: relative !important;
            height: auto !important;
            padding: 15px 0 !important;
        }
        
        .topbar .wrap {
            flex-direction: column !important;
            gap: 15px !important;
        }
    
        /* 2. NEUTRALIZE THE SIDEBAR (This is likely what's 'locking' the stats) */
        .profile_layout {
            display: flex !important;
            flex-direction: column !important; /* Stack sidebar on top of content */
        }
    
        aside.profile_side, .profile_side {
            position: relative !important;
            top: 0 !important;
            width: 100% !important;
            margin-bottom: 20px !important;
            display: block !important;
        }
    
        /* 3. FIX THE STATS BOX */
        .profile_stats {
            position: relative !important;
            display: block !important; /* Back to standard block flow */
            width: 100% !important;
            background-attachment: scroll !important; /* Fixes "frozen" background issues */
            margin: 0 0 20px 0 !important;
            box-shadow: none !important;
            transform: none !important;
        }
    
        /* 4. Fix Hero/Avatar for Mobile */
        .profile_hero_inner {
            padding: 20px 10px !important;
        }
    
        .profile_hero_inner .row.gap {
            flex-direction: column !important;
            text-align: center !important;
        }
    
        .avatar_lg {
            margin: 0 auto 15px auto !important;
        }
    
        /* 5. Force the 3-column grid for posters */
        .postergrid {
            display: grid !important;
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 8px !important;
        }
    
        /* 6. Fix the 'Stats' section internals so they don't look squished */
        .profile_stats .kicker {
            text-align: center;
        }
        
        .profile_stats .muted.small {
            text-align: center;
            display: block;
        }
    }

  </style>
</head>

<%
  const pu = profile_user || {};
  const meUsername = me && me.username ? me.username : null;
  const puUsername = pu && pu.username ? pu.username : null;
  const isMe = typeof is_me !== "undefined"
    ? !!is_me
    : !!(meUsername && puUsername && meUsername === puUsername);

  const viewerIsFollowing = !!pu.viewer_is_following;
  const friendStatus = pu.viewer_friend_status || "none";

  const recentRatings = Array.isArray(recent_ratings) ? recent_ratings : [];
  const recentReviews = Array.isArray(recent_reviews) ? recent_reviews : [];
  const roles = Array.isArray(user_roles) ? user_roles : [];
  const flashesList = Array.isArray(flashes) ? flashes : [];

  const avgRatingCnt = pu.avg_rating_cnt != null ? Number(pu.avg_rating_cnt) : 0;
  const avgRating = pu.avg_rating != null ? Number(pu.avg_rating) : 0;
%>

<body
  class="app"
  <%= pu && pu.theme_color
    ? `style="
        --accent: ${pu.theme_color};
        --accent2: ${pu.theme_color};
        --accentSoft: color-mix(in srgb, ${pu.theme_color} 55%, transparent);
        --accentFaint: color-mix(in srgb, ${pu.theme_color} 22%, transparent);
      "`
    : ""
  %>>
  <header class="topbar">
    <div class="wrap row between">
      <div style="display: flex; align-items: center; gap: 10px;">
        
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" style="display: flex; align-items: center; text-decoration: none;">
          <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <img 
              src="/static/logo.png" 
              alt="Logo" 
              style="max-width: 35px; max-height: 35px; width: auto; height: auto; object-fit: contain; transition: transform 0.6s ease-in-out;"
              onmouseover="this.style.transform='rotate(360deg)'" 
              onmouseout="this.style.transform='rotate(0deg)'"
            >
          </div>
        </a>
  
        <a class="brand" href="/shows">
          <span>Pressboxd</span>
        </a>
  
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <% if (me && Number(me.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (me) { %>
          <div class="authBellSlot">
            <div class="notifWrap">
              <button class="bellBtn" id="bellBtn" aria-label="Notifications" title="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1"/>
                  <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
                </svg>

                <% if (notif_count && notif_count > 0) { %>
                  <span class="badgeDot"><%= notif_count %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>
                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>

                <% if (notif_items && notif_items.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of notif_items) {
                      const kind = n.kind || "";
                      const actor = n.actor_username || "Someone";
                      const created = n.created_at || "";
                      const unread = Number(n.is_read || 0) === 0;
                      const sid = n.show_id || null;
                    %>
                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>
                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>
                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else if (kind === "review_comment") { %>
                          <div>
                            <b><%= actor %></b> commented on your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (me.avatar_url) { %>
                <img src="<%= me.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= me.username %></span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <% if (flashesList.length > 0) { %>
      <div class="flashes">
        <% for (const f of flashesList) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <% if (pu.username) { %>
      <div class="profile_top_actions profile_counts">
        <a class="badge muted" href="/u/<%= encodeURIComponent(pu.username) %>/followers">
          Followers: <%= pu.followers_count != null ? pu.followers_count : 0 %>
        </a>

        <a class="badge muted" href="/u/<%= encodeURIComponent(pu.username) %>/following">
          Following: <%= pu.following_count != null ? pu.following_count : 0 %>
        </a>

        <% if (me && !isMe) { %>
          <% if (viewerIsFollowing) { %>
            <form method="post" action="/u/<%= encodeURIComponent(pu.username) %>/unfollow">
              <button class="btn ghost" type="submit">Unfollow</button>
            </form>
          <% } else { %>
            <form method="post" action="/u/<%= encodeURIComponent(pu.username) %>/follow">
              <button class="btn green" type="submit">Follow</button>
            </form>
          <% } %>

          <% if (friendStatus === "friends") { %>
            <form method="post" action="/u/<%= encodeURIComponent(pu.username) %>/friend/remove">
              <button class="btn ghost" type="submit">Remove friend</button>
            </form>
          <% } else if (friendStatus === "pending_out") { %>
            <span class="badge muted">Friend request sent</span>
          <% } else if (friendStatus === "pending_in") { %>
            <form method="post" action="/u/<%= encodeURIComponent(pu.username) %>/friend/accept">
              <button class="btn green" type="submit">Accept friend</button>
            </form>
            <form method="post" action="/u/<%= encodeURIComponent(pu.username) %>/friend/decline">
              <button class="btn ghost" type="submit">Decline</button>
            </form>
          <% } else { %>
            <form method="post" action="/u/<%= encodeURIComponent(pu.username) %>/friend/request">
              <button class="btn ghost" type="submit">Add friend</button>
            </form>
          <% } %>
        <% } %>

        <% if (isMe) { %>
          <a class="btn ghost" href="/me/friends">Friends</a>
        <% } %>
      </div>
    <% } %>

    <div class="profile_hero" <%= pu.banner_url ? `style="--pBanner:url('${pu.banner_url}');"` : "" %>>
      <div class="profile_hero_inner" <%= pu.theme_color ? `style="--pAccent: ${pu.theme_color};"` : "" %>>
        <div class="row gap" style="align-items:center;">
          <div class="avatar_lg">
            <% if (pu.avatar_url) { %>
              <img src="<%= pu.avatar_url %>" alt="avatar">
            <% } else { %>
              <div class="avatar_fallback"></div>
            <% } %>
          </div>

          <div style="min-width:0; flex: 1;">
            <div class="kicker" style="color: var(--accent);">Profile</div>
            <h1 style="margin:6px 0 0;"><%= pu.username || "User" %></h1>

            <% if (roles.length > 0) { %>
              <div class="row gap" style="margin-top:10px; flex-wrap:wrap;">
                <% for (const r of roles) { %>
                  <span class="role_tag" <%= r && r.color ? `style="border-color:${r.color}; color:${r.color}; background:${r.color}22;"` : "" %>>
                    <%= r && r.name ? r.name : "" %>
                  </span>
                <% } %>
              </div>
            <% } %>

            <% if (pu.bio) { %>
              <div class="profile_bio">
                <%= pu.bio %>
              </div>
            <% } %>

            <% if (pu.username) { %>
              <div class="row gap" style="margin-top:10px; flex-wrap:wrap;">
                <% if (isMe) { %>
                  <a class="btn ghost" href="/me/customize">Customize</a>
                <% } %>
                <a class="btn ghost" href="/u/<%= encodeURIComponent(pu.username) %>/ratings">All Ratings</a>
              </div>
            <% } %>
          </div>

          <div class="profile_avg_box">
            <div class="kicker" style="color: var(--accent);">Avg rating</div>
            <% if (avgRatingCnt > 0) { %>
              <div class="profile_avg_value">
                <span class="profile_avg_star">★</span>
                <%= avgRating.toFixed(2) %>
              </div>
              <div class="muted small"><%= avgRatingCnt %> ratings</div>
            <% } else { %>
              <div class="muted">No ratings</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="profile_layout" style="margin-top:16px;">
      <aside class="profile_side">
        <div class="panel profile_stats">
          <div class="kicker" style="color: var(--accent);">Stats</div>
          <div class="muted small" style="margin-top:10px;">
            Ratings shown: <%= recentRatings.length %><br/>
            Reviews shown: <%= recentReviews.length %>
          </div>

          <% if (me && Number(me.is_admin) === 1 && pu.username) { %>
            <div style="margin-top:10px;">
              <a class="btn ghost" href="/admin/user/<%= encodeURIComponent(pu.username) %>/roles">Roles</a>
            </div>
          <% } %>

          <% if (isMe) { %>
            <div class="acct_details">
              <details>
                <summary class="btn ghost" style="width:100%; justify-content:space-between;">
                  Account
                  <span class="muted small">▼</span>
                </summary>

                <div class="panel acct_panel" style="margin-top:10px; padding:14px;">
                  <div class="kicker profile_section_title">Account</div>

                  <div style="margin-top:12px; display:grid; grid-template-columns: 1fr; gap:14px;">
                    <div>
                      <div class="muted small" style="margin-bottom:8px;"><b>Change username</b></div>
                      <form method="post" action="/me/change_username">
                        <div class="field">
                          <label>New username</label>
                          <input name="new_username" placeholder="New username" autocomplete="username">
                        </div>

                        <div class="field">
                          <label>Current password</label>
                          <input type="password" name="current_password" placeholder="Current password" autocomplete="current-password">
                        </div>

                        <div class="actions">
                          <button class="btn green" type="submit">Update username</button>
                        </div>
                      </form>
                    </div>

                    <div class="topline_accent">
                      <div class="muted small" style="margin-bottom:8px;"><b>Change password</b></div>
                      <form method="post" action="/me/change_password">
                        <div class="field">
                          <label>Current password</label>
                          <input type="password" name="current_password" placeholder="Current password" autocomplete="current-password">
                        </div>

                        <div class="field">
                          <label>New password</label>
                          <input type="password" name="new_password" placeholder="New password" autocomplete="new-password">
                        </div>

                        <div class="field">
                          <label>Confirm new password</label>
                          <input type="password" name="new_password2" placeholder="Confirm new password" autocomplete="new-password">
                        </div>

                        <div class="actions">
                          <button class="btn green" type="submit">Update password</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              </details>
            </div>
          <% } %>
        </div>
      </aside>

      <section class="stack">
        <% if (isMe) { %>
          <div class="panel profile_main_panel">
            <div class="kicker profile_section_title">Bio</div>
            <div class="field" style="margin-top:12px;">
              <form method="post" action="/me/update_bio">
                <textarea name="bio" placeholder="Tell us about your favorite corps..." rows="3" style="width:100%;"><%= pu.bio || "" %></textarea>
                <div class="actions" style="margin-top:8px;">
                  <button class="btn green" type="submit">Save Bio</button>
                </div>
              </form>
            </div>
          </div>
        <% } %>

        <div class="panel profile_ratings_panel">
          <div class="kicker" style="color: var(--accent);">Recent ratings</div>

          <% if (recentRatings.length > 0) { %>
            <div class="postergrid" style="margin-top:12px;">
              <% for (const rr of recentRatings) {
                const rh = rr && rr.rating_half != null ? Number(rr.rating_half) : 0;
              %>
                <a class="poster" href="/show/<%= rr.show_id %>">
                  <div class="poster_art">
                    <% if (rr && rr.poster_url) { %>
                      <img class="poster_img" src="<%= rr.poster_url %>" alt="<%= rr.title || 'poster' %> poster" loading="lazy, object-position:center center;">
                    <% } else { %>
                      <div class="poster_fallback"></div>
                    <% } %>

                    <div class="tile_rating">
                      <span class="tile_star">★</span> <%= (rh / 2).toFixed(1) %>
                    </div>

                    <% if (rr && rr.year) { %>
                      <div class="tile_year"><%= rr.year %></div>
                    <% } %>
                  </div>

                  <div class="poster_meta">
                    <div class="poster_title"><%= rr && rr.title ? rr.title : "" %></div>
                    <div class="poster_sub"><%= rr && rr.corps ? rr.corps : "" %></div>
                  </div>
                </a>
              <% } %>
            </div>
          <% } else { %>
            <div class="muted" style="margin-top:8px;">No ratings yet.</div>
          <% } %>
        </div>

        <div class="panel profile_reviews_panel">
          <div class="kicker" style="color: var(--accent);">Recent reviews</div>

          <% if (recentReviews.length > 0) { %>
            <div class="reviewlist" style="margin-top:12px;">
              <% for (const rv of recentReviews) { %>
                <div class="reviewcard">
                  <div class="small">
                    <a class="reviewuser" href="/show/<%= rv.show_id %>">
                      <%= rv && rv.title ? rv.title : "Show" %>
                    </a>

                    <% if (rv && rv.year && rv.corps) { %>
                      <span class="muted">• <%= rv.year %> — <%= rv.corps %></span>
                    <% } %>

                    <% if (rv && rv.rating_half != null) { %>
                      <span class="muted">• ★ <%= (Number(rv.rating_half) / 2).toFixed(1) %></span>
                    <% } %>
                  </div>

                  <div class="reviewtext">“<%= rv && rv.review_text ? rv.review_text : "" %>”</div>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div class="muted" style="margin-top:8px;">No reviews yet.</div>
          <% } %>
        </div>
      </section>
    </div>
  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd  = document.getElementById("notifDropdown");
      if (btn && dd) {
        dd.addEventListener("click", (e) => e.stopPropagation());
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          dd.classList.toggle("open");
        });
        document.addEventListener("click", () => dd.classList.remove("open"));
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") dd.classList.remove("open");
        });
      }
    })();
  </script>
</body>
</html>

























