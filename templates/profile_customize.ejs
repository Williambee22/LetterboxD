<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Customize Profile - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
  <link rel="icon" type="image/png" href="/static/favicon.png"/>

  <style>
    .auth { align-items:center; gap: 12px; }

    .notifWrap { position: relative; display: inline-flex; align-items:center; }
    .bellBtn {
      position: relative;
      border: none;
      background: transparent;
      cursor: pointer;
      color: inherit;
      padding: 6px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.95;
    }
    .bellBtn:hover { background: rgba(255,255,255,0.06); }
    .badgeDot {
      position:absolute;
      top: 3px;
      right: 3px;
      min-width: 18px;
      height: 18px;
      padding: 0 6px;
      border-radius: 999px;
      background: #ff3b30;
      color: #fff;
      font-size: 11px;
      line-height: 18px;
      text-align: center;
      font-weight: 800;
      box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }

    .notifDropdown {
      display: none;
      position: absolute;
      right: 0;
      top: 40px;
      width: 340px;
      max-height: 420px;
      overflow: auto;
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.45);
      z-index: 9999;
    }
    .notifDropdown.open { display:block; }

    .notifHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding: 10px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.10);
      position: sticky;
      top: 0;
      background: rgba(15, 23, 42, 0.98);
      backdrop-filter: blur(8px);
    }
    .notifTitle { font-weight: 900; }
    .markReadBtn {
      border: none;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.85;
      font-size: 12px;
      padding: 6px 8px;
      border-radius: 10px;
    }
    .markReadBtn:hover { background: rgba(255,255,255,0.06); opacity: 1; }

    .notifList { padding: 8px; display:flex; flex-direction:column; gap: 8px; }
    .notifItem {
      padding: 10px;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
    }
    .notifItem.unread { background: rgba(99,102,241,0.18); border-color: rgba(99,102,241,0.25); }
    .notifTime { font-size: 12px; opacity: 0.7; margin-top: 4px; }
    .notifEmpty { padding: 12px; opacity: 0.8; }

    .authBellSlot { display:inline-flex; align-items:center; }

    .notifDropdown,
    .notifDropdown * {
      pointer-events: auto !important;
    }

    .customGrid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
      max-width: 820px;
      margin-top: 14px;
    }

    .previewCard {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 16px;
      align-items: center;
    }

    .previewAvatar {
      width: 96px;
      height: 96px;
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.04);
      display:flex;
      align-items:center;
      justify-content:center;
    }
    .previewAvatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display:block;
    }

   

    .dropzone {
      border: 1px dashed rgba(255,255,255,.18);
      border-radius: 14px;
      padding: 18px;
      cursor: pointer;
      background: rgba(255,255,255,.03);
      transition: .15s ease;
    }
    .dropzone:hover,
    .dropzone.hover {
      background: rgba(255,255,255,.05);
      border-color: rgba(255,255,255,.28);
    }
    .dropzone_inner {
      display:flex;
      flex-direction:column;
      gap: 4px;
      align-items:center;
      justify-content:center;
      min-height: 78px;
      text-align:center;
    }

    .themeRow {
      display:flex;
      gap:12px;
      align-items:center;
      flex-wrap: wrap;
    }

    .colorPreview {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,.14);
      flex: 0 0 auto;
    }

    .bannerPreviewWrap {
      width: 100%;
      min-height: 180px;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.04);
    }
    
    .bannerPreview {
      width: 100%;
      height: 180px;
      background: rgba(255,255,255,.03);
      display:flex;
      align-items:center;
      justify-content:center;
      overflow: hidden;
    }
    
    .bannerPreview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display:block;
    }
    
    .bannerPreviewEmpty {
      color: var(--muted);
      font-size: 14px;
      opacity: 0.85;
      text-align: center;
      padding: 20px;
    }



    @media (max-width: 700px) {
      .previewCard {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body class="app" <%= me && me.theme_color ? `style="--accent: ${me.theme_color};"` : "" %>>
<%
  const safeMe = (typeof me !== "undefined" && me) ? me : null;
  const safeU = (typeof u !== "undefined" && u) ? u : {};
  const safeNotifCount = (typeof notif_count !== "undefined" && notif_count) ? notif_count : 0;
  const safeNotifItems = (typeof notif_items !== "undefined" && Array.isArray(notif_items)) ? notif_items : [];
  const safeFlashes = (typeof flashes !== "undefined" && Array.isArray(flashes)) ? flashes : [];
  const currentAvatar = safeU.avatar_url || '';
  const currentBanner = safeU.banner_url || '';
  const currentTheme = safeU.theme_color || '';
%>

  <header class="topbar">
    <div class="wrap row between">
      <div style="display:flex; align-items:center; gap:10px;">
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" style="display:flex; align-items:center;">
          <img
            src="/static/logo.png"
            alt="Logo"
            style="width:36px; height:36px; object-fit:contain; transition: transform 0.6s ease-in-out;"
            onmouseover="this.style.transform='rotate(360deg)'"
            onmouseout="this.style.transform='rotate(0deg)'"
          >
        </a>
      
        <a class="brand" href="/shows" style="display:flex; align-items:center;">
          <img
            src="/static/pressboxd-wordmark.png"
            alt="Pressboxd"
            style="height:68px; width:auto; display:block;"
          >
        </a>
      </div>


      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <% if (safeMe && Number(safeMe.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (safeMe) { %>
          <div class="authBellSlot">
            <div class="notifWrap">
              <button class="bellBtn" id="bellBtn" aria-label="Notifications" title="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1"/>
                  <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
                </svg>

                <% if (safeNotifCount > 0) { %>
                  <span class="badgeDot"><%= safeNotifCount %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>
                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>

                <% if (safeNotifItems.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of safeNotifItems) {
                      const kind = n.kind || "";
                      const actor = n.actor_username || "Someone";
                      const created = n.created_at || "";
                      const unread = Number(n.is_read || 0) === 0;
                      const sid = n.show_id || null;
                    %>
                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>
                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>
                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else if (kind === "review_comment") { %>
                          <div>
                            <b><%= actor %></b> commented on your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (safeMe.avatar_url) { %>
                <img src="<%= safeMe.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= safeMe.username %></span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <% if (safeFlashes.length > 0) { %>
      <div class="flashes">
        <% for (const f of safeFlashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <div class="row between" style="margin-top:10px; gap:12px; flex-wrap:wrap;">
      <div>
        <div class="kicker">Settings</div>
        <h1 style="margin:6px 0 0;">Customize Profile</h1>
      </div>
      <a class="btn ghost" href="/me">Back to Profile</a>
    </div>

    <div class="customGrid">

      <div class="panel">
        <div class="kicker">Profile Picture</div>

        <div class="previewCard" style="margin-top:14px;">
          <div class="previewAvatar">
            <% if (currentAvatar) { %>
              <img src="<%= currentAvatar %>" alt="Current profile picture">
            <% } else { %>
              <div class="avatar_fallback"></div>
            <% } %>
          </div>

          <div>
            <div class="muted small" style="margin-bottom:10px;">Upload a new profile picture.</div>

            <div class="dropzone" id="pfpDrop">
              <div class="dropzone_inner">
                <div class="muted">Drag & drop image or click</div>
                <div class="muted small">PNG / JPG / WEBP</div>
              </div>
            </div>

            <form id="pfpUploadForm" method="post" action="/me/upload_pfp" enctype="multipart/form-data">
              <input type="file" id="pfpFileReal" name="pfp_file" accept="image/*" hidden>
            </form>
          </div>
        </div>
      </div>
    <div class="panel">
      <div class="kicker">Profile Banner</div>
    
      <div style="margin-top:14px; display:grid; gap:14px;">
        <div class="bannerPreviewWrap">
          <div class="bannerPreview">
            <% if (currentBanner) { %>
              <img src="<%= currentBanner %>" alt="Current profile banner">
            <% } else { %>
              <div class="bannerPreviewEmpty">No banner uploaded yet.</div>
            <% } %>
          </div>
        </div>
    
        <div>
          <div class="muted small" style="margin-bottom:10px;">Upload a banner image for your profile header.</div>
    
          <div class="dropzone" id="bannerDrop">
            <div class="dropzone_inner">
              <div class="muted">Drag & drop banner image or click</div>
              <div class="muted small">PNG / JPG / WEBP</div>
            </div>
          </div>
    
          <form id="bannerUploadForm" method="post" action="/me/upload_banner" enctype="multipart/form-data">
            <input type="file" id="bannerFileReal" name="banner_file" accept="image/*" hidden>
          </form>
        </div>
      </div>
    </div>
      <div class="panel">
        <div class="kicker">Theme Color</div>

        <form method="post" action="/me/customize" style="margin-top:14px;">
          <div class="field">
            <label>Accent Color</label>

            <div class="themeRow">
              <input
                id="themeColorInput"
                name="theme_color"
                value="<%= currentTheme %>"
                placeholder="#4ea1ff"
                style="max-width:220px;"
              >
              <input
                id="themeColorPicker"
                type="color"
                value="<%= (/^#([0-9a-fA-F]{6})$/.test(currentTheme || '') ? currentTheme : '#4ea1ff') %>"
                style="width:52px; height:42px; padding:0; border:none; background:transparent; cursor:pointer;"
              >
              <div
                id="colorPreview"
                class="colorPreview"
                style="background:<%= (/^#([0-9a-fA-F]{6})$/.test(currentTheme || '') ? currentTheme : '#4ea1ff') %>;"
              ></div>
            </div>

            <div class="muted small" style="margin-top:8px;">
              Allowed format: <code>#RRGGBB</code> (example: <code>#22c55e</code>)
            </div>
          </div>

          <div class="actions" style="margin-top:16px;">
            <button class="btn" type="submit">Save Theme</button>
            <a class="btn ghost" href="/me">Cancel</a>
          </div>
        </form>
      </div>

    </div>
  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd  = document.getElementById("notifDropdown");
      if (btn && dd) {
        dd.addEventListener("click", (e) => e.stopPropagation());

        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          dd.classList.toggle("open");
        });

        document.addEventListener("click", () => {
          dd.classList.remove("open");
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") dd.classList.remove("open");
        });
      }

      function setupDropzone(dropId, inputId, formId) {
        const drop = document.getElementById(dropId);
        const input = document.getElementById(inputId);
        const form = document.getElementById(formId);
        if (!drop || !input || !form) return;

        drop.addEventListener("click", () => input.click());

        input.addEventListener("change", () => {
          if (input.files && input.files[0]) form.submit();
        });

        drop.addEventListener("dragover", (e) => {
          e.preventDefault();
          drop.classList.add("hover");
        });

        drop.addEventListener("dragleave", () => {
          drop.classList.remove("hover");
        });

        drop.addEventListener("drop", (e) => {
          e.preventDefault();
          drop.classList.remove("hover");

          if (e.dataTransfer.files && e.dataTransfer.files[0]) {
            const dt = new DataTransfer();
            dt.items.add(e.dataTransfer.files[0]);
            input.files = dt.files;
            form.submit();
          }
        });
      }

      setupDropzone("pfpDrop", "pfpFileReal", "pfpUploadForm");
      setupDropzone("bannerDrop", "bannerFileReal", "bannerUploadForm");

      const textInput = document.getElementById("themeColorInput");
      const colorPicker = document.getElementById("themeColorPicker");
      const colorPreview = document.getElementById("colorPreview");

      function syncColorFromText() {
        const v = String(textInput.value || "").trim();
        if (/^#([0-9a-fA-F]{6})$/.test(v)) {
          colorPicker.value = v;
          colorPreview.style.background = v;
        }
      }

      function syncColorFromPicker() {
        const v = colorPicker.value;
        textInput.value = v;
        colorPreview.style.background = v;
      }

      if (textInput && colorPicker && colorPreview) {
        textInput.addEventListener("input", syncColorFromText);
        colorPicker.addEventListener("input", syncColorFromPicker);
      }
    })();
  </script>
</body>
</html>

