<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Reset Password - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
</head>
<body class="app">
  <main class="wrap">
    <% if (Array.isArray(flashes) && flashes.length > 0) { %>
      <div class="flashes">
        <% for (const f of flashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <h1>Reset Password</h1>

    <form class="panel form" method="post" action="/reset-password/<%= encodeURIComponent(token) %>">
      <label>New password</label>
      <input type="password" name="new_password" required minlength="6"/>

      <label>Confirm new password</label>
      <input type="password" name="new_password2" required minlength="6"/>

      <button class="btn green" type="submit">Save new password</button>
    </form>
  </main>
</body>
</html>
