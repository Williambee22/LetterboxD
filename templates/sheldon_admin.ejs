<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Manage Sheldon Results - Pressboxd</title><link rel="stylesheet" href="/static/styles.css"><%- include('sheldon_styles') %></head><body class="app" style="--accent:#3252b3"><%- include('sheldon_header') %><main class="sr-wrap"><div class="sr-heading"><div><div class="sr-kicker">ADMIN DASHBOARD</div><h1>Manage Sheldon Results</h1><div class="sr-muted">Upload Excel workbooks. Every upload creates a separate public results page.</div></div><a class="sr-btn" href="/sheldon-results">View public results</a></div><section class="sr-panel"><h2 style="margin:0 0 15px">Upload a result sheet</h2><form action="/sheldon-results/admin/upload" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf" value="<%= csrf %>"><div class="sr-fields"><label class="sr-field">Result title<input name="title" placeholder="2026 Sheldon Invitational — Prelims" maxlength="160" required></label><label class="sr-field">Category<select name="category" required><option value="DCI">DCI</option><option value="BOA">BOA</option><option value="Other">Other</option></select></label><label class="sr-field">Excel workbook (.xlsx)<input type="file" name="file" accept=".xlsx" required></label><label class="sr-field">Description (optional)<input name="description" maxlength="600" placeholder="Preliminary competition results"></label></div><div class="sr-actions"><button class="sr-btn sr-primary" type="submit">Upload & create results page</button><span class="sr-hint">Multiple worksheet tabs supported · Up to 12 MB per upload</span></div></form></section><section class="sr-panel"><h2 style="margin:0 0 13px">Uploaded sheets</h2><% if(!items.length){ %><p class="sr-muted">No results uploaded yet.</p><% } %><% items.forEach(x=>{ %><div style="display:flex;justify-content:space-between;align-items:center;gap:12px;border-bottom:1px solid #252525;padding:12px 0"><div><strong><%= x.title %></strong><div class="sr-muted"><%= x.category %> · ID <%= x.id %></div></div><div class="sr-actions" style="margin:0"><a class="sr-btn" href="/sheldon-results/<%= x.id %>">View</a><a class="sr-btn sr-primary" href="/sheldon-results/<%= x.id %>/edit">Edit grid</a><form action="/sheldon-results/<%= x.id %>/delete" method="post" onsubmit="return confirm('Permanently delete this result sheet?')"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="sr-btn" type="submit">Delete</button></form></div></div><% }) %></section></main></body></html>
