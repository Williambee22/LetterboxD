<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sheldon Results - Pressboxd</title><link rel="stylesheet" href="/static/styles.css"><%- include('sheldon_styles') %></head><body class="app" style="--accent:#3252b3"><%- include('sheldon_header') %><main class="sr-wrap"><div class="sr-heading"><div><div class="sr-kicker">COMPETITION ARCHIVE</div><h1>Sheldon <span style="color:#597ff5">Results</span></h1><div class="sr-muted">Explore results from DCI, BOA, and other competitions.</div></div><% if(me && Number(me.is_admin)===1){ %><a class="sr-btn sr-primary" href="/sheldon-results/admin">Manage / Upload Results</a><% } %></div><div class="sr-tabs" id="categories"><button type="button" class="sr-tab active" data-cat="All">All Results</button><button type="button" class="sr-tab" data-cat="DCI">DCI</button><button type="button" class="sr-tab" data-cat="BOA">BOA</button><button type="button" class="sr-tab" data-cat="Other">Other</button></div><div class="sr-gridcards" id="resultsCards"><% items.forEach(item=>{ %><a class="sr-card" data-category="<%= item.category %>" href="/sheldon-results/<%= item.id %>"><span class="sr-tag"><%= item.category %></span><h2><%= item.title %></h2><div class="sr-muted"><%= item.description || 'View the complete score sheet' %></div><div class="sr-meta" style="margin-top:15px">Published <%= new Date(item.created_ts*1000).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %> →</div></a><% }) %></div><p class="sr-muted" id="noResults" style="display:none">No results in this category yet.</p></main><footer class="sr-footer">Pressboxd · Sheldon Results</footer><script>const cards=[...document.querySelectorAll('#resultsCards [data-category]')],none=document.getElementById('noResults');function filter(cat){let visible=0;for(const c of cards){let show=cat==='All'||c.dataset.category===cat;c.hidden=!show;if(show)visible++}none.style.display=visible?'none':'block';document.querySelectorAll('[data-cat]').forEach(b=>b.classList.toggle('active',b.dataset.cat===cat));}document.querySelectorAll('[data-cat]').forEach(b=>b.addEventListener('click',()=>filter(b.dataset.cat)));filter('All');</script>
<script>
/* Sheldon Results: reset the one-visit unlock when leaving the archive.
   Normal navigation among results pages does not reset progress. */
(() => {
  let navigatingWithinResults = false;
  const archivePath = path => /^\/sheldon-results(?:\/|$)/.test(path);

  document.addEventListener('click', event => {
    const link = event.target.closest('a[href]');
    if (!link || event.defaultPrevented) return;
    const destination = new URL(link.href, location.href);
    navigatingWithinResults =
      destination.origin === location.origin &&
      archivePath(destination.pathname) &&
      !/^\/sheldon-results\/admin(?:\/|$)/.test(destination.pathname);
  }, true);

  document.addEventListener('submit', event => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement)) return;
    const destination = new URL(form.action, location.href);
    navigatingWithinResults =
      destination.origin === location.origin &&
      archivePath(destination.pathname);
  }, true);

  window.addEventListener('pagehide', () => {
    if (!navigatingWithinResults) {
      navigator.sendBeacon('/__sheldon/reset', new Blob([], { type: 'text/plain' }));
    }
  });
})();
</script>
</body></html>
