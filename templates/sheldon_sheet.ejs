<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= item.title %> - Sheldon Results</title><link rel="stylesheet" href="/static/styles.css"><%- include('sheldon_styles') %></head><body class="app" style="--accent:#3252b3"><%- include('sheldon_header') %><main class="sr-wrap"><div class="sr-heading"><div><div class="sr-kicker"><a href="/sheldon-results" style="color:#aaa;text-decoration:none">Sheldon Results</a> / <%= item.category %></div><h1><%= item.title %></h1><div class="sr-muted"><%= item.description %></div></div><div class="sr-actions"><% if(me && Number(me.is_admin)===1){ %><a class="sr-btn <%= editing?'sr-primary':'' %>" href="/sheldon-results/<%= item.id %>/edit?sheet=<%= chosen %>">Edit formatting</a><% } %><a class="sr-btn" href="/sheldon-results/<%= item.id %>?sheet=<%= chosen %>">Public view</a></div></div><% if(editing){ %><div class="sr-notice">Admin editor · Click a cell, or drag across cells to select a range. Your saved changes immediately appear on the public page.</div><section class="sr-panel"><form method="post" action="/sheldon-results/<%= item.id %>/info"><input type="hidden" name="csrf" value="<%= csrf %>"><div class="sr-fields"><label class="sr-field">Title<input name="title" value="<%= item.title %>" required maxlength="160"></label><label class="sr-field">Category<select name="category"><% ['DCI','BOA','Other'].forEach(c=>{ %><option value="<%= c %>" <%= c===item.category?'selected':'' %>><%= c %></option><% }) %></select></label><label class="sr-field">Description<input name="description" value="<%= item.description %>" maxlength="600"></label></div><div class="sr-actions"><button class="sr-btn" type="submit">Save page details</button></div></form></section><section class="sr-panel"><h2 style="margin:0 0 6px;font-size:16px">Cell & range editor</h2><div class="sr-hint" id="selectedRange">Select cells in the grid below.</div><form method="post" action="/sheldon-results/<%= item.id %>/edit" id="editCellsForm"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="sheet" value="<%= chosen %>"><input type="hidden" name="r1" id="r1"><input type="hidden" name="r2" id="r2"><input type="hidden" name="c1" id="c1"><input type="hidden" name="c2" id="c2"><div class="sr-fields" style="margin-top:14px"><label class="sr-field">Cell text (one selected cell)<input name="value" id="cellText" maxlength="1200" placeholder="Select a single cell"></label><label class="sr-field">Font color<input type="color" name="color" value="#ffffff"></label><label class="sr-field">Background start<input type="color" name="bg" value="#161616"></label><label class="sr-field">Gradient end<input type="color" name="gradientEnd" value="#161616"></label><label class="sr-field">Background type<select id="gradientToggle"><option value="solid">Solid</option><option value="gradient">Gradient</option></select></label><label class="sr-field">Gradient direction<select name="gradientAngle"><option value="0">Left to right</option><option value="90">Top to bottom</option></select></label><label class="sr-field">Bold<select name="bold"><option value="no">Normal</option><option value="yes">Bold</option></select></label><label class="sr-field">Italic<select name="italic"><option value="no">Normal</option><option value="yes">Italic</option></select></label><label class="sr-field">Alignment<select name="align"><option value="left">Left</option><option value="center">Center</option><option value="right">Right</option></select></label></div><div class="sr-actions"><button class="sr-btn sr-primary" type="submit" name="action" value="style" id="applyStyle" disabled>Apply formatting</button><button class="sr-btn" type="submit" name="action" value="text" id="applyText" disabled>Update cell text</button><span class="sr-hint">Use the background colors to build cell gradients; Excel's imported font/fill formatting is retained.</span></div></form></section><% } %><div class="sr-tabs"><% tabs.forEach((t,i)=>{ %><a href="<%= editing?'/sheldon-results/'+item.id+'/edit':'/sheldon-results/'+item.id %>?sheet=<%= i %>" class="sr-tab <%= i===chosen?'active':'' %>"><%= t.name %></a><% }) %></div><div class="sr-muted" style="margin-bottom:9px"><%= tabs[chosen].rows %> rows × <%= tabs[chosen].cols %> columns</div><div class="sr-sheet-scroller"><table class="sr-table <%= editing?'editable':'' %>" id="resultGrid" aria-label="<%= tabs[chosen].name %>"><thead><tr><th style="min-width:46px">#</th><% for(let c=0;c<tabs[chosen].cols;c++){let n=c+1,label='';while(n){n--;label=String.fromCharCode(65+n%26)+label;n=Math.floor(n/26)} %><th><%= label %></th><% } %></tr></thead><tbody><% const t=tabs[chosen];const merged=new Set();const masters=new Map((t.merges||[]).map(m=>[m.r+':'+m.c,m]));for(const m of t.merges||[]){for(let r=m.r;r<m.r+m.rs;r++)for(let c=m.c;c<m.c+m.cs;c++)if(r!==m.r||c!==m.c)merged.add(r+':'+c)} %><% for(let r=0;r<t.rows;r++){ %><tr><th><%= r+1 %></th><% for(let c=0;c<t.cols;c++){const key=r+':'+c;if(merged.has(key))continue;const s=t.styles?.[key]||{};const style=[];if(s.bold)style.push('font-weight:900');if(s.italic)style.push('font-style:italic');if(/^#[\da-fA-F]{6}$/.test(s.color||''))style.push('color:'+s.color);if(/^#[\da-fA-F]{6}$/.test(s.bg||'')){if(/^#[\da-fA-F]{6}$/.test(s.gradientEnd||''))style.push('background:linear-gradient('+(Number(s.gradientAngle)===90?'180deg':'90deg')+','+s.bg+','+s.gradientEnd+')');else style.push('background-color:'+s.bg)}if(['left','center','right'].includes(s.align))style.push('text-align:'+s.align);const m=masters.get(key);%><td data-r="<%= r %>" data-c="<%= c %>" <%- m?`rowspan="${Math.min(m.rs,t.rows-r)}" colspan="${Math.min(m.cs,t.cols-c)}"`:'' %> style="<%= style.join(';') %>"><%= t.grid[r]?.[c]??'' %></td><% } %></tr><% } %></tbody></table></div><div class="sr-actions" style="margin-top:20px"><a class="sr-btn" href="/sheldon-results">← All Sheldon Results</a></div></main><footer class="sr-footer">Pressboxd · Sheldon Results</footer><% if(editing){ %><script>
(()=>{const grid=document.getElementById('resultGrid'),range=document.getElementById('selectedRange'),f=document.getElementById('editCellsForm'),text=document.getElementById('cellText'),save=document.getElementById('applyText'),format=document.getElementById('applyStyle'),grad=document.getElementById('gradientToggle');let start=null,end=null,dragging=false;const cells=[...grid.querySelectorAll('td[data-r]')];const pos=el=>[Number(el.dataset.r),Number(el.dataset.c)];function pick(a,b){let [r0,c0]=a,[r1,c1]=b;let minR=Math.min(r0,r1),maxR=Math.max(r0,r1),minC=Math.min(c0,c1),maxC=Math.max(c0,c1);for(const [id,v]of Object.entries({r1:minR,r2:maxR,c1:minC,c2:maxC}))document.getElementById(id).value=v;cells.forEach(el=>{const[r,c]=pos(el);el.classList.toggle('sr-selected',r>=minR&&r<=maxR&&c>=minC&&c<=maxC)});const one=minR===maxR&&minC===maxC;range.textContent=one?`Cell: row ${minR+1}, column ${minC+1}`:`Selected ${maxR-minR+1} rows × ${maxC-minC+1} columns`;format.disabled=false;save.disabled=!one;text.disabled=!one;if(one){const cell=cells.find(el=>el.dataset.r==minR&&el.dataset.c==minC);text.value=cell?.textContent||''}}
grid.addEventListener('pointerdown',e=>{const td=e.target.closest('td[data-r]');if(!td)return;start=pos(td);end=start;dragging=true;pick(start,end)});document.addEventListener('pointerup',()=>dragging=false);grid.addEventListener('pointerover',e=>{if(!dragging||!start)return;const td=e.target.closest('td[data-r]');if(td){end=pos(td);pick(start,end)}});grad.addEventListener('change',()=>{f.querySelector('[name=gradientEnd]').disabled=grad.value!=='gradient'});grad.dispatchEvent(new Event('change'));})();
</script><% } %></body></html>
