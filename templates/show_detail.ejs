<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= row && row.title ? row.title : "Show Detail" %> - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>

  <style>
    .auth { align-items:center; gap: 12px; }

    .notifWrap { position: relative; display: inline-flex; align-items:center; }
    .bellBtn {
      position: relative;
      border: none;
      background: transparent;
      cursor: pointer;
      color: inherit;
      padding: 6px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.95;
    }
    .bellBtn:hover { background: rgba(255,255,255,0.06); }
    .badgeDot {
      position:absolute;
      top: 3px;
      right: 3px;
      min-width: 18px;
      height: 18px;
      padding: 0 6px;
      border-radius: 999px;
      background: #ff3b30;
      color: #fff;
      font-size: 11px;
      line-height: 18px;
      text-align: center;
      font-weight: 800;
      box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }

    .notifDropdown {
      display: none;
      position: absolute;
      right: 0;
      top: 40px;
      width: 340px;
      max-height: 420px;
      overflow: auto;
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.45);
      z-index: 9999;
    }
    .notifDropdown.open { display:block; }

    .notifHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding: 10px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.10);
      position: sticky;
      top: 0;
      background: rgba(15, 23, 42, 0.98);
      backdrop-filter: blur(8px);
    }
    .notifTitle { font-weight: 900; }
    .markReadBtn {
      border: none;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.85;
      font-size: 12px;
      padding: 6px 8px;
      border-radius: 10px;
    }
    .markReadBtn:hover { background: rgba(255,255,255,0.06); opacity: 1; }

    .notifList { padding: 8px; display:flex; flex-direction:column; gap: 8px; }
    .notifItem {
      padding: 10px;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
    }
    .notifItem.unread { background: rgba(99,102,241,0.18); border-color: rgba(99,102,241,0.25); }
    .notifTime { font-size: 12px; opacity: 0.7; margin-top: 4px; }
    .notifEmpty { padding: 12px; opacity: 0.8; }

    .authBellSlot { display:inline-flex; align-items:center; }

    .notifDropdown,
    .notifDropdown * {
      pointer-events: auto !important;
    }

    .ratingDistPanel {
      margin-top: 12px;
      box-shadow: none;
    }

    .ratingDistHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom: 12px;
    }

    .ratingDistTitle {
      font-weight: 900;
      line-height: 1.15;
    }

    .ratingDistMeta {
      text-align:right;
      font-size: 12px;
      opacity: 0.8;
      white-space: nowrap;
    }

    .ratingDistList {
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    .ratingDistRow {
      display:grid;
      grid-template-columns: 52px 1fr 42px;
      gap:10px;
      align-items:center;
    }

    .ratingDistLabel {
      font-size: 13px;
      font-weight: 700;
      opacity: 0.95;
    }

    .ratingDistTrack {
      position: relative;
      height: 10px;
      border-radius: 999px;
      overflow: hidden;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.06);
    }

    .ratingDistFill {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      min-width: 0;
      border-radius: 999px;
      background: linear-gradient(90deg,
        color-mix(in srgb, var(--accent) 90%, #ffffff 0%),
        color-mix(in srgb, var(--accent) 60%, #ffffff 0%)
      );
    }

    .ratingDistCount {
      text-align: right;
      font-size: 12px;
      opacity: 0.85;
      font-variant-numeric: tabular-nums;
    }

    .ratingDistEmpty {
      font-size: 13px;
      opacity: 0.75;
    }

    @media (max-width: 768px) {
        /* 1. Reset the Top Panel layout from Side-by-Side to Vertical */
        .panel > div[style*="display:flex"] {
            flex-direction: column !important;
            align-items: center !important;
            gap: 16px !important;
        }
    
        /* 2. Fix the Poster size so it's not a giant wall */
        .showposter {
            width: 160px !important; 
            height: 240px !important;
            flex: 0 0 160px !important;
            margin: 0 auto;
            border-radius: 8px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        }
    
        /* 3. Center the Meta text */
        .showmeta {
            text-align: center;
            width: 100%;
        }
        
        .showmeta h1 {
            font-size: 1.6rem !important;
            line-height: 1.2;
        }
    
        /* 4. Fix the 380px Rating Box that causes overflow */
        div[style*="flex:0 0 380px"] {
            flex: 1 1 auto !important;
            width: 100% !important;
            min-width: 0 !important;
            margin: 0 !important;
        }
    
        /* 5. Make the Star Rating huge and easy to tap */
        .stars {
            font-size: 38px !important; /* Bigger for thumbs */
            justify-content: center !important;
        }
        
        .starwrap {
            justify-content: center !important;
            flex-direction: column;
            gap: 8px;
        }
    
        /* 6. Stack the Histogram Panels (Critic vs All) */
        div[style*="display:flex; gap:10px; margin-top:12px"] {
            flex-direction: column !important;
        }
    
        .ratingDistPanel {
            width: 100% !important;
        }
    
        /* 7. Review Section: Move 'Write Review' above 'Community' on mobile */
        .layout {
            display: flex;
            flex-direction: column-reverse; /* Puts the review form on top */
        }
    
        aside.side {
            position: static !important;
            width: 100% !important;
            margin-bottom: 24px;
        }
    
        /* 8. Fix the Review Cards */
        .reviewcard {
            padding: 12px !important;
        }
        .topbar {
        position: relative !important; /* Changes from fixed/sticky to natural flow */
        height: auto !important;
        padding: 10px 0;
    }

        /* 2. Stack the Navigation Links so they don't overlap the logo */
        .topbar .wrap.row.between {
            flex-direction: column !important;
            align-items: center !important;
            gap: 12px !important;
        }
    
        .nav.row {
            display: flex !important;
            flex-wrap: wrap !important;
            justify-content: center !important;
            gap: 8px 15px !important; /* Horizontal and Vertical spacing */
        }
    
        .nav.row a {
            font-size: 13px !important;
            padding: 4px 0;
        }
    
        /* 3. Handle the Auth/Bell section */
        .auth.row {
            width: 100%;
            justify-content: center !important;
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 10px;
            margin-top: 5px;
        }
    
        /* 4. Remove any forced margin-top on the main wrap that was 
              trying to "guess" the header height */
        main.wrap {
            margin-top: 10px !important;
        }

        .review_votes {
            margin-top: 12px;
            justify-content: flex-start;
            border-top: 1px solid rgba(255,255,255,0.05);
            padding-top: 8px;
        }
    }

  </style>
</head>
<body class="app" <%= me && me.theme_color ? `style="--accent: ${me.theme_color};"` : "" %>>
  <%
  // 1. Core Variables & Fallbacks
  const POSTER_FALLBACK = "/static/posters/placeholder.png";
  const meUser = typeof me !== "undefined" ? me : null;
  const showRow = row || {};
  
  // 2. Review Processing
  const reviewList = Array.isArray(reviews) ? [...reviews] : [];
  const activeSort = typeof sort !== "undefined" ? sort : "popular";
  
  reviewList.sort((a, b) => {
    if (activeSort === 'newest') {
      return new Date(b.created_at || 0) - new Date(a.created_at || 0);
    } else if (activeSort === 'oldest') {
      return new Date(a.created_at || 0) - new Date(b.created_at || 0);
    } else if (activeSort === 'highest') {
      return Number(b.rating_half || 0) - Number(a.rating_half || 0);
    } else if (activeSort === 'lowest') {
      return Number(a.rating_half || 0) - Number(b.rating_half || 0);
    } else {
      // Default: Popular (vote_score)
      return Number(b.vote_score || 0) - Number(a.vote_score || 0);
    }
  });
  
  // 3. User-specific ratings/notifs
  const myReviewText = typeof my_review !== "undefined" ? (my_review || "") : "";
  const myRatingVal = typeof my_rating !== "undefined" ? my_rating : null;
  const loginNext = "/login?next=" + encodeURIComponent("/show/" + (showRow.id || ""));
  const notifCountSafe = typeof notif_count !== "undefined" ? Number(notif_count || 0) : 0;
  const notifItemsSafe = (typeof notif_items !== "undefined" && Array.isArray(notif_items)) ? notif_items : [];

  // 4. Histogram & Critic Score Logic
  const distLabels = ["5.0","4.5","4.0","3.5","3.0","2.5","2.0","1.5","1.0","0.5","0.0"];
  const ratingHistogramRaw = (typeof rating_histogram !== "undefined" && rating_histogram) ? rating_histogram : {};
  const verifiedHistogramRaw = (typeof verified_rating_histogram !== "undefined" && verified_rating_histogram) ? verified_rating_histogram : {};

  function getHistCount(obj, key) {
    if (!obj) return 0;
    const v = obj[key];
    const n = Number(v || 0);
    return Number.isFinite(n) ? n : 0;
  }

  const ratingDistRows = distLabels.map((label) => ({
    label,
    count: getHistCount(ratingHistogramRaw, label)
  }));

  const verifiedDistRows = distLabels.map((label) => ({
    label,
    count: getHistCount(verifiedHistogramRaw, label)
  }));

  const ratingDistTotal = ratingDistRows.reduce((sum, r) => sum + r.count, 0);
  const verifiedDistTotal = verifiedDistRows.reduce((sum, r) => sum + r.count, 0);
  const ratingDistMax = ratingDistRows.reduce((m, r) => Math.max(m, r.count), 0);
  const verifiedDistMax = verifiedDistRows.reduce((m, r) => Math.max(m, r.count), 0);

  // 5. Critic Score Calculation
  let verifiedSum = 0;
  verifiedDistRows.forEach(r => {
    verifiedSum += (parseFloat(r.label) * r.count);
  });
  
  const criticAvg = verifiedDistTotal >= 5 
    ? (verifiedSum / verifiedDistTotal).toFixed(2) 
    : null;
%>
  <header class="topbar">
    <div class="wrap row between">
      <a class="brand" href="/shows" style="display: flex; align-items: center; gap: 8px; text-decoration: none;">
        <img src="/static/logo.png" alt="logo" style="width: 30px; height: 30px; object-fit: contain; flex-shrink: 0;">
        <span>Pressboxd</span>
      </a>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <% if (meUser && Number(meUser.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (meUser) { %>
          <div class="authBellSlot">
            <div class="notifWrap">
              <button class="bellBtn" id="bellBtn" aria-label="Notifications" title="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1"/>
                  <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
                </svg>

                <% if (notifCountSafe > 0) { %>
                  <span class="badgeDot"><%= notifCountSafe %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>
                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>

                <% if (notifItemsSafe.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of notifItemsSafe) {
                         const kind = (n && n.kind) || "";
                         const actor = (n && n.actor_username) || "Someone";
                         const created = (n && n.created_at) || "";
                         const unread = Number((n && n.is_read) != null ? n.is_read : 0) === 0;
                         const sid = (n && n.show_id) || null;
                    %>
                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>
                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>
                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else if (kind === "review_comment") { %>
                          <div>
                            <b><%= actor %></b> commented on your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (meUser.avatar_url) { %>
                <img src="<%= meUser.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>

            <span class="muted small">
              <%= meUser.username || "me" %>
            </span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">

    <% if (typeof flashes !== "undefined" && Array.isArray(flashes) && flashes.length > 0) { %>
      <div class="flashes">
        <% for (const f of flashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <div style="margin-top:14px;">
      <div class="panel">
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:28px; width:100%;">

          <div style="display:flex; align-items:flex-start; gap:18px; flex:1 1 auto; min-width:0;">
            <div class="showposter" style="position:relative; overflow:hidden; width:240px; height:360px; flex:0 0 240px;">
              <img
                src="<%= showRow.poster_url || POSTER_FALLBACK %>"
                alt="<%= showRow.title || 'Show' %> poster"
                style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;"
                onerror="this.onerror=null;this.src='<%= POSTER_FALLBACK %>';"
              >
              <div class="poster_fallback" style="position:absolute; inset:0;"></div>
            </div>

            <div class="showmeta" style="flex:1 1 auto; min-width:0;">
              <div class="kicker">Show</div>
              <h1 style="margin:6px 0 8px;"><%= showRow.title || "" %></h1>
              <div class="muted"><%= showRow.year || "" %> — <%= showRow.corps || "" %></div>

              <div style="margin-top:12px; display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                <% if (Number(showRow.cnt || 0) === 0) { %>
                  <span class="badge muted">Unrated</span>
                <% } else { %>
                  <span class="badge good">★ <%= Number(showRow.avg_rating || 0).toFixed(2) %></span>
                  <span class="badge muted"><%= Number(showRow.cnt || 0) %> ratings</span>
                <% } %>

                <% if (meUser && Number(meUser.is_admin) === 1) { %>
                  <a class="btn ghost" href="/admin/show/<%= showRow.id %>/edit">Edit show</a>
                <% } %>
              </div>
            </div>
          </div>

          <div style="flex:0 0 380px; width:380px; min-width:380px; margin-left:auto;">
            <div class="panel" style="box-shadow:none; margin:0; width:100%;">
              <% if (meUser) { %>
                <div class="kicker">Your rating</div>

                <form id="rateForm" method="post" action="/show/<%= showRow.id %>/rate">
                  <input type="hidden" name="rating_half" id="ratingHalf" value="<%= myRatingVal != null ? myRatingVal : 0 %>"/>

                  <div class="starwrap" style="justify-content:flex-end;">
                    <div class="stars"
                         id="stars"
                         data-current="<%= myRatingVal != null ? myRatingVal : 0 %>"
                         aria-label="Rate this show from 0 to 5 stars in half-star steps"
                         role="slider"
                         tabindex="0">
                      <div class="stars-base">★★★★★</div>
                      <div class="stars-fill" id="starsFill">★★★★★</div>
                    </div>

                    <div class="muted" id="ratingLabel" style="min-width:90px;"></div>
                  </div>
                </form>

                <% if (myRatingVal != null) { %>
                  <form method="post" action="/show/<%= showRow.id %>/unrate" style="margin-top:10px;">
                    <button class="btn ghost" type="submit">Remove rating</button>
                  </form>
                <% } %>

                <script>
                  (function(){
                    const stars = document.getElementById("stars");
                    const fill  = document.getElementById("starsFill");
                    const input = document.getElementById("ratingHalf");
                    const label = document.getElementById("ratingLabel");
                    const form  = document.getElementById("rateForm");
                    if (!stars || !fill || !input || !label || !form) return;

                    const current = parseInt(stars.dataset.current || "0", 10);
                    setDisplay(current);

                    function clamp(n, a, b){ return Math.max(a, Math.min(b, n)); }
                    function halfToText(rh){
                      const val = (rh / 2).toFixed(rh % 2 ? 1 : 0);
                      return val === "0" ? "0 ★" : (val + " ★");
                    }
                    function setDisplay(rh){
                      const pct = (clamp(rh,0,10) / 10) * 100;
                      fill.style.width = pct + "%";
                      label.textContent = halfToText(clamp(rh,0,10));
                    }
                    function eventToHalf(e){
                      const rect = stars.getBoundingClientRect();
                      const x = clamp(e.clientX - rect.left, 0, rect.width);
                      return clamp(Math.round((x / rect.width) * 10), 0, 10);
                    }

                    stars.addEventListener("mousemove", (e) => setDisplay(eventToHalf(e)));
                    stars.addEventListener("mouseleave", () => setDisplay(parseInt(input.value || "0", 10)));

                    stars.addEventListener("click", (e) => {
                      const rh = eventToHalf(e);
                      input.value = rh;
                      setDisplay(rh);
                      form.submit();
                    });

                    stars.addEventListener("keydown", (e) => {
                      let rh = parseInt(input.value || "0", 10);
                      if (e.key === "ArrowLeft")  rh = clamp(rh - 1, 0, 10);
                      if (e.key === "ArrowRight") rh = clamp(rh + 1, 0, 10);
                      if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        form.submit();
                        return;
                      }
                      if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
                        e.preventDefault();
                        input.value = rh;
                        setDisplay(rh);
                      }
                    });
                  })();
                </script>

              <% } else { %>
                <div class="muted">
                  <a href="<%= loginNext %>">Log in</a>
                  to rate this show.
                </div>
              <% } %>
            </div>

            <div style="display:flex; gap:10px; margin-top:12px; align-items:flex-start;">
              <div class="panel ratingDistPanel" style="width:50%; margin-top:0; padding:10px;">
                <div class="ratingDistHeader" style="margin-bottom:8px;">
                  <div>
                    <div class="kicker" style="font-size:12px;">Critic Rating</div>
                  </div>
                  <div class="ratingDistMeta" style="font-size:11px;"><%= verifiedDistTotal %> total</div>
                </div>

                <% if (verifiedDistTotal > 0) { %>
                  <div class="ratingDistList" style="gap:6px;">
                    <% for (const r of verifiedDistRows) {
                         const pct = verifiedDistMax > 0 ? (r.count / verifiedDistMax) * 100 : 0;
                    %>
                      <div class="ratingDistRow" style="grid-template-columns: 42px 1fr 30px; gap:8px;">
                        <div class="ratingDistLabel" style="font-size:12px;"><%= r.label %>★</div>
                        <div class="ratingDistTrack" style="height:8px;">
                          <div class="ratingDistFill" style="width:<%= pct %>%"></div>
                        </div>
                        <div class="ratingDistCount" style="font-size:11px;"><%= r.count %></div>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="ratingDistEmpty" style="font-size:12px;">No verified reviewer ratings yet.</div>
                <% } %>
              </div>

              <div class="panel ratingDistPanel" style="width:50%; margin-top:0; padding:10px;">
                <div class="ratingDistHeader" style="margin-bottom:8px;">
                  <div>
                    <div class="kicker">All Ratings</div>
                  </div>
                  <div class="ratingDistMeta" style="font-size:11px;"><%= ratingDistTotal %> total</div>
                </div>

                <% if (ratingDistTotal > 0) { %>
                  <div class="ratingDistList" style="gap:6px;">
                    <% for (const r of ratingDistRows) {
                         const pct = ratingDistMax > 0 ? (r.count / ratingDistMax) * 100 : 0;
                    %>
                      <div class="ratingDistRow" style="grid-template-columns: 42px 1fr 30px; gap:8px;">
                        <div class="ratingDistLabel" style="font-size:12px;"><%= r.label %>★</div>
                        <div class="ratingDistTrack" style="height:8px;">
                          <div class="ratingDistFill" style="width:<%= pct %>%"></div>
                        </div>
                        <div class="ratingDistCount" style="font-size:11px;"><%= r.count %></div>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="ratingDistEmpty" style="font-size:12px;">No ratings yet.</div>
                <% } %>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="layout" style="margin-top:8px;">

      <section>
        <section style="max-width: 600px; margin: 0 auto; width: 100%;">
          <div class="row between" style="margin-bottom:14px; align-items: flex-end;">
            <div>
              <div class="kicker">Reviews</div>
              <h2 style="margin:6px 0 0;">Community</h2>
            </div>
          
            <form method="get" action="/show/<%= showRow.id %>" style="margin:0;">
              <% const currentSort = typeof sort !== 'undefined' ? sort : 'popular'; %>
              <select 
                name="sort" 
                onchange="this.form.submit()" 
                style="padding: 6px 28px 6px 12px; border-radius: 10px; background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.12); font-size: 13px; cursor: pointer; appearance: none; -webkit-appearance: none; background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E'); background-repeat: no-repeat; background-position: right 8px center; background-size: 14px;"
              >
                <option value="popular" <%= currentSort === 'popular' ? 'selected' : '' %>>Popular</option>
                <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Newest</option>
                <option value="oldest" <%= currentSort === 'oldest' ? 'selected' : '' %>>Oldest</option>
                <option value="highest" <%= currentSort === 'highest' ? 'selected' : '' %>>Highest Rated</option>
                <option value="lowest" <%= currentSort === 'lowest' ? 'selected' : '' %>>Lowest Rated</option>
              </select>
            </form>
          </div>

          <% if (reviewList.length > 0) { %>
            <div class="reviewlist">
              <% for (const rv of reviewList) {
                   const commentList = Array.isArray(rv.comments) ? rv.comments : [];
                   const ccount = Number(rv.comment_count || commentList.length || 0);
                   const upStyle = Number(rv.my_vote) === 1
                     ? 'background: rgba(6,136,24,.18); border:1px solid rgba(6,136,24,.7); color:#06a31d; padding:4px 8px; border-radius:10px; cursor:pointer; line-height:1; opacity:.9;'
                     : 'background: transparent; border:1px solid rgba(255,255,255,.18); color:inherit; padding:4px 8px; border-radius:10px; cursor:pointer; line-height:1; opacity:.9;';
                   const downStyle = Number(rv.my_vote) === -1
                     ? 'background: rgba(220,38,38,.18); border:1px solid rgba(220,38,38,.7); color:#ef4444; padding:4px 8px; border-radius:10px; cursor:pointer; line-height:1; opacity:.9;'
                     : 'background: transparent; border:1px solid rgba(255,255,255,.18); color:inherit; padding:4px 8px; border-radius:10px; cursor:pointer; line-height:1; opacity:.9;';
              %>
                <div class="reviewcard">
                  <div class="row between" style="gap:12px; align-items:flex-start;">

                    <div style="flex:1; min-width:0;">
                      <div class="row gap" style="align-items:center; flex-wrap:wrap;">
                        <span class="avatar_sm">
                          <% if (rv.avatar_url) { %>
                            <img src="<%= rv.avatar_url %>" alt="avatar">
                          <% } else { %>
                            <span class="avatar_fallback"></span>
                          <% } %>
                        </span>

                        <a class="reviewuser"
                           href="/u/<%= encodeURIComponent(rv.username) %>"
                           <%= rv.role_color ? `style="color: ${rv.role_color};"` : "" %>>
                          <%= rv.username %>
                        </a>

                        <% if (rv.role_name) { %>
                          <span class="role_tag tiny" <%= rv.role_color ? `style="border-color: ${rv.role_color}; color: ${rv.role_color};"` : "" %>>
                            <%= rv.role_name %>
                          </span>
                        <% } %>

                        <% if (rv.rating_half != null) { %>
                          <span class="muted"> ★ <%= (Number(rv.rating_half) / 2).toFixed(1) %></span>
                        <% } %>
                      </div>

                      <div class="reviewtext"><%= rv.review_text || "" %></div>

                      <details style="margin-top:10px;">
                        <summary class="muted" style="cursor:pointer; user-select:none;">
                          Comments (<%= ccount %>)
                        </summary>

                        <div style="margin-top:10px; display:flex; flex-direction:column; gap:10px;">

                          <% if (commentList.length > 0) { %>
                            <% for (const c of commentList) { %>
                              <div style="display:flex; gap:10px; align-items:flex-start;">
                                <span class="avatar_sm">
                                  <% if (c.commenter_avatar_url) { %>
                                    <img src="<%= c.commenter_avatar_url %>" alt="avatar">
                                  <% } else { %>
                                    <span class="avatar_fallback"></span>
                                  <% } %>
                                </span>

                                <div style="min-width:0; flex:1;">
                                  <div class="row gap" style="align-items:baseline; flex-wrap:wrap;">
                                    <a class="reviewuser"
                                       href="/u/<%= encodeURIComponent(c.commenter_username) %>">
                                      <%= c.commenter_username %>
                                    </a>
                                    <span class="muted" style="font-size:12px;"><%= c.created_at || "" %></span>

                                    <% if (meUser && Number(meUser.is_admin) === 1) { %>
                                      <form method="post"
                                            action="/admin/show/<%= showRow.id %>/comment/<%= c.comment_id %>/delete"
                                            style="margin:0; margin-left:auto;">
                                        <button class="btn ghost" type="submit" style="padding:2px 8px; font-size:12px;">
                                          Delete
                                        </button>
                                      </form>
                                    <% } else if (meUser && Number(meUser.id) === Number(c.commenter_user_id)) { %>
                                      <form method="post"
                                            action="/show/<%= showRow.id %>/comment/<%= c.comment_id %>/delete"
                                            style="margin:0; margin-left:auto;">
                                        <button class="btn ghost" type="submit" style="padding:2px 8px; font-size:12px;">
                                          Delete
                                        </button>
                                      </form>
                                    <% } %>
                                  </div>

                                  <% if (c.comment_text === "[comment deleted]") { %>
                                    <div class="muted" style="margin-top:2px; font-style:italic;">[comment deleted]</div>
                                  <% } else { %>
                                    <div class="muted" style="margin-top:2px; white-space:pre-wrap;"><%= c.comment_text || "" %></div>
                                  <% } %>
                                </div>
                              </div>
                            <% } %>
                          <% } else { %>
                            <div class="muted">No comments yet.</div>
                          <% } %>

                          <% if (meUser) { %>
                            <form method="post"
                                  action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/comment"
                                  style="margin:0;">
                              <div class="row gap" style="align-items:flex-start;">
                                <textarea name="comment_text" rows="2"
                                          placeholder="Add a comment…"
                                          style="flex:1; resize:vertical;"></textarea>
                                <button class="btn ghost" type="submit">Post</button>
                              </div>
                            </form>
                          <% } else { %>
                            <div class="muted">
                              <a href="<%= loginNext %>">Log in</a>
                              to comment.
                            </div>
                          <% } %>
                        </div>
                      </details>
                    </div>

                    <div class="review_votes" style="display:flex; align-items:center; gap:8px;">
                      <% if (meUser && Number(meUser.id) !== Number(rv.user_id)) { %>
                        <form method="post"
                              action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/vote"
                              style="margin:0;">
                          <input type="hidden" name="vote" value="1">
                          <button class="vote_btn up" type="submit" style="<%= upStyle %>">▲</button>
                        </form>

                        <div class="vote_score"><%= Number(rv.vote_score || 0) %></div>

                        <form method="post"
                              action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/vote"
                              style="margin:0;">
                          <input type="hidden" name="vote" value="-1">
                          <button class="vote_btn down" type="submit" style="<%= downStyle %>">▼</button>
                        </form>
                      <% } else { %>
                        <div class="vote_score"><%= Number(rv.vote_score || 0) %></div>
                      <% } %>

                      <% if (meUser && Number(meUser.is_admin) === 1) { %>
                        <form method="post"
                              action="/admin/show/<%= showRow.id %>/review/<%= rv.user_id %>/delete"
                              style="margin:0; margin-left:8px;">
                          <button class="btn ghost" type="submit" style="padding:4px 8px; font-size:12px;">
                            Delete
                          </button>
                        </form>
                      <% } else if (meUser && Number(meUser.id) === Number(rv.user_id)) { %>
                        <form method="post"
                              action="/show/<%= showRow.id %>/review/delete"
                              style="margin:0; margin-left:8px;">
                          <button class="btn ghost" type="submit" style="padding:4px 8px; font-size:12px;">
                            Delete
                          </button>
                        </form>
                      <% } %>
                    </div>

                  </div>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div class="muted">No reviews yet. Be the first to write one.</div>
          <% } %>
        </div>
      </section>

      <aside class="side" style="top:86px;">
        <div class="panel">

          <% if (meUser) { %>
            <form method="post" action="/show/<%= showRow.id %>/review">
              <div class="field">
                <label><%= myReviewText ? "Edit your review" : "Write a review" %></label>
                <textarea name="review_text" rows="10" placeholder="What did you think?"><%= myReviewText %></textarea>
              </div>

              <div class="actions">
                <button class="btn green" type="submit"><%= myReviewText ? "Save" : "Post" %></button>
                <a class="btn ghost" href="/show/<%= showRow.id %>">Cancel</a>
              </div>
            </form>

            <% if (myReviewText) { %>
              <form method="post" action="/show/<%= showRow.id %>/review/delete" style="margin-top:10px;">
                <button class="btn ghost" type="submit">Delete</button>
              </form>
            <% } %>

          <% } else { %>
            <div class="muted">
              <a href="<%= loginNext %>">Log in</a>
              to post a review.
            </div>
          <% } %>
        </div>
      </aside>

    </div>

  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd  = document.getElementById("notifDropdown");
      if (!btn || !dd) return;

      dd.addEventListener("click", (e) => e.stopPropagation());

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        dd.classList.toggle("open");
      });

      document.addEventListener("click", () => {
        dd.classList.remove("open");
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") dd.classList.remove("open");
      });
    })();
  </script>
</body>
</html>











