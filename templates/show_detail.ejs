<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <%
    const seoShow = row || {};
    const seoTitle = seoShow.title
      ? `${seoShow.corps ? `${seoShow.corps} - ` : ""}${seoShow.title}${seoShow.year ? ` (${seoShow.year})` : ""} - Pressboxd`
      : "Show Detail - Pressboxd";
  
    const seoDescription = seoShow.title
      ? `View ratings, reviews, rankings, and details for ${seoShow.corps ? `${seoShow.corps} - ` : ""}${seoShow.title}${seoShow.year ? ` (${seoShow.year})` : ""} on Pressboxd.`
      : "View drum corps show ratings, reviews, rankings, and details on Pressboxd.";
  
    const seoUrl = seoShow.id
      ? `https://www.pressboxd.com/show/${seoShow.id}`
      : "https://www.pressboxd.com/shows";
  
    const seoImage = seoShow.poster_url || "https://www.pressboxd.com/static/posters/placeholder.png";
  %>
  
  <title><%= seoTitle %></title>
  <meta name="description" content="<%= seoDescription %>">
  <link rel="canonical" href="<%= seoUrl %>">
  
  <meta property="og:title" content="<%= seoTitle %>">
  <meta property="og:description" content="<%= seoDescription %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= seoUrl %>">
  <meta property="og:image" content="<%= seoImage %>">
  
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seoTitle %>">
  <meta name="twitter:description" content="<%= seoDescription %>">
  <meta name="twitter:image" content="<%= seoImage %>">

  <link rel="icon" type="image/png" href="/static/favicon.png"/>
  <link rel="stylesheet" href="/static/styles.css"/>

  <style>
    html,
    body,
    body.app {
      font-family:ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    }

    .auth { align-items:center; gap: 12px; }

    .notifWrap { position: relative; display: inline-flex; align-items:center; }
    .bellBtn {
      position: relative;
      border: none;
      background: transparent;
      cursor: pointer;
      color: inherit;
      padding: 6px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.95;
    }
    .bellBtn:hover { background: rgba(255,255,255,0.06); }

    .badgeDot {
      position:absolute;
      top: 3px;
      right: 3px;
      min-width: 18px;
      height: 18px;
      padding: 0 6px;
      border-radius: 999px;
      background: #ff3b30;
      color: #fff;
      font-size: 11px;
      line-height: 18px;
      text-align: center;
      font-weight: 800;
      box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }

    .notifDropdown {
      display: none;
      position: absolute;
      right: 0;
      top: 40px;
      width: 340px;
      max-height: 420px;
      overflow: auto;
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.45);
      z-index: 9999;
    }
    .notifDropdown.open { display:block; }

    .notifHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding: 10px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.10);
      position: sticky;
      top: 0;
      background: rgba(15, 23, 42, 0.98);
      backdrop-filter: blur(8px);
    }

    .notifTitle { font-weight: 900; }

    .markReadBtn {
      border: none;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.85;
      font-size: 12px;
      padding: 6px 8px;
      border-radius: 10px;
    }
    .markReadBtn:hover { background: rgba(255,255,255,0.06); opacity: 1; }

    .notifList {
      padding: 8px;
      display:flex;
      flex-direction:column;
      gap: 8px;
    }

    .notifItem {
      padding: 10px;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .notifItem.unread {
      background: rgba(99,102,241,0.18);
      border-: rgba(99,102,241,0.25);
    }

    .notifTime {
      font-size: 12px;
      opacity: 0.7;
      margin-top: 4px;
    }

    .notifEmpty {
      padding: 12px;
      opacity: 0.8;
    }

    .authBellSlot { display:inline-flex; align-items:center; }

    .notifDropdown,
    .notifDropdown * {
      pointer-events: auto !important;
    }

    .ratingDistPanel {
      margin-top: 12px;
      box-shadow: none;
    }

    .ratingDistHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom: 12px;
    }

    .ratingDistTitle {
      font-weight: 900;
      line-height: 1.15;
    }

    .ratingDistMeta {
      text-align:right;
      font-size: 12px;
      opacity: 0.8;
      white-space: nowrap;
    }

    .ratingDistList {
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    .ratingDistRow {
      display:grid;
      grid-template-columns: 52px 1fr 42px;
      gap:10px;
      align-items:center;
    }

    .ratingDistLabel {
      font-size: 13px;
      font-weight: 700;
      opacity: 0.95;
    }

    .ratingDistTrack {
      position: relative;
      height: 10px;
      border-radius: 999px;
      overflow: hidden;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.06);
    }

    .ratingDistFill {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      min-width: 0;
      border-radius: 999px;
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--accent) 50%, rgba(255,255,255,0.04)),
        color-mix(in srgb, var(--accent) 36%, rgba(255,255,255,0.03))
      );
    }

    .ratingDistCount {
      text-align: right;
      font-size: 12px;
      opacity: 0.85;
      font-variant-numeric: tabular-nums;
    }

    .reviewToolbar {
      gap: 16px;
    }

    .reviewSortForm {
      min-width: 220px;
    }

    .review_footer {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 12px;
      margin-top: 10px;
    }

    .review_posted_date {
      margin-left: auto;
      text-align: right;
      font-size: 10px;
      : var(--muted);
      white-space: nowrap;
    }

    .criticPanelLink {
      transition: transform .15s ease, border- .15s ease, background .15s ease;
      cursor: pointer;
    }

    .comment-reply {
      margin-left: 22px;
      padding-left: 12px;
      border-left: 2px solid rgba(255,255,255,0.12);
    }


    .criticPanelLink:hover {
      transform: translateY(-1px);
      background: rgba(255,255,255,0.045);
      border-: -mix(in srgb, var(--accent) 28%, rgba(255,255,255,0.14));
    }

    .criticPanelLink:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    @media (max-width: 720px) {
      .review_footer {
        flex-direction: column;
        align-items: flex-start;
      }

      .review_posted_date {
        margin-left: 0;
        text-align: left;
        white-space: normal;
      }
    }

    .reviewSortSelect {
      width: 100%;
      min-width: 220px;
      padding: 10px 12px;
      background: color-mix(in srgb, var(--accent) 10%, rgba(255,255,255,0.03)) !important;
      color: #fff !important;
      border: 1px solid color-mix(in srgb, var(--accent) 24%, rgba(255,255,255,0.14));
      border-radius: 10px;
      outline: none;
      box-shadow: none;
    }
    
    .reviewSortSelect:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 18%, transparent);
    }
    
    .reviewSortSelect option {
      background: #111 !important;
      color: #fff !important;
    }

    @media (max-width: 720px) {
      .reviewToolbar {
        flex-direction: column !important;
        align-items: stretch !important;
      }

      .reviewSortForm {
        width: 100%;
        min-width: 0;
      }

      .reviewSortSelect {
        min-width: 0;
        width: 100%;
      }
    }

    .ratingDistEmpty {
      font-size: 16px;
      opacity: 0.75;
    }

    .reviewcard {
      padding: 14px;
      border: 1px solid var(--accentSoft);
      border-radius: 14px;
      background: rgba(255,255,255,0.03);
      margin-bottom: 14px;
    }

    .reviewhead {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
      margin-bottom:10px;
    }

    .reviewuser {
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .reviewavatar {
      width:40px;
      height:40px;
      border-radius:999px;
      overflow:hidden;
      background: rgba(255,255,255,0.08);
      flex: 0 0 40px;
    }

    .reviewavatar img {
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .reviewmeta {
      min-width:0;
    }

    .reviewname {
      font-weight:800;
      display:flex;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
    }

    .rolebadge {
      display:inline-flex;
      align-items:center;
      font-size:11px;
      font-weight:800;
      border-radius:999px;
      padding:3px 8px;
      :#fff;
    }

    .reviewsub {
      font-size:12px;
      opacity:0.8;
    }

    .reviewtext {
      white-space: pre-wrap;
      line-height:1.5;
      margin-top: 6px;
    }

    .review_votes {
      display:flex;
      align-items:center;
      gap:8px;
      margin-top: 12px;
      flex-wrap:wrap;
    }

    .vote_btn {
      border: 1px solid var(--accentSoft);
      background: rgba(255,255,255,0.03);
      : inherit;
      border-radius: 10px;
      padding: 6px 10px;
      cursor: pointer;
      font-weight: 700;
      min-width: 36px;
      text-align: center;
      transition: background .15s ease, border- .15s ease, color .15s ease, transform .15s ease;
    }

    .vote_btn:hover {
      background: rgba(255,255,255,0.06);
    }

    .vote_btn.up.on {
      background: rgba(34,197,94,0.18);
      border-color: rgba(34,197,94,0.65);
      color: #22c55e;
    }

    .vote_btn.down.on {
      background: rgba(239,68,68,0.18);
      border-color: rgba(239,68,68,0.65);
      color: #ef4444;
    }

    .vote_total {
      display: inline-flex;
      align-items: center;
      padding: 4px 8px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 800;
      color: var(--muted);
      border: 1px solid var(--accentSoft);
      background: rgba(255,255,255,0.03);
    }

    .vote_btn.active {
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 18%, transparent);
    }

    .comment-item {
      padding: 10px;
      border-radius: 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--accentSoft);
    }

    .comment-head {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:6px;
    }

    .comment-user {
      display:flex;
      align-items:center;
      gap:8px;
    }

    .comment-avatar {
      width:28px;
      height:28px;
      border-radius:999px;
      overflow:hidden;
      background: rgba(255,255,255,0.08);
      flex:0 0 28px;
    }

    .comment-avatar img {
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .comment-form textarea,
    .write-review-form textarea {
      width:100%;
      min-height:200px;
      resize:vertical;
      border-radius:12px;
      border: 1px solid var(--accentSoft);
      background: rgba(255,255,255,0.03);
      color: inherit;
      padding: 12px;
      font: inherit;
    }

    .comment-form textarea {
      min-height:72px;
    }

    .review-actions {
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      margin-top:12px;
    }

    .reviewsSection {
      width: 100% !important;
    }

    .friendRatingBox {
      position: relative;
      width: auto;
      max-width: none;
      display: inline-flex;
    }
    
    .friendRatingSummary {
      list-style: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-wrap: nowrap;
    }
    
    .friendRatingSummary::-webkit-details-marker {
      display: none;
    }
    
    .friendRatingSummary::after {
      content: "▾";
      font-size: 11px;
      opacity: 0.75;
      margin-left: 4px;
    }
    
    .friendRatingBox[open] .friendRatingSummary::after {
      content: "▴";
    }
    
    .friendRatingDropdown {
      position: absolute;
      top: 100%;
      left: 0;
      margin-top: 8px;
      width: min(360px, 90vw);
      border: 1px solid var(--accentSoft);
      background: rgba(10,10,10,0.98);
      border-radius: 14px;
      padding: 8px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.45);
      display: flex;
      flex-direction: column;
      gap: 8px;
      z-index: 50;
    }
    
    .friendRatingItem {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 8px;
      border-radius: 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.06);
    }
    
    .friendRatingUser {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }
    
    .friendRatingAvatar {
      width: 28px;
      height: 28px;
      border-radius: 999px;
      overflow: hidden;
      background: rgba(255,255,255,0.08);
      flex: 0 0 28px;
    }
    
    .friendRatingAvatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .reviewsLayout {
      display: flex !important;
      align-items: flex-start !important;
      gap: 20px !important;
      width: 100% !important;
      flex-wrap: nowrap !important;
    }

    .reviewsMain {
      flex: 1 1 auto !important;
      min-width: 0 !important;
      width: auto !important;
    }

    .reviewsSide {
      flex: 0 0 600px !important;
      width: 600px !important;
      min-width: 600px !important;
      align-self: flex-start !important;
    }

    .reviewlist,
    .reviewcard {
      width: 100% !important;
      max-width: none !important;
    }

    .review_rating_plain {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-weight: 800;
      color: var(--text);
    }

    .showTopRight {
      flex: 0 0 540px !important;
      width: 540px !important;
      min-width: 540px !important;
      margin-left: auto;
    }

    .showActionPanels {
      display: flex;
      gap: 12px;
      align-items: stretch;
    }

    .favoritePanel {
      flex: 0 0 132px;
      width: 132px;
      min-width: 132px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-shadow: none;
      margin: 0;
      padding: 14px 10px;
    }

    .favoriteLabel {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .04em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 10px;
    }

    .favoriteHeartForm {
      width: 100%;
    }

    .favoriteHeartBtn {
      width: 72px;
      height: 72px;
      border-radius: 999px;
      border: 1px solid var(--accentSoft);
      background: rgba(255,255,255,0.03);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform .15s ease, border-color .15s ease, background .15s ease, box-shadow .15s ease;
      box-shadow: 0 10px 24px rgba(0,0,0,.18);
    }

    .favoriteHeartBtn:hover {
      transform: translateY(-1px);
      background: rgba(255,255,255,0.06);
    }

    .favoriteHeartBtn.on {
      color: #ff4d6d;
      border-color: rgba(255,77,109,0.45);
      background: rgba(255,77,109,0.12);
      box-shadow: 0 0 0 1px rgba(255,77,109,0.10) inset, 0 10px 24px rgba(0,0,0,.18);
    }

    .favoriteHeartBtn svg {
      width: 34px;
      height: 34px;
      display: block;
    }

    .favoriteMeta {
      margin-top: 10px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.35;
    }

    .ratingPanel {
      flex: 1 1 auto;
      min-width: 0;
      box-shadow: none;
      margin: 0;
      width: 100%;
    }

    .starwrap {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .stars {
      position: relative;
      display: inline-block;
      font-size: 42px;
      line-height: 1;
      letter-spacing: 0;
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
    }

    .stars-base {
      color: rgba(255,255,255,0.18);
    }

    .stars-fill {
      position: absolute;
      left: 0;
      top: 0;
      overflow: hidden;
      width: 0%;
      color: var(--accent);
      pointer-events: none;
      transition: filter .18s ease, text-shadow .18s ease;
    }
    
    .stars-fill.perfect {
      filter: drop-shadow(0 0 3px color-mix(in srgb, var(--accent) 50%, white 15%))
              drop-shadow(0 0 7px color-mix(in srgb, var(--accent) 35%, transparent));
      text-shadow:
        0 0 3px color-mix(in srgb, var(--accent) 50%, white 15%),
        0 0 7px color-mix(in srgb, var(--accent) 25%, transparent);
    }


    @media (max-width: 768px) {
      .panel > div[style*="display:flex"] {
        flex-direction: column !important;
        align-items: center !important;
        gap: 16px !important;
      }

      .showposter {
        width: 160px !important;
        height: 240px !important;
        flex: 0 0 160px !important;
        margin: 0 auto;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      }

      .showmeta {
        text-align: center;
        width: 100%;
      }

      .showmeta h1 {
        font-size: 1.6rem !important;
        line-height: 1.2;
      }

      .showTopRight {
        flex: 1 1 auto !important;
        width: 100% !important;
        min-width: 0 !important;
        margin-left: 0 !important;
      }

      .showActionPanels {
        flex-direction: column !important;
      }

      .favoritePanel {
        width: 100%;
        min-width: 0;
        flex: 1 1 auto;
      }

      div[style*="display:flex; gap:10px; margin-top:12px"] {
        flex-direction: column !important;
      }

      .ratingDistPanel {
        width: 100% !important;
      }

      .topbar {
        position: relative !important;
        height: auto !important;
        padding: 10px 0;
      }

      .topbar .wrap.row.between {
        flex-direction: column !important;
        align-items: center !important;
        gap: 12px !important;
      }

      .nav.row {
        display: flex !important;
        flex-wrap: wrap !important;
        justify-content: center !important;
        gap: 8px 15px !important;
      }

      .nav.row a {
        font-size: 13px !important;
        padding: 4px 0;
      }

      .auth.row {
        width: 100%;
        justify-content: center !important;
        border-top: 1px solid rgba(255,255,255,0.1);
        padding-top: 10px;
        margin-top: 5px;
      }

      main.wrap {
        margin-top: 10px !important;
      }

      .reviewcard {
        padding: 8px !important;
      }

      .review_votes {
        margin-top: 12px;
        justify-content: flex-start;
        border-top: 1px solid rgba(255,255,255,0.05);
        padding-top: 8px;
      }

      .stars {
        font-size: 38px !important;
        justify-content: center !important;
      }

      .starwrap {
        justify-content: center !important;
        flex-direction: column;
        gap: 8px;
      }
    }

    @media (max-width: 720px) {
      .reviewsLayout {
        display: block !important;
      }

      .reviewsMain,
      .reviewsSide {
        width: 100% !important;
        min-width: 0 !important;
        max-width: none !important;
      }

      .reviewsSide {
        margin-top: 16px !important;
      }
    }

    /* =========================================================
       SHOW DETAIL — COMPACT DISCUSSION LAYOUT
       ========================================================= */

    .showJumpNav {
      position: sticky;
      top: 8px;
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 7px;
      flex-wrap: wrap;
      margin: 10px 0 14px;
      padding: 8px;
      border: 1px solid rgba(255,255,255,0.09);
      border-radius: 13px;
      background: rgba(8,8,8,0.94);
      backdrop-filter: blur(12px);
      box-shadow: 0 8px 30px rgba(0,0,0,0.22);
    }

    .showJumpNav a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 32px;
      padding: 0 11px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.035);
      color: rgba(255,255,255,0.76);
      text-decoration: none;
      font-size: 11px;
      font-weight: 850;
    }

    .showJumpNav a:hover {
      color: #fff;
      background: rgba(255,255,255,0.07);
      border-color: color-mix(in srgb, var(--accent) 38%, rgba(255,255,255,0.10));
    }

    .showJumpCount {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 20px;
      height: 20px;
      padding: 0 5px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent) 22%, rgba(255,255,255,0.05));
      color: #fff;
      font-size: 9px;
      font-weight: 900;
    }

    .discussionSection {
      scroll-margin-top: 70px;
    }

    .discussionHeader {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 10px;
      padding: 14px 16px;
      border: 1px solid color-mix(in srgb, var(--accent) 20%, rgba(255,255,255,0.10));
      border-radius: 14px;
      background: #050505;
    }

    .discussionHeader h2 {
      margin: 5px 0 0;
      font-size: 22px;
      color: #fff;
    }

    .discussionHeaderMeta {
      margin-top: 4px;
      color: rgba(255,255,255,0.55);
      font-size: 12px;
    }

    .discussionLayout {
      display: grid;
      grid-template-columns: minmax(0,1fr) 330px;
      gap: 12px;
      align-items: start;
    }

    .discussionFeed {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .reviewConversation {
      display: grid;
      grid-template-columns: minmax(280px, .88fr) minmax(340px, 1.12fr);
      min-width: 0;
      border: 1px solid rgba(255,255,255,0.09);
      border-radius: 15px;
      background: rgba(255,255,255,0.025);
      overflow: hidden;
    }

    .reviewPane {
      min-width: 0;
      padding: 14px;
      border-right: 1px solid rgba(255,255,255,0.07);
      background: rgba(255,255,255,0.018);
    }

    .commentsPane {
      min-width: 0;
      display: flex;
      flex-direction: column;
      background: rgba(0,0,0,0.18);
    }

    .commentsPaneHeader {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 11px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      background: rgba(255,255,255,0.025);
    }

    .commentsPaneTitle {
      color: #fff;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .02em;
    }

    .commentsPaneCount {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 24px;
      height: 22px;
      padding: 0 7px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent) 18%, rgba(255,255,255,0.04));
      border: 1px solid color-mix(in srgb, var(--accent) 26%, rgba(255,255,255,0.07));
      color: #fff;
      font-size: 10px;
      font-weight: 900;
    }

    .commentsScroller {
      max-height: 390px;
      overflow-y: auto;
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      scrollbar-width: thin;
    }

    .commentsScroller::-webkit-scrollbar {
      width: 7px;
    }

    .commentsScroller::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.16);
      border-radius: 999px;
    }

    .commentsEmpty {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 90px;
      padding: 14px;
      color: rgba(255,255,255,0.45);
      font-size: 12px;
      text-align: center;
    }

    .commentsComposer {
      padding: 10px;
      border-top: 1px solid rgba(255,255,255,0.07);
      background: rgba(5,5,5,0.92);
    }

    .commentsComposer .comment-form {
      margin: 0;
    }

    .commentsComposer .comment-form textarea {
      min-height: 58px;
      max-height: 150px;
      padding: 9px 10px;
      border-radius: 10px;
      font-size: 12px;
    }

    .commentsComposer .review-actions {
      margin-top: 7px;
    }

    .commentsComposer .btn {
      padding: 6px 10px;
      font-size: 11px;
    }

    .comment-item {
      padding: 9px !important;
      border-radius: 10px !important;
      background: rgba(255,255,255,0.035) !important;
      border: 1px solid rgba(255,255,255,0.07) !important;
    }

    .comment-item .comment-item.comment-reply {
      background: rgba(255,255,255,0.022) !important;
    }

    .comment-replies {
      display: flex;
      flex-direction: column;
      gap: 7px;
      margin-top: 8px;
      margin-left: 16px;
      padding-left: 9px;
      border-left: 2px solid color-mix(in srgb, var(--accent) 28%, rgba(255,255,255,0.08));
    }

    .comment-reply {
      margin-left: 0 !important;
      padding-left: 8px !important;
      border-left: 0 !important;
    }

    .comment-head {
      margin-bottom: 5px !important;
    }

    .commentText {
      color: rgba(255,255,255,0.75);
      font-size: 12px;
      line-height: 1.45;
      overflow-wrap: anywhere;
    }

    .replyToggle {
      margin-top: 7px;
    }

    .replyToggle summary {
      width: fit-content;
      cursor: pointer;
      color: color-mix(in srgb, var(--accent) 70%, white 22%);
      font-size: 10px;
      font-weight: 800;
      list-style: none;
    }

    .replyToggle summary::-webkit-details-marker {
      display: none;
    }

    .replyToggle summary::before {
      content: "↳ ";
      opacity: .7;
    }

    .replyToggle .comment-form {
      margin-top: 7px;
    }

    .replyToggle .comment-form textarea {
      min-height: 56px;
      font-size: 12px;
    }

    .reviewPane .reviewcard,
    .reviewPane.reviewcard {
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
    }

    .reviewPane .reviewhead {
      margin-bottom: 10px;
    }

    .reviewPane .reviewtext {
      margin-top: 10px;
      color: rgba(255,255,255,0.88);
      font-size: 13px;
      line-height: 1.55;
      overflow-wrap: anywhere;
    }

    .reviewPane .review_footer {
      align-items: center;
      margin-top: 12px;
      padding-top: 10px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }

    .reviewPane .review_posted_date {
      color: rgba(255,255,255,0.42);
    }

    .reviewComposer {
      position: sticky;
      top: 62px;
      scroll-margin-top: 70px;
      padding: 15px;
      border: 1px solid color-mix(in srgb, var(--accent) 20%, rgba(255,255,255,0.10));
      border-radius: 14px;
      background: #050505;
    }

    .reviewComposer h3 {
      margin: 5px 0 12px;
      color: #fff;
    }

    .reviewComposer .write-review-form textarea {
      min-height: 150px;
      max-height: 320px;
    }

    .discussionEmpty {
      padding: 34px 18px;
      border: 1px dashed rgba(255,255,255,0.10);
      border-radius: 14px;
      color: rgba(255,255,255,0.50);
      text-align: center;
    }

    @media (max-width: 1180px) {
      .discussionLayout {
        grid-template-columns: minmax(0,1fr) 290px;
      }

      .reviewConversation {
        grid-template-columns: 1fr;
      }

      .reviewPane {
        border-right: 0;
        border-bottom: 1px solid rgba(255,255,255,0.07);
      }

      .commentsScroller {
        max-height: 310px;
      }
    }

    @media (max-width: 840px) {
      .discussionLayout {
        grid-template-columns: 1fr;
      }

      .reviewComposer {
        position: static;
        order: -1;
      }

      .showJumpNav {
        position: static;
      }
    }

    @media (max-width: 650px) {
      .discussionHeader {
        align-items: stretch;
        flex-direction: column;
      }

      .discussionHeader .reviewSortForm {
        width: 100%;
      }

      .reviewConversation {
        border-radius: 12px;
      }

      .reviewPane {
        padding: 11px;
      }

      .commentsScroller {
        max-height: 280px;
      }

      .comment-replies {
        margin-left: 8px;
      }
    }

  </style>
</head>

<%
  const POSTER_FALLBACK = "/static/posters/placeholder.png";
  const meUser = typeof me !== "undefined" ? me : null;
  const showRow = row || {};
  const reviewList = Array.isArray(reviews) ? [...reviews] : [];
  const activeSort = typeof sort !== "undefined" ? sort : "popular";
  const myReviewText = typeof my_review !== "undefined" ? (my_review || "") : "";
  const myRatingVal = typeof my_rating !== "undefined" ? my_rating : null;
  const loginNext = "/login?next=" + encodeURIComponent("/show/" + (showRow.id || ""));
  const notifCountSafe = typeof notif_count !== "undefined" ? Number(notif_count || 0) : 0;
  const notifItemsSafe = (typeof notif_items !== "undefined" && Array.isArray(notif_items)) ? notif_items : [];
  const currentUserId = meUser ? Number(meUser.id) : null;
  const isFavorite = typeof is_favorite !== "undefined" ? !!is_favorite : false;
  const favoriteCount = typeof favorite_count !== "undefined" ? Number(favorite_count || 0) : 0;
  const showFavoriteCount = typeof show_favorite_count !== "undefined" ? Number(show_favorite_count || 0) : 0;

  const friendRatings = Array.isArray(typeof friend_ratings !== "undefined" ? friend_ratings : [])
    ? friend_ratings
    : [];

  const friendRatingCount = friendRatings.length;
  
  const friendRatingAvg = friendRatingCount > 0
    ? friendRatings.reduce((sum, fr) => sum + (Number(fr.rating_half || 0) / 2), 0) / friendRatingCount
    : 0;
  const overallRank = typeof overall_rank !== "undefined" ? Number(overall_rank || 0) : 0;
  const criticRank = typeof critic_rank !== "undefined" ? Number(critic_rank || 0) : 0;
  const corpsRank = typeof corps_rank !== "undefined" ? Number(corps_rank || 0) : 0;
  const yearRank = typeof year_rank !== "undefined" ? Number(year_rank || 0) : 0;
  const overallTieRank = typeof overall_tie_rank !== "undefined" ? Number(overall_tie_rank || 0) : 0;
  const criticTieRank = typeof critic_tie_rank !== "undefined" ? Number(critic_tie_rank || 0) : 0;

  const friendRatingAvgValue = typeof friend_rating_avg !== "undefined" ? Number(friend_rating_avg || 0) : 0;
  const friendRatingCountValue = typeof friend_rating_count !== "undefined" ? Number(friend_rating_count || 0) : 0;
  const friendRank = typeof friend_rank !== "undefined" ? Number(friend_rank || 0) : 0;
  const friendTieRank = typeof friend_tie_rank !== "undefined" ? Number(friend_tie_rank || 0) : 0;

  const distLabels = ["5.0","4.5","4.0","3.5","3.0","2.5","2.0","1.5","1.0","0.5","0.0"];
  const ratingHistogramRaw = (typeof rating_histogram !== "undefined" && rating_histogram) ? rating_histogram : {};
  const verifiedHistogramRaw = (typeof verified_rating_histogram !== "undefined" && verified_rating_histogram) ? verified_rating_histogram : {};

  function getHistCount(obj, key) {
    if (!obj) return 0;
    const v = obj[key];
    const n = Number(v || 0);
    return Number.isFinite(n) ? n : 0;
  }

  const ratingDistRows = distLabels.map((label) => ({
    label,
    count: getHistCount(ratingHistogramRaw, label)
  }));

  const verifiedDistRows = distLabels.map((label) => ({
    label,
    count: getHistCount(verifiedHistogramRaw, label)
  }));

  const ratingDistTotal = ratingDistRows.reduce((sum, r) => sum + r.count, 0);
  const verifiedDistTotal = verifiedDistRows.reduce((sum, r) => sum + r.count, 0);
  const ratingDistMax = ratingDistRows.reduce((m, r) => Math.max(m, r.count), 0);
  const verifiedDistMax = verifiedDistRows.reduce((m, r) => Math.max(m, r.count), 0);

  const verifiedWeightedTotal = verifiedDistRows.reduce((sum, r) => sum + (Number(r.label) * r.count), 0);
  const verifiedAverage = verifiedDistTotal > 0 ? (verifiedWeightedTotal / verifiedDistTotal) : 0;
%>

<body class="app" style="--accent: <%= accent_color || '#3252b3' %>;">
  <header class="topbar">
    <div class="wrap row between">
      <div style="display:flex; align-items:center; gap:10px;">
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" style="display:flex; align-items:center;">
          <img
            src="/static/logo.png"
            alt="Logo"
            style="width:36px; height:36px; object-fit:contain; flex-shrink:0; transition: transform 0.6s ease-in-out;"
            onmouseover="this.style.transform='rotate(360deg)'"
            onmouseout="this.style.transform='rotate(0deg)'"
          >
        </a>
      
        <a class="brand" href="/shows" style="display:flex; align-items:center; text-decoration:none;">
          <img
            src="/static/pressboxd-wordmark.png"
            alt="Pressboxd"
            style="height:68px; width:auto; display:block;"
          >
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <a href="/predictions">Predictions</a>
        <a href="/forums">Forums</a>
        <a href="/tierlists">Tierlists</a>
        <% if (meUser && Number(meUser.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (meUser) { %>
          <div class="authBellSlot">
            <div class="notifWrap">
              <button class="bellBtn" id="bellBtn" aria-label="Notifications" title="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1"/>
                  <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
                </svg>

                <% if (notifCountSafe > 0) { %>
                  <span class="badgeDot"><%= notifCountSafe %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>
                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>

                <% if (notifItemsSafe.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of notifItemsSafe) {
                      const kind = (n && n.kind) || "";
                      const actor = (n && n.actor_username) || "Someone";
                      const created = (n && n.created_at) || "";
                      const unread = Number((n && n.is_read) != null ? n.is_read : 0) === 0;
                      const sid = (n && n.show_id) || null;
                    %>
                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>
                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>
                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (sid) { %> — <a href="/show/<%= sid %>">View show</a><% } %>
                          </div>
                        <% } else if (kind === "review_comment") { %>
                          <div>
                            <b><%= actor %></b> commented on your review
                            <% if (sid) { %> — <a href="/show/<%= sid %>">View show</a><% } %>
                          </div>
                        <% } else if (kind === "comment_reply") { %>
                          <div>
                            <b><%= actor %></b> replied to your comment
                            <% if (sid) { %> — <a href="/show/<%= sid %>">View show</a><% } %>
                          </div>
                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (meUser.avatar_url) { %>
                <img src="<%= meUser.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= meUser.username || "me" %></span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <% if (typeof flashes !== "undefined" && Array.isArray(flashes) && flashes.length > 0) { %>
      <div class="flashes">
        <% for (const f of flashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <div id="show-overview" style="margin-top:14px;">
      <div class="panel">
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:28px; width:100%;">
          <div style="display:flex; align-items:flex-start; gap:18px; flex:1 1 auto; min-width:0;">
            <div class="showposter" style="position:relative; overflow:hidden; width:240px; height:360px; flex:0 0 240px;">
              <img
                src="<%= showRow.poster_url || POSTER_FALLBACK %>"
                alt="<%= showRow.title || 'Show' %> poster"
                style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;"
                onerror="this.onerror=null;this.src='<%= POSTER_FALLBACK %>';"
              >
              <div class="poster_fallback" style="position:absolute; inset:0;"></div>
            </div>

            <div class="showmeta" style="flex:1 1 auto; min-width:0;">
              <div class="kicker">Show</div>
              <h1 style="margin:6px 0 8px;"><%= showRow.title || "" %></h1>
              <div class="muted">
                <% if (showRow.year) { %>
                  <a href="/shows?year=<%= encodeURIComponent(showRow.year) %>" style="color:inherit; text-decoration:none;"><%= showRow.year %></a>
                <% } %>
                <% if (showRow.year && showRow.corps) { %>
                  <span> — </span>
                <% } %>
                <% if (showRow.corps) { %>
                  <a href="/shows?corps=<%= encodeURIComponent(showRow.corps) %>" style="color:inherit; text-decoration:none;"><%= showRow.corps %></a>
                <% } %>
              </div>

              <div style="margin-top:12px; display:flex; flex-direction:column; align-items:flex-start; gap:8px;">
                <% const avgRating = Number(showRow.avg_rating || 0); %>
                <% const totalRatings = Number(showRow.cnt || 0); %>

                <% if (totalRatings === 0) { %>
                  <span class="badge muted">Unrated</span>
                <% } else { %>
                  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                    <span class="badge good">★ <%= avgRating.toFixed(2) %></span>
                    <span class="badge muted"><%= totalRatings %> ratings</span>
                    <% if (overallRank > 0) { %>
                      <span class="badge muted">
                        Rank #<%= overallRank %>
                        <% if (overallTieRank > 0 && overallTieRank !== overallRank) { %>
                          <span class="tie-rank">(T-<%= overallTieRank %>)</span>
                        <% } %>
                      </span>
                    <% } %>
                  </div>
                <% } %>

                <% if (verifiedDistTotal > 0) { %>
                  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                    <span class="badge" style="border-color: rgba(255,255,255,0.14); background: rgba(255,255,255,0.05);">
                      Critic Avg. ★ <%= verifiedAverage.toFixed(2) %>
                    </span>
                    <% if (criticRank > 0) { %>
                      <span class="badge muted">
                        Critic Rank #<%= criticRank %>
                        <% if (criticTieRank > 0 && criticTieRank !== criticRank) { %>
                          <span class="tie-rank">(T-<%= criticTieRank %>)</span>
                        <% } %>
                      </span>
                    <% } else { %>
                      <span class="badge muted">Needs 5 ratings to rank</span>
                    <% } %>
                  </div>
                <% } %>

                <% if (yearRank > 0 && showRow.year) { %>
                  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                    <span class="badge muted"><%= showRow.year %> Rank #<%= yearRank %></span>
                  </div>
                <% } %>

                <% if (corpsRank > 0 && showRow.corps) { %>
                  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                    <span class="badge muted"><%= showRow.corps %> Rank #<%= corpsRank %></span>
                  </div>
                <% } %>

                <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                  <span class="badge muted"><%= showFavoriteCount %> favorite<%= showFavoriteCount === 1 ? '' : 's' %></span>
                </div>

                <% if (meUser) { %>
                  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                    <% if (friendRatingCountValue > 0) { %>
                      <span class="badge good">Friend Avg. ★ <%= friendRatingAvgValue.toFixed(2) %></span>
                
                      <% if (friendRank > 0) { %>
                        <span class="badge muted">
                          Friend Rank #<%= friendRank %>
                          <% if (friendTieRank > 0 && friendTieRank !== friendRank) { %>
                            <span class="tie-rank">(T-<%= friendTieRank %>)</span>
                          <% } %>
                        </span>
                      <% } %>
                
                      <details class="friendRatingBox" style="width:auto; max-width:none;">
                        <summary class="friendRatingSummary">
                          <span class="badge muted">
                            <%= friendRatingCountValue %> friend rating<%= friendRatingCountValue === 1 ? '' : 's' %>
                          </span>
                        </summary>
                
                        <div class="friendRatingDropdown">
                          <% for (const fr of friendRatings) {
                            const frHalf = Number(fr.rating_half || 0);
                            const frRatingText = (frHalf / 2).toFixed(frHalf % 2 ? 1 : 0);
                          %>
                            <div class="friendRatingItem">
                              <div class="friendRatingUser">
                                <a href="/u/<%= encodeURIComponent(fr.username || '') %>" class="friendRatingAvatar">
                                  <% if (fr.avatar_url) { %>
                                    <img src="<%= fr.avatar_url %>" alt="<%= fr.username || 'user' %>">
                                  <% } %>
                                </a>
                
                                <div style="min-width:0;">
                                  <a
                                    href="/u/<%= encodeURIComponent(fr.username || '') %>"
                                    style="font-weight:800; text-decoration:none; color:inherit;"
                                  >
                                    <%= fr.username || "User" %>
                                  </a>
                                </div>
                              </div>
                
                              <div style="display:flex; align-items:center; gap:8px; white-space:nowrap;">
                                <span style="font-weight:900;">★ <%= frRatingText %></span>
                              </div>
                            </div>
                          <% } %>
                        </div>
                      </details>
                    <% } else { %>
                      <span class="badge muted">No friend ratings yet</span>
                    <% } %>
                  </div>
                <% } %>
                
        

                <% if (meUser && Number(meUser.is_admin) === 1) { %>
                  <a class="btn ghost" href="/admin/show/<%= showRow.id %>/edit">Edit show</a>
                <% } %>
              </div>
            </div>
          </div>

          <div class="showTopRight">
            <div class="showActionPanels">
              <div class="panel favoritePanel">
                <div class="favoriteLabel">Favorite Show</div>

                <% if (meUser) { %>
                  <% if (isFavorite) { %>
                    <form class="favoriteHeartForm" method="post" action="/show/<%= showRow.id %>/unfavorite">
                      <button class="favoriteHeartBtn on" type="submit" title="Remove from favorites" aria-label="Remove from favorites">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                      </button>
                    </form>
                  <% } else { %>
                    <form class="favoriteHeartForm" method="post" action="/show/<%= showRow.id %>/favorite">
                      <button class="favoriteHeartBtn" type="submit" title="Add to favorites" aria-label="Add to favorites">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                      </button>
                    </form>
                  <% } %>

                  <div class="favoriteMeta"><%= favoriteCount %>/5 selected</div>
                <% } else { %>
                  <div class="favoriteMeta">
                    <a href="<%= loginNext %>">Log in</a> to favorite.
                  </div>
                <% } %>
              </div>

              <div class="panel ratingPanel">
                <% if (meUser) { %>
                  <div class="kicker">Your rating</div>

                  <form id="rateForm" method="post" action="/show/<%= showRow.id %>/rate">
                    <input type="hidden" name="rating_half" id="ratingHalf" value="<%= myRatingVal != null ? myRatingVal : 0 %>"/>

                    <div class="starwrap" style="justify-content:flex-end;">
                      <div
                        class="stars"
                        id="stars"
                        data-rating="<%= myRatingVal != null ? myRatingVal : 0 %>"
                        aria-label="Rate this show from 0 to 5 stars in half-star steps"
                        role="slider"
                        tabindex="0"
                      >
                        <div class="stars-base">★★★★★</div>
                        <div class="stars-fill" id="starsFill">★★★★★</div>
                      </div>

                      <div class="muted" id="ratingLabel" style="min-width:90px;"></div>
                    </div>
                  </form>

                  <% if (myRatingVal != null) { %>
                    <form method="post" action="/show/<%= showRow.id %>/unrate" style="margin-top:10px;">
                      <button class="btn ghost" type="submit">Remove rating</button>
                    </form>
                  <% } %>

                  <script>
                  (function () {
                    const stars = document.getElementById("stars");
                    const fill = document.getElementById("starsFill");
                    const input = document.getElementById("ratingHalf");
                    const label = document.getElementById("ratingLabel");
                    const form = document.getElementById("rateForm");
                    if (!stars || !fill || !input || !label || !form) return;
                
                    const initial = parseInt(stars.dataset.rating || "0", 10);
                    setDisplay(initial);
                
                    function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }
                    function halfToText(rh) {
                      const val = (rh / 2).toFixed(rh % 2 ? 1 : 0);
                      return val + " ★";
                    }
                    function setDisplay(rh) {
                      const safe = clamp(rh, 0, 10);
                      const pct = (safe / 10) * 100;
                      fill.style.width = pct + "%";
                      fill.classList.toggle("perfect", safe === 10);
                      label.textContent = halfToText(safe);
                    }
                    function eventToHalf(e) {
                      const rect = stars.getBoundingClientRect();
                      const x = clamp(e.clientX - rect.left, 0, rect.width);
                      return clamp(Math.round((x / rect.width) * 10), 0, 10);
                    }
                
                    stars.addEventListener("mousemove", (e) => setDisplay(eventToHalf(e)));
                    stars.addEventListener("mouseleave", () => setDisplay(parseInt(input.value || "0", 10)));
                
                    stars.addEventListener("click", (e) => {
                      const rh = eventToHalf(e);
                      input.value = rh;
                      setDisplay(rh);
                      form.submit();
                    });
                
                    stars.addEventListener("keydown", (e) => {
                      let rh = parseInt(input.value || "0", 10);
                      if (e.key === "ArrowLeft") rh = clamp(rh - 1, 0, 10);
                      if (e.key === "ArrowRight") rh = clamp(rh + 1, 0, 10);
                
                      if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        form.submit();
                        return;
                      }
                
                      if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
                        e.preventDefault();
                        input.value = rh;
                        setDisplay(rh);
                      }
                    });
                  })();
                </script>
                <% } else { %>
                  <div class="muted">
                    <a href="<%= loginNext %>">Log in</a> to rate this show.
                  </div>
                <% } %>
              </div>
            </div>

            <div style="display:flex; gap:10px; margin-top:12px; align-items:flex-start;">
              <a
                href="/show/<%= showRow.id %>/critics"
                class="panel ratingDistPanel criticPanelLink"
                style="width:50%; margin-top:0; padding:10px; text-decoration:none; color:inherit; display:block;"
              >
                <div class="ratingDistHeader" style="margin-bottom:8px;">
                  <div>
                    <div class="kicker" style="font-size:12px;">Critic Rating</div>
                    <div class="muted small" style="margin-top:2px;">Click to view all verified critic ratings</div>
                  </div>
                  <div class="ratingDistMeta" style="font-size:11px;"><%= verifiedDistTotal %> total</div>
                </div>

                <% if (verifiedDistTotal > 0) { %>
                  <div class="ratingDistList" style="gap:6px;">
                    <% for (const r of verifiedDistRows) {
                      const pct = verifiedDistMax > 0 ? (r.count / verifiedDistMax) * 100 : 0;
                    %>
                      <div class="ratingDistRow" style="grid-template-columns: 42px 1fr 30px; gap:8px;">
                        <div class="ratingDistLabel" style="font-size:12px;"><%= r.label %>★</div>
                        <div class="ratingDistTrack" style="height:8px;">
                          <div class="ratingDistFill" style="width:<%= pct %>%"></div>
                        </div>
                        <div class="ratingDistCount" style="font-size:11px;"><%= r.count %></div>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="ratingDistEmpty" style="font-size:12px;">No verified reviewer ratings yet.</div>
                <% } %>
              </a>

              <div class="panel ratingDistPanel" style="width:50%; margin-top:0; padding:10px;">
                <div class="ratingDistHeader" style="margin-bottom:8px;">
                  <div><div class="kicker">All Ratings</div></div>
                  <div class="ratingDistMeta" style="font-size:11px;"><%= ratingDistTotal %> total</div>
                </div>

                <% if (ratingDistTotal > 0) { %>
                  <div class="ratingDistList" style="gap:6px;">
                    <% for (const r of ratingDistRows) {
                      const pct = ratingDistMax > 0 ? (r.count / ratingDistMax) * 100 : 0;
                    %>
                      <div class="ratingDistRow" style="grid-template-columns: 42px 1fr 30px; gap:8px;">
                        <div class="ratingDistLabel" style="font-size:12px;"><%= r.label %>★</div>
                        <div class="ratingDistTrack" style="height:8px;">
                          <div class="ratingDistFill" style="width:<%= pct %>%"></div>
                        </div>
                        <div class="ratingDistCount" style="font-size:11px;"><%= r.count %></div>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="ratingDistEmpty" style="font-size:12px;">No ratings yet.</div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    
    <%
      const totalDiscussionComments = reviewList.reduce((sum, rv) => {
        return sum + Number(rv && rv.comment_count ? rv.comment_count : 0);
      }, 0);
    %>

    <nav class="showJumpNav" aria-label="Show page sections">
      <a href="#show-overview">Overview</a>
      <a href="#community-discussion">
        Reviews & Comments
        <span class="showJumpCount"><%= reviewList.length %></span>
      </a>
      <a href="#write-review">Write Review</a>
    </nav>

    <section id="community-discussion" class="discussionSection">
      <div class="discussionHeader">
        <div>
          <div class="kicker">Community</div>
          <h2>Reviews & Discussion</h2>
          <div class="discussionHeaderMeta">
            <%= reviewList.length %> review<%= reviewList.length === 1 ? '' : 's' %>
            •
            <%= totalDiscussionComments %> comment<%= totalDiscussionComments === 1 ? '' : 's' %>
          </div>
        </div>

        <form method="get" action="/show/<%= showRow.id %>" class="reviewSortForm">
          <label for="reviewSort" class="muted small" style="display:block;margin-bottom:6px;">Sort reviews</label>
          <select id="reviewSort" name="sort" class="reviewSortSelect" onchange="this.form.submit()">
            <option value="popular" <%= activeSort === 'popular' ? 'selected' : '' %>>Most Popular</option>
            <option value="newest" <%= activeSort === 'newest' ? 'selected' : '' %>>Newest</option>
            <option value="oldest" <%= activeSort === 'oldest' ? 'selected' : '' %>>Oldest</option>
            <option value="highest" <%= activeSort === 'highest' ? 'selected' : '' %>>Lowest Reviewed</option>
            <option value="lowest" <%= activeSort === 'lowest' ? 'selected' : '' %>>Highest Reviewed</option>
          </select>
        </form>
      </div>

      <div class="discussionLayout">
        <div class="discussionFeed">
          <% if (reviewList.length > 0) { %>
            <% for (const rv of reviewList) {
              const commentList = Array.isArray(rv.comments)
                ? [...rv.comments].sort((a, b) => {
                    const at = String(a.created_at || '');
                    const bt = String(b.created_at || '');
                    return at.localeCompare(bt);
                  })
                : [];

              const rvVote = Number(rv.vote_score || 0);
              const myVote = rv.my_vote == null ? 0 : Number(rv.my_vote);
              const isOwner = currentUserId != null && currentUserId === Number(rv.user_id);
              const canAdminDelete = meUser && Number(meUser.is_admin || 0) === 1 && !isOwner;
            %>
              <article class="reviewConversation">
                <div class="reviewPane">
                  <div class="reviewcard">
                    <div class="reviewhead">
                      <div class="reviewuser">
                        <a href="/u/<%= encodeURIComponent(rv.username || '') %>" class="reviewavatar">
                          <% if (rv.avatar_url) { %>
                            <img src="<%= rv.avatar_url %>" alt="<%= rv.username || 'user' %>">
                          <% } %>
                        </a>

                        <div class="reviewmeta">
                          <div class="reviewname">
                            <a href="/u/<%= encodeURIComponent(rv.username || '') %>"><%= rv.username || "User" %></a>

                            <% if (rv.role_name) { %>
                              <span class="rolebadge" style="background:<%= rv.role_color || '#666666' %>;">
                                <%= rv.role_name %>
                              </span>
                            <% } %>

                            <% if (rv.rating_half != null) { %>
                              <span class="review_rating_plain">
                                ★ <%= (Number(rv.rating_half) / 2).toFixed(Number(rv.rating_half) % 2 ? 1 : 0) %>
                              </span>
                            <% } %>
                          </div>
                        </div>
                      </div>

                      <% if (canAdminDelete) { %>
                        <form method="post" action="/admin/show/<%= showRow.id %>/review/<%= rv.user_id %>/delete">
                          <button class="btn ghost" type="submit">Delete review</button>
                        </form>
                      <% } %>
                    </div>

                    <div class="reviewtext"><%= rv.review_text || "" %></div>

                    <div class="review_footer">
                      <div class="review_votes">
                        <% if (meUser && !isOwner) { %>
                          <form method="post" action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/vote" style="display:inline;">
                            <input type="hidden" name="vote" value="1">
                            <button class="vote_btn up <%= myVote === 1 ? 'on' : '' %>" type="submit" aria-label="Upvote review" title="Upvote">▲</button>
                          </form>

                          <form method="post" action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/vote" style="display:inline;">
                            <input type="hidden" name="vote" value="-1">
                            <button class="vote_btn down <%= myVote === -1 ? 'on' : '' %>" type="submit" aria-label="Downvote review" title="Downvote">▼</button>
                          </form>
                        <% } %>

                        <span class="vote_total"><%= rvVote > 0 ? '+' + rvVote : rvVote %></span>
                      </div>

                      <% if (rv.ts) { %>
                        <div class="review_posted_date">
                          Posted <%= new Date(Number(rv.ts) * 1000).toLocaleDateString('en-US') %>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>

                <div class="commentsPane">
                  <div class="commentsPaneHeader">
                    <div class="commentsPaneTitle">Discussion</div>
                    <span class="commentsPaneCount"><%= Number(rv.comment_count || 0) %></span>
                  </div>

                  <div class="commentsScroller">
                    <% if (commentList.length > 0) { %>
                      <% for (const c of commentList) {
                        const isCommentOwner = currentUserId != null && currentUserId === Number(c.commenter_user_id);
                        const canAdminDeleteComment = meUser && Number(meUser.is_admin || 0) === 1;
                        const replyList = Array.isArray(c.replies) ? c.replies : [];
                        const commentDeleted = String(c.comment_text || '').trim() === '[comment deleted]';
                      %>
                        <div class="comment-item">
                          <div class="comment-head">
                            <div class="comment-user">
                              <a href="/u/<%= encodeURIComponent(c.commenter_username || '') %>" class="comment-avatar">
                                <% if (c.commenter_avatar_url) { %>
                                  <img src="<%= c.commenter_avatar_url %>" alt="<%= c.commenter_username || 'user' %>">
                                <% } %>
                              </a>

                              <div>
                                <div style="font-weight:700;font-size:12px;">
                                  <a href="/u/<%= encodeURIComponent(c.commenter_username || '') %>">
                                    <%= c.commenter_username || "User" %>
                                  </a>
                                </div>

                                <% if (c.created_at) { %>
                                  <div class="muted" style="font-size:9px;"><%= c.created_at %></div>
                                <% } %>
                              </div>
                            </div>

                            <% if (!commentDeleted) { %>
                              <% if (canAdminDeleteComment) { %>
                                <form method="post" action="/admin/show/<%= showRow.id %>/comment/<%= c.comment_id %>/delete">
                                  <button class="btn ghost" type="submit" style="padding:4px 7px;font-size:9px;">Delete</button>
                                </form>
                              <% } else if (isCommentOwner) { %>
                                <form method="post" action="/show/<%= showRow.id %>/comment/<%= c.comment_id %>/delete">
                                  <button class="btn ghost" type="submit" style="padding:4px 7px;font-size:9px;">Delete</button>
                                </form>
                              <% } %>
                            <% } %>
                          </div>

                          <div class="commentText">
                            <%= commentDeleted ? '[comment deleted]' : c.comment_text %>
                          </div>

                          <% if (replyList.length > 0) { %>
                            <div class="comment-replies">
                              <% for (const r of replyList) {
                                const isReplyOwner = currentUserId != null && currentUserId === Number(r.replier_user_id);
                                const replyDeleted = String(r.reply_text || '').trim() === '[reply deleted]';
                              %>
                                <div class="comment-item comment-reply">
                                  <div class="comment-head">
                                    <div class="comment-user">
                                      <a href="/u/<%= encodeURIComponent(r.replier_username || '') %>" class="comment-avatar">
                                        <% if (r.replier_avatar_url) { %>
                                          <img src="<%= r.replier_avatar_url %>" alt="<%= r.replier_username || 'user' %>">
                                        <% } %>
                                      </a>

                                      <div>
                                        <div style="font-weight:700;font-size:12px;">
                                          <a href="/u/<%= encodeURIComponent(r.replier_username || '') %>">
                                            <%= r.replier_username || "User" %>
                                          </a>
                                        </div>

                                        <% if (r.created_at) { %>
                                          <div class="muted" style="font-size:9px;"><%= r.created_at %></div>
                                        <% } %>
                                      </div>
                                    </div>

                                    <% if (!replyDeleted) { %>
                                      <% if (canAdminDeleteComment) { %>
                                        <form method="post" action="/admin/show/<%= showRow.id %>/reply/<%= r.reply_id %>/delete">
                                          <button class="btn ghost" type="submit" style="padding:4px 7px;font-size:9px;">Delete</button>
                                        </form>
                                      <% } else if (isReplyOwner) { %>
                                        <form method="post" action="/show/<%= showRow.id %>/reply/<%= r.reply_id %>/delete">
                                          <button class="btn ghost" type="submit" style="padding:4px 7px;font-size:9px;">Delete</button>
                                        </form>
                                      <% } %>
                                    <% } %>
                                  </div>

                                  <div class="commentText">
                                    <% if (!replyDeleted && r.parent_replier_username) { %>
                                      <b>@<%= r.parent_replier_username %></b>
                                      <span> </span>
                                    <% } %>
                                    <%= replyDeleted ? '[reply deleted]' : r.reply_text %>
                                  </div>

                                  <% if (meUser && !replyDeleted) { %>
                                    <details class="replyToggle">
                                      <summary>Reply</summary>
                                      <form
                                        class="comment-form"
                                        method="post"
                                        action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/comment/<%= c.comment_id %>/reply"
                                      >
                                        <input type="hidden" name="parent_reply_id" value="<%= r.reply_id %>">
                                        <textarea name="reply_text" placeholder="Write a reply…" required></textarea>
                                        <div class="review-actions">
                                          <button class="btn ghost" type="submit">Post reply</button>
                                        </div>
                                      </form>
                                    </details>
                                  <% } %>
                                </div>
                              <% } %>
                            </div>
                          <% } %>

                          <% if (meUser && !commentDeleted) { %>
                            <details class="replyToggle">
                              <summary>Reply</summary>
                              <form
                                class="comment-form"
                                method="post"
                                action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/comment/<%= c.comment_id %>/reply"
                              >
                                <textarea name="reply_text" placeholder="Write a reply…" required></textarea>
                                <div class="review-actions">
                                  <button class="btn ghost" type="submit">Post reply</button>
                                </div>
                              </form>
                            </details>
                          <% } %>
                        </div>
                      <% } %>
                    <% } else { %>
                      <div class="commentsEmpty">No comments yet. Start the discussion.</div>
                    <% } %>
                  </div>

                  <div class="commentsComposer">
                    <% if (meUser) { %>
                      <form
                        class="comment-form"
                        method="post"
                        action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/comment"
                      >
                        <textarea name="comment_text" placeholder="Add a comment…" required></textarea>
                        <div class="review-actions">
                          <button class="btn ghost" type="submit">Post comment</button>
                        </div>
                      </form>
                    <% } else { %>
                      <div class="muted" style="font-size:11px;">
                        <a href="<%= loginNext %>">Log in</a> to comment.
                      </div>
                    <% } %>
                  </div>
                </div>
              </article>
            <% } %>
          <% } else { %>
            <div class="discussionEmpty">
              No reviews yet. Be the first to write one.
            </div>
          <% } %>
        </div>

        <aside id="write-review" class="reviewComposer">
          <div class="kicker">Share your thoughts</div>
          <h3>Write a Review</h3>

          <% if (meUser) { %>
            <form class="write-review-form" action="/show/<%= showRow.id %>/review" method="POST">
              <textarea
                name="review_text"
                placeholder="Write your review here..."
                required
              ><%= myReviewText %></textarea>

              <div class="review-actions">
                <button type="submit" class="btn primary">Save Review</button>

                <% if (myReviewText && myReviewText.trim()) { %>
                  <button
                    type="submit"
                    class="btn ghost"
                    formaction="/show/<%= showRow.id %>/review/delete"
                    formmethod="POST"
                  >
                    Delete Review
                  </button>
                <% } %>
              </div>
            </form>
          <% } else { %>
            <div class="muted">
              <p>
                Please
                <a href="/login?next=<%= encodeURIComponent('/show/' + showRow.id) %>">log in</a>
                to review.
              </p>
            </div>
          <% } %>
        </aside>
      </div>
    </section>

  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd = document.getElementById("notifDropdown");
      if (!btn || !dd) return;

      dd.addEventListener("click", (e) => e.stopPropagation());

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        dd.classList.toggle("open");
      });

      document.addEventListener("click", () => {
        dd.classList.remove("open");
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") dd.classList.remove("open");
      });
    })();
  </script>
</body>
</html>
