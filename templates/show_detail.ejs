<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= row && row.title ? row.title : "Show Detail" %> - Pressboxd</title>

  <link rel="icon" type="image/png" href="/static/favicon.png"/>
  <link rel="stylesheet" href="/static/styles.css"/>

  <style>
    html,
    body,
    body.app {
      font-family:ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    }

    .auth { align-items:center; gap: 12px; }

    .notifWrap { position: relative; display: inline-flex; align-items:center; }
    .bellBtn {
      position: relative;
      border: none;
      background: transparent;
      cursor: pointer;
      color: inherit;
      padding: 6px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.95;
    }
    .bellBtn:hover { background: rgba(255,255,255,0.06); }

    .badgeDot {
      position:absolute;
      top: 3px;
      right: 3px;
      min-width: 18px;
      height: 18px;
      padding: 0 6px;
      border-radius: 999px;
      background: #ff3b30;
      color: #fff;
      font-size: 11px;
      line-height: 18px;
      text-align: center;
      font-weight: 800;
      box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }

    .notifDropdown {
      display: none;
      position: absolute;
      right: 0;
      top: 40px;
      width: 340px;
      max-height: 420px;
      overflow: auto;
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.45);
      z-index: 9999;
    }
    .notifDropdown.open { display:block; }

    .notifHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding: 10px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.10);
      position: sticky;
      top: 0;
      background: rgba(15, 23, 42, 0.98);
      backdrop-filter: blur(8px);
    }

    .notifTitle { font-weight: 900; }

    .markReadBtn {
      border: none;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.85;
      font-size: 12px;
      padding: 6px 8px;
      border-radius: 10px;
    }
    .markReadBtn:hover { background: rgba(255,255,255,0.06); opacity: 1; }

    .notifList {
      padding: 8px;
      display:flex;
      flex-direction:column;
      gap: 8px;
    }

    .notifItem {
      padding: 10px;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .notifItem.unread {
      background: rgba(99,102,241,0.18);
      border-color: rgba(99,102,241,0.25);
    }

    .notifTime {
      font-size: 12px;
      opacity: 0.7;
      margin-top: 4px;
    }

    .notifEmpty {
      padding: 12px;
      opacity: 0.8;
    }

    .authBellSlot { display:inline-flex; align-items:center; }

    .notifDropdown,
    .notifDropdown * {
      pointer-events: auto !important;
    }

    .ratingDistPanel {
      margin-top: 12px;
      box-shadow: none;
    }

    .ratingDistHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom: 12px;
    }

    .ratingDistTitle {
      font-weight: 900;
      line-height: 1.15;
    }

    .ratingDistMeta {
      text-align:right;
      font-size: 12px;
      opacity: 0.8;
      white-space: nowrap;
    }

    .ratingDistList {
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    .ratingDistRow {
      display:grid;
      grid-template-columns: 52px 1fr 42px;
      gap:10px;
      align-items:center;
    }

    .ratingDistLabel {
      font-size: 13px;
      font-weight: 700;
      opacity: 0.95;
    }

    .ratingDistTrack {
      position: relative;
      height: 10px;
      border-radius: 999px;
      overflow: hidden;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.06);
    }

    .ratingDistFill {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      min-width: 0;
      border-radius: 999px;
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--accent) 90%, #ffffff 0%),
        color-mix(in srgb, var(--accent) 60%, #ffffff 0%)
      );
    }

    .ratingDistCount {
      text-align: right;
      font-size: 12px;
      opacity: 0.85;
      font-variant-numeric: tabular-nums;
    }

    .reviewToolbar {
      gap: 16px;
    }

    .reviewSortForm {
      min-width: 220px;
    }

    .review_footer {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 12px;
      margin-top: 10px;
    }

    .review_posted_date {
      margin-left: auto;
      text-align: right;
      font-size: 10px;
      color: var(--muted);
      white-space: nowrap;
    }

    .criticPanelLink {
      transition: transform .15s ease, border-color .15s ease, background .15s ease;
      cursor: pointer;
    }

    .comment-reply {
      margin-left: 22px;
      padding-left: 12px;
      border-left: 2px solid rgba(255,255,255,0.12);
    }


    .criticPanelLink:hover {
      transform: translateY(-1px);
      background: rgba(255,255,255,0.045);
      border-color: color-mix(in srgb, var(--accent) 28%, rgba(255,255,255,0.14));
    }

    .criticPanelLink:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    @media (max-width: 720px) {
      .review_footer {
        flex-direction: column;
        align-items: flex-start;
      }

      .review_posted_date {
        margin-left: 0;
        text-align: left;
        white-space: normal;
      }
    }

    .reviewSortSelect {
      width: 100%;
      min-width: 220px;
      padding: 10px 12px;
      background: #000 !important;
      color: #fff !important;
      border: 1px solid rgba(255,255,255,0.16);
      border-radius: 10px;
      outline: none;
      box-shadow: none;
    }

    .reviewSortSelect:focus {
      border-color: var(--accent);
    }

    .reviewSortSelect option {
      background: #000 !important;
      color: #fff !important;
    }

    @media (max-width: 720px) {
      .reviewToolbar {
        flex-direction: column !important;
        align-items: stretch !important;
      }

      .reviewSortForm {
        width: 100%;
        min-width: 0;
      }

      .reviewSortSelect {
        min-width: 0;
        width: 100%;
      }
    }

    .ratingDistEmpty {
      font-size: 16px;
      opacity: 0.75;
    }

    .reviewcard {
      padding: 14px;
      border: 1px solid var(--accentSoft);
      border-radius: 14px;
      background: rgba(255,255,255,0.03);
      margin-bottom: 14px;
    }

    .reviewhead {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
      margin-bottom:10px;
    }

    .reviewuser {
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .reviewavatar {
      width:40px;
      height:40px;
      border-radius:999px;
      overflow:hidden;
      background: rgba(255,255,255,0.08);
      flex: 0 0 40px;
    }

    .reviewavatar img {
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .reviewmeta {
      min-width:0;
    }

    .reviewname {
      font-weight:800;
      display:flex;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
    }

    .rolebadge {
      display:inline-flex;
      align-items:center;
      font-size:11px;
      font-weight:800;
      border-radius:999px;
      padding:3px 8px;
      color:#fff;
    }

    .reviewsub {
      font-size:12px;
      opacity:0.8;
    }

    .reviewtext {
      white-space: pre-wrap;
      line-height:1.5;
      margin-top: 6px;
    }

    .review_votes {
      display:flex;
      align-items:center;
      gap:8px;
      margin-top: 12px;
      flex-wrap:wrap;
    }

    .vote_btn {
      border: 1px solid var(--accentSoft);
      background: rgba(255,255,255,0.03);
      color: inherit;
      border-radius: 10px;
      padding: 6px 10px;
      cursor: pointer;
      font-weight: 700;
      min-width: 36px;
      text-align: center;
      transition: background .15s ease, border-color .15s ease, color .15s ease, transform .15s ease;
    }

    .vote_btn:hover {
      background: rgba(255,255,255,0.06);
    }

    .vote_btn.up.on {
      background: rgba(34,197,94,0.18);
      border-color: rgba(34,197,94,0.65);
      color: #22c55e;
    }

    .vote_btn.down.on {
      background: rgba(239,68,68,0.18);
      border-color: rgba(239,68,68,0.65);
      color: #ef4444;
    }

    .vote_total {
      display: inline-flex;
      align-items: center;
      padding: 4px 8px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 800;
      color: var(--muted);
      border: 1px solid var(--accentSoft);
      background: rgba(255,255,255,0.03);
    }

    .vote_btn.active {
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 18%, transparent);
    }

    .comment-item {
      padding: 10px;
      border-radius: 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--accentSoft);
    }

    .comment-head {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:6px;
    }

    .comment-user {
      display:flex;
      align-items:center;
      gap:8px;
    }

    .comment-avatar {
      width:28px;
      height:28px;
      border-radius:999px;
      overflow:hidden;
      background: rgba(255,255,255,0.08);
      flex:0 0 28px;
    }

    .comment-avatar img {
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .comment-form textarea,
    .write-review-form textarea {
      width:100%;
      min-height:200px;
      resize:vertical;
      border-radius:12px;
      border: 1px solid var(--accentSoft);
      background: rgba(255,255,255,0.03);
      color: inherit;
      padding: 12px;
      font: inherit;
    }

    .comment-form textarea {
      min-height:72px;
    }

    .review-actions {
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      margin-top:12px;
    }

    .reviewsSection {
      width: 100% !important;
    }

    .reviewsLayout {
      display: flex !important;
      align-items: flex-start !important;
      gap: 20px !important;
      width: 100% !important;
      flex-wrap: nowrap !important;
    }

    .reviewsMain {
      flex: 1 1 auto !important;
      min-width: 0 !important;
      width: auto !important;
    }

    .reviewsSide {
      flex: 0 0 600px !important;
      width: 600px !important;
      min-width: 600px !important;
      align-self: flex-start !important;
    }

    .reviewlist,
    .reviewcard {
      width: 100% !important;
      max-width: none !important;
    }

    .review_rating_plain {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-weight: 800;
      color: var(--text);
    }

    .showTopRight {
      flex: 0 0 540px !important;
      width: 540px !important;
      min-width: 540px !important;
      margin-left: auto;
    }

    .showActionPanels {
      display: flex;
      gap: 12px;
      align-items: stretch;
    }

    .favoritePanel {
      flex: 0 0 132px;
      width: 132px;
      min-width: 132px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-shadow: none;
      margin: 0;
      padding: 14px 10px;
    }

    .favoriteLabel {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .04em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 10px;
    }

    .favoriteHeartForm {
      width: 100%;
    }

    .favoriteHeartBtn {
      width: 72px;
      height: 72px;
      border-radius: 999px;
      border: 1px solid var(--accentSoft);
      background: rgba(255,255,255,0.03);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform .15s ease, border-color .15s ease, background .15s ease, box-shadow .15s ease;
      box-shadow: 0 10px 24px rgba(0,0,0,.18);
    }

    .favoriteHeartBtn:hover {
      transform: translateY(-1px);
      background: rgba(255,255,255,0.06);
    }

    .favoriteHeartBtn.on {
      color: #ff4d6d;
      border-color: rgba(255,77,109,0.45);
      background: rgba(255,77,109,0.12);
      box-shadow: 0 0 0 1px rgba(255,77,109,0.10) inset, 0 10px 24px rgba(0,0,0,.18);
    }

    .favoriteHeartBtn svg {
      width: 34px;
      height: 34px;
      display: block;
    }

    .favoriteMeta {
      margin-top: 10px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.35;
    }

    .ratingPanel {
      flex: 1 1 auto;
      min-width: 0;
      box-shadow: none;
      margin: 0;
      width: 100%;
    }

    .starwrap {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .stars {
      position: relative;
      display: inline-block;
      font-size: 42px;
      line-height: 1;
      letter-spacing: 0;
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
    }

    .stars-base {
      color: rgba(255,255,255,0.18);
    }

    .stars-fill {
      position: absolute;
      left: 0;
      top: 0;
      overflow: hidden;
      width: 0%;
      color: var(--accent);
      pointer-events: none;
      transition: filter .18s ease, text-shadow .18s ease;
    }
    
    .stars-fill.perfect {
      filter: drop-shadow(0 0 3px color-mix(in srgb, var(--accent) 70%, white 30%))
              drop-shadow(0 0 7px color-mix(in srgb, var(--accent) 45%, transparent));
      text-shadow:
        0 0 3px color-mix(in srgb, var(--accent) 70%, white 30%),
        0 0 7px color-mix(in srgb, var(--accent) 45%, transparent);
    }


    @media (max-width: 768px) {
      .panel > div[style*="display:flex"] {
        flex-direction: column !important;
        align-items: center !important;
        gap: 16px !important;
      }

      .showposter {
        width: 160px !important;
        height: 240px !important;
        flex: 0 0 160px !important;
        margin: 0 auto;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      }

      .showmeta {
        text-align: center;
        width: 100%;
      }

      .showmeta h1 {
        font-size: 1.6rem !important;
        line-height: 1.2;
      }

      .showTopRight {
        flex: 1 1 auto !important;
        width: 100% !important;
        min-width: 0 !important;
        margin-left: 0 !important;
      }

      .showActionPanels {
        flex-direction: column !important;
      }

      .favoritePanel {
        width: 100%;
        min-width: 0;
        flex: 1 1 auto;
      }

      div[style*="display:flex; gap:10px; margin-top:12px"] {
        flex-direction: column !important;
      }

      .ratingDistPanel {
        width: 100% !important;
      }

      .topbar {
        position: relative !important;
        height: auto !important;
        padding: 10px 0;
      }

      .topbar .wrap.row.between {
        flex-direction: column !important;
        align-items: center !important;
        gap: 12px !important;
      }

      .nav.row {
        display: flex !important;
        flex-wrap: wrap !important;
        justify-content: center !important;
        gap: 8px 15px !important;
      }

      .nav.row a {
        font-size: 13px !important;
        padding: 4px 0;
      }

      .auth.row {
        width: 100%;
        justify-content: center !important;
        border-top: 1px solid rgba(255,255,255,0.1);
        padding-top: 10px;
        margin-top: 5px;
      }

      main.wrap {
        margin-top: 10px !important;
      }

      .reviewcard {
        padding: 8px !important;
      }

      .review_votes {
        margin-top: 12px;
        justify-content: flex-start;
        border-top: 1px solid rgba(255,255,255,0.05);
        padding-top: 8px;
      }

      .stars {
        font-size: 38px !important;
        justify-content: center !important;
      }

      .starwrap {
        justify-content: center !important;
        flex-direction: column;
        gap: 8px;
      }
    }

    @media (max-width: 720px) {
      .reviewsLayout {
        display: block !important;
      }

      .reviewsMain,
      .reviewsSide {
        width: 100% !important;
        min-width: 0 !important;
        max-width: none !important;
      }

      .reviewsSide {
        margin-top: 16px !important;
      }
    }
  </style>
</head>

<%
  const POSTER_FALLBACK = "/static/posters/placeholder.png";
  const meUser = typeof me !== "undefined" ? me : null;
  const showRow = row || {};
  const reviewList = Array.isArray(reviews) ? [...reviews] : [];
  const activeSort = typeof sort !== "undefined" ? sort : "popular";
  const myReviewText = typeof my_review !== "undefined" ? (my_review || "") : "";
  const myRatingVal = typeof my_rating !== "undefined" ? my_rating : null;
  const loginNext = "/login?next=" + encodeURIComponent("/show/" + (showRow.id || ""));
  const notifCountSafe = typeof notif_count !== "undefined" ? Number(notif_count || 0) : 0;
  const notifItemsSafe = (typeof notif_items !== "undefined" && Array.isArray(notif_items)) ? notif_items : [];
  const currentUserId = meUser ? Number(meUser.id) : null;
  const isFavorite = typeof is_favorite !== "undefined" ? !!is_favorite : false;
  const favoriteCount = typeof favorite_count !== "undefined" ? Number(favorite_count || 0) : 0;
  const showFavoriteCount = typeof show_favorite_count !== "undefined" ? Number(show_favorite_count || 0) : 0;
  const overallRank = typeof overall_rank !== "undefined" ? Number(overall_rank || 0) : 0;
  const criticRank = typeof critic_rank !== "undefined" ? Number(critic_rank || 0) : 0;
  const corpsRank = typeof corps_rank !== "undefined" ? Number(corps_rank || 0) : 0;
  const yearRank = typeof year_rank !== "undefined" ? Number(year_rank || 0) : 0;

  const distLabels = ["5.0","4.5","4.0","3.5","3.0","2.5","2.0","1.5","1.0","0.5","0.0"];
  const ratingHistogramRaw = (typeof rating_histogram !== "undefined" && rating_histogram) ? rating_histogram : {};
  const verifiedHistogramRaw = (typeof verified_rating_histogram !== "undefined" && verified_rating_histogram) ? verified_rating_histogram : {};

  function getHistCount(obj, key) {
    if (!obj) return 0;
    const v = obj[key];
    const n = Number(v || 0);
    return Number.isFinite(n) ? n : 0;
  }

  const ratingDistRows = distLabels.map((label) => ({
    label,
    count: getHistCount(ratingHistogramRaw, label)
  }));

  const verifiedDistRows = distLabels.map((label) => ({
    label,
    count: getHistCount(verifiedHistogramRaw, label)
  }));

  const ratingDistTotal = ratingDistRows.reduce((sum, r) => sum + r.count, 0);
  const verifiedDistTotal = verifiedDistRows.reduce((sum, r) => sum + r.count, 0);
  const ratingDistMax = ratingDistRows.reduce((m, r) => Math.max(m, r.count), 0);
  const verifiedDistMax = verifiedDistRows.reduce((m, r) => Math.max(m, r.count), 0);

  const verifiedWeightedTotal = verifiedDistRows.reduce((sum, r) => sum + (Number(r.label) * r.count), 0);
  const verifiedAverage = verifiedDistTotal > 0 ? (verifiedWeightedTotal / verifiedDistTotal) : 0;
%>

<body
  class="app"
  style="
    --accent: <%= accent_color || '#3252b3' %>;
    --accent2: <%= accent_color || '#3252b3' %>;
    --accentSoft: color-mix(in srgb, <%= accent_color || '#3252b3' %> 90%, transparent);
    --accentFaint: color-mix(in srgb, <%= accent_color || '#3252b3' %> 68%, transparent);
    --accentGlow: color-mix(in srgb, <%= accent_color || '#3252b3' %> 80%, transparent);
  ">
  <header class="topbar">
    <div class="wrap row between">
      <div style="display:flex; align-items:center; gap:10px;">
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" style="display:flex; align-items:center;">
          <img
            src="/static/logo.png"
            alt="Logo"
            style="width:36px; height:36px; object-fit:contain; flex-shrink:0; transition: transform 0.6s ease-in-out;"
            onmouseover="this.style.transform='rotate(360deg)'"
            onmouseout="this.style.transform='rotate(0deg)'"
          >
        </a>
      
        <a class="brand" href="/shows" style="display:flex; align-items:center; text-decoration:none;">
          <img
            src="/static/pressboxd-wordmark.png"
            alt="Pressboxd"
            style="height:68px; width:auto; display:block;"
          >
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <% if (meUser && Number(meUser.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (meUser) { %>
          <div class="authBellSlot">
            <div class="notifWrap">
              <button class="bellBtn" id="bellBtn" aria-label="Notifications" title="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1"/>
                  <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
                </svg>

                <% if (notifCountSafe > 0) { %>
                  <span class="badgeDot"><%= notifCountSafe %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>
                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>

                <% if (notifItemsSafe.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of notifItemsSafe) {
                      const kind = (n && n.kind) || "";
                      const actor = (n && n.actor_username) || "Someone";
                      const created = (n && n.created_at) || "";
                      const unread = Number((n && n.is_read) != null ? n.is_read : 0) === 0;
                      const sid = (n && n.show_id) || null;
                    %>
                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>
                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>
                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (sid) { %> — <a href="/show/<%= sid %>">View show</a><% } %>
                          </div>
                        <% } else if (kind === "review_comment") { %>
                          <div>
                            <b><%= actor %></b> commented on your review
                            <% if (sid) { %> — <a href="/show/<%= sid %>">View show</a><% } %>
                          </div>
                        <% } else if (kind === "comment_reply") { %>
                          <div>
                            <b><%= actor %></b> replied to your comment
                            <% if (sid) { %> — <a href="/show/<%= sid %>">View show</a><% } %>
                          </div>
                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (meUser.avatar_url) { %>
                <img src="<%= meUser.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= meUser.username || "me" %></span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <% if (typeof flashes !== "undefined" && Array.isArray(flashes) && flashes.length > 0) { %>
      <div class="flashes">
        <% for (const f of flashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <div style="margin-top:14px;">
      <div class="panel">
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:28px; width:100%;">
          <div style="display:flex; align-items:flex-start; gap:18px; flex:1 1 auto; min-width:0;">
            <div class="showposter" style="position:relative; overflow:hidden; width:240px; height:360px; flex:0 0 240px;">
              <img
                src="<%= showRow.poster_url || POSTER_FALLBACK %>"
                alt="<%= showRow.title || 'Show' %> poster"
                style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;"
                onerror="this.onerror=null;this.src='<%= POSTER_FALLBACK %>';"
              >
              <div class="poster_fallback" style="position:absolute; inset:0;"></div>
            </div>

            <div class="showmeta" style="flex:1 1 auto; min-width:0;">
              <div class="kicker">Show</div>
              <h1 style="margin:6px 0 8px;"><%= showRow.title || "" %></h1>
              <div class="muted">
                <% if (showRow.year) { %>
                  <a href="/shows?year=<%= encodeURIComponent(showRow.year) %>" style="color:inherit; text-decoration:none;"><%= showRow.year %></a>
                <% } %>
                <% if (showRow.year && showRow.corps) { %>
                  <span> — </span>
                <% } %>
                <% if (showRow.corps) { %>
                  <a href="/shows?corps=<%= encodeURIComponent(showRow.corps) %>" style="color:inherit; text-decoration:none;"><%= showRow.corps %></a>
                <% } %>
              </div>

              <div style="margin-top:12px; display:flex; flex-direction:column; align-items:flex-start; gap:8px;">
                <% const avgRating = Number(showRow.avg_rating || 0); %>
                <% const totalRatings = Number(showRow.cnt || 0); %>

                <% if (totalRatings === 0) { %>
                  <span class="badge muted">Unrated</span>
                <% } else { %>
                  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                    <span class="badge good">★ <%= avgRating.toFixed(2) %></span>
                    <span class="badge muted"><%= totalRatings %> ratings</span>
                    <% if (overallRank > 0) { %>
                      <span class="badge muted">Rank #<%= overallRank %></span>
                    <% } %>
                  </div>
                <% } %>

                <% if (verifiedDistTotal > 0) { %>
                  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                    <span class="badge" style="border-color: rgba(255,255,255,0.14); background: rgba(255,255,255,0.05);">
                      Critic Avg. ★ <%= verifiedAverage.toFixed(2) %>
                    </span>
                    <% if (criticRank > 0) { %>
                      <span class="badge muted">Critic Rank #<%= criticRank %></span>
                    <% } else { %>
                      <span class="badge muted">Needs 5 ratings to rank</span>
                    <% } %>
                  </div>
                <% } %>

                <% if (yearRank > 0 && showRow.year) { %>
                  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                    <span class="badge muted"><%= showRow.year %> Rank #<%= yearRank %></span>
                  </div>
                <% } %>

                <% if (corpsRank > 0 && showRow.corps) { %>
                  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                    <span class="badge muted"><%= showRow.corps %> Rank #<%= corpsRank %></span>
                  </div>
                <% } %>

                <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                  <span class="badge muted"><%= showFavoriteCount %> favorite<%= showFavoriteCount === 1 ? '' : 's' %></span>
                </div>

                <% if (meUser && Number(meUser.is_admin) === 1) { %>
                  <a class="btn ghost" href="/admin/show/<%= showRow.id %>/edit">Edit show</a>
                <% } %>
              </div>
            </div>
          </div>

          <div class="showTopRight">
            <div class="showActionPanels">
              <div class="panel favoritePanel">
                <div class="favoriteLabel">Favorite Show</div>

                <% if (meUser) { %>
                  <% if (isFavorite) { %>
                    <form class="favoriteHeartForm" method="post" action="/show/<%= showRow.id %>/unfavorite">
                      <button class="favoriteHeartBtn on" type="submit" title="Remove from favorites" aria-label="Remove from favorites">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                      </button>
                    </form>
                  <% } else { %>
                    <form class="favoriteHeartForm" method="post" action="/show/<%= showRow.id %>/favorite">
                      <button class="favoriteHeartBtn" type="submit" title="Add to favorites" aria-label="Add to favorites">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                      </button>
                    </form>
                  <% } %>

                  <div class="favoriteMeta"><%= favoriteCount %>/5 selected</div>
                <% } else { %>
                  <div class="favoriteMeta">
                    <a href="<%= loginNext %>">Log in</a> to favorite.
                  </div>
                <% } %>
              </div>

              <div class="panel ratingPanel">
                <% if (meUser) { %>
                  <div class="kicker">Your rating</div>

                  <form id="rateForm" method="post" action="/show/<%= showRow.id %>/rate">
                    <input type="hidden" name="rating_half" id="ratingHalf" value="<%= myRatingVal != null ? myRatingVal : 0 %>"/>

                    <div class="starwrap" style="justify-content:flex-end;">
                      <div
                        class="stars"
                        id="stars"
                        data-rating="<%= myRatingVal != null ? myRatingVal : 0 %>"
                        aria-label="Rate this show from 0 to 5 stars in half-star steps"
                        role="slider"
                        tabindex="0"
                      >
                        <div class="stars-base">★★★★★</div>
                        <div class="stars-fill" id="starsFill">★★★★★</div>
                      </div>

                      <div class="muted" id="ratingLabel" style="min-width:90px;"></div>
                    </div>
                  </form>

                  <% if (myRatingVal != null) { %>
                    <form method="post" action="/show/<%= showRow.id %>/unrate" style="margin-top:10px;">
                      <button class="btn ghost" type="submit">Remove rating</button>
                    </form>
                  <% } %>

                  <script>
                  (function () {
                    const stars = document.getElementById("stars");
                    const fill = document.getElementById("starsFill");
                    const input = document.getElementById("ratingHalf");
                    const label = document.getElementById("ratingLabel");
                    const form = document.getElementById("rateForm");
                    if (!stars || !fill || !input || !label || !form) return;
                
                    const initial = parseInt(stars.dataset.rating || "0", 10);
                    setDisplay(initial);
                
                    function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }
                    function halfToText(rh) {
                      const val = (rh / 2).toFixed(rh % 2 ? 1 : 0);
                      return val + " ★";
                    }
                    function setDisplay(rh) {
                      const safe = clamp(rh, 0, 10);
                      const pct = (safe / 10) * 100;
                      fill.style.width = pct + "%";
                      fill.classList.toggle("perfect", safe === 10);
                      label.textContent = halfToText(safe);
                    }
                    function eventToHalf(e) {
                      const rect = stars.getBoundingClientRect();
                      const x = clamp(e.clientX - rect.left, 0, rect.width);
                      return clamp(Math.round((x / rect.width) * 10), 0, 10);
                    }
                
                    stars.addEventListener("mousemove", (e) => setDisplay(eventToHalf(e)));
                    stars.addEventListener("mouseleave", () => setDisplay(parseInt(input.value || "0", 10)));
                
                    stars.addEventListener("click", (e) => {
                      const rh = eventToHalf(e);
                      input.value = rh;
                      setDisplay(rh);
                      form.submit();
                    });
                
                    stars.addEventListener("keydown", (e) => {
                      let rh = parseInt(input.value || "0", 10);
                      if (e.key === "ArrowLeft") rh = clamp(rh - 1, 0, 10);
                      if (e.key === "ArrowRight") rh = clamp(rh + 1, 0, 10);
                
                      if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        form.submit();
                        return;
                      }
                
                      if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
                        e.preventDefault();
                        input.value = rh;
                        setDisplay(rh);
                      }
                    });
                  })();
                </script>
                <% } else { %>
                  <div class="muted">
                    <a href="<%= loginNext %>">Log in</a> to rate this show.
                  </div>
                <% } %>
              </div>
            </div>

            <div style="display:flex; gap:10px; margin-top:12px; align-items:flex-start;">
              <a
                href="/show/<%= showRow.id %>/critics"
                class="panel ratingDistPanel criticPanelLink"
                style="width:50%; margin-top:0; padding:10px; text-decoration:none; color:inherit; display:block;"
              >
                <div class="ratingDistHeader" style="margin-bottom:8px;">
                  <div>
                    <div class="kicker" style="font-size:12px;">Critic Rating</div>
                    <div class="muted small" style="margin-top:2px;">Click to view all verified critic ratings</div>
                  </div>
                  <div class="ratingDistMeta" style="font-size:11px;"><%= verifiedDistTotal %> total</div>
                </div>

                <% if (verifiedDistTotal > 0) { %>
                  <div class="ratingDistList" style="gap:6px;">
                    <% for (const r of verifiedDistRows) {
                      const pct = verifiedDistMax > 0 ? (r.count / verifiedDistMax) * 100 : 0;
                    %>
                      <div class="ratingDistRow" style="grid-template-columns: 42px 1fr 30px; gap:8px;">
                        <div class="ratingDistLabel" style="font-size:12px;"><%= r.label %>★</div>
                        <div class="ratingDistTrack" style="height:8px;">
                          <div class="ratingDistFill" style="width:<%= pct %>%"></div>
                        </div>
                        <div class="ratingDistCount" style="font-size:11px;"><%= r.count %></div>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="ratingDistEmpty" style="font-size:12px;">No verified reviewer ratings yet.</div>
                <% } %>
              </a>

              <div class="panel ratingDistPanel" style="width:50%; margin-top:0; padding:10px;">
                <div class="ratingDistHeader" style="margin-bottom:8px;">
                  <div><div class="kicker">All Ratings</div></div>
                  <div class="ratingDistMeta" style="font-size:11px;"><%= ratingDistTotal %> total</div>
                </div>

                <% if (ratingDistTotal > 0) { %>
                  <div class="ratingDistList" style="gap:6px;">
                    <% for (const r of ratingDistRows) {
                      const pct = ratingDistMax > 0 ? (r.count / ratingDistMax) * 100 : 0;
                    %>
                      <div class="ratingDistRow" style="grid-template-columns: 42px 1fr 30px; gap:8px;">
                        <div class="ratingDistLabel" style="font-size:12px;"><%= r.label %>★</div>
                        <div class="ratingDistTrack" style="height:8px;">
                          <div class="ratingDistFill" style="width:<%= pct %>%"></div>
                        </div>
                        <div class="ratingDistCount" style="font-size:11px;"><%= r.count %></div>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="ratingDistEmpty" style="font-size:12px;">No ratings yet.</div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div style="margin-top:8px;">
      <section class="reviewsSection">
        <div class="reviewsLayout">
          <div class="panel reviewsMain" style="flex:1 1 0; min-width:0;">
            <div class="row between reviewToolbar" style="margin-bottom:14px; align-items: flex-end;">
              <div>
                <div class="kicker">Reviews</div>
                <h2 style="margin:6px 0 0;">Community</h2>
                <div class="muted small" style="margin-top:4px;">
                  <%= reviewList.length %> review<%= reviewList.length === 1 ? '' : 's' %>
                </div>
              </div>

              <form method="get" action="/show/<%= showRow.id %>" class="reviewSortForm">
                <label for="reviewSort" class="muted small" style="display:block; margin-bottom:6px;">Sort by</label>
                <select id="reviewSort" name="sort" class="reviewSortSelect" onchange="this.form.submit()">
                  <option value="popular" <%= activeSort === 'popular' ? 'selected' : '' %>>Most Popular</option>
                  <option value="newest" <%= activeSort === 'newest' ? 'selected' : '' %>>Newest</option>
                  <option value="oldest" <%= activeSort === 'oldest' ? 'selected' : '' %>>Oldest</option>
                  <option value="highest" <%= activeSort === 'highest' ? 'selected' : '' %>>Lowest Reviewed</option>
                  <option value="lowest" <%= activeSort === 'lowest' ? 'selected' : '' %>>Highest Reviewed</option>
                </select>
              </form>
            </div>

            <% if (reviewList.length > 0) { %>
              <div class="reviewlist">
                <% for (const rv of reviewList) {
                  const commentList = Array.isArray(rv.comments)
                    ? [...rv.comments].sort((a, b) => {
                        const at = String(a.created_at || '');
                        const bt = String(b.created_at || '');
                        return at.localeCompare(bt);
                      })
                    : [];
                  const rvVote = Number(rv.vote_score || 0);
                  const myVote = rv.my_vote == null ? 0 : Number(rv.my_vote);
                  const isOwner = currentUserId != null && currentUserId === Number(rv.user_id);
                  const canAdminDelete = meUser && Number(meUser.is_admin || 0) === 1 && !isOwner;
                %>
                  <div class="reviewcard">
                    <div class="reviewhead">
                      <div class="reviewuser">
                        <a href="/u/<%= encodeURIComponent(rv.username || '') %>" class="reviewavatar">
                          <% if (rv.avatar_url) { %>
                            <img src="<%= rv.avatar_url %>" alt="<%= rv.username || 'user' %>">
                          <% } %>
                        </a>

                        <div class="reviewmeta">
                          <div class="reviewname">
                            <a href="/u/<%= encodeURIComponent(rv.username || '') %>"><%= rv.username || "User" %></a>

                            <% if (rv.role_name) { %>
                              <span class="rolebadge" style="background:<%= rv.role_color || '#666666' %>;">
                                <%= rv.role_name %>
                              </span>
                            <% } %>

                            <% if (rv.rating_half != null) { %>
                              <span class="review_rating_plain">★ <%= (Number(rv.rating_half) / 2).toFixed(Number(rv.rating_half) % 2 ? 1 : 0) %></span>
                            <% } %>
                          </div>
                        </div>
                      </div>

                      <% if (canAdminDelete) { %>
                        <form method="post" action="/admin/show/<%= showRow.id %>/review/<%= rv.user_id %>/delete">
                          <button class="btn ghost" type="submit">Delete review</button>
                        </form>
                      <% } %>
                    </div>

                    <div class="reviewtext"><%= rv.review_text || "" %></div>

                    <div class="review_footer">
                      <div class="review_votes">
                        <% if (meUser && !isOwner) { %>
                          <form method="post" action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/vote" style="display:inline;">
                            <input type="hidden" name="vote" value="1">
                            <button class="vote_btn up <%= myVote === 1 ? 'on' : '' %>" type="submit" aria-label="Upvote review" title="Upvote">▲</button>
                          </form>

                          <form method="post" action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/vote" style="display:inline;">
                            <input type="hidden" name="vote" value="-1">
                            <button class="vote_btn down <%= myVote === -1 ? 'on' : '' %>" type="submit" aria-label="Downvote review" title="Downvote">▼</button>
                          </form>
                        <% } %>

                        <span class="vote_total"><%= rvVote > 0 ? '+' + rvVote : rvVote %></span>
                      </div>

                      <% if (rv.ts) { %>
                        <div class="review_posted_date">
                          Posted on <%= new Date(Number(rv.ts) * 1000).toLocaleDateString('en-US') %>
                        </div>
                      <% } %>
                    </div>

                    <details style="margin-top:10px;">
                      <summary class="muted">
                        Comments (
                        <% if (rv.comment_count !== 0) { %>
                          <b><%= rv.comment_count %></b>
                        <% } else { %>
                          <%= rv.comment_count %>
                        <% } %>
                        )
                      </summary>
                    
                      <div style="margin-top:10px; display:flex; flex-direction:column; gap:10px;">
                        <% if (commentList.length > 0) { %>
                          <% for (const c of commentList) {
                            const isCommentOwner = currentUserId != null && currentUserId === Number(c.commenter_user_id);
                            const canAdminDeleteComment = meUser && Number(meUser.is_admin || 0) === 1;
                            const replyList = Array.isArray(c.replies) ? c.replies : [];
                          %>
                            <div class="comment-item">
                              <div class="comment-head">
                                <div class="comment-user">
                                  <a href="/u/<%= encodeURIComponent(c.commenter_username || '') %>" class="comment-avatar">
                                    <% if (c.commenter_avatar_url) { %>
                                      <img src="<%= c.commenter_avatar_url %>" alt="<%= c.commenter_username || 'user' %>">
                                    <% } %>
                                  </a>
                                  <div>
                                    <div style="font-weight:700;">
                                      <a href="/u/<%= encodeURIComponent(c.commenter_username || '') %>"><%= c.commenter_username || "User" %></a>
                                    </div>
                                    <% if (c.created_at) { %>
                                      <div class="muted small"><%= c.created_at %></div>
                                    <% } %>
                                  </div>
                                </div>
                    
                                <% if (canAdminDeleteComment) { %>
                                  <form method="post" action="/admin/show/<%= showRow.id %>/comment/<%= c.comment_id %>/delete">
                                    <button class="btn ghost" type="submit">Delete</button>
                                  </form>
                                <% } else if (isCommentOwner) { %>
                                  <form method="post" action="/show/<%= showRow.id %>/comment/<%= c.comment_id %>/delete">
                                    <button class="btn ghost" type="submit">Delete</button>
                                  </form>
                                <% } %>
                              </div>
                    
                              <div class="muted"><%= c.comment_text %></div>
                    
                              <% if (replyList.length > 0) { %>
                                <div style="margin-top:10px; margin-left:20px; display:flex; flex-direction:column; gap:8px;">
                                  <% for (const r of replyList) {
                                    const isReplyOwner = currentUserId != null && currentUserId === Number(r.replier_user_id);
                                  %>
                                    <div class="comment-item comment-reply" style="background:rgba(255,255,255,0.025);">
                                      <div class="comment-head">
                                        <div class="comment-user">
                                          <a href="/u/<%= encodeURIComponent(r.replier_username || '') %>" class="comment-avatar">
                                            <% if (r.replier_avatar_url) { %>
                                              <img src="<%= r.replier_avatar_url %>" alt="<%= r.replier_username || 'user' %>">
                                            <% } %>
                                          </a>
                                          <div>
                                            <div style="font-weight:700;">
                                              <a href="/u/<%= encodeURIComponent(r.replier_username || '') %>"><%= r.replier_username || "User" %></a>
                                            </div>
                                            <% if (r.created_at) { %>
                                              <div class="muted small"><%= r.created_at %></div>
                                            <% } %>
                                          </div>
                                        </div>
                              
                                        <% if (canAdminDeleteComment) { %>
                                          <form method="post" action="/admin/show/<%= showRow.id %>/reply/<%= r.reply_id %>/delete">
                                            <button class="btn ghost" type="submit">Delete</button>
                                          </form>
                                        <% } else if (isReplyOwner) { %>
                                          <form method="post" action="/show/<%= showRow.id %>/reply/<%= r.reply_id %>/delete">
                                            <button class="btn ghost" type="submit">Delete</button>
                                          </form>
                                        <% } %>
                                      </div>
                              
                                      <div class="muted">
                                        <% if (r.parent_replier_username) { %>
                                          <b>@<%= r.parent_replier_username %></b>
                                          <span> </span>
                                        <% } %>
                                        <%= r.reply_text %>
                                      </div>
                              
                                      <% if (meUser) { %>
                                        <details style="margin-top:10px;">
                                          <summary class="muted small" style="cursor:pointer;">Reply</summary>
                                          <form
                                            class="comment-form"
                                            method="post"
                                            action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/comment/<%= c.comment_id %>/reply"
                                            style="margin-top:8px;"
                                          >
                                            <input type="hidden" name="parent_reply_id" value="<%= r.reply_id %>">
                                            <textarea name="reply_text" placeholder="Write a reply…" required></textarea>
                                            <div class="review-actions">
                                              <button class="btn ghost" type="submit">Post reply</button>
                                            </div>
                                          </form>
                                        </details>
                                      <% } %>
                                    </div>
                                  <% } %>
                                </div>
                              <% } %>
                                
                              <% if (meUser) { %>
                                <details style="margin-top:10px;">
                                  <summary class="muted small" style="cursor:pointer;">Reply</summary>
                                  <form
                                    class="comment-form"
                                    method="post"
                                    action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/comment/<%= c.comment_id %>/reply"
                                    style="margin-top:8px;"
                                  >
                                    <textarea name="reply_text" placeholder="Write a reply…" required></textarea>
                                    <div class="review-actions">
                                      <button class="btn ghost" type="submit">Post reply</button>
                                    </div>
                                  </form>
                                </details>
                              <% } %>
                            </div>
                          <% } %>
                        <% } else { %>
                          <div class="muted">No comments yet.</div>
                        <% } %>
                    
                        <% if (meUser) { %>
                          <form
                            class="comment-form"
                            method="post"
                            action="/show/<%= showRow.id %>/review/<%= rv.user_id %>/comment"
                          >
                            <textarea name="comment_text" placeholder="Add a comment…" required></textarea>
                            <div class="review-actions">
                              <button class="btn ghost" type="submit">Post comment</button>
                            </div>
                          </form>
                        <% } else { %>
                          <div class="muted">Log in to comment.</div>
                        <% } %>
                      </div>
                    </details>
                  </div>
                <% } %>
              </div>
            <% } else { %>
              <div class="muted">No reviews yet. Be the first to write one.</div>
            <% } %>
          </div>

          <div class="panel reviewsSide">
            <div class="kicker">Share your thoughts</div>
            <h3 style="margin: 6px 0 16px;">Write a Review</h3>

            <% if (meUser) { %>
              <form class="write-review-form" action="/show/<%= showRow.id %>/review" method="POST">
                <textarea
                  name="review_text"
                  placeholder="Write your review here..."
                  required
                ><%= myReviewText %></textarea>

                <div class="review-actions">
                  <button type="submit" class="btn primary">Save Review</button>

                  <% if (myReviewText && myReviewText.trim()) { %>
                    <button
                      type="submit"
                      class="btn ghost"
                      formaction="/show/<%= showRow.id %>/review/delete"
                      formmethod="POST"
                    >
                      Delete Review
                    </button>
                  <% } %>
                </div>
              </form>
            <% } else { %>
              <div class="muted">
                <p>Please <a href="/login?next=<%= encodeURIComponent('/show/' + showRow.id) %>">log in</a> to review.</p>
              </div>
            <% } %>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd = document.getElementById("notifDropdown");
      if (!btn || !dd) return;

      dd.addEventListener("click", (e) => e.stopPropagation());

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        dd.classList.toggle("open");
      });

      document.addEventListener("click", () => {
        dd.classList.remove("open");
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") dd.classList.remove("open");
      });
    })();
  </script>
</body>
</html>
