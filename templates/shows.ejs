<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Shows - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
</head>

<%
  const safeMe = (typeof me !== "undefined" && me) ? me : null;
  const safeRows = Array.isArray(rows) ? rows : [];
  const safeFriendActivity = Array.isArray(friend_activity) ? friend_activity : [];
  const safeNotifCount = (typeof notif_count !== "undefined" && notif_count) ? Number(notif_count) : 0;
  const safeNotifItems = Array.isArray(notif_items) ? notif_items : [];
  const safeFlashes = Array.isArray(flashes) ? flashes : [];

  const currentSort = String(sort || "year_desc");
  const currentYear = String(year || "");
  const currentCorps = String(corps || "");

  function avgLabel(n) {
    const v = Number(n || 0);
    if (!Number.isFinite(v) || v <= 0) return "Unrated";
    return v.toFixed(2);
  }

  function ratingCount(n) {
    const v = Number(n || 0);
    return Number.isFinite(v) ? v : 0;
  }
%>

<body class="app" <%= safeMe && safeMe.theme_color ? `style="--accent:${safeMe.theme_color};"` : "" %>>
  <header class="topbar">
    <div class="wrap row between">
      <a class="brand" href="/shows">
        <span class="brand_logo_box">
          <img class="brand_logo" src="/static/logo.png" alt="Pressboxd logo">
        </span>
        <span>Pressboxd</span>
      </a>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <% if (safeMe && Number(safeMe.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (safeMe) { %>
          <div class="authBellSlot">
            <div class="notifWrap">
              <button class="bellBtn" id="bellBtn" aria-label="Notifications" title="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1"/>
                  <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
                </svg>

                <% if (safeNotifCount > 0) { %>
                  <span class="badgeDot"><%= safeNotifCount %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>
                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>

                <% if (safeNotifItems.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of safeNotifItems) {
                      const kind = n.kind || "";
                      const actor = n.actor_username || "Someone";
                      const created = n.created_at || "";
                      const unread = Number(n.is_read || 0) === 0;
                      const sid = n.show_id || null;
                    %>
                      <div class="notifItem <%= unread ? "unread" : "" %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>
                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>
                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else if (kind === "review_comment") { %>
                          <div>
                            <b><%= actor %></b> commented on your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (safeMe.avatar_url) { %>
                <img src="<%= safeMe.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= safeMe.username %></span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <% if (safeFlashes.length > 0) { %>
      <div class="flashes">
        <% for (const f of safeFlashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <section class="shows_header">
      <div class="shows_intro">
        <div class="kicker">Library</div>
        <h1 style="margin:6px 0 8px;">All Shows</h1>
        <div class="muted">
          Browse, filter, and rate drum corps shows.
          <% if (safeRows.length > 0) { %>
            Currently showing <b><%= safeRows.length %></b> show<%= safeRows.length === 1 ? "" : "s" %>.
          <% } %>
        </div>
      </div>

      <div class="pills">
        <a class="pilltab <%= currentSort === 'year_desc' ? 'active' : '' %>" href="/shows?sort=year_desc<%= currentYear ? `&year=${encodeURIComponent(currentYear)}` : '' %><%= currentCorps ? `&corps=${encodeURIComponent(currentCorps)}` : '' %>">Newest</a>
        <a class="pilltab <%= currentSort === 'year_asc' ? 'active' : '' %>" href="/shows?sort=year_asc<%= currentYear ? `&year=${encodeURIComponent(currentYear)}` : '' %><%= currentCorps ? `&corps=${encodeURIComponent(currentCorps)}` : '' %>">Oldest</a>
        <a class="pilltab <%= currentSort === 'corps' ? 'active' : '' %>" href="/shows?sort=corps<%= currentYear ? `&year=${encodeURIComponent(currentYear)}` : '' %><%= currentCorps ? `&corps=${encodeURIComponent(currentCorps)}` : '' %>">Corps</a>
        <a class="pilltab <%= currentSort === 'top' ? 'active' : '' %>" href="/shows?sort=top<%= currentYear ? `&year=${encodeURIComponent(currentYear)}` : '' %><%= currentCorps ? `&corps=${encodeURIComponent(currentCorps)}` : '' %>">Top Rated</a>
        <a class="pilltab <%= currentSort === 'bottom' ? 'active' : '' %>" href="/shows?sort=bottom<%= currentYear ? `&year=${encodeURIComponent(currentYear)}` : '' %><%= currentCorps ? `&corps=${encodeURIComponent(currentCorps)}` : '' %>">Lowest Rated</a>
      </div>
    </section>

    <section class="shows_shell">
      <aside class="shows_sidebar stack">
        <div class="panel">
          <div class="kicker">Filters</div>

          <form class="filter_form" method="get" action="/shows" style="margin-top:12px;">
            <div class="field">
              <label for="sort">Sort</label>
              <select id="sort" name="sort">
                <option value="year_desc" <%= currentSort === 'year_desc' ? 'selected' : '' %>>Newest first</option>
                <option value="year_asc" <%= currentSort === 'year_asc' ? 'selected' : '' %>>Oldest first</option>
                <option value="corps" <%= currentSort === 'corps' ? 'selected' : '' %>>Corps A–Z</option>
                <option value="top" <%= currentSort === 'top' ? 'selected' : '' %>>Top rated</option>
                <option value="bottom" <%= currentSort === 'bottom' ? 'selected' : '' %>>Lowest rated</option>
              </select>
            </div>

            <div class="field">
              <label for="year">Year</label>
              <input id="year" name="year" value="<%= currentYear %>" placeholder="e.g. 2024">
            </div>

            <div class="field">
              <label for="corps">Corps</label>
              <input id="corps" name="corps" value="<%= currentCorps %>" placeholder="e.g. Bluecoats">
            </div>

            <div class="filter_actions">
              <button class="btn primary" type="submit">Apply</button>
              <a class="btn ghost" href="/shows">Reset</a>
            </div>
          </form>
        </div>

        <% if (safeMe) { %>
          <div class="panel">
            <div class="kicker">Friend Activity</div>

            <% if (safeFriendActivity.length > 0) { %>
              <div class="friend_activity" style="margin-top:12px;">
                <% for (const item of safeFriendActivity) { %>
                  <a class="friend_item" href="/show/<%= item.show_id %>">
                    <div class="friend_thumb">
                      <% if (item.poster_url) { %>
                        <img src="<%= item.poster_url %>" alt="<%= item.title || item.corps || 'Poster' %> poster">
                      <% } else { %>
                        <div class="avatar_fallback"></div>
                      <% } %>
                    </div>

                    <div class="friend_body">
                      <div class="friend_title">
                        <%= item.actor_username || 'Someone' %>
                        <% if (item.kind === 'review') { %>
                          reviewed
                        <% } else { %>
                          rated
                        <% } %>
                        <%= item.title || `${item.corps || ''} ${item.year || ''}` %>
                      </div>

                      <div class="friend_meta">
                        <% if (item.year) { %><%= item.year %><% } %>
                        <% if (item.corps) { %> • <%= item.corps %><% } %>
                        <% if (item.rating_half != null) { %>
                          • ★ <%= (Number(item.rating_half) / 2).toFixed(1) %>
                        <% } %>
                      </div>
                    </div>
                  </a>
                <% } %>
              </div>
            <% } else { %>
              <div class="empty_state" style="margin-top:12px;">
                No friend activity yet.
              </div>
            <% } %>
          </div>
        <% } %>
      </aside>

      <section class="stack">
        <% if (safeRows.length > 0) { %>
          <div class="postergrid">
            <% for (const s of safeRows) { %>
              <a class="poster" href="/show/<%= s.id %>">
                <div class="poster_art">
                  <% if (s.poster_url) { %>
                    <img class="poster_img" src="<%= s.poster_url %>" alt="<%= s.title || 'Show' %> poster" loading="lazy">
                  <% } else { %>
                    <div class="poster_fallback"></div>
                  <% } %>

                  <div class="tile_rating">
                    <% if (ratingCount(s.cnt) > 0) { %>
                      <span class="tile_star">★</span>
                      <span><%= avgLabel(s.avg_rating) %></span>
                    <% } else { %>
                      <span>Unrated</span>
                    <% } %>
                  </div>

                  <% if (s.year) { %>
                    <div class="tile_year"><%= s.year %></div>
                  <% } %>
                </div>

                <div class="poster_meta">
                  <div class="poster_title"><%= s.title || '' %></div>
                  <div class="poster_sub"><%= s.corps || '' %></div>
                  <div class="tile_count">
                    <%= ratingCount(s.cnt) %> rating<%= ratingCount(s.cnt) === 1 ? '' : 's' %>
                  </div>
                </div>
              </a>
            <% } %>
          </div>
        <% } else { %>
          <div class="panel empty_state">
            No shows matched your filters.
          </div>
        <% } %>
      </section>
    </section>
  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd = document.getElementById("notifDropdown");

      if (btn && dd) {
        dd.addEventListener("click", (e) => e.stopPropagation());

        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          dd.classList.toggle("open");
        });

        document.addEventListener("click", () => {
          dd.classList.remove("open");
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") dd.classList.remove("open");
        });
      }
    })();
  </script>
</body>
</html>

