<!doctype html>
<html lang="en">
<head>
  <title>Pressboxd — Rate Drum Corps Shows</title>
  <meta name="description" content="Pressboxd is a site for rating drum corps shows, writing reviews, and tracking favorites.">
  <link rel="canonical" href="https://www.pressboxd.com/">
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>All Shows - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>

  <style>
    html,
    body,
    body.app {
      background: #000000 !important;
      background-image: none !important;
    }

    .accentBorder { border: 1px solid color-mix(in srgb, var(--accent) 28%, rgba(255,255,255,0.10)); }
    .accentBorderSoft { border: 1px solid color-mix(in srgb, var(--accent) 18%, rgba(255,255,255,0.10)); }

    .accentCard {
      background: #000000;
      border: 1px solid color-mix(in srgb, var(--accent) 18%, rgba(255,255,255,0.10));
      border-radius: 12px;
    }

    .accentThumb {
      background: color-mix(in srgb, var(--accent) 10%, rgba(255,255,255,0.05));
      border: 1px solid color-mix(in srgb, var(--accent) 16%, rgba(255,255,255,0.10));
    }

    .accentLink { color: var(--accent); }
    .accentLink:hover { text-decoration: underline; }

    .accentMutedLink { color: color-mix(in srgb, var(--accent) 55%, rgba(255,255,255,0.65)); }
    .accentMutedLink:hover { color: var(--accent); }

    .auth { align-items:center; gap: 12px; }

    .notifWrap { position: relative; display: inline-flex; align-items:center; }
    .bellBtn {
      position: relative;
      border: none;
      background: transparent;
      cursor: pointer;
      color: inherit;
      padding: 6px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.95;
    }
    .bellBtn:hover { background: rgba(255,255,255,0.06); }

    .badge,
    .badgeDot {
      position:absolute;
      top: 3px;
      right: 3px;
      min-width: 18px;
      height: 18px;
      padding: 0 6px;
      border-radius: 999px;
      background: #ff3b30;
      color: #fff;
      font-size: 11px;
      line-height: 18px;
      text-align: center;
      font-weight: 800;
      box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }

    .notifDropdown {
      display: none;
      position: absolute;
      right: 0;
      top: 40px;
      width: 340px;
      max-height: 420px;
      overflow: auto;
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.45);
      z-index: 9999;
    }
    .notifDropdown.open { display:block; }

    .notifHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding: 10px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.10);
      position: sticky;
      top: 0;
      background: rgba(15, 23, 42, 0.98);
      backdrop-filter: blur(8px);
    }
    .notifTitle { font-weight: 900; }
    .markReadBtn {
      border: none;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.85;
      font-size: 12px;
      padding: 6px 8px;
      border-radius: 10px;
    }
    .markReadBtn:hover { background: rgba(255,255,255,0.06); opacity: 1; }

    .notifList { padding: 8px; display:flex; flex-direction:column; gap: 8px; }
    .notifItem {
      padding: 10px;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
    }
    .notifItem.unread { background: rgba(99,102,241,0.18); border-color: rgba(99,102,241,0.25); }
    .notifTime { font-size: 12px; opacity: 0.7; margin-top: 4px; }
    .notifEmpty { padding: 12px; opacity: 0.8; }

    .authBellSlot { display:inline-flex; align-items:center; }

    .notifDropdown,
    .notifDropdown * {
      pointer-events: auto !important;
    }

    .userSearchWrap {
      position: relative;
      display: inline-flex;
      align-items: center;
    }

    .userSearchInput {
      width: 220px;
      height: 38px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.05);
      color: inherit;
      padding: 0 12px;
      outline: none;
    }

    .userSearchInput::placeholder {
      color: rgba(255,255,255,0.55);
    }

    .userSearchInput:focus {
      border-color: color-mix(in srgb, var(--accent) 40%, rgba(255,255,255,0.15));
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    }

    .userSearchDropdown {
      display: none;
      position: absolute;
      top: 44px;
      right: 0;
      width: 280px;
      max-height: 320px;
      overflow: auto;
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.45);
      z-index: 9999;
    }

    .userSearchDropdown.open {
      display: block;
    }

    .userSearchItem {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      text-decoration: none;
      color: inherit;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .userSearchItem:last-child {
      border-bottom: none;
    }

    .userSearchItem:hover {
      background: rgba(255,255,255,0.06);
    }

    .userSearchAvatar {
      width: 30px;
      height: 30px;
      border-radius: 999px;
      overflow: hidden;
      flex: 0 0 auto;
      background: rgba(255,255,255,0.08);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .userSearchAvatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .userSearchEmpty {
      padding: 12px;
      opacity: 0.8;
    }

    .hotWrap {
      width: 100%;
      padding: 20px 0;
      display: flex;
      gap: 18px;
      align-items: flex-start;
      justify-content: center;
      flex-wrap: wrap;
    }

    .hotIntro {
      flex: 1 1 560px;
      min-width: 320px;
      text-align: center;
      display: block;
      padding-top: 68px;
    }

    .hotCard {
      flex: 0 1 360px;
      min-width: 300px;
      max-width: 380px;
      padding: 14px;
      text-align: left;
    }

    .hotList {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .hotItem {
      display: flex;
      gap: 12px;
      align-items: center;
      text-decoration: none;
      color: inherit;
      padding: 10px;
      border-radius: 12px;
      background: rgba(0,0,0,1.00);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .hotRank {
      width: 32px;
      flex: 0 0 32px;
      text-align: center;
      font-weight: 900;
      font-size: 20px;
      opacity: .92;
    }

    .hotPosterBox {
      width: 58px;
      height: 82px;
      padding: 4px;
      box-sizing: border-box;
      border-radius: 10px;
      overflow: hidden;
      flex: 0 0 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,1.00);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .hotPosterImg {
      width: 100%;
      height: 100%;
      object-fit: scale-down;
      object-position: center;
      display: block;
      background: transparent;
    }

    .hotMeta {
      min-width: 0;
      flex: 1;
    }

    .hotTitle {
      font-weight: 800;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .hotSub {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .hotActivity {
      margin-top: 4px;
      font-size: 12px;
      opacity: .9;
    }

    @media (max-width: 768px) {
      .topbar .wrap {
        flex-direction: column !important;
        gap: 15px;
        padding: 15px 10px !important;
      }

      .nav.row {
        width: 100%;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      .auth.row {
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
      }

      .userSearchInput {
        width: 100% !important;
        min-width: 280px;
      }

      .userSearchDropdown {
        width: 100%;
        right: 0;
        left: 0;
      }

      .hotWrap {
        flex-direction: column !important;
        align-items: stretch !important;
      }

      .hotIntro,
      .hotCard {
        max-width: none !important;
        width: 100% !important;
      }

      .hotIntro div[style*="font-size: 42px"] {
        font-size: 28px !important;
      }

      div[style*="flex: 1 1 240px"] {
        flex: 1 1 100% !important;
        max-width: none !important;
      }

      #showsFilterForm {
        flex-direction: column !important;
        align-items: stretch !important;
      }

      #showsFilterForm .field {
        width: 100% !important;
        min-width: 0 !important;
      }

      #showsFilterForm .actions {
        display: flex;
        gap: 8px;
        margin-top: 10px;
      }

      #showsFilterForm .actions .btn {
        flex: 1;
        text-align: center;
      }

      .notifDropdown {
        width: 90vw;
        position: fixed;
        left: 5vw;
        right: 5vw;
        top: 60px;
      }
    }

    @media (max-width: 480px) {
      .postergrid {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)) !important;
        gap: 10px !important;
      }

      .poster_title {
        font-size: 14px !important;
      }
    }
  </style>
</head>
<%
  const POSTER_FALLBACK = "/static/posters/placeholder.png";
  const safeRows = Array.isArray(rows) ? rows : [];
  const safeFriendActivity = Array.isArray(friend_activity) ? friend_activity : [];
  const safeHotShows = Array.isArray(hot_shows) ? hot_shows : [];
  const meUser = typeof me !== "undefined" ? me : null;
  const notifCountSafe = typeof notif_count !== "undefined" ? Number(notif_count || 0) : 0;
  const notifItemsSafe = Array.isArray(typeof notif_items !== "undefined" ? notif_items : []) ? notif_items : [];
%>
<body class="app" <%= meUser && meUser.theme_color ? `style="--accent: ${meUser.theme_color};"` : "" %>>
  <header class="topbar">
    <div class="wrap row between">
      <div style="display: flex; align-items: center; gap: 10px;">
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" style="display: flex; align-items: center; text-decoration: none;">
          <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <img 
              src="/static/logo.png" 
              alt="Logo" 
              style="max-width: 35px; max-height: 35px; width: auto; height: auto; object-fit: contain; transition: transform 0.6s ease-in-out;"
              onmouseover="this.style.transform='rotate(360deg)'" 
              onmouseout="this.style.transform='rotate(0deg)'"
            >
          </div>
        </a>

        <a class="brand" href="/shows">
          <span>Pressboxd</span>
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <% if (meUser && Number(meUser.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (meUser) { %>
          <div class="userSearchWrap">
            <input id="userSearchInput" class="userSearchInput" type="text" placeholder="Search users..." autocomplete="off">
            <div id="userSearchDropdown" class="userSearchDropdown"></div>
          </div>

          <div class="authBellSlot">
            <div class="notifWrap">
              <button class="bellBtn" id="bellBtn" aria-label="Notifications" title="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1"/>
                  <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
                </svg>
                <% if (notifCountSafe > 0) { %>
                  <span class="badge"><%= notifCountSafe %></span>
                <% } %>
              </button>
              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>
                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>
                <% if (notifItemsSafe.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of notifItemsSafe) {
                         const kind = n?.kind || "";
                         const actor = n?.actor_username || "Someone";
                         const created = n?.created_at || "";
                         const unread = Number(n?.is_read ?? 0) === 0;
                         const sid = n?.show_id || null;
                    %>
                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>
                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>
                        <% } else if (kind === "review_upvote") { %>
                          <div><b><%= actor %></b> upvoted your review <% if (sid) { %> — <a href="/show/<%= sid %>">View show</a><% } %></div>
                        <% } else if (kind === "review_comment") { %>
                          <div><b><%= actor %></b> commented on your review <% if (sid) { %> — <a href="/show/<%= sid %>">View show</a><% } %></div>
                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>
                        <% if (created) { %> <div class="notifTime"><%= created %></div> <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (meUser.avatar_url) { %><img src="<%= meUser.avatar_url %>" alt="avatar"><% } else { %><span class="avatar_fallback"></span><% } %>
            </span>
            <span class="muted small"><%= meUser.username || "me" %></span>
          </a>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="hotWrap">
      <div class="hotIntro">
        <div style="font-weight: 900; font-size: 42px; line-height: 1.1; letter-spacing: -1px; margin-top: 10px; margin-bottom: 10px; color: #ffffff;">
          Welcome to <span style="color: #3252b3;">Pressboxd</span>
        </div>
        <div style="max-width: 600px; margin: 10px auto 0; padding: 15px; border-top: 1px solid rgba(255,255,255,0.1); color: #ffffff;">
          <p style="margin-bottom: 8px; opacity: 0.9; font-size: 14px;">
            <strong>Early Development:</strong> Customization options and UI optimization are coming soon!
          </p>
          <p style="margin-bottom: 10px; font-style: italic; color: #ffcc00; font-weight: 500; font-size: 14px; line-height: 1.4;">
            If the site feels down or you are logged out, we are likely pushing live fixes. We apologize for the inconvenience! (likely development window times: 8am-9:30am, 9pm-10pm)
          </p>
          <p style="opacity: 0.8; font-size: 14px; margin-bottom: 0;">
            Suggestions? Reach out at 
            <a href="mailto:PressboxdContact@gmail.com" style="color: #3252b3; text-decoration: none; font-weight: bold;">PressboxdContact@gmail.com</a>
          </p>
        </div>
      </div>

      <div class="accentCard accentBorderSoft hotCard">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px;">
          <div>
            <div style="font-weight:900; font-size:18px; line-height:1.1;">Hot Shows</div>
            <div class="muted small">Top 3 most popular shows in the last 48h.</div>
          </div>
        </div>

        <% if (safeHotShows.length > 0) { %>
          <div class="hotList">
            <% for (let i = 0; i < safeHotShows.length; i++) {
                 const hs = safeHotShows[i] || {};
                 const hotPoster = hs.poster_url || POSTER_FALLBACK;
            %>
              <a class="hotItem" href="/show/<%= hs.id %>">
                <div class="hotRank"><%= i + 1 %></div>

                <div class="hotPosterBox accentThumb">
                  <img
                    class="hotPosterImg"
                    src="<%= hotPoster %>"
                    alt="poster"
                    onerror="this.src='<%= POSTER_FALLBACK %>';"
                  >
                </div>

                <div class="hotMeta">
                  <div class="hotTitle"><%= hs.title || 'Untitled' %></div>
                  <div class="hotSub muted small">
                    <%= hs.corps || '' %><% if (hs.year) { %> • <%= hs.year %><% } %>
                  </div>
                
                  <div class="hotActivity">
                    <% const hotAvg = Number(hs.avg_rating || 0); %>
                    <% if (hotAvg > 0) { %>
                      <span style="font-weight:800;">★ <%= hotAvg.toFixed(2) %></span>
                      <span style="opacity:.5; margin:0 6px;">•</span>
                    <% } else { %>
                      <span class="muted">Unrated</span>
                      <span style="opacity:.5; margin:0 6px;">•</span>
                    <% } %>
                  
                    <span><%= Number(hs.ratings_2d || 0) %> ratings</span>
                    <span style="opacity:.5; margin:0 6px;">•</span>
                    <span><%= Number(hs.reviews_2d || 0) %> reviews</span>
                  </div>
                </div>
              </a>
            <% } %>
          </div>
        <% } else { %>
          <div class="muted small" style="padding:8px 2px;">No trending shows in the last 48h yet.</div>
        <% } %>
      </div>
    </div>

    <% if (meUser) { %>
      <div class="panel" style="margin-top:12px; padding:12px;">
        <div class="row between" style="align-items:center; margin-bottom:-10px;">
          <div style="font-weight:900;">Friend activity</div>
          <a class="muted small" href="/me/friends" style="text-decoration:none;">Friends</a>
        </div>
        <% if (safeFriendActivity.length > 0) { %>
          <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:14px; align-items:stretch;">
            <% for (const a of safeFriendActivity) { 
                 const kind = a?.kind || "";
                 const who = a?.actor_username || "Someone";
                 const sid = a?.show_id || null;
                 const corpsv = a?.corps || "";
                 const yearv = a?.year || "";
                 const stars = a?.rating_half != null ? Number(a.rating_half) / 2 : null;
            %>
              <div style="flex: 1 1 240px; max-width: 360px; padding:10px; border-radius:12px; background: rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.10); overflow:hidden;">
                <div class="small" style="line-height:1.35; min-width:0;">
                  <b><%= who %></b>
                  <%= kind === "rating" ? "rated" : (kind === "review" ? "reviewed" : "did something on") %>
                  <% if (sid) { %> <a href="/show/<%= sid %>" style="text-decoration:none;"><%= corpsv %><%= yearv ? ' ' + yearv : '' %></a> <% } else { %> <%= corpsv %><%= yearv ? ' ' + yearv : '' %> <% } %>
                  <% if (kind === "rating" && stars != null) { %> <span class="muted">(<%= stars %>★)</span> <% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="muted small" style="margin-top:20px;">No recent friend activity.</div>
        <% } %>
      </div>
    <% } %>

    <div style="margin-top:24px;">
      <div class="row between" style="align-items:flex-end; gap:12px;">
        <div>
          <h1 style="margin:6px 0 0;">All Shows</h1>
          <div class="muted small">Browse, sort, and click a show to rate and review.</div>
        </div>
      </div>
    </div>

    <div class="panel" style="margin-top:14px;">
      <form id="showsFilterForm" method="get" action="/shows" class="row gap" style="flex-wrap:wrap; align-items:flex-end;">
        <div class="field" style="min-width:220px;">
          <label>Sort</label>
          <select name="sort">
            <option value="" <%= !typeof sort !== 'undefined' ? "selected" : "" %>>Default</option>
            <option value="year_desc" <%= typeof sort !== 'undefined' && sort === "year_desc" ? "selected" : "" %>>Year (New → Old)</option>
            <option value="year_asc" <%= typeof sort !== 'undefined' && sort === "year_asc" ? "selected" : "" %>>Year (Old → New)</option>
            <option value="top" <%= typeof sort !== 'undefined' && sort === "top" ? "selected" : "" %>>Top Average Rating</option>
            <option value="bottom" <%= typeof sort !== 'undefined' && sort === "bottom" ? "selected" : "" %>>Lowest Average Rating</option>
            <option value="corps" <%= typeof sort !== 'undefined' && sort === "corps" ? "selected" : "" %>>Corps (A → Z)</option>
          </select>
        </div>
        <div class="field" style="width:140px;">
          <label>Year</label>
          <input name="year" value="<%= typeof year !== 'undefined' ? year : '' %>" placeholder="2014">
        </div>
        <div class="field" style="min-width:240px;">
          <label>Corps</label>
          <input id="corpsFilterInput" name="corps" value="<%= typeof corps !== 'undefined' ? corps : '' %>" placeholder="Blue Devils" autocomplete="off">
        </div>
        <div class="actions">
          <button class="btn green" type="submit">Apply</button>
          <a class="btn ghost" href="/shows">Reset</a>
        </div>
      </form>
    </div>
    
    <% if (safeRows.length > 0) { %>
      <div class="postergrid" style="margin-top:14px;">
        <% for (const row of safeRows) {
             const poster = row?.poster_url || POSTER_FALLBACK;
             const avg = row?.avg_rating != null ? Number(row.avg_rating) : (row?.avg != null ? Number(row.avg) : 0);
             const pct = Math.max(0, Math.min(1, avg / 5));
             const hue = 60 * Math.pow(pct, 2.6);
        %>
          <div class="poster">
            <a class="poster_art" href="/show/<%= row.id %>" style="position:relative; display:block;">
              <img class="poster_img" src="<%= poster %>" alt="poster" loading="lazy" onerror="this.src='<%= POSTER_FALLBACK %>';">
              <% if (row.cnt > 0) { %>
                <div class="tile_rating" style="color: hsl(<%= hue %>, 100%, 50%); text-shadow: -0.3px -0.3px 0 #000, 0.3px -0.3px 0 #000, -0.3px 0.3px 0 #000, 0.3px 0.3px 0 #000, 0 0 4px rgba(0,0,0,0.9);"><span class="tile_star">★</span> <%= avg.toFixed(2) %></div>
    
                <div
                  class="muted small"
                  style="
                    position:absolute;
                    right:8px;
                    top:8px;
                    z-index:3;
                    background: rgba(0,0,0,0.60);
                    color:#ffffff;
                    padding:3px 6px;
                    border-radius:999px;
                    font-size:9px;
                    line-height:1;
                    border:1px solid rgba(255,255,255,0.10);
                  "
                >
                  <%= Number(row.cnt || 0) %> ratings
                </div>
              <% } else { %>
                <span class="badge unrated bottom_left">Unrated</span>
              <% } %>
            </a>
    
            <div class="poster_meta">
              <div class="poster_title">
                <a href="/show/<%= row.id %>" style="color:inherit; text-decoration:none;">
                  <%= row.title || 'Untitled' %>
                </a>
              </div>
              <div class="poster_sub">
                <% if (row.corps) { %>
                  <a href="/shows?corps=<%= encodeURIComponent(row.corps) %>" style="color:inherit; text-decoration:none;"><%= row.corps %></a>
                <% } %>
                <% if (row.year) { %>
                  <span style="opacity: 0.5; margin: 0 4px;">&bull;</span>
                  <a href="/shows?year=<%= encodeURIComponent(row.year) %>" style="color:inherit; text-decoration:none;"><%= row.year %></a>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="panel" style="margin-top:14px;">
        <div class="muted">No shows found.</div>
      </div>
    <% } %>
  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd = document.getElementById("notifDropdown");
      if (btn && dd) {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          dd.classList.toggle("open");
        });

        dd.addEventListener("click", (e) => e.stopPropagation());
        document.addEventListener("click", () => dd.classList.remove("open"));
      }
    })();

    (() => {
      const form = document.getElementById("showsFilterForm");
      const corpsInput = document.getElementById("corpsFilterInput");
      if (!form || !corpsInput) return;

      let timer = null;
      let isSubmitting = false;

      corpsInput.addEventListener("input", () => {
        if (isSubmitting) return;

        clearTimeout(timer);
        timer = setTimeout(() => {
          isSubmitting = true;
          sessionStorage.setItem("restoreCorpsFocus", "1");
          form.submit();
        }, 400);
      });

      window.addEventListener("load", () => {
        const shouldRestore = sessionStorage.getItem("restoreCorpsFocus");
        if (shouldRestore === "1" && corpsInput) {
          sessionStorage.removeItem("restoreCorpsFocus");
          corpsInput.focus();
          const len = corpsInput.value.length;
          corpsInput.setSelectionRange(len, len);
        }
      });
    })();

    (() => {
      const input = document.getElementById("userSearchInput");
      const dropdown = document.getElementById("userSearchDropdown");
      if (!input || !dropdown) return;

      let timer = null;
      let requestId = 0;

      function escapeHtml(str) {
        return String(str || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function renderUsers(users) {
        if (!Array.isArray(users) || users.length === 0) {
          dropdown.innerHTML = '<div class="userSearchEmpty">No users found.</div>';
          dropdown.classList.add("open");
          return;
        }

        dropdown.innerHTML = users.map(u => {
          const avatar = u.avatar_url
            ? `<img src="${escapeHtml(u.avatar_url)}" alt="${escapeHtml(u.username)}">`
            : `<span style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:12px;opacity:.7;">👤</span>`;

          return `
            <a class="userSearchItem" href="/u/${encodeURIComponent(u.username)}">
              <div class="userSearchAvatar">${avatar}</div>
              <div style="min-width:0;">
                <div style="font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                  ${escapeHtml(u.username)}
                </div>
              </div>
            </a>
          `;
        }).join("");

        dropdown.classList.add("open");
      }

      function clearDropdown() {
        dropdown.innerHTML = "";
        dropdown.classList.remove("open");
      }

      input.addEventListener("input", () => {
        const q = input.value.trim();
        clearTimeout(timer);

        if (!q) {
          clearDropdown();
          return;
        }

        timer = setTimeout(async () => {
          const currentRequest = ++requestId;

          try {
            const res = await fetch(`/api/users/search?q=${encodeURIComponent(q)}`, {
              headers: { "Accept": "application/json" }
            });

            if (!res.ok) throw new Error("search request failed");

            const data = await res.json();

            if (currentRequest !== requestId) return;

            renderUsers(Array.isArray(data.users) ? data.users : []);
          } catch (err) {
            console.error("user search failed:", err);
            if (currentRequest !== requestId) return;
            dropdown.innerHTML = '<div class="userSearchEmpty">Search failed.</div>';
            dropdown.classList.add("open");
          }
        }, 200);
      });

      input.addEventListener("focus", () => {
        if (dropdown.innerHTML.trim()) {
          dropdown.classList.add("open");
        }
      });

      document.addEventListener("click", (e) => {
        if (!dropdown.contains(e.target) && e.target !== input) {
          dropdown.classList.remove("open");
        }
      });
    })();
  </script>
</body>
</html>














