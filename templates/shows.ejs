<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>All Shows</title>
  <link rel="stylesheet" href="/static/styles.css"/>

  <style>
    .accentBorder { border: 1px solid color-mix(in srgb, var(--accent) 28%, rgba(255,255,255,0.10)); }
    .accentBorderSoft { border: 1px solid color-mix(in srgb, var(--accent) 18%, rgba(255,255,255,0.10)); }

    .accentCard {
      background: color-mix(in srgb, var(--accent) 10%, rgba(255,255,255,0.03));
      border: 1px solid color-mix(in srgb, var(--accent) 18%, rgba(255,255,255,0.10));
      border-radius: 12px;
    }

    .accentThumb {
      background: color-mix(in srgb, var(--accent) 10%, rgba(255,255,255,0.05));
      border: 1px solid color-mix(in srgb, var(--accent) 16%, rgba(255,255,255,0.10));
    }

    .accentLink { color: var(--accent); }
    .accentLink:hover { text-decoration: underline; }

    .accentMutedLink { color: color-mix(in srgb, var(--accent) 55%, rgba(255,255,255,0.65)); }
    .accentMutedLink:hover { color: var(--accent); }
  </style>
</head>
<body>
  <%
    const POSTER_FALLBACK = "/static/posters/placeholder.png";
    const safeRows = Array.isArray(rows) ? rows : [];
    const safeFriendActivity = Array.isArray(friend_activity) ? friend_activity : [];
    const meUser = typeof me !== "undefined" ? me : null;
  %>

  <div class="wrap">
    <div style="margin-top:10px;">
      <div class="row between" style="align-items:flex-end; gap:12px;">
        <div>
          <div class="kicker"></div>
          <h1 style="margin:6px 0 0; margin-top: 140px;">All Shows</h1>
          <div class="muted small">Browse, sort, and click a show to rate and review.</div>
        </div>

        <div style="flex:1; text-align:center; padding-bottom:2px;">
          <div style="font-weight:900; font-size:42px; line-height:1.2; margin-top: 0px;">
            Welcome to Pressboxd!
          </div>
          <div class="muted small" style="margin-top:80px;">
            This website is still in early development. Feel free to send suggestions to *email_here*.
          </div>
        </div>

        <div style="width:220px;"></div>
      </div>

      <% if (meUser) { %>
        <div class="panel" style="margin-top:12px; padding:12px;">
          <div class="row between" style="align-items:center; margin-bottom:-10px;">
            <div style="font-weight:900;">Friend activity</div>
            <a class="muted small" href="/me/friends" style="text-decoration:none;">Friends</a>
          </div>

          <% if (safeFriendActivity.length > 0) { %>
            <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:stretch; margin-top: 20px;">
              <% for (const a of safeFriendActivity) { 
                   const kind = a?.kind || "";
                   const who = a?.actor_username || "Someone";
                   const sid = a?.show_id || null;
                   const corpsv = a?.corps || "";
                   const yearv = a?.year || "";
                   const posterThumb = a?.poster_url || POSTER_FALLBACK;
                   const ratingHalf = a?.rating_half;
                   const stars = ratingHalf != null ? Number(ratingHalf) / 2 : null;
              %>
                <div style="width:340px; flex:0 0 auto; padding:10px; border-radius:12px; background: rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.10);">
                  <div style="display:flex; gap:10px; align-items:flex-start;">
                    <div style="width:60px; height:80px; overflow:hidden; flex:0 0 auto; background: rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.10);">
                      <% if (sid) { %>
                        <a href="/show/<%= sid %>" style="display:block; width:100%; height:100%;">
                          <img
                            src="<%= posterThumb %>"
                            alt="poster"
                            style="width:100%; height:100%; object-fit:contain; display:block;"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='<%= POSTER_FALLBACK %>';"
                          >
                        </a>
                      <% } else { %>
                        <img
                          src="<%= posterThumb %>"
                          alt="poster"
                          style="width:100%; height:100%; object-fit:contain; display:block;"
                          loading="lazy"
                          onerror="this.onerror=null;this.src='<%= POSTER_FALLBACK %>';"
                        >
                      <% } %>
                    </div>

                    <div style="min-width:0;">
                      <div class="small" style="line-height:1.25;">
                        <b><%= who %></b>
                        <% if (kind === "rating") { %>
                          rated
                        <% } else if (kind === "review") { %>
                          reviewed
                        <% } else { %>
                          did something on
                        <% } %>

                        <% if (sid) { %>
                          <a href="/show/<%= sid %>" style="text-decoration:none;">
                            <%= corpsv %><% if (yearv) { %> <%= yearv %><% } %>
                          </a>
                        <% } else { %>
                          <%= corpsv %><% if (yearv) { %> <%= yearv %><% } %>
                        <% } %>

                        <% if (kind === "rating" && ratingHalf != null) { %>
                          <span class="muted">(<%= stars %>★)</span>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div class="muted small">No recent friend activity.</div>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="panel" style="margin-top:14px;">
      <form method="get" action="/shows" class="row gap" style="flex-wrap:wrap; align-items:flex-end;">
        <div class="field" style="min-width:220px;">
          <label>Sort</label>
          <select name="sort">
            <option value="" <%= !sort ? "selected" : "" %>>Default</option>
            <option value="year_desc" <%= sort === "year_desc" ? "selected" : "" %>>Year (New → Old)</option>
            <option value="year_asc" <%= sort === "year_asc" ? "selected" : "" %>>Year (Old → New)</option>
            <option value="top" <%= sort === "top" ? "selected" : "" %>>Top Average Rating</option>
            <option value="bottom" <%= sort === "bottom" ? "selected" : "" %>>Lowest Average Rating</option>
            <option value="corps" <%= sort === "corps" ? "selected" : "" %>>Corps (A → Z)</option>
          </select>
        </div>

        <div class="field" style="width:140px;">
          <label>Year</label>
          <input name="year" value="<%= year || '' %>" placeholder="2014">
        </div>

        <div class="field" style="min-width:240px;">
          <label>Corps</label>
          <input name="corps" value="<%= corps || '' %>" placeholder="Blue Devils">
        </div>

        <div class="actions">
          <button class="btn green" type="submit">Apply</button>
          <a class="btn ghost" href="/shows">Reset</a>
        </div>
      </form>
    </div>

    <% if (safeRows.length > 0) { %>
      <div class="postergrid" style="margin-top:14px;">
        <% for (const row of safeRows) { 
             const yearv = row?.year || "";
             const corpsv = row?.corps || "";
             const titlev = row?.title || "Untitled";
             const cnt = row?.cnt != null ? Number(row.cnt) : 0;
             const avg = row?.avg_rating != null ? Number(row.avg_rating) : (row?.avg != null ? Number(row.avg) : 0);
             const poster = row?.poster_url || POSTER_FALLBACK;

             let pct = avg / 5.0;
             if (pct < 0) pct = 0;
             if (pct > 1) pct = 1;
             const curve = Math.pow(pct, 2.6);
             const hue = 60 * curve;
        %>
          <a class="poster" href="/show/<%= row.id %>">
            <div class="poster_art">
              <img
                class="poster_img"
                src="<%= poster %>"
                alt="<%= titlev %> poster"
                loading="lazy"
                onerror="this.onerror=null;this.src='<%= POSTER_FALLBACK %>';"
              >

              <% if (yearv) { %>
                <div class="tile_year"><%= yearv %></div>
              <% } %>

              <% if (cnt > 0) { %>
                <div class="tile_rating" style="color: hsl(<%= hue %>, 98%, 62%);">
                  <span class="tile_star">★</span> <%= avg.toFixed(2) %>
                </div>
                <div class="tile_count"><%= cnt %> ratings</div>
              <% } else { %>
                <span class="badge unrated bottom_left">Unrated</span>
              <% } %>
            </div>

            <div class="poster_meta">
              <div class="poster_title"><%= titlev %></div>
              <div class="poster_sub"><%= corpsv %></div>
            </div>
          </a>
        <% } %>
      </div>
    <% } else { %>
      <div class="panel" style="margin-top:14px;">
        <div class="muted">No shows found.</div>
      </div>
    <% } %>
  </div>
</body>
</html>
