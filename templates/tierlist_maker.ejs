<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= tierlist.name %> - Pressboxd Tierlist</title>

  <link rel="stylesheet" href="/static/styles.css">
  <link rel="stylesheet" href="/static/css/tierlists.css">
  <link rel="icon" type="image/png" href="/static/favicon.png">
</head>

<body class="app" style="--accent: <%= accent_color || '#3252b3' %>;">
  <header class="topbar">
    <div class="wrap row between">
      <div style="display:flex; align-items:center; gap:10px;">
        <a href="/shows" class="brand" style="display:flex; align-items:center;">
          <img
            src="/static/pressboxd-wordmark.png"
            alt="Pressboxd"
            style="height:68px; width:auto; display:block;"
          >
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <a href="/predictions">Predictions</a>
        <a href="/forums">Forums</a>
        <a href="/tierlists">Tierlists</a>

        <% if (me && Number(me.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
          <a href="/admin/stats">Stats</a>
          <a href="/admin/predictions">Predictions Admin</a>
          <a href="/admin/site-message">Site Message</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (me) { %>
          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (me.avatar_url) { %>
                <img src="<%= me.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= me.username || "me" %></span>
          </a>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main
    class="wrap tierMakerPage"
    data-tierlist-id="<%= tierlist.id %>"
    data-initial-data='<%- JSON.stringify(data) %>'
  >
    <div class="tierMakerTop panel">
      <div>
        <input id="tierlistName" class="tierTitleInput" value="<%= tierlist.name %>" maxlength="80">
        <div id="saveStatus" class="muted small">Saved</div>

        <label class="tierPublicToggle">
          <input
            id="tierlistPublic"
            type="checkbox"
            <%= Number(tierlist.is_public || 0) === 1 ? 'checked' : '' %>
          >
          Public tierlist
        </label>
      </div>

      <a href="/tierlists" class="btn ghost">Back to Tierlists</a>
    </div>

    <div class="tierFilters panel">
      <label class="field">
        <span>Corps</span>
        <select id="corpsFilter">
          <option value="">All corps</option>
          <% corps_options.forEach(c => { %>
            <option
              value="<%= c.corps %>"
              <%= tierlist.filter_corps === c.corps ? 'selected' : '' %>
            >
              <%= c.corps %>
            </option>
          <% }) %>
        </select>
      </label>
    
      <label id="yearFilterWrap" class="field">
        <span>Year</span>
        <select id="yearFilter">
          <option value="">All years</option>
          <% year_options.forEach(y => { %>
            <option
              value="<%= y.year %>"
              <%= String(tierlist.filter_year || '') === String(y.year) ? 'selected' : '' %>
            >
              <%= y.year %>
            </option>
          <% }) %>
        </select>
      </label>
    
      <label id="decadeFilterWrap" class="field">
        <span>Decade</span>
        <select id="decadeFilter">
          <option value="">All decades</option>
          <% decade_options.forEach(d => { %>
            <option
              value="<%= d %>"
              <%= String(tierlist.filter_decade || '') === String(d) ? 'selected' : '' %>
            >
              <%= d %>s
            </option>
          <% }) %>
        </select>
      </label>
    
      <button type="button" id="addTierBtn" class="btn">Add Tier</button>
    </div>

    <section id="tierBoard" class="tierBoard"></section>

    <h2 class="poolTitle">Available Shows</h2>
    <section id="showPool" class="showPool tierDropZone"></section>
  </main>

  <script src="/static/js/tierlist-maker.js"></script>
</body>
</html>
