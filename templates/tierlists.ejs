<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Tierlists - Pressboxd</title>

  <link rel="stylesheet" href="/static/styles.css">
  <link rel="stylesheet" href="/static/css/tierlists.css?v=20260701f">
  <link rel="icon" type="image/png" href="/static/favicon.png">
</head>

<body class="app" style="--accent: <%= accent_color || '#3252b3' %>;">
  <header class="topbar">
    <div class="wrap row between">
      <a href="/shows" class="brand" style="display:flex; align-items:center;">
        <img
          src="/static/pressboxd-wordmark.png"
          alt="Pressboxd"
          style="height:68px; width:auto; display:block;"
        >
      </a>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <a href="/predictions">Predictions</a>
        <a href="/forums">Forums</a>
        <a href="/tierlists">Tierlists</a>
      </nav>

      <div class="auth row">
        <% if (me) { %>
          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (me.avatar_url) { %>
                <img src="<%= me.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= me.username || "me" %></span>
          </a>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap tierPage">
    <div class="tierHeader">
      <div>
        <h1>Tierlists</h1>
        <p class="muted">Create your own or browse public tierlists from other users.</p>
      </div>

      <form method="POST" action="/tierlists/new" class="newTierForm">
        <input name="name" placeholder="Example: William's 2023 Uniform Tierlist" maxlength="80">
        <button type="submit" class="btn">New Tierlist</button>
      </form>
    </div>

    <section class="panel tierSection">
      <h2>Your Tierlists</h2>

      <div class="savedTierlists">
        <% if (!tierlists.length) { %>
          <p class="muted">No saved tierlists yet.</p>
        <% } %>

        <% tierlists.forEach(t => { %>
          <div class="savedTierCard">
            <a href="/tierlists/<%= t.id %>">
              <strong><%= t.name %></strong>
              <span>
                <% if (t.filter_year) { %>
                  <%= t.filter_year %>
                <% } else if (t.filter_decade) { %>
                  <%= t.filter_decade %>s
                <% } else if (t.filter_corps) { %>
                  <%= t.filter_corps %>
                <% } else { %>
                  All shows
                <% } %>

                <% if (Number(t.is_public || 0) === 1) { %>
                  • Public
                <% } else { %>
                  • Private
                <% } %>
              </span>
            </a>

            <form method="POST" action="/tierlists/<%= t.id %>/delete" onsubmit="return confirm('Delete this tierlist?')">
              <button type="submit" class="dangerBtn">Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="panel tierSection">
      <h2>Public Tierlists</h2>
      <p class="muted small">These are tierlists other users marked as public.</p>

      <% if (!public_tierlists.length) { %>
        <div class="empty_state">No public tierlists yet.</div>
      <% } %>

      <% if (public_tierlists.length) { %>
        <div class="publicTierColumns publicTierColumnsFour">
          <div class="publicTierColumn">
            <h3>All Shows</h3>

            <% if (public_groups.all.length === 0) { %>
              <div class="muted small">No uncategorized tierlists yet.</div>
            <% } %>

            <% if (public_groups.all.length) { %>
              <div class="publicTierGroup">
                <h4>No filters</h4>

                <div class="publicTierList">
                  <% public_groups.all.forEach(t => { %>
                    <a class="publicTierCard" href="/tierlists/public/<%= t.id %>">
                      <strong><%= t.name %></strong>

                      <span class="publicTierUser">
                        <span class="avatar_sm">
                          <% if (t.avatar_url) { %>
                            <img src="<%= t.avatar_url %>" alt="avatar">
                          <% } else { %>
                            <span class="avatar_fallback"></span>
                          <% } %>
                        </span>

                        <span>by <%= t.username %></span>
                      </span>
                    </a>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>

          <div class="publicTierColumn">
            <h3>Corps</h3>

            <% if (public_groups.corps.size === 0) { %>
              <div class="muted small">No corps tierlists yet.</div>
            <% } %>

            <% for (const [corpsName, items] of public_groups.corps) { %>
              <div class="publicTierGroup">
                <h4><%= corpsName %></h4>

                <div class="publicTierList">
                  <% items.forEach(t => { %>
                    <a class="publicTierCard" href="/tierlists/public/<%= t.id %>">
                      <strong><%= t.name %></strong>

                      <span class="publicTierUser">
                        <span class="avatar_sm">
                          <% if (t.avatar_url) { %>
                            <img src="<%= t.avatar_url %>" alt="avatar">
                          <% } else { %>
                            <span class="avatar_fallback"></span>
                          <% } %>
                        </span>

                        <span>by <%= t.username %></span>
                      </span>
                    </a>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>

          <div class="publicTierColumn">
            <h3>Year</h3>

            <% if (public_groups.years.size === 0) { %>
              <div class="muted small">No year tierlists yet.</div>
            <% } %>

            <% for (const [yearName, items] of public_groups.years) { %>
              <div class="publicTierGroup">
                <h4><%= yearName %></h4>

                <div class="publicTierList">
                  <% items.forEach(t => { %>
                    <a class="publicTierCard" href="/tierlists/public/<%= t.id %>">
                      <strong><%= t.name %></strong>

                      <span class="publicTierUser">
                        <span class="avatar_sm">
                          <% if (t.avatar_url) { %>
                            <img src="<%= t.avatar_url %>" alt="avatar">
                          <% } else { %>
                            <span class="avatar_fallback"></span>
                          <% } %>
                        </span>

                        <span>by <%= t.username %></span>
                      </span>
                    </a>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>

          <div class="publicTierColumn">
            <h3>Decade</h3>

            <% if (public_groups.decades.size === 0) { %>
              <div class="muted small">No decade tierlists yet.</div>
            <% } %>

            <% for (const [decade, items] of public_groups.decades) { %>
              <div class="publicTierGroup">
                <h4><%= decade %>s</h4>

                <div class="publicTierList">
                  <% items.forEach(t => { %>
                    <a class="publicTierCard" href="/tierlists/public/<%= t.id %>">
                      <strong><%= t.name %></strong>

                      <span class="publicTierUser">
                        <span class="avatar_sm">
                          <% if (t.avatar_url) { %>
                            <img src="<%= t.avatar_url %>" alt="avatar">
                          <% } else { %>
                            <span class="avatar_fallback"></span>
                          <% } %>
                        </span>

                        <span>by <%= t.username %></span>
                      </span>
                    </a>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
