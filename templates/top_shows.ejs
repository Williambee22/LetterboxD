<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= mode === "bottom" ? "Lowest Rated Shows" : "Top Shows" %> - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
</head>
<body class="app">
  <main class="wrap">

    <div class="topshows_page">

      <div class="row between" style="margin-top:10px; align-items:flex-end;">
        <div>
          <div class="kicker">Rankings</div>
          <h1 style="margin:6px 0 0;">
            <%= mode === "bottom" ? "Lowest Rated Shows" : "Top Shows" %>
          </h1>
          <div class="muted small">
            <%= mode === "bottom"
              ? "Sorted by lowest average rating (tie-break: most ratings)."
              : "Sorted by highest average rating (tie-break: most ratings)." %>
          </div>
        </div>

        <div class="seg" style="display:flex; gap:8px;">
          <a class="btn ghost <%= mode !== 'bottom' ? 'on' : '' %>" href="/top?mode=top">Top rated</a>
          <a class="btn ghost <%= mode === 'bottom' ? 'on' : '' %>" href="/top?mode=bottom">Lowest rated</a>
        </div>
      </div>

      <% if (Array.isArray(rows) && rows.length > 0) { %>
        <div class="panel" style="margin-top:14px;">
          <div class="stack">
            <% rows.forEach((r, i) => { 
                 const vs = r.top_review_score != null ? Number(r.top_review_score) : 0;
            %>
              <div class="ts_card">

                <div class="ts_rank">#<%= i + 1 %></div>

                <a class="ts_thumb" href="/show/<%= r.id %>">
                  <% if (r.poster_url) { %>
                    <img src="<%= r.poster_url %>" alt="<%= r.title %> poster">
                  <% } else { %>
                    <div class="ts_thumb_fallback"></div>
                  <% } %>
                </a>

                <div class="ts_meta">
                  <div class="ts_title">
                    <a href="/show/<%= r.id %>"><%= r.title %></a>
                  </div>
                  <div class="muted small"><%= r.corps %> — <%= r.year %></div>

                  <div class="ts_badges">
                    <div class="ts_avg">
                      ★ <%= Number(r.avg_rating || 0).toFixed(2) %>
                    </div>
                    <span class="badge muted"><%= r.cnt %> ratings</span>
                  </div>
                </div>

                <div class="ts_review">
                  <% if (r.top_review_text) { %>

                    <div style="display:flex; gap:14px; align-items:flex-start;">

                      <div style="display:flex; gap:10px; align-items:flex-start;">
                        <span class="avatar_sm">
                          <% if (r.top_review_avatar_url) { %>
                            <img src="<%= r.top_review_avatar_url %>" alt="avatar">
                          <% } else { %>
                            <span class="avatar_fallback"></span>
                          <% } %>
                        </span>

                        <div style="min-width:0;">
                          <a class="reviewuser"
                             href="/u/<%= encodeURIComponent(r.top_review_username) %>"
                             style="text-decoration:none;">
                            <%= r.top_review_username %>
                          </a>

                          <% if (r.top_review_rating_half != null) { %>
                            <span class="badge good" style="margin-left:8px;">
                              ★ <%= (Number(r.top_review_rating_half) / 2).toFixed(1) %>
                            </span>
                          <% } else { %>
                            <span class="badge muted" style="margin-left:8px;">No rating</span>
                          <% } %>
                        </div>
                      </div>

                      <div class="ts_quote_row" style="flex:1; min-width:0; margin-top:0;">
                        <div class="ts_vote <%= vs > 0 ? 'pos' : vs < 0 ? 'neg' : 'zero' %>">
                          <%= vs > 0 ? '+' : '' %><%= vs %>
                        </div>

                        <div class="muted small ts_quote" style="margin-top:0;">
                          “<%= r.top_review_text %>”
                        </div>
                      </div>

                    </div>

                  <% } else { %>
                    <div class="muted small">No reviews yet.</div>
                  <% } %>
                </div>

              </div>
            <% }) %>
          </div>
        </div>
      <% } else { %>
        <div class="panel" style="margin-top:14px;">
          <div class="muted">No rated shows yet.</div>
        </div>
      <% } %>

    </div>

  </main>
</body>
</html>
