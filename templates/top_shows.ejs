<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= mode === "bottom" ? "Lowest Rated Shows" : "Top Shows" %> - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>

  <style>
    .auth { align-items:center; gap: 12px; }

    .notifWrap { position: relative; display: inline-flex; align-items:center; }
    .bellBtn {
      position: relative;
      border: none;
      background: transparent;
      cursor: pointer;
      color: inherit;
      padding: 6px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.95;
    }
    .bellBtn:hover { background: rgba(255,255,255,0.06); }
    .badgeDot {
      position:absolute;
      top: 3px;
      right: 3px;
      min-width: 18px;
      height: 18px;
      padding: 0 6px;
      border-radius: 999px;
      background: #ff3b30;
      color: #fff;
      font-size: 11px;
      line-height: 18px;
      text-align: center;
      font-weight: 800;
      box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }

    .notifDropdown {
      display: none;
      position: absolute;
      right: 0;
      top: 40px;
      width: 340px;
      max-height: 420px;
      overflow: auto;
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.45);
      z-index: 9999;
    }
    .notifDropdown.open { display:block; }

    .notifHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding: 10px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.10);
      position: sticky;
      top: 0;
      background: rgba(15, 23, 42, 0.98);
      backdrop-filter: blur(8px);
    }
    .notifTitle { font-weight: 900; }
    .markReadBtn {
      border: none;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.85;
      font-size: 12px;
      padding: 6px 8px;
      border-radius: 10px;
    }
    .markReadBtn:hover { background: rgba(255,255,255,0.06); opacity: 1; }

    .notifList { padding: 8px; display:flex; flex-direction:column; gap: 8px; }
    .notifItem {
      padding: 10px;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
    }
    .notifItem.unread { background: rgba(99,102,241,0.18); border-color: rgba(99,102,241,0.25); }
    .notifTime { font-size: 12px; opacity: 0.7; margin-top: 4px; }
    .notifEmpty { padding: 12px; opacity: 0.8; }

    .authBellSlot { display:inline-flex; align-items:center; }

    .notifDropdown,
    .notifDropdown * {
      pointer-events: auto !important;
    }


    /* 1. Create the container for the review section */
    .ts_review {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-left: 20px; /* Space between the meta info and the review */
        border-left: 1px solid var(--line); /* The missing vertical border */
        margin-left: 20px;
    }
    
    /* 2. Fix the inner layout so things aren't "too far right" */
    .ts_review_inner {
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: 100%;
    }
    
    /* 3. Fix the "first line indented" issue */
    .ts_quote {
        text-indent: 0; /* Forces the first line to align with the rest */
        margin-top: 4px;
        line-height: 1.4;
        font-style: italic;
        display: block; /* Ensures it behaves as a block element */
    }
    
    /* 4. Align the vote count and the text on the same horizontal plane */
    .ts_quote_row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }
    
    /* 5. Ensure the user block (avatar + name) is tight against the border */
    .ts_review_head {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

    /* 1. Define the Card Layout (CRITICAL FIX) */
    .ts_card {
        display: grid;
        /* Columns: Rank(40px) | Poster(80px) | Meta(240px) | Review(the rest) */
        grid-template-columns: 40px 80px 240px 1fr;
        align-items: center;
        gap: 10px;
        padding: 16px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    
    /* 2. Create the container for the review section */
    .ts_review {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-left: 20px; 
        /* This border creates the visual wall you wanted */
        border-left: 1px solid rgba(255,255,255,0.15); 
        margin-left: 10px;
        min-height: 60px;
    }
    
    /* 3. Fix the inner layout */
    .ts_review_inner {
        display: flex;
        flex-direction: column;
        gap: 6px;
        width: 100%;
    }
    
    /* 4. Fix the "first line indented" and alignment issues */
    .ts_quote {
        text-indent: 0 !important; /* Force removal of any inherited indentation */
        margin: 0;
        line-height: 1.4;
        font-style: italic;
        display: block;
    }
    
    /* 5. Align the vote count and the text */
    .ts_quote_row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }
    
    /* 6. Fix the avatar and username block */
    .ts_review_head {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 2px;
    }
    
    .ts_review_userblock {
        display: flex;
        align-items: center;
    }
    
    /* Vertical centering for the rank */
    .ts_rank {
        font-weight: 800;
        opacity: 0.5;
        text-align: center;
    }
    
    /* Thumbnail sizing */
    .ts_thumb img {
        width: 70px;
        height: auto;
        border-radius: 4px;
        display: block;
    }



  </style>
</head>
<body class="app" <%= me && me.theme_color ? `style="--accent: ${me.theme_color};"` : "" %>>
<%
  const safeMe = (typeof me !== "undefined" && me) ? me : null;
  const safeRows = (typeof rows !== "undefined" && Array.isArray(rows)) ? rows : [];
  const safeMode = (typeof mode !== "undefined" && mode) ? mode : "top";
  const safeNotifCount = (typeof notif_count !== "undefined" && notif_count) ? notif_count : 0;
  const safeNotifItems = (typeof notif_items !== "undefined" && Array.isArray(notif_items)) ? notif_items : [];
  const safeFlashes = (typeof flashes !== "undefined" && Array.isArray(flashes)) ? flashes : [];
%>

  <header class="topbar">
    <div class="wrap row between">
      <div style="display: flex; align-items: center; gap: 10px;">
        
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" style="display: flex; align-items: center; text-decoration: none;">
          <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <img 
              src="/static/logo.png" 
              alt="Logo" 
              style="max-width: 35px; max-height: 35px; width: auto; height: auto; object-fit: contain; transition: transform 0.6s ease-in-out;"
              onmouseover="this.style.transform='rotate(360deg)'" 
              onmouseout="this.style.transform='rotate(0deg)'"
            >
          </div>
        </a>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <% if (safeMe && Number(safeMe.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (safeMe) { %>
          <div class="authBellSlot">
            <div class="notifWrap">
              <button class="bellBtn" id="bellBtn" aria-label="Notifications" title="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1"/>
                  <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
                </svg>

                <% if (safeNotifCount > 0) { %>
                  <span class="badgeDot"><%= safeNotifCount %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>
                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>

                <% if (safeNotifItems.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of safeNotifItems) {
                      const kind = n.kind || "";
                      const actor = n.actor_username || "Someone";
                      const created = n.created_at || "";
                      const unread = Number(n.is_read || 0) === 0;
                      const sid = n.show_id || null;
                    %>
                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>
                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>
                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (safeMe.avatar_url) { %>
                <img src="<%= safeMe.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= safeMe.username %></span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <% if (safeFlashes.length > 0) { %>
      <div class="flashes">
        <% for (const f of safeFlashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <div class="topshows_page">

      <div class="row between" style="margin-top:10px; align-items:flex-end;">
        <div>
          <div class="kicker">Rankings</div>
          <h1 style="margin:6px 0 0;">
            <%= safeMode === "bottom" ? "Lowest Rated Shows" : "Top Shows" %>
          </h1>
          <div class="muted small">
            <%= safeMode === "bottom"
              ? "Sorted by lowest average rating (tie-break: most ratings)."
              : "Sorted by highest average rating (tie-break: most ratings)." %>
          </div>
        </div>

        <div class="seg" style="display:flex; gap:8px;">
          <a class="btn ghost <%= safeMode !== 'bottom' ? 'on' : '' %>" href="/top?mode=top">Top rated</a>
          <a class="btn ghost <%= safeMode === 'bottom' ? 'on' : '' %>" href="/top?mode=bottom">Lowest rated</a>
        </div>
      </div>

      <% if (safeRows.length > 0) { %>
        <div class="panel" style="margin-top:14px;">
          <div class="stack">
            <% safeRows.forEach((r, i) => {
                 const vs = r.top_review_score != null ? Number(r.top_review_score) : 0;
            %>
              <div class="ts_card">

                <div class="ts_rank">#<%= i + 1 %></div>

                <a class="ts_thumb" href="/show/<%= r.id %>">
                  <% if (r.poster_url) { %>
                    <img src="<%= r.poster_url %>" alt="<%= r.title %> poster">
                  <% } else { %>
                    <div class="ts_thumb_fallback"></div>
                  <% } %>
                </a>

                <div class="ts_meta">
                  <div class="ts_title">
                    <a href="/show/<%= r.id %>"><%= r.title %></a>
                  </div>
                  <div class="muted small"><%= r.corps %> — <%= r.year %></div>

                  <div class="ts_badges">
                    <div class="ts_avg">
                      ★ <%= Number(r.avg_rating || 0).toFixed(2) %>
                    </div>
                    <span class="badge muted"><%= r.cnt %> ratings</span>
                  </div>
                </div>

                <div class="ts_review">
                  <% if (r.top_review_text) { %>
                    <div class="ts_review_inner">
                
                      <div class="ts_review_head">
                        <span class="avatar_sm">
                          <% if (r.top_review_avatar_url) { %>
                            <img src="<%= r.top_review_avatar_url %>" alt="avatar">
                          <% } else { %>
                            <span class="avatar_fallback"></span>
                          <% } %>
                        </span>
                
                        <div class="ts_review_userblock">
                          <a class="reviewuser"
                             href="/u/<%= encodeURIComponent(r.top_review_username) %>"
                             style="text-decoration:none;">
                            <%= r.top_review_username %>
                          </a>
                
                          <% if (r.top_review_rating_half != null) { %>
                            <span class="badge good" style="margin-left:8px;">
                              ★ <%= (Number(r.top_review_rating_half) / 2).toFixed(1) %>
                            </span>
                          <% } else { %>
                            <span class="badge muted" style="margin-left:8px;">No rating</span>
                          <% } %>
                        </div>
                      </div>
                
                      <div class="ts_quote_row">
                        <div class="ts_vote <%= vs > 0 ? 'pos' : vs < 0 ? 'neg' : 'zero' %>">
                          <%= vs > 0 ? '+' : '' %><%= vs %>
                        </div>
                
                        <div class="muted small ts_quote">
                          “<%= r.top_review_text %>”
                        </div>
                      </div>
                
                    </div>
                  <% } else { %>
                    <div class="muted small">No reviews yet.</div>
                  <% } %>
                </div>

              </div>
            <% }) %>
          </div>
        </div>
      <% } else { %>
        <div class="panel" style="margin-top:14px;">
          <div class="muted">No rated shows yet.</div>
        </div>
      <% } %>

    </div>
  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd  = document.getElementById("notifDropdown");
      if (!btn || !dd) return;

      dd.addEventListener("click", (e) => e.stopPropagation());

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        dd.classList.toggle("open");
      });

      document.addEventListener("click", () => {
        dd.classList.remove("open");
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") dd.classList.remove("open");
      });
    })();
  </script>
</body>
</html>



