<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Top Voted Users - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
  <style>
      .topbar { background: var(--panel); border-bottom: 1px solid var(--line); padding: 10px 0; }
      .nav_user { display: flex; align-items: center; gap: 8px; text-decoration: none; }
  
      .topusers_list {
        display: flex;
        flex-direction: column;
        gap: 1px; 
        background: var(--line2);
        border: 1px solid var(--line2);
        border-radius: 8px;
        overflow: hidden;
      }
  
      .topusers_page .ts_card {
        display: grid;
        /* Define specific widths: Rank, Avatar, Meta, Review */
        grid-template-columns: 50px 80px 220px 1fr;
        gap: 20px;
        align-items: center; /* Vertically centers all items in the row */
        background: var(--panel);
        padding: 15px;
        
        /* Fixed height for uniformity */
        height: 180px; 
        box-sizing: border-box;
        overflow: hidden; /* Safety net */
      }
  
      .ts_rank { font-weight: 900; color: var(--muted); text-align: center; font-size: 1.1rem; }
      
      .ts_thumb { 
        width: 70px; 
        height: 70px; 
        border-radius: 50%; 
        overflow: hidden; 
        border: 1px solid var(--line); 
        background: var(--panel2);
        flex-shrink: 0;
      }
      .ts_thumb img { width: 100%; height: 100%; object-fit: cover; }
  
      .ts_meta { 
        display: flex; 
        flex-direction: column; 
        gap: 4px; 
        min-width: 0; /* Prevents long usernames from breaking the grid */
      }
  
      .ts_username { 
        font-weight: 900; 
        font-size: 1.1rem; 
        text-decoration: none; 
        color: inherit; 
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis; 
      }
      
      .ts_review_box { 
        padding-left: 20px; 
        border-left: 1px solid var(--line); 
        /* Ensures the box stays within its grid cell */
        min-width: 0; 
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: 80%; /* Keeps the border-left from touching the very top/bottom */
      }
  
      .tu_label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--muted);
        margin-bottom: 4px;
      }
  
      .tu_quote { 
        font-style: italic; 
        font-size: 13px; 
        opacity: 0.8; 
        line-height: 1.4;
        /* The Magic: Limits text to 2 lines and adds "..." */
        display: -webkit-box; 
        -webkit-line-clamp: 2; 
        -webkit-box-orient: vertical; 
        overflow: hidden; 
        word-break: break-word;
      }
  
      .badge.score { background: rgba(34, 197, 94, 0.1); color: #22c55e; font-weight: 800; }


      /* Mobile Optimization for Top Users */
      @media (max-width: 768px) {
          /* 1. Reset the fixed height and change the grid layout */
          .topusers_page .ts_card {
              grid-template-columns: 50px 70px 1fr !important;
              grid-template-rows: auto auto !important;
              height: auto !important; /* Allow card to grow with content */
              gap: 10px 15px !important;
              padding: 15px !important;
              align-items: start !important;
          }
      
          /* 2. Position the Rank (#1) */
          .ts_rank {
              grid-column: 1;
              grid-row: 1;
              padding-top: 5px;
          }
      
          /* 3. Position the Avatar */
          .ts_thumb {
              grid-column: 2;
              grid-row: 1;
              width: 60px !important;
              height: 60px !important;
          }
      
          /* 4. Position the User Info (Name, Stats) */
          .ts_meta {
              grid-column: 3;
              grid-row: 1;
              justify-content: center;
          }
      
          .ts_username {
              white-space: normal !important; /* Allow names to wrap if very long */
              font-size: 1rem;
          }
      
          /* 5. Move the Review Box to its own row at the bottom */
          .ts_review_box {
              grid-column: 1 / -1; /* Span all columns */
              grid-row: 2;
              border-left: none !important;
              padding-left: 0 !important;
              border-top: 1px solid var(--line);
              padding-top: 12px !important;
              margin-top: 5px;
              height: auto !important;
          }
      
          /* 6. Header adjustments */
          .topusers_page header {
              margin: 20px 0 !important;
              text-align: center;
          }
      
          .topbar .wrap {
              flex-direction: column;
              gap: 12px;
              padding: 15px 0;
          }
      }
      
      /* Fix for very small screens */
      @media (max-width: 400px) {
          .topusers_page .ts_card {
              grid-template-columns: 40px 1fr !important; /* Merge rank and avatar space */
          }
          .ts_thumb {
              width: 50px !important;
              height: 50px !important;
          }
      }

  </style>
</head>

<% 
  // Safety check for user session data
  const safeMe = (typeof me !== 'undefined' && me) ? me : null;
  const userRows = (typeof rows !== 'undefined' && rows) ? rows : [];
%>

<body class="app">

  <header class="topbar">
    <div class="wrap row between">
      <div style="display:flex; align-items:center; gap:10px;">
        <a class="brand" href="/shows" style="display:flex; align-items:center; gap:10px; text-decoration:none;">
          <img
            src="/static/logo.png"
            alt="Pressboxd logo"
            style="width:30px; height:30px; object-fit:contain; flex-shrink:0; transition:transform 0.6s ease-in-out;"
            onmouseover="this.style.transform='rotate(360deg)'"
            onmouseout="this.style.transform='rotate(0deg)'"
          >
          <img
            src="/static/pressboxd-wordmark.png"
            alt="Pressboxd"
            style="height:64px; width:auto; object-fit:contain; display:block;"
          >
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
      </nav>

      <div class="auth row">
        <% if (safeMe) { %>
          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (safeMe.avatar_url) { %>
                <img src="<%= safeMe.avatar_url %>">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= safeMe.username %></span>
          </a>
        <% } else { %>
          <a href="/login" class="muted small">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="topusers_page">
      <header style="margin: 40px 0 20px;">
        <div class="kicker">Leaderboard</div>
        <h1 style="margin:0;">Top Voted Users</h1>
        <p class="muted">Ranked by review community impact.</p>
      </header>

      <% if (userRows.length > 0) { %>
        <div style="border: 1px solid var(--line2); border-radius: 8px; overflow: hidden;">
          <% userRows.forEach((r, i) => { %>
            <div class="ts_card">
              <div class="ts_rank">#<%= i + 1 %></div>
              
              <div class="ts_thumb">
                <% if (r.avatar_url) { %>
                  <img src="<%= r.avatar_url %>" alt="avatar">
                <% } %>
              </div>

              <div class="ts_meta">
                <a class="ts_username" href="/u/<%= encodeURIComponent(r.username || '') %>">
                  <%= r.username || 'Anonymous' %>
                </a>
                <div class="row" style="gap: 10px;">
                   <span class="badge small">▲ <%= r.upvotes || 0 %></span>
                   <span class="badge small score">★ <%= r.net_score || 0 %></span>
                </div>
                <div class="muted small"><%= r.reviews_count || 0 %> reviews</div>
              </div>

              <div class="ts_review_box">
                <div class="muted small" style="text-transform: uppercase; font-size: 9px; margin-bottom: 4px;">
                  Top Review <% if (r.top_show_id) { %>
                    of <a href="/show/<%= r.top_show_id %>" style="color:var(--accent);"><%= r.top_corps %> <%= r.top_year %></a>
                  <% } %>
                </div>
                <div class="tu_quote">
                  <%= r.top_review_text ? `“${r.top_review_text}”` : "User hasn't written any review text yet." %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="panel" style="text-align: center; padding: 50px;">
          <p class="muted">No users found.</p>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>



