<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Top Voted Users - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>

  <style>
      .auth { align-items:center; gap: 12px; }
      
      /* --- TOP USERS CARD --- */
      .topusers_page .ts_card {
          display: grid !important;
          /* Adjusted to 3 columns since your DB current query doesn't have "Top Review" data yet */
          grid-template-columns: 60px 90px 1fr !important; 
          gap: 24px !important;
          align-items: center !important;
          background: var(--panel) !important;
          padding: 20px !important;
          border-bottom: 1px solid var(--line2) !important;
          min-height: 100px !important; 
          width: 100% !important;
      }
  
      .topusers_page .ts_rank {
          font-weight: 950;
          font-size: 20px;
          color: var(--muted);
          text-align: center;
      }
  
      .topusers_page .ts_thumb {
          width: 80px !important;
          height: 80px !important;
          border-radius: 50%; 
          border: 1px solid var(--line);
          background: var(--panel2);
          overflow: hidden;
      }
      
      .topusers_page .ts_thumb img {
          width: 100%;
          height: 100%;
          object-fit: cover;
      }

      .ts_thumb_fallback {
          width: 100%; height: 100%;
          background: linear-gradient(135deg, var(--accentFaint), transparent);
      }
  
      .topusers_page .ts_meta {
          display: flex;
          flex-direction: column;
          gap: 4px;
      }
  
      .topusers_page .ts_title {
          font-weight: 950;
          font-size: 1.3rem;
      }

      .role_badge {
          font-size: 10px;
          text-transform: uppercase;
          font-weight: 800;
          padding: 2px 6px;
          border-radius: 4px;
          margin-left: 8px;
          vertical-align: middle;
      }

      .stat_row {
          display: flex;
          gap: 15px;
          margin-top: 5px;
      }

      .stat_item {
          font-size: 13px;
          color: var(--muted);
      }

      .stat_item strong { color: var(--text); }
  </style>
</head>

<%
  const meUser = (typeof me !== "undefined" && me) ? me : null;
  // Match the variable name 'rows' usually passed by the controller
  const userRows = (typeof rows !== "undefined" && Array.isArray(rows)) ? rows : [];
%>

<body class="app" <%= meUser && meUser.theme_color ? `style="--accent: ${meUser.theme_color};"` : "" %>>

  <header class="topbar">
    <div class="wrap row between">
      <div style="display: flex; align-items: center; gap: 10px;">
        <a href="/shows" style="display: flex; align-items: center; text-decoration: none;">
            <img src="/static/logo.png" alt="Logo" style="width: 30px; height: 30px;">
            <span class="brand" style="margin-left: 8px;">Pressboxd</span>
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
      </nav>

      <div class="auth row">
        <% if (meUser) { %>
          <a class="nav_user" href="/me">
            <span class="avatar_sm">
                <% if (meUser.avatar_url) { %>
                    <img src="<%= meUser.avatar_url %>">
                <% } else { %>
                    <span class="avatar_fallback"></span>
                <% } %>
            </span>
            <span class="muted small"><%= meUser.username %></span>
          </a>
          <a href="/logout">Logout</a>
        <% } else { %>
            <a href="/login">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="topusers_page">
      <div style="margin-top:30px; margin-bottom: 20px;">
        <div class="kicker">Community</div>
        <h1 style="margin:5px 0;">Top Voted Users</h1>
        <p class="muted">Ranked by total upvotes received on their reviews.</p>
      </div>

      <% if (userRows.length > 0) { %>
        <div style="display:flex; flex-direction:column; gap:1px; background: var(--line2); border: 1px solid var(--line2); border-radius: 8px; overflow: hidden;">
          <% userRows.forEach((r, i) => { %>
            <div class="ts_card">
              <div class="ts_rank">#<%= i + 1 %></div>

              <div class="ts_thumb">
                <% if (r.avatar_url) { %>
                  <img src="<%= r.avatar_url %>" alt="avatar">
                <% } else { %>
                  <div class="ts_thumb_fallback"></div>
                <% } %>
              </div>

              <div class="ts_meta">
                <div class="ts_title">
                  <a href="/u/<%= encodeURIComponent(r.username || '') %>" style="text-decoration:none; color: inherit;">
                    <%= r.username %>
                  </a>
                  <% if (r.role_name) { %>
                    <span class="role_badge" style="background: <%= r.role_color || 'var(--line)' %>22; color: <%= r.role_color || 'var(--text)' %>; border: 1px solid <%= r.role_color || 'var(--line)' %>44;">
                        <%= r.role_name %>
                    </span>
                  <% } %>
                </div>
                
                <div class="stat_row">
                    <div class="stat_item">Upvotes: <strong><%= r.total_upvotes || 0 %></strong></div>
                    <div class="stat_item">Reviews: <strong><%= r.reviews_count || 0 %></strong></div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="panel" style="text-align: center; padding: 40px;">
            <div class="muted">No ranked users found yet. Start voting on reviews!</div>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
