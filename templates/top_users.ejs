<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Top Voted Users - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>

  <style>
      /* --- SHARED NAVIGATION & NOTIFICATIONS --- */
      .auth { align-items:center; gap: 12px; }
      .notifWrap { position: relative; display: inline-flex; align-items:center; }
      .bellBtn { position: relative; border: none; background: transparent; cursor: pointer; color: inherit; padding: 6px; display: inline-flex; align-items: center; justify-content: center; }
      .notifDropdown { display: none; position: absolute; right: 0; top: 40px; width: 340px; max-height: 420px; overflow: auto; background: rgba(15, 23, 42, 0.98); border: 1px solid rgba(255,255,255,0.12); z-index: 9999; }
      .notifDropdown.open { display:block; }
  
      /* --- TOP USERS CARD LAYOUT --- */
      
      .topusers_page .ts_card {
          display: grid !important;
          /* Increased Meta column to 260px to push review section right */
          grid-template-columns: 60px 90px 260px 1fr !important; 
          gap: 24px !important;
          align-items: center !important;
          background: var(--panel) !important;
          padding: 20px !important;
          border-bottom: 1px solid var(--line2) !important;
          /* FIX: Changed height to min-height to prevent text cutoff */
          min-height: 140px !important; 
          width: 100% !important;
          overflow: hidden !important;
      }
  
      .topusers_page .ts_rank {
          font-weight: 950;
          font-size: 20px;
          color: var(--muted);
          text-align: center;
      }
  
      /* FIX: Increased PFP by 10px (from 80px to 90px) */
      .topusers_page .ts_thumb {
          width: 90px !important;
          height: 90px !important;
          flex: 0 0 90px !important;
          border-radius: 50%; 
          border: 1px solid var(--line);
          background: var(--panel2);
          overflow: hidden;
      }
      
      .topusers_page .ts_thumb img {
          width: 100% !important;
          height: 100% !important;
          object-fit: cover !important;
      }

      .ts_thumb_fallback {
          width: 100%;
          height: 100%;
          background: linear-gradient(135deg, var(--accentFaint), transparent);
      }
  
      .topusers_page .ts_meta {
          display: flex;
          flex-direction: column;
          gap: 8px;
          min-width: 0 !important;
      }
  
      .topusers_page .ts_title {
          font-weight: 950;
          font-size: 1.3rem;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
      }

      .ts_badges {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
      }


      .badge.good_score {
          color: #22c55e !important;
          background: rgba(34, 197, 94, 0.1) !important;
          border-color: rgba(34, 197, 94, 0.2) !important;
          font-weight: 800;
      }
  
      /* --- THE REVIEW SECTION --- */
      .topusers_page .ts_review {
          display: flex !important;
          flex-direction: column !important;
          justify-content: center !important;
          padding-left: 24px !important;
          border-left: 1px solid var(--line) !important;
          min-height: 80px !important; /* Changed from fixed height */
      }
  
      .tu_label {
          font-size: 10px;
          text-transform: uppercase;
          letter-spacing: 0.12em;
          color: var(--muted);
          margin-bottom: 6px;
      }

      .tu_label a { color: var(--accent); font-weight: 800; text-decoration: none; }
  
      .tu_quote {
          display: -webkit-box !important;
          -webkit-line-clamp: 3; /* Increased slightly to allow more text */
          -webkit-box-orient: vertical;
          overflow: hidden;
          text-overflow: ellipsis;
          font-style: italic;
          line-height: 1.5;
          color: var(--text);
          opacity: 0.8;
          font-size: 14px;
      }
    </style>
</head>

<%
  const safeMe = (typeof me !== "undefined" && me) ? me : null;
  const safeRows = (typeof rows !== "undefined" && Array.isArray(rows)) ? rows : [];
  const safeNotifCount = (typeof notif_count !== "undefined" && notif_count) ? notif_count : 0;
  const safeNotifItems = (typeof notif_items !== "undefined" && Array.isArray(notif_items)) ? notif_items : [];
%>

<body class="app" <%= safeMe && safeMe.theme_color ? `style="--accent: ${safeMe.theme_color};"` : "" %>>

  <header class="topbar">
    <div class="wrap row between">
      <div style="display: flex; align-items: center; gap: 10px;">
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" style="display: flex; align-items: center;">
            <img src="/static/logo.png" alt="Logo" style="max-width: 35px; max-height: 35px; width: auto; height: auto;">
        </a>
        <a class="brand" href="/shows"><span>Pressboxd</span></a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
      </nav>

      <div class="auth row">
        <% if (safeMe) { %>
          <a class="nav_user" href="/me">
            <span class="avatar_sm"><% if (safeMe.avatar_url) { %><img src="<%= safeMe.avatar_url %>"><% } else { %><span class="avatar_fallback"></span><% } %></span>
            <span class="muted small"><%= safeMe.username %></span>
          </a>
          <a href="/logout">Logout</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="topusers_page">
      <div style="margin-top:20px;">
        <div class="kicker">Community</div>
        <h1 style="margin:6px 0 0;">Top Voted Users</h1>
        <div class="muted small">Ranked by total net score on reviews.</div>
      </div>

      <% if (safeRows.length > 0) { %>
        <div style="margin-top:20px; display:flex; flex-direction:column; gap:1px; background: var(--line2); border: 1px solid var(--line2);">
          <% safeRows.forEach((r, i) => { %>
            <div class="ts_card">
              <div class="ts_rank">#<%= i + 1 %></div>

              <div class="ts_thumb">
                <% if (r.avatar_url) { %>
                  <img src="<%= r.avatar_url %>" alt="avatar">
                <% } else { %>
                  <div class="ts_thumb_fallback"></div>
                <% } %>
              </div>

              <div class="ts_meta">
                <div class="ts_title">
                  <a href="/u/<%= encodeURIComponent(r.username) %>" style="text-decoration:none;"><%= r.username %></a>
                </div>
                <div class="ts_badges">
                  <span class="badge small">▲ <%= r.upvotes || 0 %></span>
                  <span class="badge small neg_score">▼ <%= r.downvotes || 0 %></span>
                  <span class="badge small good_score">★ <%= r.net_score || 0 %></span>
                </div>
              </div>

              <div class="ts_review">
                <div class="tu_label">
                    Top review <% if (r.top_show_id) { %> 
                        of <a href="/show/<%= r.top_show_id %>"><%= r.top_corps %> <%= r.top_year %></a>
                    <% } %>
                </div>
                <% if (r.top_review_text) { %>
                  <div class="tu_quote">“<%= r.top_review_text %>”</div>
                <% } else { %>
                  <div class="muted small">No review text available.</div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>

