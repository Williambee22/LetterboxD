<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Top Voted Users - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
  <style>
      .topbar { background: var(--panel); border-bottom: 1px solid var(--line); padding: 10px 0; }
      .nav_user { display: flex; align-items: center; gap: 8px; text-decoration: none; }
  
      .topusers_list {
        display: flex;
        flex-direction: column;
        gap: 1px; 
        background: var(--line2);
        border: 1px solid var(--line2);
        border-radius: 8px;
        overflow: hidden;
      }
  
      .topusers_page .ts_card {
        display: grid;
        /* Define specific widths: Rank, Avatar, Meta, Review */
        grid-template-columns: 50px 80px 220px 1fr;
        gap: 20px;
        align-items: center; /* Vertically centers all items in the row */
        background: var(--panel);
        padding: 15px;
        
        /* Fixed height for uniformity */
        height: 180px; 
        box-sizing: border-box;
        overflow: hidden; /* Safety net */
      }
  
      .ts_rank { font-weight: 900; color: var(--muted); text-align: center; font-size: 1.1rem; }
      
      .ts_thumb { 
        width: 70px; 
        height: 70px; 
        border-radius: 50%; 
        overflow: hidden; 
        border: 1px solid var(--line); 
        background: var(--panel2);
        flex-shrink: 0;
      }
      .ts_thumb img { width: 100%; height: 100%; object-fit: cover; }
  
      .ts_meta { 
        display: flex; 
        flex-direction: column; 
        gap: 4px; 
        min-width: 0; /* Prevents long usernames from breaking the grid */
      }
  
      .ts_username { 
        font-weight: 900; 
        font-size: 1.1rem; 
        text-decoration: none; 
        color: inherit; 
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis; 
      }
      
      .ts_review_box { 
        padding-left: 20px; 
        border-left: 1px solid var(--line); 
        /* Ensures the box stays within its grid cell */
        min-width: 0; 
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: 80%; /* Keeps the border-left from touching the very top/bottom */
      }
  
      .tu_label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--muted);
        margin-bottom: 4px;
      }
  
      .tu_quote { 
        font-style: italic; 
        font-size: 13px; 
        opacity: 0.8; 
        line-height: 1.4;
        /* The Magic: Limits text to 2 lines and adds "..." */
        display: -webkit-box; 
        -webkit-line-clamp: 2; 
        -webkit-box-orient: vertical; 
        overflow: hidden; 
        word-break: break-word;
      }
  
      .badge.score { background: rgba(34, 197, 94, 0.1); color: #22c55e; font-weight: 800; }
  </style>
</head>

<% 
  // Safety check for user session data
  const safeMe = (typeof me !== 'undefined' && me) ? me : null;
  const userRows = (typeof rows !== 'undefined' && rows) ? rows : [];
%>

<body class="app">

  <header class="topbar">
    <div class="wrap row between">
      <div style="display: flex; align-items: center; gap: 10px;">
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" style="display: flex; align-items: center; text-decoration: none;">
          <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <img src="/static/logo.png" alt="Logo" style="max-width: 35px; max-height: 35px; width: auto; height: auto;">
          </div>
        </a>
        <a class="brand" href="/shows"><span>Pressboxd</span></a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
      </nav>

      <div class="auth row">
        <% if (safeMe) { %>
          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (safeMe.avatar_url) { %>
                <img src="<%= safeMe.avatar_url %>">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= safeMe.username %></span>
          </a>
        <% } else { %>
          <a href="/login" class="muted small">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="topusers_page">
      <header style="margin: 40px 0 20px;">
        <div class="kicker">Leaderboard</div>
        <h1 style="margin:0;">Top Voted Users</h1>
        <p class="muted">Ranked by review community impact.</p>
      </header>

      <% if (userRows.length > 0) { %>
        <div style="border: 1px solid var(--line2); border-radius: 8px; overflow: hidden;">
          <% userRows.forEach((r, i) => { %>
            <div class="ts_card">
              <div class="ts_rank">#<%= i + 1 %></div>
              
              <div class="ts_thumb">
                <% if (r.avatar_url) { %>
                  <img src="<%= r.avatar_url %>" alt="avatar">
                <% } %>
              </div>

              <div class="ts_meta">
                <a class="ts_username" href="/u/<%= encodeURIComponent(r.username || '') %>">
                  <%= r.username || 'Anonymous' %>
                </a>
                <div class="row" style="gap: 10px;">
                   <span class="badge small">▲ <%= r.upvotes || 0 %></span>
                   <span class="badge small score">★ <%= r.net_score || 0 %></span>
                </div>
                <div class="muted small"><%= r.reviews_count || 0 %> reviews</div>
              </div>

              <div class="ts_review_box">
                <div class="muted small" style="text-transform: uppercase; font-size: 9px; margin-bottom: 4px;">
                  Top Review <% if (r.top_show_id) { %>
                    of <a href="/show/<%= r.top_show_id %>" style="color:var(--accent);"><%= r.top_corps %> <%= r.top_year %></a>
                  <% } %>
                </div>
                <div class="tu_quote">
                  <%= r.top_review_text ? `“${r.top_review_text}”` : "User hasn't written any review text yet." %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="panel" style="text-align: center; padding: 50px;">
          <p class="muted">No users found.</p>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>


