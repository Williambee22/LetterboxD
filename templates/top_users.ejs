<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Top Voted Users - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>

  <style>
    .auth { align-items:center; gap: 12px; }

    .notifWrap { position: relative; display: inline-flex; align-items:center; }
    .bellBtn {
      position: relative;
      border: none;
      background: transparent;
      cursor: pointer;
      color: inherit;
      padding: 6px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.95;
    }
    .bellBtn:hover { background: rgba(255,255,255,0.06); }
    .badgeDot {
      position:absolute;
      top: 3px;
      right: 3px;
      min-width: 18px;
      height: 18px;
      padding: 0 6px;
      border-radius: 999px;
      background: #ff3b30;
      color: #fff;
      font-size: 11px;
      line-height: 18px;
      text-align: center;
      font-weight: 800;
      box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }

    .notifDropdown {
      display: none;
      position: absolute;
      right: 0;
      top: 40px;
      width: 340px;
      max-height: 420px;
      overflow: auto;
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.45);
      z-index: 9999;
    }
    .notifDropdown.open { display:block; }

    .notifHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding: 10px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.10);
      position: sticky;
      top: 0;
      background: rgba(15, 23, 42, 0.98);
      backdrop-filter: blur(8px);
    }
    .notifTitle { font-weight: 900; }
    .markReadBtn {
      border: none;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.85;
      font-size: 12px;
      padding: 6px 8px;
      border-radius: 10px;
    }
    .markReadBtn:hover { background: rgba(255,255,255,0.06); opacity: 1; }

    .notifList { padding: 8px; display:flex; flex-direction:column; gap: 8px; }
    .notifItem {
      padding: 10px;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
    }
    .notifItem.unread { background: rgba(99,102,241,0.18); border-color: rgba(99,102,241,0.25); }
    .notifTime { font-size: 12px; opacity: 0.7; margin-top: 4px; }
    .notifEmpty { padding: 12px; opacity: 0.8; }

    .authBellSlot { display:inline-flex; align-items:center; }

    .notifDropdown,
    .notifDropdown * {
      pointer-events: auto !important;
    }

    /* ... existing notification CSS ... */

    /* 1. Profile Thumbnail: Square & Large */
    .topusers_page .ts_thumb {
        width: 80px;
        height: 80px;
        flex: 0 0 80px;
        overflow: hidden;
        border: 1px solid var(--accentSoft);
        background: var(--panel2);
        border-radius: 4px; /* Optional: slight rounding */
    }
    
    .topusers_page .ts_thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    /* 2. The Card Layout: This pushes the review to the right */
    .topusers_page .ts_card {
        display: grid;
        /* Columns: Rank | Thumb | Stats (Fixed Width) | Review (Flexible/Right) */
        grid-template-columns: 40px 80px 240px 1fr; 
        gap: 20px;
        align-items: center;
        background: var(--panel);
        padding: 16px;
        border: 1px solid var(--line2);
        width: 100%; /* Ensures the card uses the full container width */
    }
    
    /* 3. Review Section: Pushed to the right with a divider */
    .topusers_page .ts_review {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-left: 24px;
        border-left: 1px solid var(--line);
        min-height: 60px;
        /* This ensures the review stays right-aligned */
        margin-left: auto; 
        width: 100%;
    }
    
    /* 4. Text Cleanup */
    .tu_quote {
        text-indent: 0;
        margin-top: 6px;
        line-height: 1.5;
        color: var(--text);
        font-style: italic;
        opacity: 0.9;
    }
    
    .tu_label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted);
        margin-bottom: 4px;
    }
    
    .ts_rank {
        text-align: center;
        font-weight: 950;
        font-size: 18px;
        color: var(--muted);
    }
    
    .ts_meta {
        min-width: 200px; /* Keeps name/upvotes from collapsing */
    }
  </style>
</head>
<body class="app" <%= me && me.theme_color ? `style="--accent: ${me.theme_color};"` : "" %>>
<%
  const safeMe = (typeof me !== "undefined" && me) ? me : null;
  const safeRows = (typeof rows !== "undefined" && Array.isArray(rows)) ? rows : [];
  const safeNotifCount = (typeof notif_count !== "undefined" && notif_count) ? notif_count : 0;
  const safeNotifItems = (typeof notif_items !== "undefined" && Array.isArray(notif_items)) ? notif_items : [];
  const safeFlashes = (typeof flashes !== "undefined" && Array.isArray(flashes)) ? flashes : [];
%>

  <header class="topbar">
    <div class="wrap row between">
      <div style="display: flex; align-items: center; gap: 10px;">
        
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" style="display: flex; align-items: center; text-decoration: none;">
          <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <img 
              src="/static/logo.png" 
              alt="Logo" 
              style="max-width: 35px; max-height: 35px; width: auto; height: auto; object-fit: contain; transition: transform 0.6s ease-in-out;"
              onmouseover="this.style.transform='rotate(360deg)'" 
              onmouseout="this.style.transform='rotate(0deg)'"
            >
          </div>
        </a>
  
        <a class="brand" href="/shows">
          <span>Pressboxd</span>
        </a>
  
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <% if (safeMe && Number(safeMe.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (safeMe) { %>
          <div class="authBellSlot">
            <div class="notifWrap">
              <button class="bellBtn" id="bellBtn" aria-label="Notifications" title="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1"/>
                  <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
                </svg>

                <% if (safeNotifCount > 0) { %>
                  <span class="badgeDot"><%= safeNotifCount %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>
                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>

                <% if (safeNotifItems.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of safeNotifItems) {
                      const kind = n.kind || "";
                      const actor = n.actor_username || "Someone";
                      const created = n.created_at || "";
                      const unread = Number(n.is_read || 0) === 0;
                      const sid = n.show_id || null;
                    %>
                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>
                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>
                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (safeMe.avatar_url) { %>
                <img src="<%= safeMe.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= safeMe.username %></span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <% if (safeFlashes.length > 0) { %>
      <div class="flashes">
        <% for (const f of safeFlashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <div class="topshows_page topusers_page">
      <div style="margin-top:10px;">
        <div class="kicker">Users</div>
        <h1 style="margin:6px 0 0;">Top Voted Users</h1>
        <div class="muted small">Ranked by total upvotes earned on reviews.</div>
      </div>

      <% if (safeRows.length > 0) { %>
        <div style="margin-top:14px; display:flex; flex-direction:column; gap:12px;">
          <% safeRows.forEach((r, i) => {
               const rank = i + 1;
               const username = r?.username || "Unknown";
               const avatar = r?.avatar_url || "";
               const upvotes = r?.upvotes != null ? Number(r.upvotes) : 0;
               const downvotes = r?.downvotes != null ? Number(r.downvotes) : 0;
               const net = r?.net_score != null ? Number(r.net_score) : 0;
               const sid = r?.top_show_id || null;
               const quote = r?.top_review_text || "";
               const topCorps = r?.top_corps || "";
               const topYear = r?.top_year || "";
          %>
            <div class="ts_card">
              <div class="ts_rank">#<%= rank %></div>

              <div class="ts_thumb">
                <% if (avatar) { %>
                  <img src="<%= avatar %>" alt="<%= username %> avatar">
                <% } else { %>
                  <div class="ts_thumb_fallback"></div>
                <% } %>
              </div>

              <div class="ts_meta">
                <div class="ts_title">
                  <a href="/u/<%= encodeURIComponent(username) %>" style="text-decoration:none;">
                    <%= username %>
                  </a>
                </div>

                <div class="ts_badges">
                  <span class="badge">▲ <%= upvotes %> upvotes</span>
                  <span class="badge muted">▼ <%= downvotes %> downvotes</span>
                  <span class="badge good"><%= net %></span>
                </div>
              </div>

              <div class="ts_review">
                <% if (quote) { %>
                  <div class="tu_quote_row">
                    <div class="tu_label">
                      Top review<% if (sid && (topCorps || topYear)) { %> of<% } %>
                      <% if (sid) { %>
                        <a href="/show/<%= sid %>" style="text-decoration:none;">
                          <%= topCorps %><% if (topYear) { %> <%= topYear %><% } %>
                        </a>
                      <% } else if (topCorps || topYear) { %>
                        <%= topCorps %><% if (topYear) { %> <%= topYear %><% } %>
                      <% } %>
                    </div>

                    <div class="tu_quote top_quote"><%= quote %></div>
                  </div>
                <% } else { %>
                  <div class="muted small">No review text found.</div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="panel" style="margin-top:14px;">
          <div class="muted">No voted users yet.</div>
        </div>
      <% } %>
    </div>
  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd  = document.getElementById("notifDropdown");
      if (!btn || !dd) return;

      dd.addEventListener("click", (e) => e.stopPropagation());

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        dd.classList.toggle("open");
      });

      document.addEventListener("click", () => {
        dd.classList.remove("open");
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") dd.classList.remove("open");
      });
    })();
  </script>
</body>
</html>




