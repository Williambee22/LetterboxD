<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>All Ratings - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
  <link rel="icon" type="image/png" href="/static/favicon.png"/>

  <style>
    .auth { align-items:center; gap: 12px; }

    .notifWrap { position: relative; display: inline-flex; align-items:center; }
    .bellBtn {
      position: relative;
      border: none;
      background: transparent;
      cursor: pointer;
      color: inherit;
      padding: 6px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.95;
    }
    .bellBtn:hover { background: rgba(255,255,255,0.06); }
    .badgeDot {
      position:absolute;
      top: 3px;
      right: 3px;
      min-width: 18px;
      height: 18px;
      padding: 0 6px;
      border-radius: 999px;
      background: #ff3b30;
      color: #fff;
      font-size: 11px;
      line-height: 18px;
      text-align: center;
      font-weight: 800;
      box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }

    .notifDropdown {
      display: none;
      position: absolute;
      right: 0;
      top: 40px;
      width: 340px;
      max-height: 4;
      overflow: auto;
      background: rgba(15, 23, 42, 0.98);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.45);
      z-index: 9999;
    }
    .notifDropdown.open { display:block; }

    .notifHeader {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding: 10px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.10);
      position: sticky;
      top: 0;
      background: rgba(15, 23, 42, 0.98);
      backdrop-filter: blur(8px);
    }
    .notifTitle { font-weight: 900; }
    .markReadBtn {
      border: none;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.85;
      font-size: 12px;
      padding: 6px 8px;
      border-radius: 10px;
    }
    .markReadBtn:hover { background: rgba(255,255,255,0.06); opacity: 1; }

    .notifList { padding: 8px; display:flex; flex-direction:column; gap: 8px; }
    .notifItem {
      padding: 10px;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
    }
    .notifItem.unread { background: rgba(99,102,241,0.18); border-color: rgba(99,102,241,0.25); }
    .notifTime { font-size: 12px; opacity: 0.7; margin-top: 4px; }
    .notifEmpty { padding: 12px; opacity: 0.8; }

    .authBellSlot { display:inline-flex; align-items:center; }

    .notifDropdown,
    .notifDropdown * {
      pointer-events: auto !important;
    }

    /* critic-style ratings list */
    .ratings_list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 16px;
    }
    
    .ratingCard {
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 14px;
      background: rgba(255,255,255,0.03);
      overflow: hidden;
    }
    
    .ratingSummary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 14px;
    }
    
    .ratingSummary::-webkit-details-marker {
      display: none;
    }
    
    .ratingSummary:hover {
      background: rgba(255,255,255,0.035);
    }
    
    .ratingLeft {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }
    
    .ratingMeta {
      min-width: 0;
    }
    
    .ratingTitle {
      font-weight: 900;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    
    .ratingSub {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.25;
      margin-top: 3px;
    }
    
    .ratingScore {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-weight: 900;
      white-space: nowrap;
      padding: 6px 10px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.04);
    }
    
    .ratingChevron {
      font-size: 14px;
      opacity: 0.75;
      transition: transform .15s ease;
      margin-left: 10px;
    }
    
    details[open] .ratingChevron {
      transform: rotate(90deg);
    }
    
    .ratingBody {
      padding: 0 14px 14px 14px;
      border-top: 1px solid rgba(255,255,255,0.06);
      background: rgba(255,255,255,0.02);
    }
    
    .ratingReviewText {
      white-space: pre-wrap;
      line-height: 1.55;
      margin-top: 12px;
    }

    .ratingFilterSelect,
    .ratingSearchInput {
      background: #111 !important;
      color: #fff !important;
      border: 1px solid rgba(255,255,255,0.14) !important;
      border-radius: 10px;
    }
    
    .ratingFilterSelect option {
      background: #111 !important;
      color: #fff !important;
    }


    .ratingNoReview {
      margin-top: 12px;
      color: var(--muted);
    }
    
    @media (max-width: 700px) {
      .ratingSummary {
        align-items: flex-start;
      }
    
      .ratingTitle {
        white-space: normal;
      }
    }

    .rating_row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 12px 14px;
      border-radius: 12px;
      text-decoration: none;
      color: inherit;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .rating_row:hover {
      background: rgba(255,255,255,0.05);
      border-color: rgba(255,255,255,0.12);
    }

    .rating_main {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .rating_title {
      font-weight: 800;
      line-height: 1.2;
    }

    .rating_sub {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.2;
    }

    .rating_score {
      flex: 0 0 auto;
      white-space: nowrap;
      font-weight: 800;
    }

    @media (max-width: 700px) {
      .rating_row {
        flex-direction: column;
        align-items: flex-start;
      }
      .rating_score {
        margin-top: 4px;
      }
    }
  </style>
</head>
<body class="app" <%= me && me.theme_color ? `style="--accent: ${me.theme_color};"` : "" %>>
<%
  const safeMe = (typeof me !== "undefined" && me) ? me : null;
  const safeProfileUser = (typeof profile_user !== "undefined" && profile_user) ? profile_user : {};

  const safeRoles = (typeof user_roles !== "undefined" && Array.isArray(user_roles)) ? user_roles : [];
  const safeRows = (typeof rows !== "undefined" && Array.isArray(rows)) ? rows : [];
  const safeSort = (typeof sort !== "undefined" && sort) ? sort : "high";
  const safeQ = (typeof q !== "undefined" && q) ? q : "";

  const safeNotifCount = (typeof notif_count !== "undefined" && notif_count) ? notif_count : 0;
  const safeNotifItems = (typeof notif_items !== "undefined" && Array.isArray(notif_items)) ? notif_items : [];
  const safeFlashes = (typeof flashes !== "undefined" && Array.isArray(flashes)) ? flashes : [];
%>

  <header class="topbar">
    <div class="wrap row between">
      <div style="display:flex; align-items:center; gap:10px;">
        <a href="https://www.generaleffect.media/" target="_blank" rel="noopener" style="display:flex; align-items:center;">
          <img
            src="/static/logo.png"
            alt="Logo"
            style="width:36px; height:36px; object-fit:contain; transition: transform 0.6s ease-in-out;"
            onmouseover="this.style.transform='rotate(360deg)'"
            onmouseout="this.style.transform='rotate(0deg)'"
          >
        </a>
      
        <a class="brand" href="/shows" style="display:flex; align-items:center;">
          <img
            src="/static/pressboxd-wordmark.png"
            alt="Pressboxd"
            style="height:68px; width:auto; display:block;"
          >
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <% if (safeMe && Number(safeMe.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (safeMe) { %>
          <div class="authBellSlot">
            <div class="notifWrap">
              <button class="bellBtn" id="bellBtn" aria-label="Notifications" title="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1"/>
                  <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
                </svg>

                <% if (safeNotifCount > 0) { %>
                  <span class="badgeDot"><%= safeNotifCount %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>
                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>

                <% if (safeNotifItems.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of safeNotifItems) {
                      const kind = n.kind || "";
                      const actor = n.actor_username || "Someone";
                      const created = n.created_at || "";
                      const unread = Number(n.is_read || 0) === 0;
                      const sid = n.show_id || null;
                    %>
                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>
                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>
                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (safeMe.avatar_url) { %>
                <img src="<%= safeMe.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= safeMe.username %></span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap">
    <% if (safeFlashes.length > 0) { %>
      <div class="flashes">
        <% for (const f of safeFlashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <div class="profile_hero"
      <%= safeProfileUser.banner_url ? `style="--pBanner:url('${safeProfileUser.banner_url}');"` : "" %>>
      <div class="profile_hero_inner"
        <%= safeProfileUser.theme_color ? `style="--pAccent: ${safeProfileUser.theme_color};"` : "" %>>

        <div class="row gap" style="align-items:center;">
          <div class="avatar_lg">
            <% if (safeProfileUser.avatar_url) { %>
              <img src="<%= safeProfileUser.avatar_url %>" alt="avatar">
            <% } else { %>
              <div class="avatar_fallback"></div>
            <% } %>
          </div>

          <div style="min-width:0;">
            <div class="kicker">Profile</div>
            <h1 style="margin:6px 0 0;">
              <%= safeProfileUser.username ? safeProfileUser.username : "User" %>
            </h1>

            <% if (safeRoles.length > 0) { %>
              <div class="row gap" style="margin-top:10px; flex-wrap:wrap;">
                <% for (const r of safeRoles) { %>
                  <span class="role_tag" <%= r && r.color ? `style="border-color: ${r.color}; color: ${r.color};"` : "" %>>
                    <%= r && r.name ? r.name : "" %>
                  </span>
                <% } %>
              </div>
            <% } %>

            <% if (safeProfileUser.username) { %>
              <div class="row gap" style="margin-top:10px; flex-wrap:wrap;">
                <a class="btn ghost" href="/u/<%= encodeURIComponent(safeProfileUser.username) %>">Back to profile</a>
                <a class="btn ghost on" href="/u/<%= encodeURIComponent(safeProfileUser.username) %>/ratings">All Ratings</a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="profile_layout" style="margin-top:16px;">
      <aside class="profile_side">
        <div class="panel profile_stats">
          <div class="kicker">Stats</div>
          <div class="muted small" style="margin-top:10px;">
            Total ratings: <%= safeRows.length %>
          </div>
        </div>
      </aside>

      <section class="stack">
        <div class="panel">
          <div class="row between" style="align-items:flex-end;">
            <div>
              <div class="kicker">Ratings</div>
              <h2 style="margin:6px 0 0;">All Ratings</h2>
              <div class="muted small">Filter by rating, or ratings with written reviews.</div>
            </div>
          </div>

          <% if (safeProfileUser.username) { %>
            <form method="get"
                  id="ratingsFilterForm"
                  action="/u/<%= encodeURIComponent(safeProfileUser.username) %>/ratings"
                  style="margin-top:12px;">
              <div class="row gap" style="flex-wrap:wrap; align-items:flex-end;">
                <div class="field" style="min-width:240px; flex:1;">
                  <label>Search corps</label>
                  <input
                    class="ratingSearchInput"
                    id="ratingsSearchInput"
                    name="q"
                    value="<%= safeQ %>"
                    placeholder="e.g., Blue Devils, Crown, Phantom"
                    autocomplete="off"
                  >
                </div>
          
                <div class="field" style="min-width:260px;">
                  <label>Sort</label>
                  <select class="ratingFilterSelect" id="ratingsSortSelect" name="sort">
                    <option value="high" <%= safeSort === 'high' ? 'selected' : '' %>>Highest Rating</option>
                    <option value="low" <%= safeSort === 'low' ? 'selected' : '' %>>Lowest Rating</option>
                    <option value="high_reviews" <%= safeSort === 'high_reviews' ? 'selected' : '' %>>Highest Rating With Reviews</option>
                    <option value="low_reviews" <%= safeSort === 'low_reviews' ? 'selected' : '' %>>Lowest Rating With Reviews</option>
                  </select>
                </div>
              </div>
            </form>
          <% } %>

          <% if (safeRows.length > 0) { %>
            <div class="ratings_list">
              <% for (const rr of safeRows) {
                   const rh = rr.rating_half != null ? Number(rr.rating_half) : 0;
                   const titleText = rr.title || "Untitled Show";
                   const corpsText = rr.corps || "";
                   const yearText = rr.year || "";
                   const reviewText = String(rr.review_text || "").trim();
                   const hasReview = reviewText.length > 0;
              %>
                <details class="ratingCard">
                  <summary class="ratingSummary">
                    <div class="ratingLeft">
                      <div class="ratingMeta">
                        <div class="ratingTitle">
                          <a href="/show/<%= rr.show_id %>" style="color:inherit; text-decoration:none;" onclick="event.stopPropagation();">
                            <%= titleText %>
                          </a>
                        </div>
          
                        <div class="ratingSub">
                          <%= corpsText %><%= corpsText && yearText ? " • " : "" %><%= yearText %>
                        </div>
          
                        <div class="muted small" style="margin-top:5px;">
                          <% if (hasReview) { %>
                            Click to view review
                          <% } else { %>
                            No written review
                          <% } %>
                        </div>
                      </div>
                    </div>
          
                    <div style="display:flex; align-items:center;">
                      <div class="ratingScore">
                        ★ <%= (rh / 2).toFixed(rh % 2 ? 1 : 0) %>
                      </div>
                      <span class="ratingChevron">▶</span>
                    </div>
                  </summary>
          
                  <div class="ratingBody">
                    <% if (hasReview) { %>
                      <div class="ratingReviewText"><%= reviewText %></div>
                      <% if (rr.review_ts) { %>
                        <div class="muted small" style="margin-top:10px;">
                          Posted on <%= new Date(Number(rr.review_ts) * 1000).toLocaleDateString('en-US') %>
                        </div>
                      <% } %>
                    <% } else { %>
                      <div class="ratingNoReview">
                        <%= safeProfileUser.username || "This user" %> rated this show but did not leave a written review.
                      </div>
                    <% } %>
                  </div>
                </details>
              <% } %>
            </div>
          <% } else { %>
            <div class="muted" style="margin-top:12px;">No ratings found.</div>
          <% } %>
        </div>
      </section>
    </div>
  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd  = document.getElementById("notifDropdown");
      if (!btn || !dd) return;

      dd.addEventListener("click", (e) => e.stopPropagation());

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        dd.classList.toggle("open");
      });

      document.addEventListener("click", () => {
        dd.classList.remove("open");
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") dd.classList.remove("open");
      });
    })();
  </script>
  <script>
    (() => {
      const form = document.getElementById("ratingsFilterForm");
      const sortSelect = document.getElementById("ratingsSortSelect");
      const searchInput = document.getElementById("ratingsSearchInput");
  
      if (!form) return;
  
      if (sortSelect) {
        sortSelect.addEventListener("change", () => {
          form.submit();
        });
      }
  
      if (searchInput) {
        let timer = null;
  
        searchInput.addEventListener("input", () => {
          clearTimeout(timer);
          timer = setTimeout(() => {
            form.submit();
          }, 450);
        });
  
        window.addEventListener("load", () => {
          if (sessionStorage.getItem("restoreRatingsSearchFocus") === "1") {
            sessionStorage.removeItem("restoreRatingsSearchFocus");
            searchInput.focus();
            const len = searchInput.value.length;
            searchInput.setSelectionRange(len, len);
          }
        });
  
        searchInput.addEventListener("input", () => {
          sessionStorage.setItem("restoreRatingsSearchFocus", "1");
        });
      }
    })();
  </script>

</body>
</html>




