<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>All Ratings - Pressboxd</title>
  <link rel="stylesheet" href="/static/styles.css"/>
</head>
<body class="app">
<%
  const meUsername = me && me.username ? me.username : null;
  const puUsername = profile_user && profile_user.username ? profile_user.username : null;
  const isMe = !!(meUsername && puUsername && meUsername === puUsername);
  const safeRoles = Array.isArray(user_roles) ? user_roles : [];
  const safeRows = Array.isArray(rows) ? rows : [];
%>
  <main class="wrap">

    <div class="profile_hero"
      <%= profile_user && profile_user.banner_url ? `style="--pBanner:url('${profile_user.banner_url}');"` : "" %>>
      <div class="profile_hero_inner"
        <%= profile_user && profile_user.theme_color ? `style="--pAccent: ${profile_user.theme_color};"` : "" %>>

        <div class="row gap" style="align-items:center;">

          <div class="avatar_lg">
            <% if (profile_user && profile_user.avatar_url) { %>
              <img src="<%= profile_user.avatar_url %>" alt="avatar">
            <% } else { %>
              <div class="avatar_fallback"></div>
            <% } %>
          </div>

          <div style="min-width:0;">
            <div class="kicker">Profile</div>
            <h1 style="margin:6px 0 0;">
              <%= profile_user && profile_user.username ? profile_user.username : "User" %>
            </h1>

            <% if (safeRoles.length > 0) { %>
              <div class="row gap" style="margin-top:10px; flex-wrap:wrap;">
                <% for (const r of safeRoles) { %>
                  <span class="role_tag" <%= r && r.color ? `style="border-color: ${r.color}; color: ${r.color};"` : "" %>>
                    <%= r && r.name ? r.name : "" %>
                  </span>
                <% } %>
              </div>
            <% } %>

            <div class="row gap" style="margin-top:10px; flex-wrap:wrap;">
              <a class="btn ghost" href="/u/<%= encodeURIComponent(profile_user.username) %>">Back to profile</a>
              <a class="btn ghost on" href="/u/<%= encodeURIComponent(profile_user.username) %>/ratings">All Ratings</a>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="profile_layout" style="margin-top:16px;">

      <aside class="profile_side">
        <div class="panel profile_stats">
          <div class="kicker">Stats</div>
          <div class="muted small" style="margin-top:10px;">
            Total ratings: <%= safeRows.length %>
          </div>
        </div>
      </aside>

      <section class="stack">

        <div class="panel">
          <div class="row between" style="align-items:flex-end;">
            <div>
              <div class="kicker">Ratings</div>
              <h2 style="margin:6px 0 0;">All Ratings</h2>
              <div class="muted small">Filter by corps name, and sort high/low.</div>
            </div>
          </div>

          <form method="get"
                action="/u/<%= encodeURIComponent(profile_user.username) %>/ratings"
                style="margin-top:12px;">
            <div class="row gap" style="flex-wrap:wrap; align-items:flex-end;">
              <div class="field" style="min-width:240px; flex:1;">
                <label>Search corps</label>
                <input name="q" value="<%= q || '' %>" placeholder="e.g., Blue Devils, Crown, Phantom">
              </div>

              <div class="field" style="min-width:200px;">
                <label>Sort</label>
                <select name="sort">
                  <option value="high" <%= sort !== 'low' ? 'selected' : '' %>>Highest rated</option>
                  <option value="low" <%= sort === 'low' ? 'selected' : '' %>>Lowest rated</option>
                </select>
              </div>

              <div class="actions" style="min-width:160px;">
                <button class="btn green" type="submit">Apply</button>
              </div>
            </div>
          </form>

          <% if (safeRows.length > 0) { %>
            <div class="postergrid" style="margin-top:14px;">
              <% for (const rr of safeRows) { 
                   const p =
                     rr.poster_url ||
                     rr.show_poster_url ||
                     rr.poster ||
                     rr.poster_path ||
                     "";
                   const rh = rr.rating_half != null ? Number(rr.rating_half) : 0;
                   const titleText = rr.title || "";
                   const corpsText = rr.corps || "";
                   const yearText = rr.year || "";
                   let imgSrc = "";
                   if (p) {
                     if (String(p).includes("://") || String(p).startsWith("/")) {
                       imgSrc = p;
                     } else {
                       imgSrc = "/" + String(p).replace(/^static\//, "");
                       if (!imgSrc.startsWith("/")) imgSrc = "/" + imgSrc;
                     }
                   }
              %>
                <a class="poster" href="/show/<%= rr.show_id %>">
                  <div class="poster_art">
                    <% if (imgSrc) { %>
                      <img class="poster_img" src="<%= imgSrc %>"
                           alt="<%= titleText || 'poster' %>" loading="lazy">
                    <% } else { %>
                      <div class="poster_fallback"></div>
                    <% } %>

                    <div class="tile_rating">
                      <span class="tile_star">★</span> <%= (rh / 2).toFixed(1) %>
                    </div>

                    <% if (yearText) { %>
                      <div class="tile_year"><%= yearText %></div>
                    <% } %>
                  </div>

                  <div class="poster_meta">
                    <div class="poster_title"><%= titleText %></div>
                    <div class="poster_sub"><%= corpsText %></div>
                  </div>
                </a>
              <% } %>
            </div>
          <% } else { %>
            <div class="muted" style="margin-top:12px;">No ratings found.</div>
          <% } %>
        </div>

      </section>
    </div>

  </main>
</body>
</html>
