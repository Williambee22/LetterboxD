<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>All Ratings - Pressboxd</title>

  <link rel="stylesheet" href="/static/styles.css"/>
  <link rel="icon" type="image/png" href="/static/favicon.png"/>

  <style>
    html,
    body,
    body.app {
      background: #000 !important;
      background-image: none !important;
    }

    .auth {
      align-items: center;
      gap: 12px;
    }

    .notifWrap {
      position: relative;
      display: inline-flex;
      align-items: center;
    }

    .bellBtn {
      position: relative;
      border: none;
      background: transparent;
      cursor: pointer;
      color: inherit;
      padding: 6px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: .95;
    }

    .bellBtn:hover {
      background: rgba(255,255,255,.06);
    }

    .badgeDot {
      position: absolute;
      top: 3px;
      right: 3px;
      min-width: 18px;
      height: 18px;
      padding: 0 6px;
      border-radius: 999px;
      background: #ff3b30;
      color: #fff;
      font-size: 11px;
      line-height: 18px;
      text-align: center;
      font-weight: 800;
      box-shadow: 0 6px 18px rgba(0,0,0,.35);
    }

    .notifDropdown {
      display: none;
      position: absolute;
      right: 0;
      top: 40px;
      width: 340px;
      max-height: 420px;
      overflow: auto;
      background: rgba(15,23,42,.98);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,.45);
      z-index: 9999;
    }

    .notifDropdown.open {
      display: block;
    }

    .notifHeader {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 12px;
      border-bottom: 1px solid rgba(255,255,255,.10);
      position: sticky;
      top: 0;
      background: rgba(15,23,42,.98);
      backdrop-filter: blur(8px);
    }

    .notifTitle {
      font-weight: 900;
    }

    .markReadBtn {
      border: none;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: .85;
      font-size: 12px;
      padding: 6px 8px;
      border-radius: 10px;
    }

    .markReadBtn:hover {
      background: rgba(255,255,255,.06);
      opacity: 1;
    }

    .notifList {
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .notifItem {
      padding: 10px;
      border-radius: 12px;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.08);
    }

    .notifItem.unread {
      background: rgba(99,102,241,.18);
      border-color: rgba(99,102,241,.25);
    }

    .notifTime {
      font-size: 12px;
      opacity: .7;
      margin-top: 4px;
    }

    .notifEmpty {
      padding: 12px;
      opacity: .8;
    }

    .authBellSlot {
      display: inline-flex;
      align-items: center;
    }

    .notifDropdown,
    .notifDropdown * {
      pointer-events: auto !important;
    }

    /* =========================================================
       PAGE
       ========================================================= */

    .ratingsPage {
      padding-top: 22px;
      padding-bottom: 60px;
    }

    .ratingsHero {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.10);
      border-radius: 18px;
      background: #080808;
      margin-bottom: 16px;
    }

    .ratingsHero::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(0,0,0,.92), rgba(0,0,0,.58)),
        var(--ratings-banner, none);
      background-size: cover;
      background-position: center;
      opacity: .9;
      pointer-events: none;
    }

    .ratingsHeroInner {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 22px;
    }

    .ratingsIdentity {
      display: flex;
      align-items: center;
      gap: 15px;
      min-width: 0;
    }

    .ratingsAvatar {
      width: 72px;
      height: 72px;
      flex: 0 0 72px;
      border-radius: 50%;
      overflow: hidden;
      border: 2px solid color-mix(in srgb, var(--accent) 60%, rgba(255,255,255,.20));
      background: rgba(255,255,255,.07);
    }

    .ratingsAvatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .ratingsAvatar .avatar_fallback {
      display: block;
      width: 100%;
      height: 100%;
    }

    .ratingsKicker {
      text-transform: uppercase;
      letter-spacing: .09em;
      font-size: 10px;
      font-weight: 900;
      color: rgba(255,255,255,.55);
    }

    .ratingsUsername {
      margin: 4px 0 0;
      color: #fff;
      font-size: 28px;
      line-height: 1.05;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .ratingsRoles {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 9px;
    }

    .ratingsHeroActions {
      flex: 0 0 auto;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    /* =========================================================
       STATS
       ========================================================= */

    .ratingsStats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 10px;
      margin-bottom: 16px;
    }

    .ratingsStat {
      border: 1px solid rgba(255,255,255,.09);
      border-radius: 14px;
      background: rgba(255,255,255,.03);
      padding: 14px 16px;
    }

    .ratingsStatLabel {
      color: rgba(255,255,255,.55);
      font-size: 11px;
      font-weight: 750;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .ratingsStatValue {
      margin-top: 5px;
      color: #fff;
      font-size: 24px;
      line-height: 1;
      font-weight: 900;
    }

    /* =========================================================
       FILTER BAR
       ========================================================= */

    .ratingsToolbar {
      border: 1px solid rgba(255,255,255,.10);
      border-radius: 15px;
      background: #050505;
      padding: 15px;
      margin-bottom: 14px;
    }

    .ratingsToolbarTop {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 12px;
    }

    .ratingsToolbarTitle {
      margin: 0;
      color: #fff;
      font-size: 20px;
      font-weight: 900;
    }

    .ratingsToolbarSub {
      margin-top: 4px;
      color: rgba(255,255,255,.55);
      font-size: 12px;
    }

    .ratingsResultCount {
      color: rgba(255,255,255,.55);
      font-size: 12px;
      white-space: nowrap;
    }

    .ratingsFilterRow {
      display: grid;
      grid-template-columns: minmax(220px,1fr) minmax(220px,280px);
      gap: 10px;
      align-items: end;
    }

    .ratingsField label {
      display: block;
      margin-bottom: 6px;
      color: rgba(255,255,255,.65);
      font-size: 11px;
      font-weight: 800;
    }

    .ratingSearchInput,
    .ratingFilterSelect {
      width: 100%;
      height: 40px;
      box-sizing: border-box;
      border: 1px solid rgba(255,255,255,.13) !important;
      border-radius: 10px;
      background: #111 !important;
      color: #fff !important;
      outline: none;
    }

    .ratingSearchInput {
      padding: 0 12px;
    }

    .ratingFilterSelect {
      padding: 0 10px;
      cursor: pointer;
    }

    .ratingFilterSelect option {
      background: #111 !important;
      color: #fff !important;
    }

    .ratingSearchInput:focus,
    .ratingFilterSelect:focus {
      border-color: color-mix(in srgb, var(--accent) 55%, rgba(255,255,255,.18)) !important;
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent);
    }

    /* =========================================================
       RATING CARDS
       ========================================================= */

    .ratingsGrid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 10px;
    }

    .ratingCard {
      min-width: 0;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 14px;
      background: rgba(255,255,255,.025);
      overflow: hidden;
      transition: background .15s ease, border-color .15s ease, transform .15s ease;
    }

    .ratingCard:hover {
      background: rgba(255,255,255,.045);
      border-color: color-mix(in srgb, var(--accent) 32%, rgba(255,255,255,.10));
      transform: translateY(-1px);
    }

    .ratingSummary {
      list-style: none;
      cursor: pointer;
      display: grid;
      grid-template-columns: 62px minmax(0,1fr) auto;
      gap: 12px;
      align-items: center;
      padding: 11px;
    }

    .ratingSummary::-webkit-details-marker {
      display: none;
    }

    .ratingPoster {
      width: 62px;
      height: 88px;
      border-radius: 9px;
      overflow: hidden;
      background: rgba(255,255,255,.05);
      border: 1px solid rgba(255,255,255,.07);
    }

    .ratingPoster img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .ratingMeta {
      min-width: 0;
    }

    .ratingTitle {
      color: #fff;
      font-size: 14px;
      font-weight: 900;
      line-height: 1.25;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ratingTitle a {
      color: inherit;
      text-decoration: none;
    }

    .ratingTitle a:hover {
      text-decoration: underline;
    }

    .ratingSub {
      margin-top: 4px;
      color: rgba(255,255,255,.58);
      font-size: 12px;
      line-height: 1.25;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ratingStatusRow {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 9px;
    }

    .ratingMiniTag {
      display: inline-flex;
      align-items: center;
      min-height: 19px;
      padding: 2px 6px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.08);
      background: rgba(255,255,255,.04);
      color: rgba(255,255,255,.60);
      font-size: 9px;
      font-weight: 800;
    }

    .ratingMiniTag.reviewed {
      background: rgba(25,135,75,.15);
      border-color: rgba(25,135,75,.24);
      color: rgba(150,235,185,.92);
    }

    .ratingRight {
      display: flex;
      align-items: center;
      gap: 7px;
      align-self: start;
    }

    .ratingScore {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
      padding: 7px 11px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.11);
      background: rgba(255,255,255,.05);
      color: #fff;
      font-size: 16px;
      font-weight: 900;
      line-height: 1;
    }
    .ratingChevron {
      font-size: 11px;
      opacity: .6;
      transition: transform .15s ease;
    }

    details[open] .ratingChevron {
      transform: rotate(90deg);
    }

    .ratingBody {
      padding: 11px 13px 13px;
      border-top: 1px solid rgba(255,255,255,.06);
      background: rgba(0,0,0,.22);
    }

    .ratingReviewText {
      white-space: pre-wrap;
      line-height: 1.55;
      font-size: 13px;
      color: rgba(255,255,255,.88);
    }

    .ratingNoReview {
      color: rgba(255,255,255,.50);
      font-size: 12px;
    }

    .ratingDate {
      margin-top: 10px;
      color: rgba(255,255,255,.45);
      font-size: 10px;
    }

    .ratingsEmpty {
      border: 1px dashed rgba(255,255,255,.10);
      border-radius: 14px;
      padding: 34px 18px;
      text-align: center;
      color: rgba(255,255,255,.55);
    }

    @media (max-width: 850px) {
      .ratingsGrid {
        grid-template-columns: 1fr;
      }

      .ratingsHeroInner {
        align-items: flex-start;
        flex-direction: column;
      }

      .ratingsHeroActions {
        justify-content: flex-start;
      }
    }

    @media (max-width: 650px) {
      .ratingsPage {
        padding-top: 14px;
      }

      .ratingsStats {
        grid-template-columns: 1fr;
      }

      .ratingsFilterRow {
        grid-template-columns: 1fr;
      }

      .ratingsToolbarTop {
        align-items: flex-start;
        flex-direction: column;
      }

      .ratingSummary {
        grid-template-columns: 54px minmax(0,1fr);
      }

      .ratingPoster {
        width: 54px;
        height: 77px;
      }

      .ratingRight {
        grid-column: 2;
        margin-top: -4px;
      }

      .ratingsAvatar {
        width: 62px;
        height: 62px;
        flex-basis: 62px;
      }

      .ratingsUsername {
        font-size: 24px;
      }
    }
  </style>
</head>

<%
  const safeMe = (typeof me !== "undefined" && me) ? me : null;
  const safeProfileUser = (typeof profile_user !== "undefined" && profile_user) ? profile_user : {};
  const safeRoles = (typeof user_roles !== "undefined" && Array.isArray(user_roles)) ? user_roles : [];
  const safeRows = (typeof rows !== "undefined" && Array.isArray(rows)) ? rows : [];
  const safeSort = (typeof sort !== "undefined" && sort) ? sort : "high";
  const safeQ = (typeof q !== "undefined" && q) ? q : "";
  const safeNotifCount = (typeof notif_count !== "undefined" && notif_count) ? notif_count : 0;
  const safeNotifItems = (typeof notif_items !== "undefined" && Array.isArray(notif_items)) ? notif_items : [];
  const safeFlashes = (typeof flashes !== "undefined" && Array.isArray(flashes)) ? flashes : [];

  const totalRatings = safeRows.length;
  const reviewCount = safeRows.filter(r => String(r?.review_text || "").trim()).length;
  const avgRating = totalRatings
    ? safeRows.reduce((sum, r) => sum + (Number(r?.rating_half || 0) / 2), 0) / totalRatings
    : null;

  const bannerStyle = safeProfileUser.banner_url
    ? `--ratings-banner:url('${safeProfileUser.banner_url}');`
    : "";
%>

<body class="app" <%= safeMe && safeMe.theme_color ? `style="--accent:${safeMe.theme_color};"` : "" %>>
  <header class="topbar">
    <div class="wrap row between">
      <div style="display:flex;align-items:center;gap:10px;">
        <a
          href="https://www.generaleffect.media/"
          target="_blank"
          rel="noopener"
          style="display:flex;align-items:center;"
        >
          <img
            src="/static/logo.png"
            alt="Logo"
            style="width:36px;height:36px;object-fit:contain;transition:transform .6s ease-in-out;"
            onmouseover="this.style.transform='rotate(360deg)'"
            onmouseout="this.style.transform='rotate(0deg)'"
          >
        </a>

        <a class="brand" href="/shows" style="display:flex;align-items:center;">
          <img
            src="/static/pressboxd-wordmark.png"
            alt="Pressboxd"
            style="height:68px;width:auto;display:block;"
          >
        </a>
      </div>

      <nav class="nav row">
        <a href="/shows">Shows</a>
        <a href="/top">Top Shows</a>
        <a href="/top_users">Top Users</a>
        <a href="/predictions">Predictions</a>
        <a href="/forums">Forums</a>
        <a href="/tierlists">Tierlists</a>

        <% if (safeMe && Number(safeMe.is_admin) === 1) { %>
          <a href="/admin/bulk_add">Mass Add</a>
          <a href="/admin/roles">Roles</a>
          <a href="/admin/users">Users</a>
        <% } %>
      </nav>

      <div class="auth row">
        <% if (safeMe) { %>
          <div class="authBellSlot">
            <div class="notifWrap">
              <button class="bellBtn" id="bellBtn" aria-label="Notifications" title="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Z" stroke="currentColor" stroke-width="1"/>
                  <path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16l-2-2Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
                </svg>

                <% if (safeNotifCount > 0) { %>
                  <span class="badgeDot"><%= safeNotifCount %></span>
                <% } %>
              </button>

              <div class="notifDropdown" id="notifDropdown">
                <div class="notifHeader">
                  <div class="notifTitle">Notifications</div>
                  <form method="post" action="/me/notifications/read">
                    <button class="markReadBtn" type="submit">Mark all read</button>
                  </form>
                </div>

                <% if (safeNotifItems.length > 0) { %>
                  <div class="notifList">
                    <% for (const n of safeNotifItems) {
                         const kind = n.kind || "";
                         const actor = n.actor_username || "Someone";
                         const created = n.created_at || "";
                         const unread = Number(n.is_read || 0) === 0;
                         const sid = n.show_id || null;
                    %>
                      <div class="notifItem <%= unread ? 'unread' : '' %>">
                        <% if (kind === "friend_request") { %>
                          <div><b><%= actor %></b> sent you a friend request.</div>
                        <% } else if (kind === "follow") { %>
                          <div><b><%= actor %></b> followed you.</div>
                        <% } else if (kind === "review_upvote") { %>
                          <div>
                            <b><%= actor %></b> upvoted your review
                            <% if (sid) { %>
                              — <a href="/show/<%= sid %>">View show</a>
                            <% } %>
                          </div>
                        <% } else { %>
                          <div>New activity.</div>
                        <% } %>

                        <% if (created) { %>
                          <div class="notifTime"><%= created %></div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="notifEmpty">No notifications.</div>
                <% } %>
              </div>
            </div>
          </div>

          <a class="nav_user" href="/me">
            <span class="avatar_sm">
              <% if (safeMe.avatar_url) { %>
                <img src="<%= safeMe.avatar_url %>" alt="avatar">
              <% } else { %>
                <span class="avatar_fallback"></span>
              <% } %>
            </span>
            <span class="muted small"><%= safeMe.username %></span>
          </a>

          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="wrap ratingsPage">
    <% if (safeFlashes.length > 0) { %>
      <div class="flashes">
        <% for (const f of safeFlashes) { %>
          <div class="flash <%= f.category %>"><%= f.message %></div>
        <% } %>
      </div>
    <% } %>

    <section class="ratingsHero" style="<%= bannerStyle %>">
      <div class="ratingsHeroInner">
        <div class="ratingsIdentity">
          <div class="ratingsAvatar">
            <% if (safeProfileUser.avatar_url) { %>
              <img src="<%= safeProfileUser.avatar_url %>" alt="avatar">
            <% } else { %>
              <span class="avatar_fallback"></span>
            <% } %>
          </div>

          <div style="min-width:0;">
            <div class="ratingsKicker">All Ratings</div>
            <h1 class="ratingsUsername">
              <%= safeProfileUser.username || "User" %>
            </h1>

            <% if (safeRoles.length > 0) { %>
              <div class="ratingsRoles">
                <% for (const r of safeRoles) { %>
                  <span
                    class="role_tag"
                    <%= r && r.color ? `style="border-color:${r.color};color:${r.color};"` : "" %>
                  >
                    <%= r && r.name ? r.name : "" %>
                  </span>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>

        <% if (safeProfileUser.username) { %>
          <div class="ratingsHeroActions">
            <a
              class="btn ghost"
              href="/u/<%= encodeURIComponent(safeProfileUser.username) %>"
            >
              Back to Profile
            </a>
          </div>
        <% } %>
      </div>
    </section>

    <section class="ratingsStats">
      <div class="ratingsStat">
        <div class="ratingsStatLabel">Ratings Shown</div>
        <div class="ratingsStatValue"><%= totalRatings %></div>
      </div>

      <div class="ratingsStat">
        <div class="ratingsStatLabel">Average Rating</div>
        <div class="ratingsStatValue">
          <%= avgRating == null ? "—" : `★ ${avgRating.toFixed(2)}` %>
        </div>
      </div>

      <div class="ratingsStat">
        <div class="ratingsStatLabel">Written Reviews</div>
        <div class="ratingsStatValue"><%= reviewCount %></div>
      </div>
    </section>

    <section class="ratingsToolbar">
      <div class="ratingsToolbarTop">
        <div>
          <h2 class="ratingsToolbarTitle">Ratings Library</h2>
          <div class="ratingsToolbarSub">
            Search by corps and sort by score, year, or written reviews.
          </div>
        </div>

        <div class="ratingsResultCount">
          <%= totalRatings %> <%= totalRatings === 1 ? "rating" : "ratings" %>
        </div>
      </div>

      <% if (safeProfileUser.username) { %>
        <form
          method="get"
          id="ratingsFilterForm"
          action="/u/<%= encodeURIComponent(safeProfileUser.username) %>/ratings"
        >
          <div class="ratingsFilterRow">
            <div class="ratingsField">
              <label for="ratingsSearchInput">Search Corps</label>
              <input
                class="ratingSearchInput"
                id="ratingsSearchInput"
                name="q"
                value="<%= safeQ %>"
                placeholder="Blue Devils, Crown, Phantom..."
                autocomplete="off"
              >
            </div>

            <div class="ratingsField">
              <label for="ratingsSortSelect">Sort</label>
              <select class="ratingFilterSelect" id="ratingsSortSelect" name="sort">
                <option value="high" <%= safeSort === "high" ? "selected" : "" %>>
                  Highest Rating
                </option>
                <option value="low" <%= safeSort === "low" ? "selected" : "" %>>
                  Lowest Rating
                </option>
                <option value="year_desc" <%= safeSort === "year_desc" ? "selected" : "" %>>
                  Year: Newest to Oldest
                </option>
                <option value="year_asc" <%= safeSort === "year_asc" ? "selected" : "" %>>
                  Year: Oldest to Newest
                </option>
                <option value="high_reviews" <%= safeSort === "high_reviews" ? "selected" : "" %>>
                  Highest Rating With Reviews
                </option>
                <option value="low_reviews" <%= safeSort === "low_reviews" ? "selected" : "" %>>
                  Lowest Rating With Reviews
                </option>
              </select>
            </div>
          </div>
        </form>
      <% } %>
    </section>

    <% if (safeRows.length > 0) { %>
      <section class="ratingsGrid">
        <% for (const rr of safeRows) {
             const rh = rr.rating_half != null ? Number(rr.rating_half) : 0;
             const titleText = rr.title || "Untitled Show";
             const corpsText = rr.corps || "";
             const yearText = rr.year || "";
             const poster = rr.poster_url || "/static/posters/placeholder.png";
             const reviewText = String(rr.review_text || "").trim();
             const hasReview = reviewText.length > 0;
        %>
          <details class="ratingCard">
            <summary class="ratingSummary">
              <div class="ratingPoster">
                <img
                  src="<%= poster %>"
                  alt="poster"
                  loading="lazy"
                  onerror="this.src='/static/posters/placeholder.png';"
                >
              </div>

              <div class="ratingMeta">
                <div class="ratingTitle">
                  <a
                    href="/show/<%= rr.show_id %>"
                    onclick="event.stopPropagation();"
                  >
                    <%= titleText %>
                  </a>
                </div>

                <div class="ratingSub">
                  <%= corpsText %><%= corpsText && yearText ? " • " : "" %><%= yearText %>
                </div>

                <div class="ratingStatusRow">
                  <% if (yearText) { %>
                    <span class="ratingMiniTag"><%= yearText %></span>
                  <% } %>

                  <% if (hasReview) { %>
                    <span class="ratingMiniTag reviewed">✓ Reviewed</span>
                  <% } else { %>
                    <span class="ratingMiniTag">Rating only</span>
                  <% } %>
                </div>
              </div>

              <div class="ratingRight">
                <div class="ratingScore">
                  ★ <%= (rh / 2).toFixed(rh % 2 ? 1 : 0) %>
                </div>
                <span class="ratingChevron">▶</span>
              </div>
            </summary>

            <div class="ratingBody">
              <% if (hasReview) { %>
                <div class="ratingReviewText"><%= reviewText %></div>

                <% if (rr.review_ts) { %>
                  <div class="ratingDate">
                    Review posted <%= new Date(Number(rr.review_ts) * 1000).toLocaleDateString("en-US") %>
                  </div>
                <% } %>
              <% } else { %>
                <div class="ratingNoReview">
                  <%= safeProfileUser.username || "This user" %> rated this show but did not leave a written review.
                </div>
              <% } %>
            </div>
          </details>
        <% } %>
      </section>
    <% } else { %>
      <div class="ratingsEmpty">No ratings found.</div>
    <% } %>
  </main>

  <footer class="wrap footer">
    <div class="small">Rate drum corps shows.</div>
  </footer>

  <script>
    (() => {
      const btn = document.getElementById("bellBtn");
      const dd = document.getElementById("notifDropdown");

      if (!btn || !dd) return;

      dd.addEventListener("click", e => e.stopPropagation());

      btn.addEventListener("click", e => {
        e.preventDefault();
        e.stopPropagation();
        dd.classList.toggle("open");
      });

      document.addEventListener("click", () => dd.classList.remove("open"));

      document.addEventListener("keydown", e => {
        if (e.key === "Escape") dd.classList.remove("open");
      });
    })();

    (() => {
      const form = document.getElementById("ratingsFilterForm");
      const sortSelect = document.getElementById("ratingsSortSelect");
      const searchInput = document.getElementById("ratingsSearchInput");

      if (!form) return;

      if (sortSelect) {
        sortSelect.addEventListener("change", () => form.submit());
      }

      if (searchInput) {
        let timer = null;

        searchInput.addEventListener("input", () => {
          sessionStorage.setItem("restoreRatingsSearchFocus", "1");
          clearTimeout(timer);
          timer = setTimeout(() => form.submit(), 900);
        });

        window.addEventListener("load", () => {
          if (sessionStorage.getItem("restoreRatingsSearchFocus") !== "1") return;

          sessionStorage.removeItem("restoreRatingsSearchFocus");
          searchInput.focus();

          const len = searchInput.value.length;
          searchInput.setSelectionRange(len, len);
        });
      }
    })();
  </script>
</body>
</html>
